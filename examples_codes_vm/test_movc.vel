/*
 * test_movc.vel
 *
 * Prueba MOVC y MOVH
 * Resultados esperados:
 *   R01 == 99   (cmps r2,r3 -> ZF=0; movc r1,r99,ZF NO ejecuta; luego cmps r2,r2 -> ZF=1 -> movc r1,r99,ZF ejecuta)
 *   R02 == 42   (movh: escribe 42 en host mem y lo lee de vuelta)
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:
    // MOVC reg, reg, flag test
    mov  r1, 0          // r1 = 0
    mov  r9, 99         // r9 = 99

    // cmps r2, r3 -> r2=0, r3=0 -> ZF=1
    mov  r2, 5
    mov  r3, 3
    cmps r2, r3         // ZF=0 (5 != 3)
    movc r1, r9, ZF     // NO ejecuta (ZF=0)

    cmps r2, r2         // ZF=1 (5 == 5)
    movc r1, r9, ZF     // ejecuta -> r1 = 99

    hlt

end_code:
