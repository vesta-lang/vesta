    t06          db "clamp(0,1,10)=1 "
    t07          db "clamp(15,1,10)=10"
    t08          db "fabs(-5.0)=5.0"
    t09          db "sqrt(4.0)=2.0"
    t10          db "pow(2.0,10.0)=1024"
    t11          db "floor(3.5)=3.0"
    t12          db "ceil(3.5)=4.0"
    t13          db "round(3.5)=4.0"
    t14          db "fmin(2,3)=2.0"
    t15          db "fmax(2,3)=3.0"
    t16          db "sin(0)=0"
    t17          db "cos(0)=1"
    t18          db "tan(0)=0"
    t19          db "log(1)=0"
    t20          db "log2(1)=0"
    t21          db "log10(1)=0"
