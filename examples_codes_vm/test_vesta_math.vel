/*
 * test_vesta_math.vel  -  Tests unitarios de vesta_math.dll
 *
 * Cada test llama a una funcion de vesta_math con entradas conocidas,
 * compara el resultado con el valor esperado usando cmpu + jmp.jne,
 * e imprime "[ OK ] nombre" o "[FAIL] nombre".
 *
 * Compilar y ejecutar:
 *   ./vm --build test_vesta_math.vel -o test_vesta_math
 *   ./vm --run   test_vesta_math.velb
 *
 * Requiere: vesta_io.dll y vesta_math.dll en el directorio de trabajo.
 *
 * Registros reservados:
 *   r12 = contador de tests pasados
 *   r13 = contador de tests fallidos
 *   r14 = proc_ptr (resultado de getproc, para llamadas a vesta_io)
 *   r8  = direccion del nombre del test actual
 *   r9  = longitud del nombre del test actual
 *   r10 = valor esperado (para cmpu)
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

@Import {
    @Method { @Lib("stdlib/native/io/vesta_io")   @Name("vio_print")      }
    @Method { @Lib("stdlib/native/io/vesta_io")   @Name("vio_println")     }
    @Method { @Lib("stdlib/native/io/vesta_io")   @Name("vio_print_uint")  }
    @Method { @Lib("stdlib/native/io/vesta_io")   @Name("vio_print_float") }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_abs")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_min")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_max")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_clamp")     }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_fabs")      }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_sqrt")      }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_pow")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_floor")     }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_ceil")      }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_round")     }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_fmin")      }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_fmax")      }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_sin")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_cos")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_tan")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_log")       }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_log2")      }
    @Method { @Lib("stdlib/native/math/vesta_math") @Name("vmath_log10")     }
}

code:

    getproc r14
    mov     r12, 0
    mov     r13, 0

    // ===== cabecera =====
    mov   r1, r14
    mov   r2, @Absolute("all.s_hdr")
    mov   r3, 29
    mov   r15, 3
    calln @Method("stdlib/native/io/vesta_io:vio_println")

// ==========================================================
// TEST 01: vmath_abs(-5) = 5
// ==========================================================
    mov  r8, @Absolute("all.t01")
    mov  r9, 9
    mov  r1, 0xFFFFFFFFFFFFFFFB       // -5 como uint64 (complemento a dos)
    mov  r15, 1
    calln @Method("stdlib/native/math/vesta_math:vmath_abs")
    mov  r10, 5
    cmpu r0, r10
    jmp.jne @Absolute("all.t01_fail")
    adds r12, 1
    mov  r1, r14
    mov  r2, @Absolute("all.s_ok")
    mov  r3, 7
    mov  r15, 3
    calln @Method("stdlib/native/io/vesta_io:vio_print")
    mov  r1, r14
    mov  r2, r8
    mov  r3, r9
    mov  r15, 3
    calln @Method("stdlib/native/io/vesta_io:vio_println")
    jmp  @Absolute("all.t01_end")
t01_fail:
    adds r13, 1
    mov  r1, r14
    mov  r2, @Absolute("all.s_fail")
    mov  r3, 7
    mov  r15, 3
    calln @Method("stdlib/native/io/vesta_io:vio_print")
    mov  r1, r14
    mov  r2, r8
    mov  r3, r9
    mov  r15, 3
    calln @Method("stdlib/native/io/vesta_io:vio_println")
t01_end:

