/*
 * test_alu_logic.vel
 *
 * Prueba las instrucciones logicas AND, OR, XOR, NOT, SHL, SHR, SAR.
 *
 * Resultado esperado al llegar a hlt:
 *   R01 == 0x0F   (and  0xFF, 0x0F -> 0x0F)
 *   R02 == 0xFF   (or   0xF0, 0x0F -> 0xFF)
 *   R03 == 0xFF   (xor  0xAA, 0x55 -> 0xFF)
 *   R04 == 0x00   (xor  0xAA, 0xAA -> 0x00, mismo valor: cero)
 *   R05 == 0xFFFFFFFFFFFFFFFF  (not 0x00 -> todos los bits a 1)
 *   R06 == 0x00   (not 0xFFFFFFFFFFFFFFFF -> 0x00)
 *   R07 == 0x80   (shl  0x01,  7 -> 0x80)
 *   R08 == 0x01   (shr  0x80,  7 -> 0x01)
 *   R09 == 0xFF   (shr  0xFF00, 8 -> 0xFF)
 *   R10 == 0xFFFFFFFFFFFFFFFE (sar  0xFF00000000000000, 55 -> propagacion de signo)
 *          ( 0xFF00000000000000 como int64 = -72057594037927936; >> 55 = -2 = 0xFFFFFFFFFFFFFFFE )
 *   R11 == 0x00   (and  r12, r13 donde r12=0xAA, r13=0x55 -> 0x00, bits no solapan)
 *   R12 == 0xFF   (or   r12, r13 donde r12=0xAA, r13=0x55 -> 0xFF)
 *   R13 == 0x00   (xor  r14, r14 -> 0x00, registro consigo mismo)
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:

// -----------------------------------------------------------------------
// T1: and  r2=0xFF, r3=0x0F -> R01 = 0x0F
// -----------------------------------------------------------------------
    mov   r2, 0xFF
    mov   r3, 0x0F
    and   r2, r3
    mov   r1, r2

// -----------------------------------------------------------------------
// T2: or   r2=0xF0, r3=0x0F -> R02 = 0xFF
// -----------------------------------------------------------------------
    mov   r2, 0xF0
    mov   r3, 0x0F
    or    r2, r3
    mov   r2, r2

// -----------------------------------------------------------------------
// T3: xor  r3=0xAA, r4=0x55 -> R03 = 0xFF
// -----------------------------------------------------------------------
    mov   r3, 0xAA
    mov   r4, 0x55
    xor   r3, r4
    mov   r3, r3

// -----------------------------------------------------------------------
// T4: xor  r4=0xAA, r4=0xAA -> R04 = 0x00 (mismo registro)
// -----------------------------------------------------------------------
    mov   r4, 0xAA
    xor   r4, r4
    mov   r4, r4

// -----------------------------------------------------------------------
// T5: not  r5=0x00 -> R05 = 0xFFFFFFFFFFFFFFFF
// -----------------------------------------------------------------------
    mov   r5, 0
    not   r5
    mov   r5, r5

// -----------------------------------------------------------------------
// T6: not  r6=0xFFFFFFFFFFFFFFFF -> R06 = 0x00
// -----------------------------------------------------------------------
    mov   r6, 0xFFFFFFFFFFFFFFFF
    not   r6
    mov   r6, r6

// -----------------------------------------------------------------------
// T7: shl  r7=0x01, r8=7 -> R07 = 0x80
// -----------------------------------------------------------------------
    mov   r7, 0x01
    mov   r8, 7
    shl   r7, r8
    mov   r7, r7

// -----------------------------------------------------------------------
// T8: shr  r8=0x80, r9=7 -> R08 = 0x01
// -----------------------------------------------------------------------
    mov   r8, 0x80
    mov   r9, 7
    shr   r8, r9
    mov   r8, r8

// -----------------------------------------------------------------------
// T9: shr  r9=0xFF00, r10=8 -> R09 = 0xFF
// -----------------------------------------------------------------------
    mov   r9, 0xFF00
    mov   r10, 8
    shr   r9, r10
    mov   r9, r9

// -----------------------------------------------------------------------
// T10: sar  r10=0xFF00000000000000, r11=55 -> R10 = 0xFFFFFFFFFFFFFFFE (-2)
//      sar propaga el bit de signo (bit 63 = 1 -> se rellena con 1s)
//      como int64: -72057594037927936 >> 55 = -2
// -----------------------------------------------------------------------
    mov   r10, 0xFF00000000000000
    mov   r11, 55
    sar   r10, r11
    mov   r10, r10

// -----------------------------------------------------------------------
// T11: and  r11=0xAA, r12=0x55 -> R11 = 0x00 (bits no solapan)
// -----------------------------------------------------------------------
    mov   r11, 0xAA
    mov   r12, 0x55
    and   r11, r12
    mov   r11, r11

// -----------------------------------------------------------------------
// T12: or   r12=0xAA, r13=0x55 -> R12 = 0xFF
// -----------------------------------------------------------------------
    mov   r12, 0xAA
    mov   r13, 0x55
    or    r12, r13
    mov   r12, r12

// -----------------------------------------------------------------------
// T13: xor  r13=0xCC, r13=0xCC -> R13 = 0x00 (mismo reg, xor consigo mismo)
// -----------------------------------------------------------------------
    mov   r13, 0xCC
    xor   r13, r13
    mov   r13, r13

    hlt

end_code:
