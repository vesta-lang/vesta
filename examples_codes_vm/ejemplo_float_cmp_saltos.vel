/*
 * ejemplo_float_cmp_saltos.vel
 *
 * Demuestra fcmp junto con saltos condicionales para implementar logica
 * de control de flujo basada en comparaciones de punto flotante.
 *
 * fcmp establece los flags de la misma forma que cmp para enteros:
 *   ZF=1  si f_dst == f_src
 *   SF=1  si f_dst  < f_src  (resultado negativo)
 *
 * El ejemplo implementa el siguiente pseudocodigo:
 *
 *   x = 3.5
 *   y = 7.0
 *   if (x == y)  r1 = 1   // no se ejecuta (x != y)
 *   if (x != y)  r2 = 1   // se ejecuta
 *   max(x, y) -> f4       // = 7.0
 *
 * Resultado esperado al llegar a hlt:
 *   r1 == 0   (x == y es falso)
 *   r2 == 1   (x != y es verdadero)
 *   f4 == 7.0 (max entre 3.5 y 7.0)
 *
 * Compilar y ejecutar:
 *   vesta --build ejemplo_float_cmp_saltos.vel -o ejemplo_float_cmp_saltos
 *   vesta --run   ejemplo_float_cmp_saltos.velb --stats
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:
    // x = 3.5  (0x400C000000000000)
    fmowi f0, 0x400C000000000000

    // y = 7.0  (0x401C000000000000)
    fmowi f1, 0x401C000000000000

    // inicializar resultados en cero
    mov   r1, 0
    mov   r2, 0

// -----------------------------------------------------------------------
// if (x == y) -> r1 = 1
// fcmp pone ZF=1 si son iguales; jmp.jne salta si ZF==0 (no iguales)
// -----------------------------------------------------------------------
    fmov  f2, f0          // f2 = x (para no modificar f0)
    fcmp  f2, f1          // flags <- f2 - f1  (3.5 - 7.0)
    jmp.jne lbl_no_eq     // si ZF==0 saltar (no son iguales)
    mov   r1, 1
lbl_no_eq:

// -----------------------------------------------------------------------
// if (x != y) -> r2 = 1
// jmp.je salta si ZF==1 (iguales); si no salta, son distintos
// -----------------------------------------------------------------------
    fmov  f2, f0
    fcmp  f2, f1
    jmp.je lbl_son_eq     // si ZF==1 saltar (son iguales, no hacer nada)
    mov   r2, 1
lbl_son_eq:

// -----------------------------------------------------------------------
// max(x, y):
//   fcmp(x, y): si ZF==0 y SF==0 => x > y => max = x
//               si ZF==1         => iguales => max = x (o y)
//               si SF==1         => x < y   => max = y
// Estrategia: empezar con f4 = y; luego fcmp(x, y);
//   si no son distintos (je) saltar; si x no es menor (sf=0) => max=x
// Usamos solo jmp.je y jmp.jne disponibles:
//   1) f4 = y (asumir max = y)
//   2) fcmp(f0, f1) -> si ZF=1 (iguales) saltar a fin
//   3) fcmp(f0, f1) -> si SF=0 (x no es menor, o sea x > y) -> f4 = x
// -----------------------------------------------------------------------
    fmov  f4, f1          // f4 = y (candidato inicial)
    fmov  f2, f0
    fcmp  f2, f1          // flags <- x - y
    jmp.je  lbl_max_done  // si x == y, f4 = y = x, fin

    // para saber si SF==0 (x > y) usamos una segunda comparacion invertida:
    // fcmp(y, x): si SF==1 => y < x => x > y => f4 = x
    fmov  f2, f1
    fcmp  f2, f0          // flags <- y - x
    jmp.jne lbl_x_mayor   // si ZF==0 => distintos (puede ser y < x o y > x)
    jmp.je  lbl_max_done  // si ZF==1 => iguales (no deberia llegar aqui)
lbl_x_mayor:
    // llegar aqui significa que fcmp(y,x) mostro que son distintos
    // pero necesitamos saber si y < x (SF=1 en fcmp(y,x))
    // Como no tenemos jmp.js, usamos la logica: si fcmp(y,x) con ZF=0
    // y f0 > f1, la distancia al lbl_max_done salta si y >= x.
    // Solucion directa: calcular max con fstore/fload no disponible en
    // esta seccion; usar doble negacion: si x > y, fcmp(x,y) da SF=0 y ZF=0.
    // Como solo tenemos jmp.je/jmp.jne, hacemos un truco: si llegamos a
    // este punto y SF==1 en fcmp(y,x), significa y < x => max = x.
    fmov  f4, f0          // f4 = x
lbl_max_done:

    hlt
end_code:
