/*
 * test_alu_sib.vel
 *
 * Prueba el modo de direccionamiento SIB (Scale-Index-Base):
 *   adds/mov reg, [base + index*scale]
 *   adds/mov [base + index*scale], reg
 *
 * Datos en memoria (lazy-allocated desde 0x3000):
 *   0x3000: 5   (slot0)
 *   0x3008: 15  (slot1)
 *   0x3010: 100 (slot2)
 *
 * Resultado esperado al llegar a hlt:
 *   R01 == 5    (mov r1, [r14 + r13*8]  base=0x3000 idx=0 s=8 -> mem[0x3000]=5)
 *   R02 == 15   (mov r2, [r14 + r12*8]  base=0x3000 idx=1 s=8 -> mem[0x3008]=15)
 *   R03 == 100  (mov r3, [r14 + r11*8]  base=0x3000 idx=2 s=8 -> mem[0x3010]=100)
 *   R04 == 15   (adds r4=10, [r14+r13*8] -> 10+5=15)
 *   R05 == 42   (mov [r14+r13*8], 42; verificacion: r5=read back)
 *   R06 == 18   (adds [r14+r12*8], r6=3 -> mem[0x3008]=15+3=18; luego r6=read back)
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:

// -----------------------------------------------------------------------
// Setup: escribe 3 valores qword en la zona de datos 0x3000
// -----------------------------------------------------------------------
    mov   r14, 0x3000
    mov   [r14], 5          // mem[0x3000] = 5  (slot0)

    mov   r15, 0x3008
    mov   [r15], 15         // mem[0x3008] = 15 (slot1)

    mov   r15, 0x3010
    mov   [r15], 100        // mem[0x3010] = 100 (slot2)

// -----------------------------------------------------------------------
// T1: mov r1, [r14 + r13*8]  r13=0, scale=8 -> r1 = mem[0x3000] = 5
// -----------------------------------------------------------------------
    mov   r13, 0
    mov   r1, [r14 + r13*8]

// -----------------------------------------------------------------------
// T2: mov r2, [r14 + r12*8]  r12=1, scale=8 -> r2 = mem[0x3008] = 15
// -----------------------------------------------------------------------
    mov   r12, 1
    mov   r2, [r14 + r12*8]

// -----------------------------------------------------------------------
// T3: mov r3, [r14 + r11*8]  r11=2, scale=8 -> r3 = mem[0x3010] = 100
// -----------------------------------------------------------------------
    mov   r11, 2
    mov   r3, [r14 + r11*8]

// -----------------------------------------------------------------------
// T4: adds r4=10, [r14 + r13]  scale=1 -> r4 = 10 + mem[0x3000] = 10+5 = 15
// -----------------------------------------------------------------------
    mov   r4, 10
    adds  r4, [r14 + r13]

// -----------------------------------------------------------------------
// T5: mov [r14 + r13*8], 42 (via SIB write) -> mem[0x3000] = 42
//     luego r5 = read back via SIB
// -----------------------------------------------------------------------
    mov   r5, 42
    mov   [r14 + r13*8], r5
    mov   r5, [r14 + r13*8]

// -----------------------------------------------------------------------
// T6: adds [r14 + r12*8], r6=3 -> mem[0x3008] = 15 + 3 = 18
//     luego r6 = read back via SIB
// -----------------------------------------------------------------------
    mov   r6, 3
    adds  [r14 + r12*8], r6
    mov   r6, [r14 + r12*8]

    hlt

end_code:
