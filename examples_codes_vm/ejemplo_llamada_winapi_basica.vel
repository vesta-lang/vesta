// indicar que el formato es crudo, aunque de por si el ensamblador



// lo define asi por defecto
@Format("raw")

// creamos nuestro espacio de direcciones, como el formato es crudo, no se
// usara para nada, pero el ensamblador necesita un espacio y una
// seccion para que tu codigo se pueda generar
@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

// creamos la seccion minima para hacer que nuestro codigo se genere,
// esta bien se podria llamar de cualquier manera
@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

// indicamos que queremos importar la funcion GetTickCount de la
// libreria kernel32.dll al linker.
@Import {
    @Method {
        @Lib("kernel32.dll")
        @Name("GetTickCount")
    },

    @Method {
        @Lib("kernel32.dll")
        @Name("GetACP")
    },
    @Method {
        @Lib("kernel32.dll")
        @Name("VirtualAlloc")
    }
}
/*
@Import {
    @Method { @Lib("libc.so.6") @Name("getpid") }
    @Method { @Lib("libc.so.6") @Name("time") }
}*/

code:
    inc r1
    inc r2
    xchg r1, cur1
    xchg cur2, r2

    mov r15, 4      // 4 argumentos
    mov r1, 0       // LPVOID lpAddress
    mov r2, 0x1000  // SIZE_T dwSize
    mov r3, 0x3000  // DWORD  flAllocationType = MEM_COMMIT | MEM_RESERVE
    mov r4, 0x04    // PAGE_READWRITE
    calln @Method("kernel32.dll:VirtualAlloc")

    hlt
end_code:
