/*
 * test_oop_instanceof.vel
 *
 * Construye una jerarquia de dos clases en memoria host y verifica
 * INSTANCEOF y CHECKCAST con transitividad:
 *
 *   ClassParent (sin supers)
 *       |
 *   ClassChild  (supers[0] = ClassParent)
 *
 * Objeto de tipo ClassChild:
 *   INSTANCEOF(obj, ClassChild)    -> 1   (misma clase)
 *   INSTANCEOF(obj, ClassParent)   -> 1   (transitivo via supers[0])
 *   INSTANCEOF(obj, ClassUnrelated)-> 0   (sin relacion)
 *
 *   CHECKCAST(null, cualquiera)    -> 0   (null pasa siempre)
 *   CHECKCAST(obj, ClassChild)     -> obj ptr
 *   CHECKCAST(obj, ClassParent)    -> obj ptr  (subclase pasa)
 *
 * Tambien verifica GCALLOC: reserva un buffer GC sin ObjectHeader
 * y lo accede via GCDEREF + cursor.
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:

// -----------------------------------------------------------------------
// Helper: zerear N*8 bytes a partir de cur0
//   entrada: r12 = N (numero de qwords), r11 = 0, cur0 = inicio bloque
//   modifica: r12, r14, cur0 (avanza N*8 bytes)
// -----------------------------------------------------------------------

// -----------------------------------------------------------------------
// 1. ClassParent (136 bytes, todo cero)  -> r1
// -----------------------------------------------------------------------
    mov   r1, 136
    alloc r1
    mov   r1, r0
    xchg  cur0, r1 ; mov r11, 0 ; mov r12, 17
zero_parent:
    writecur cur0, r11
    xchg r14, cur0 ; addu r14, 8 ; xchg cur0, r14
    dec  r12 ; jmp.jne @Absolute("code.zero_parent")
    xchg  cur0, r1              // cur0 = ClassParent base

// -----------------------------------------------------------------------
// 2. ClassChild (136 bytes, todo cero)  -> r2
// -----------------------------------------------------------------------
    mov   r3, 136
    alloc r3
    mov   r2, r0
    xchg  cur0, r2 ; mov r11, 0 ; mov r12, 17
zero_child:
    writecur cur0, r11
    xchg r14, cur0 ; addu r14, 8 ; xchg cur0, r14
    dec  r12 ; jmp.jne @Absolute("code.zero_child")
    xchg  cur0, r2

// -----------------------------------------------------------------------
// 3. Supers array para ClassChild: [ClassParent]  (8 bytes)  -> r3
// -----------------------------------------------------------------------
    mov   r5, 8
    alloc r5
    mov   r3, r0
    xchg  cur0, r3
    writecur cur0, r1           // supers[0] = ClassParent*

// -----------------------------------------------------------------------
// 4. Configurar ClassChild.supers (offset 32) y super_count (offset 40)
// -----------------------------------------------------------------------
    mov   r14, r2 ; addu r14, 32 ; xchg cur0, r14
    writecur cur0, r3           // ClassChild.supers = array

    mov   r14, r2 ; addu r14, 40 ; xchg cur0, r14
    mov   r5, 1 ; writecur cur0, r5  // ClassChild.super_count = 1

// -----------------------------------------------------------------------
// 5. ObjectHeader del objeto de tipo ClassChild  (16 bytes)  -> r4
//    class_ptr = ClassChild*, flags = 2 (OBJ_FLAG_RAW_OWNED)
// -----------------------------------------------------------------------
    mov   r5, 16
    alloc r5
    mov   r4, r0

    xchg  cur0, r4
    writecur cur0, r2           // ObjectHeader.class_ptr = ClassChild*

    mov   r14, r4 ; addu r14, 8 ; xchg cur0, r14
    mov   r5, 2 ; writecur cur0, r5d  // ObjectHeader.flags = OBJ_FLAG_RAW_OWNED

// -----------------------------------------------------------------------
// T1: INSTANCEOF(obj, ClassChild) -> R0 = 1  (clase exacta)
// -----------------------------------------------------------------------
    instanceof r4, r2

// -----------------------------------------------------------------------
// T2: INSTANCEOF(obj, ClassParent) -> R0 = 1  (transitivo via supers[0])
// -----------------------------------------------------------------------
    instanceof r4, r1

// -----------------------------------------------------------------------
// 6. ClassUnrelated (136 bytes, sin parentesco)  -> r5
// -----------------------------------------------------------------------
    mov   r6, 136
    alloc r6
    mov   r5, r0
    xchg  cur0, r5 ; mov r11, 0 ; mov r12, 17
zero_unrel:
    writecur cur0, r11
    xchg r14, cur0 ; addu r14, 8 ; xchg cur0, r14
    dec  r12 ; jmp.jne @Absolute("code.zero_unrel")

// -----------------------------------------------------------------------
// T3: INSTANCEOF(obj, ClassUnrelated) -> R0 = 0
// -----------------------------------------------------------------------
    instanceof r4, r5

// -----------------------------------------------------------------------
// T4: CHECKCAST(null, cualquiera) -> R0 = 0  (null pasa siempre)
// -----------------------------------------------------------------------
    mov       r6, 0
    checkcast r6, r2

// -----------------------------------------------------------------------
// T5: CHECKCAST(obj, ClassChild) -> R0 = r4  (misma clase)
// -----------------------------------------------------------------------
    checkcast r4, r2

// -----------------------------------------------------------------------
// T6: CHECKCAST(obj, ClassParent) -> R0 = r4  (subclase pasa)
// -----------------------------------------------------------------------
    checkcast r4, r1

// -----------------------------------------------------------------------
// T7: GCALLOC de un buffer de 256 bytes sin ClassInfo
//     R0 = GcHandle (distinto de GC_NULL_HANDLE = 0xFFFFFFFF)
// -----------------------------------------------------------------------
    mov      r6, 256
    gcalloc  r6              // R0 = GcHandle de 256 bytes en el GcHeap

    gcderef  cur1, r0        // cur1 = payload ptr del buffer GC

    // Escribir y leer un valor para confirmar que el payload es accesible
    mov      r7, 0xCAFEBABE
    writecur cur1, r7        // buf[0] = 0xCAFEBABE
    readcur  r8, cur1        // r8 = 0xCAFEBABE  (verificacion)

    drop     r0              // liberar el handle cuando ya no hace falta

    hlt

end_code:
