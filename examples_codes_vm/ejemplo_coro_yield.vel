/*
 * ejemplo_coro_yield.vel
 *
 * Demuestra la instruccion YIELD del Modelo A de concurrencia cooperativa.
 *
 * YIELD decrementa reductions_remaining a cero, haciendo que el scheduler
 * ceda el CPU al finalizar el quantum actual y reencole el proceso al final
 * de la cola FIFO de procesos listos.  Es equivalente a un "sleep(0)" o
 * "sched_yield()" cooperativo: el proceso no se bloquea, simplemente deja
 * pasar su turno para dar oportunidad a otros procesos.
 *
 * En este ejemplo de un solo proceso la diferencia no es observable en los
 * registros, pero ilustra el patron de uso correcto.  Cuando hay varios
 * procesos activos, yield garantiza que no acaparen el scheduler.
 *
 * Patron tipico con yield en un bucle largo:
 *
 *   bucle:
 *     ; ... hacer trabajo ...
 *     yield          ; ceder CPU al final de este quantum
 *     jmp.jmp bucle
 *
 * Resultado esperado al llegar a hlt:
 *   r0 == 3   (contador incrementado tres veces antes del hlt)
 *
 * Compilar y ejecutar:
 *   vesta --build ejemplo_coro_yield.vel -o ejemplo_coro_yield
 *   vesta --run   ejemplo_coro_yield.velb --stats
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:
    mov r0, 0     // r0 = contador de iteraciones

    // Iteracion 1: hacer trabajo, luego ceder
    addu r0, 1
    yield

    // Iteracion 2
    addu r0, 1
    yield

    // Iteracion 3: ultima iteracion, no es necesario ceder antes de hlt
    addu r0, 1

    // r0 debe ser 3
    hlt
end_code:
