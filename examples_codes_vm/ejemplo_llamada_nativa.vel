// indicar que el formato es crudo, aunque de por si el ensamblador



// lo define asi por defecto
@Format("raw")

// creamos nuestro espacio de direcciones, como el formato es crudo, no se
// usara para nada, pero el ensamblador necesita un espacio y una
// seccion para que tu codigo se pueda generar
@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

// creamos la seccion minima para hacer que nuestro codigo se genere,
// esta bien se podria llamar de cualquier manera
@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

// indicamos que queremos importar la funcion GetTickCount de la
// libreria kernel32.dll al linker.
@Import {
    @Method {
        @Lib("kernel32.dll")
        @Name("GetTickCount")
    },

    @Method {
        @Lib("kernel32.dll")
        @Name("GetACP")
    }
}
/*
@Import {
    @Method { @Lib("libc.so.6") @Name("getpid") }
    @Method { @Lib("libc.so.6") @Name("time") }
}*/

code:
    // llamamos al metodo, el resultado se almacena en r00
    calln @Method("kernel32.dll:GetACP")

    //mov [r4], 0x1234
    //mov r4, @Relative("all.name_library_imports")
    //mov rip, 0x1234
    //mov r4, r1
    adds r0, @Method("kernel32.dll:GetTickCount")
    //adds r0, @Method("libc.so.6:getpid") // solo para linux
    adds r0, @Absolute("all.name_library_imports")

    //push r15
    //push r15w
    //push rbp
    //push rsp
    //push rflags
    //push cur0

    // no descomentar el align
    //align 16

    //pop r15
    //pop r15w
    //pop rbp
    //pop rsp
    //pop rflags
    //pop cur0

    // bucle infinito donde sumamos 1 a r0
    //push rip
    //inc r0
    //pop rip

    // aqui sabemos que el offset de end_code es 0x35
    // como queremos escribir 2 bytes, la operacion para
    // calcular el offset final a escribir es:
    //
    //              (N bytes a escribir) - 1
    // Esto lo sumamos al offset base que era 0x35 y nos da 0x36.
    // para escribir 2 bytes usamos el registro 6 en modo WORD(16 bits) -> r6w
    // luego indicamos el valor a escribir, en este caso quiero escribir la instruccion
    // "hlt" para que el codigo se detenga correctamente, Los opcodes de esta instruccion
    // son 0x00 0x03, esto es un WORD de 0x0003
    //adds r06,   0x36
    //adds [r06w], 0x03
    adds r06, @Absolute("all.end_code")
    adds [r06w], 0x0300
    adds r0d, 0x12345678

    dec r15
    //inc r15
    //dec r15
    //dec r15

    mov r14, r15
    mov r13, r14
    mov r12, r13
    adds r15b, r15b
    adds r15w, r15w
    addu r15d, r15d
    addu r15, r15
    //hlt
end_code:

align 16
data:
    msg db "Hola mundo"
    msg1 dq 0x123456789abcdef
end_data:

// tabla de nombres de librerias a cargar
name_library_imports:
    kernel32 db "kernel32.dll", 0x0

// tabla de nombres de funciones a importar, el formato es el siguiente:
name_method_imports:
    GetTickCount db "GetTickCount", 0x0
msg33 db 1, 2, 3

align 16
msg44 dw 0x1234

align 16
