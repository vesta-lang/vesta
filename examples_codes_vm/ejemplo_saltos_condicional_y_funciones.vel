/*
 * Test de instrucciones de flujo de control - VestaVM
 *
 * Cubre: jmp, jmp.je, jmp.jne, callvm, enter, leave, ret, jrel.je
 *
 * Resultado esperado en HLT:
 *   r09 = 0x11   (jmp incondicional:  no se ejecutó el mov r09,0xDEAD)
 *   r10 = 0x22   (jmp.je ZF=1:        no se ejecutó el mov r10,0xDEAD)
 *   r11 = 0x33   (jmp.jne ZF=0:       no se ejecutó el mov r11,0xDEAD)
 *   r12 = 0x44   (jmp.jne ZF=1 ->no salta: mov r12,0x44 se ejecutó)
 *   r13 = 30     (callvm add_func(10,20) -> r00=30 -> r13=30)
 *   r14 = 0x66   (jrel.je ZF=1:       no se ejecutó el mov r14,0xDEAD)
 */

@Format("velb")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:

// ======= TEST 1: JMP incondicional ========
// jmp debe saltar sobre el mov r09,0xDEAD
    mov r09, 0x11
    jmp @Absolute("code.t1_ok")
    mov r09, 0xDEAD                     // NO debe ejecutarse
    hlt
t1_ok:

// ======= TEST 2: JMP.JE  (salta cuando ZF=1) ========
    mov r10, 0x22
    mov r01, 5
    mov r02, 5
    cmpu r01, r02                       // 5 == 5  -> ZF=1
    jmp.je @Absolute("code.t2_ok")
    mov r10, 0xDEAD                     // NO debe ejecutarse
    hlt
t2_ok:

// ======= TEST 3: JMP.JNE (salta cuando ZF=0) ========
    mov r11, 0x33
    mov r01, 10
    mov r02, 20
    cmpu r01, r02                       // 10 != 20 -> ZF=0
    jmp.jne @Absolute("code.t3_ok")
    mov r11, 0xDEAD                     // NO debe ejecutarse
    hlt
t3_ok:

// ======= TEST 4: JMP.JNE no tomado (ZF=1 -> jne NO debe saltar) ========
    mov r12, 0xBAAD                     // valor "malo" de partida
    mov r01, 7
    mov r02, 7
    cmpu r01, r02                       // 7 == 7 -> ZF=1
    jmp.jne @Absolute("code.t4_bad")    // NO debe saltar (ZF=1 -> jne no actúa)
    mov r12, 0x44                       // r12 = 0x44  ← se ejecuta porque jne NO saltó
    jmp @Absolute("code.t4_end")
t4_bad:
    mov r12, 0xBAD2         // si llegamos aquí, jmp.jne saltó cuando no debía
    hlt
t4_end:

// ======= TEST 5: CALLVM + ENTER + LEAVE + RET ========
// add_func(r01=10, r02=20) -> r00 = 30
    mov r15, 2              // 2 argumentos
    mov r01, 10
    mov r02, 20
    mov rbp, 0x500
    mov rsp, 0x500 // establezco la base y cima de la pila en 0x500, esta pagina de memoria
    // ya esta reservada, si uso rbp = rsp = 0, entonces la direccion se va a 0xfffffffffffffff8
    // lo que hara que la VM reserve una pagina de memoria si esa memoria no estuvo confirmada
    callvm @Absolute("code.add_func") // hay un bug al mov a r0
    mov r13, r00            // r13 = 30

    jmp @Absolute("code.after_funcs")         // saltar el cuerpo de las funciones
    // no deberia llegar aqui
    hlt
add_func:
    enter 0                 // frame sin variables locales
    addu r1, r2           // r01 = r01 + r02 = 30
    mov r00, r01            // valor de retorno en r00
    leave
    ret

after_funcs:

// ======= TEST 6: JREL.JE (salto relativo cuando ZF=1) ========
    mov r14, 0x66
    mov r01, 42
    mov r02, 42
    cmpu r01, r02                   // 42 == 42 -> ZF=1
    jrel.je @Relative("code.t6_ok") // salto relativo a t6_ok
    mov r14, 0xDEAD                 // NO debe ejecutarse
    hlt
t6_ok:

    hlt

end_code:
