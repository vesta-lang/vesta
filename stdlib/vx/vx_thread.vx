/**
 * @file vx_thread.vx
 * @brief Multihilo REAL del SO para  AOT (paralelismo verdadero).
 *
 * SEPARADO de vx_async: la ASINCRONIA (vx_async: spawn/future/await) es
 * cooperativa de UN SOLO hilo (event-loop / fibras); el MULTIHILO (este modulo)
 * son hilos 1:1 del SO con paralelismo real.  La exclusion mutua entre hilos la
 * da el monitor de vx_sync (`synchronized` / vx_lock/vx_unlock), cuyo owner
 * compuesto (tid, fiber-id) distingue hilos reales por su tid.
 *
 * @par Modelo
 * Un "hilo" es una fn nativa @c body(arg) que corre en paralelo sobre su propia
 * pila del SO.  El body recibe @p arg en el 1er registro del ABI (rcx Win64 /
 * rdi SysV) y debe RETORNAR.  El HANDLE de @ref vx_thread_spawn se pasa a
 * @ref vx_thread_join para esperar su fin.
 *
 * @par Multiplataforma
 * Windows: kernel32 (CreateThread / WaitForSingleObject / CloseHandle).
 * Linux/ELF: libpthread (pthread_create / pthread_join).
 */

import std.types only uintptr, usize;

// ---------------------------------------------------------------------------
// Windows: kernel32.
// ---------------------------------------------------------------------------
extern "kernel32.dll" {
    // Los parametros que la API espera como PUNTERO/HANDLE se declaran uintptr
    // (ancho de puntero, portable) en vez de u64: los valores uintptr de este
    // modulo encajan sin cast y no se asume 64 bits.
    fn CreateThread(uintptr attrs, usize stacksize, uintptr startaddr,
                    uintptr param, u32 flags, uintptr threadid) -> uintptr;
    fn WaitForSingleObject(uintptr handle, u32 ms) -> u32;
    fn CloseHandle(uintptr handle) -> i32;
}

// ---------------------------------------------------------------------------
// Linux: libpthread.  pthread_create escribe el pthread_t (unsigned long, 8B)
// en su 1er arg (out-ptr); lo devolvemos por valor como HANDLE.
// ---------------------------------------------------------------------------
extern "libpthread.so.0" {
    fn pthread_create(uintptr* thread_out, uintptr attr, uintptr start_routine,
                      uintptr arg) -> i32;
    fn pthread_join(uintptr thread, uintptr retval_out) -> i32;
}

/**
 * @brief Crea un HILO REAL del SO que ejecuta @p body(@p arg) en paralelo.
 * @param body Direccion nativa de la fn del hilo (recibe @p arg en rcx/rdi).
 * @param arg  Argumento (host_ptr al estado del hilo, o 0).
 * @return HANDLE del hilo (>0), o 0 si fallo.
 */
@Target("os:windows")
public uintptr vx_thread_spawn(uintptr body, uintptr arg) {
    return CreateThread(0, 0, body, arg, 0, 0);
}

@Target("!os:windows")
public uintptr vx_thread_spawn(uintptr body, uintptr arg) {
    // pthread_t es un `unsigned long` (8 bytes) -> CABE en el u64 del HANDLE, sin
    // heap.  pthread_create lo ESCRIBE en su 1er arg (out-ptr); pasamos la
    // direccion de un local y devolvemos su valor; pthread_join lo recibe por
    // valor.
    uintptr th = 0;
    i32 rc = pthread_create(&th, 0, body, arg);
    if (rc != 0) {
        return 0;
    }
    return th; // pthread_t (valor), no un puntero
}

/**
 * @brief Espera a que el hilo @p handle termine y libera sus recursos.
 * @param handle HANDLE devuelto por @ref vx_thread_spawn.
 */
@Target("os:windows")
public void vx_thread_join(uintptr handle) {
    WaitForSingleObject(handle, 0xFFFFFFFF); // INFINITE
    CloseHandle(handle);
}

@Target("!os:windows")
public void vx_thread_join(uintptr handle) {
    if (handle == 0) {
        return;
    }
    pthread_join(handle, 0); // handle = pthread_t (valor), sin heap
}

// ---------------------------------------------------------------------------
// Sugar `spawn { }` en AOT: hilo real registrado + join-all implicito al salir.
// El lowering de native_poo baja `spawn { body }` a CALL __vx_thread_run(body) e
// INYECTA CALL __vx_thread_join_all() antes del RET de main -> el programa espera
// a todos los hilos lanzados antes de terminar (sin join explicito del usuario).
// ---------------------------------------------------------------------------

comptime i64 VX_THREAD_MAX = 256;   ///< Hilos simultaneos por `spawn` (registro).
uintptr[256] __vx_thread_handles;       ///< HANDLEs de los hilos lanzados por spawn.
i64 __vx_thread_n = 0;              ///< Numero de hilos registrados.

/**
 * @brief Lanza un hilo real para un `spawn { body }` y registra su HANDLE.
 * @param body Direccion nativa de la fn del cuerpo del spawn.
 * @return HANDLE del hilo (>0), o 0 si fallo / tabla llena.
 * @note El HANDLE queda registrado para @ref __vx_thread_join_all (join-all
 *       implicito que el lowering inyecta al final de main).
 */
public uintptr __vx_thread_run(uintptr body, uintptr arg) {
    if (__vx_thread_n >= VX_THREAD_MAX) {
        return 0;
    }
    uintptr h = vx_thread_spawn(body, arg);
    if (h == 0) {
        return 0;
    }
    __vx_thread_handles[__vx_thread_n] = h;
    __vx_thread_n = __vx_thread_n + 1;
    return h;
}

/**
 * @brief Espera a que TODOS los hilos lanzados por `spawn` terminen.
 * @note Lo inyecta el lowering antes del RET de main; el usuario no lo llama.
 */
public void __vx_thread_join_all() {
    i64 i = 0;
    while (i < __vx_thread_n) {
        vx_thread_join(__vx_thread_handles[i]);
        i = i + 1;
    }
    __vx_thread_n = 0;
}
