/**
 * @file vx_chan.vx
 * @brief Canales (estilo CSP) sobre el scheduler M:N de fibras (vx_pool).  Una
 *        fibra que hace recv de un canal sin dato (o send de uno lleno) se
 *        BLOQUEA -- sale de la run-queue -- y la operacion opuesta la despierta
 *        EXACTAMENTE a ella, entregandole el valor DIRECTAMENTE.  SIN busy-wait,
 *        SIN libc mas alla de malloc, SIN GC.  Buffered (cap >= 1) y rendezvous
 *        (cap 0) con el MISMO codigo.
 *
 * @par Modelo (la FIBRA es el nodo de espera + entrega directa via su slot ELEM)
 * Cuando una fibra se bloquea, se enlaza A SI MISMA (Fiber*, por VXP_FIB_NEXT) en
 * la wait-queue del canal; el valor de la entrega directa vive en el slot ELEM de
 * la fibra (en su STRUCT, heap).  El otro lado, bajo el lock: saca la fibra,
 * ESCRIBE/LEE su ELEM (entrega directa, sin pasar por el ring) y la despierta.
 * El nodo va en el HEAP (struct), igual que el `sudog` de Go: la pila de una
 * fibra parkeada no es un sitio fiable para el nodo cuando otra fibra lo lee.
 *
 * @par Correccion del wakeup (hand-off del lock)
 * El lock del canal se mantiene desde el chequeo hasta DESPUES de que la fibra
 * hizo el context-switch (via `vx_park` con una accion diferida que suelta el
 * lock).  La fibra ya esta fuera de CPU y encolada cuando el otro lado toma el
 * lock -> nunca se pierde un wakeup.
 *
 * @par Rendimiento
 * UN spinlock por canal (como los canales de Go): protege ring + ambas
 * wait-queues; el `wake` va FUERA del lock.  Capacidad potencia de dos ->
 * indexado `& mask` (sin division).
 *
 * @par Uso
 * Entre FIBRAS (tareas del pool).  main coordina con vx_pool_join (no es fibra:
 * no puede bloquearse en un canal).
 */

import std.types only uintptr;
import "vx_atomic" only vx_spin_lock, vx_spin_unlock;
import "vx_pool" only vx_park, vx_wake, vx_cur_fiber, vx_wq_push, vx_wq_pop,
                     vx_fib_set_elem, vx_fib_get_elem;

// ---------------------------------------------------------------------------
// Vista tipada (overlay) de la cabecera del canal sobre el bloque host.  El
// ring buffer va inline a partir de CH_HDR (tamano dinamico = cap*8), fuera del
// overlay.  Acceder a un campo es `Chan(ch).campo`; su direccion, `&Chan(ch).x`.
// ---------------------------------------------------------------------------
@overlay struct Chan {
    i64 lock   @0x00;  // spinlock (0=libre, 1=tomado).
    i64 cap    @0x08;  // capacidad del ring (0=rendezvous; si >=1, pot. de 2).
    i64 mask   @0x10;  // cap - 1 (indexado del ring; 0 si cap 0).
    i64 head   @0x18;  // indice de lectura (monotono, enmascarado).
    i64 tail   @0x20;  // indice de escritura.
    i64 count  @0x28;  // items en el buffer.
    i64 rwq_h  @0x30;  // recv wait-queue: cabeza (Fiber*).
    i64 rwq_t  @0x38;  // recv wait-queue: cola.
    i64 swq_h  @0x40;  // send wait-queue: cabeza.
    i64 swq_t  @0x48;  // send wait-queue: cola.
    i64 closed @0x50;  // 1 si cerrado (reservado; close es futuro).
}
const i64 CH_HDR = 88;  // el ring empieza aqui: cap*8 bytes inline.

/// Accion diferida de park: el WORKER la ejecuta tras el switch -> suelta el
/// lock del canal cuando la fibra ya esta fuera de CPU (hand-off).
void __vxch_unlock_after_park(i64 lock_addr, i64 fib) {
    vx_spin_unlock((i64*)lock_addr);
}

/**
 * @brief Crea un canal de capacidad @p cap.  cap<=0 -> rendezvous (sin buffer).
 *        cap>=1 -> buffered, REDONDEADA a la siguiente potencia de dos (ring
 *        indexado con `& mask`, sin division).
 * @return puntero host al canal (0 si OOM).
 */
public uintptr vx_chan_new(i64 cap) {
    i64 c = 0;
    i64 mask = 0;
    if (cap >= 1) {
        c = 1;
        while (c < cap) {
            c = c * 2;
        }
        mask = c - 1;
    }
    i64 ptr = (i64)malloc(CH_HDR + c * 8);
    if (ptr == 0) {
        return (uintptr) 0;
    }
    Chan ch = Chan(ptr);
    ch.lock = 0;
    ch.cap = c;
    ch.mask = mask;
    ch.head = 0;
    ch.tail = 0;
    ch.count = 0;
    ch.rwq_h = 0;
    ch.rwq_t = 0;
    ch.swq_h = 0;
    ch.swq_t = 0;
    ch.closed = 0;
    return (uintptr) ptr;
}

/// Libera el canal (nadie debe estar bloqueado en el).
public void vx_chan_free(uintptr ch) {
    i64 ptr = (i64) ch;
    if (ptr != 0) {
        free((u8*)ptr);
    }
}

/// Direccion del slot i-esimo del ring (host).
i64 __vxch_slot(i64 ptr, i64 idx, i64 mask) {
    return ptr + CH_HDR + (idx & mask) * 8;
}

/**
 * @brief Envia @p v por el canal.  Prioridad: (1) receptor en espera -> entrega
 *        directa; (2) hueco en el buffer -> encolar; (3) bloquear en la sendq.
 */
public void vx_chan_send(uintptr ch_h, i64 v) {
    i64 ptr = (i64) ch_h;
    Chan ch = Chan(ptr);
    vx_spin_lock(&ch.lock);
    // Enviar por un canal CERRADO es un error del programa: descartamos el
    // valor y volvemos (no bloqueamos ni corrompemos el buffer).  El
    // productor debe dejar de enviar tras cerrar.
    if (ch.closed != 0) {
        vx_spin_unlock(&ch.lock);
        return;
    }
    // (1) Receptor en espera -> entrega directa en su slot ELEM (heap).
    i64 r = vx_wq_pop((i64)&ch.rwq_h, (i64)&ch.rwq_t);
    if (r != 0) {
        vx_fib_set_elem(r, v);
        vx_spin_unlock(&ch.lock);
        vx_wake(r);
        return;
    }
    // (2) Hueco en el buffer.
    if (ch.count < ch.cap) {
        i64* slot = (i64*)__vxch_slot(ptr, ch.tail, ch.mask);
        *slot = v;
        ch.tail = ch.tail + 1;
        ch.count = ch.count + 1;
        vx_spin_unlock(&ch.lock);
        return;
    }
    // (3) Lleno (o rendezvous sin receptor) -> guardo mi valor en MI slot ELEM,
    // me encolo (la fibra ES el nodo) y bloqueo.
    i64 self = vx_cur_fiber();
    vx_fib_set_elem(self, v);
    vx_wq_push((i64)&ch.swq_h, (i64)&ch.swq_t, self);
    vx_park((i64)(cfn(i64, i64) -> void) __vxch_unlock_after_park, (i64)&ch.lock);
    // Reanudada: un receptor tomo mi slot ELEM directamente.  Nada que leer.
}

/**
 * @brief Recibe un valor.  Prioridad: (1) dato en el buffer (moviendo un emisor
 *        en espera al hueco liberado); (2) emisor en espera (rendezvous) ->
 *        entrega directa; (3) bloquear en la recvq.
 * @return el valor recibido.
 */
public i64 vx_chan_recv(uintptr ch_h) {
    i64 ptr = (i64) ch_h;
    Chan ch = Chan(ptr);
    vx_spin_lock(&ch.lock);
    // (1) Dato en el buffer.
    if (ch.count > 0) {
        i64* rslot = (i64*)__vxch_slot(ptr, ch.head, ch.mask);
        i64 val = *rslot;
        ch.head = ch.head + 1;
        // Un emisor en espera? su valor (slot ELEM) va al hueco liberado; wake.
        i64 s = vx_wq_pop((i64)&ch.swq_h, (i64)&ch.swq_t);
        if (s != 0) {
            i64* wslot = (i64*)__vxch_slot(ptr, ch.tail, ch.mask);
            *wslot = vx_fib_get_elem(s);
            ch.tail = ch.tail + 1;
            // count: -1 (leimos) +1 (metimos) = igual.
            vx_spin_unlock(&ch.lock);
            vx_wake(s);
        } else {
            ch.count = ch.count - 1;
            vx_spin_unlock(&ch.lock);
        }
        return val;
    }
    // (2) Buffer vacio + emisor en espera (rendezvous cap 0) -> directa.
    i64 s = vx_wq_pop((i64)&ch.swq_h, (i64)&ch.swq_t);
    if (s != 0) {
        i64 val = vx_fib_get_elem(s);
        vx_spin_unlock(&ch.lock);
        vx_wake(s);
        return val;
    }
    // Canal CERRADO y drenado (buffer vacio, sin emisores): devolver 0 sin
    // bloquear (semantica CSP: recv de un canal cerrado no espera).  El
    // consumidor distingue "cerrado" via vx_chan_is_closed en su condicion
    // de bucle.
    if (ch.closed != 0) {
        vx_spin_unlock(&ch.lock);
        return 0;
    }
    // (3) Nada -> me encolo (la fibra ES el nodo) y bloqueo; el sender pondra
    // mi slot ELEM.  Uso el `self` capturado (no re-llamo cur_fiber tras el park).
    i64 self = vx_cur_fiber();
    vx_fib_set_elem(self, 0);
    vx_wq_push((i64)&ch.rwq_h, (i64)&ch.rwq_t, self);
    vx_park((i64)(cfn(i64, i64) -> void) __vxch_unlock_after_park, (i64)&ch.lock);
    return vx_fib_get_elem(self);
}

/**
 * @brief Cierra el canal.  Marca cerrado y DESPIERTA a todos los que esperan:
 *        los receptores en la recvq reciben 0 (canal drenado); los emisores
 *        bloqueados en la sendq se despiertan (su envio se pierde -- enviar tras
 *        close es un error).  Idempotente-seguro: cerrar dos veces solo re-marca.
 *        Tras close, recv de un canal vacio devuelve 0 al instante (no bloquea).
 */
public void vx_chan_close(uintptr ch_h) {
    i64 ptr = (i64) ch_h;
    Chan ch = Chan(ptr);
    vx_spin_lock(&ch.lock);
    ch.closed = 1;
    // Despertar a TODOS los receptores en espera -> reciben 0 (drenado).  El
    // wake solo encola en el scheduler (no re-toma el lock del canal) -> seguro
    // bajo el lock.
    i64 r = vx_wq_pop((i64)&ch.rwq_h, (i64)&ch.rwq_t);
    while (r != 0) {
        vx_fib_set_elem(r, 0);
        vx_wake(r);
        r = vx_wq_pop((i64)&ch.rwq_h, (i64)&ch.rwq_t);
    }
    // Despertar emisores bloqueados (su valor se descarta).
    i64 s = vx_wq_pop((i64)&ch.swq_h, (i64)&ch.swq_t);
    while (s != 0) {
        vx_wake(s);
        s = vx_wq_pop((i64)&ch.swq_h, (i64)&ch.swq_t);
    }
    vx_spin_unlock(&ch.lock);
}

/// @return 1 si el canal esta cerrado, 0 si no.
public i64 vx_chan_is_closed(uintptr ch_h) {
    i64 ptr = (i64) ch_h;
    Chan ch = Chan(ptr);
    return ch.closed;
}

/**
 * @brief Envio NO-BLOQUEANTE.  Igual que send pero sin el paso (3): si no hay
 *        receptor esperando NI hueco en el buffer, NO bloquea -> devuelve 0.
 *        Es el primitivo base para `select` (probar sin comprometerse).
 * @return 1 si el valor se entrego/encolo; 0 si enviaria bloquearia (o cerrado).
 */
public i64 vx_chan_try_send(uintptr ch_h, i64 v) {
    i64 ptr = (i64) ch_h;
    Chan ch = Chan(ptr);
    vx_spin_lock(&ch.lock);
    if (ch.closed != 0) {
        vx_spin_unlock(&ch.lock);
        return 0;
    }
    // (1) Receptor en espera -> entrega directa.
    i64 r = vx_wq_pop((i64)&ch.rwq_h, (i64)&ch.rwq_t);
    if (r != 0) {
        vx_fib_set_elem(r, v);
        vx_spin_unlock(&ch.lock);
        vx_wake(r);
        return 1;
    }
    // (2) Hueco en el buffer.
    if (ch.count < ch.cap) {
        i64* slot = (i64*)__vxch_slot(ptr, ch.tail, ch.mask);
        *slot = v;
        ch.tail = ch.tail + 1;
        ch.count = ch.count + 1;
        vx_spin_unlock(&ch.lock);
        return 1;
    }
    // Lleno / sin receptor -> NO bloquear.
    vx_spin_unlock(&ch.lock);
    return 0;
}

/**
 * @brief Recepcion NO-BLOQUEANTE.  Igual que recv pero sin el paso (3): si no
 *        hay dato en el buffer NI emisor esperando, NO bloquea -> devuelve 0 y
 *        no toca @p out.  Base de `select`.
 * @param out puntero donde escribir el valor recibido (solo si retorna 1).
 * @return 1 si se recibio un valor (escrito en @p out); 0 si no habia nada.
 */
public i64 vx_chan_try_recv(uintptr ch_h, i64* out) {
    i64 ptr = (i64) ch_h;
    Chan ch = Chan(ptr);
    vx_spin_lock(&ch.lock);
    // (1) Dato en el buffer (mover un emisor en espera al hueco liberado).
    if (ch.count > 0) {
        i64* rslot = (i64*)__vxch_slot(ptr, ch.head, ch.mask);
        i64 val = *rslot;
        ch.head = ch.head + 1;
        i64 s = vx_wq_pop((i64)&ch.swq_h, (i64)&ch.swq_t);
        if (s != 0) {
            i64* wslot = (i64*)__vxch_slot(ptr, ch.tail, ch.mask);
            *wslot = vx_fib_get_elem(s);
            ch.tail = ch.tail + 1;
            vx_spin_unlock(&ch.lock);
            vx_wake(s);
        } else {
            ch.count = ch.count - 1;
            vx_spin_unlock(&ch.lock);
        }
        *out = val;
        return 1;
    }
    // (2) Emisor en espera (rendezvous) -> entrega directa.
    i64 s = vx_wq_pop((i64)&ch.swq_h, (i64)&ch.swq_t);
    if (s != 0) {
        i64 val = vx_fib_get_elem(s);
        vx_spin_unlock(&ch.lock);
        vx_wake(s);
        *out = val;
        return 1;
    }
    // Nada disponible -> NO bloquear (el caller consulta is_closed si procede).
    vx_spin_unlock(&ch.lock);
    return 0;
}
