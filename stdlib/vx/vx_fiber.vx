/**
 * @file vx_fiber.vx
 * @brief Primitivo de context-switch para fibras nativas stackful (F1), en .
 *
 * Green threads estilo goroutine: cada fibra tiene su PROPIA pila nativa; un
 * `fiber_switch` guarda el contexto actual y carga el de otra fibra sin tocar
 * el SO (solo swap de registros + RSP).  Es el MECANISMO puro (zero-runtime):
 * la POLITICA (scheduler / monitores / GC) sera una libreria  por tier en
 * fases posteriores (F3+).  Aqui NO hay scheduler, NO hay GC: solo el switch.
 *
 * @par Modelo del contexto (int-only, minimo)
 * Un @c FiberCtx es UN SOLO qword: el RSP guardado de la fibra.  Los registros
 * callee-saved + la direccion de retorno viven EN la pila de la fibra (no en el
 * ctx), asi que el ctx ocupa 8 bytes.  Es la eleccion mas eficiente (estilo
 * boost.context): el `fiber_switch` es push callee-saved + swap RSP + pop.
 *
 * @par ABI por plataforma (x86-64)
 * - SysV (Linux/mac):  args en rdi(from), rsi(to);  callee-saved = rbp, rbx,
 *   r12, r13, r14, r15 (6 qwords).
 * - Win64 (Windows):   args en rcx(from), rdx(to);   callee-saved = rbx, rbp,
 *   rdi, rsi, r12, r13, r14, r15 (8 qwords).
 * Estas dos variantes se seleccionan con @c \@Target("os:windows") vs
 * @c \@Target("!os:windows").  En una arquitectura que no sea x86-64 el
 * inline-asm no compila (arch-guard de bug 198) -> error claro para quien lo
 * use, cero coste para quien no.
 *
 * @note v2 (diferido): Win64 tambien deberia salvar XMM6-15 (callee-saved SIMD)
 *       y actualizar la info de pila del TIB (StackBase/StackLimit) para SEH y
 *       stack-overflow.  Para el test AISLADO (sin SEH, sin FP vivo cruzando el
 *       yield) NO hacen falta -> se documentan como TODO.  Ver
 *       proj_fibras_nativas / plan_fibras_fases.
 *
 * @par Uso
 * @code
 *   // ctx + estado en memoria HOST (malloc): el switch corre NATIVO y necesita
 *   // direcciones host reales (en interp, &local seria un vaddr VM erroneo).
 *   u64 main_ctx = (u64)malloc(8);
 *   u64 fib_ctx  = (u64)malloc(8);
 *   u64 top = fiber_stack_alloc(65536);
 *   fiber_init(fib_ctx, top, (u64)(cfn(u64) -> void) fiber_entry, arg);
 *   fiber_switch(main_ctx, fib_ctx);  // arranca la fibra
 *   // ... la fibra hace fiber_switch(fib_ctx, main_ctx) para ceder ...
 *   fiber_stack_free(top, 65536);
 * @endcode
 *
 * @warning Frontera nativo/VM: fiber_switch y el cuerpo de la fibra corren
 *          SIEMPRE como codigo NATIVO.  Toda la memoria que tocan (celdas de
 *          contexto + estado compartido) DEBE vivir en memoria HOST (malloc /
 *          fiber_stack_alloc), NO en el stack VM (en interp, @c &local es una
 *          direccion VM que el codigo nativo malinterpretaria como host_ptr).
 *
 * @note El swap de RSP (@c mov @c rsp,[to]) se compila NATIVO tanto en AOT como
 *       en el JIT: el compilador ENTIENDE la reasignacion de pila y la respeta
 *       (no la trata como caja negra).  Al ser @c fiber_switch @c \@Naked (sin
 *       prologo/epilogo/spills que un rsp reasignado rompa), el usuario es dueno
 *       de la pila y el JIT emite el swap verbatim.  En una funcion NORMAL la
 *       reasignacion de rsp tambien se compila en el JIT, pero el compilador
 *       avisa (@c VXA010): su epilogue gestiona la pila, asi que un cambio
 *       persistente no sobrevive al retorno -> para eso esta @c \@Naked.  Por
 *       eso las corrutinas/fibras escritas en asm corren igual bajo el JIT y el
 *       AOT.
 *
 */

// ===========================================================================
//  fiber_switch: guarda el contexto actual en *from y carga el de *to.
// ===========================================================================
// @Naked: el cuerpo es asm nativo puro (sin prologo/epilogo del compilador); el
// swap de RSP lo maneja la propia rutina.  Los args llegan en los registros del
// ABI nativo (SysV: rdi/rsi; Win64: rcx/rdx), igual que cualquier @Naked.
//
// Diagrama del switch (SysV):
//   push callee-saved en la pila ACTUAL (la de la fibra saliente)
//   mov [from], rsp        ; *from = RSP de la fibra saliente (su ctx)
//   mov rsp, [to]          ; RSP = ctx de la fibra entrante
//   pop callee-saved de la pila NUEVA (la de la fibra entrante)
//   ret                    ; salta a la retaddr que hay en la pila entrante
//
// PRIMITIVO HOST_LEAF PURO (importante):  fiber_switch es un context-switch
// nativo puro -- IDENTICO en interp/JIT/AOT/Embed.  NO asume runtime (no hay
// ProcessVM*), NO depende de que el codegen inyecte nada, y salva TODOS los
// callee-saved (incluido rbx) en su propio bloque, de forma BALANCEADA (cada
// `push X` tiene su `pop X` alcanzable antes del `ret`), igual que r12-r15.
//
// El calificador `noinfer` es CLAVE:  sin el, el backend @Naked infiere que el
// asm "clobbera" rbx (porque lo escribe con `pop rbx`) y, como rbx es un
// registro que el backend VM_ABI reserva, envuelve el bloque con un `push
// rbx`/`pop rbx` extra -- pero el `pop` queda DESPUES del `ret` del asm
// (muerto) -> pila desbalanceada -> el `ret` de un switch leeria basura.  Con
// `noinfer` el backend NO infiere clobbers ni envuelve nada: emite el asm
// VERBATIM.  Nosotros ya salvamos/restauramos rbx nosotros mismos, asi que el
// resultado es un primitivo correcto y simetrico en TODOS los modos, sin
// suponer nada del entorno de ejecucion.

/**
 * @brief Cambia de contexto: salva el actual en @p from_ctx, carga @p to_ctx.
 * @param from_ctx Puntero (u64) a un @c FiberCtx (1 qword) donde guardar el RSP
 *                 actual.  Puede ser el de un "main"/scheduler que aun no tiene
 *                 pila propia (se rellena aqui la primera vez).
 * @param to_ctx   Puntero (u64) al @c FiberCtx de la fibra a la que saltar.
 * @note Al retornar (cuando ALGUIEN vuelva a hacer switch hacia @p from_ctx),
 *       la ejecucion continua justo despues de esta llamada, con los
 *       callee-saved restaurados.
 */
@Target("!os:windows")
@Naked public void fiber_switch(u64 from_ctx, u64 to_ctx) {
    asm volatile noinfer {
        push rbp
        push rbx
        push r12
        push r13
        push r14
        push r15
        mov [rdi], rsp
        mov rsp, [rsi]
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbx
        pop rbp
        ret
    }
}

/**
 * @brief Cambia de contexto (variante Win64).
 * @copydetails fiber_switch
 * @note Win64: args en rcx/rdx; callee-saved incluye rdi/rsi ademas de
 *       rbx/rbp/r12-15 (8 qwords).  XMM6-15 y el TIB se difieren a v2.
 */
@Target("os:windows")
@Naked public void fiber_switch(u64 from_ctx, u64 to_ctx) {
    asm volatile noinfer {
        push rbp
        push rbx
        push rdi
        push rsi
        push r12
        push r13
        push r14
        push r15
        mov [rcx], rsp
        mov rsp, [rdx]
        pop r15
        pop r14
        pop r13
        pop r12
        pop rsi
        pop rdi
        pop rbx
        pop rbp
        ret
    }
}

// ===========================================================================
//  __vx_swapctx: materializacion NATIVA del primitivo abstracto de
//  fiber-switch (builtin `fiber_swapctx`) en el path AOT (FN.2).
// ===========================================================================
// A diferencia de `fiber_switch` (arriba), cuyo contexto es UN qword (RSP) y
// exige `fiber_init` para preparar la pila, este switch usa el MISMO layout de
// contexto que el opcode VM `swapctx` del interprete (FN.1), de modo que el
// MISMO cuerpo  (test 235) inicializa el ctx igual en -m vm y -m aot:
//
//   ctx = i64[19] (152 bytes).  Sub-layout que usa el nativo (offsets en bytes):
//     [ 0] PC   (direccion de reanudacion; en el arranque = fiber_entry(body))
//     [ 8] SP   (RSP de la fibra; en el arranque = cima de su pila)
//     [16] BP   (RBP)
//     [24] rbx
//     [32] r12
//     [40] r13
//     [48] r14
//     [56] r15
//     [64] rdi  (solo Win64)
//     [72] rsi  (solo Win64)
//   El resto de slots ([80..] / R0..R15 del layout VM) no lo usa el nativo.
//
// Semantica (identica a fiber_swapctx(from,to) del builtin): GUARDA el contexto
// actual en `from_ctx` y CARGA `to_ctx`.  El frontend emite
// `CALL __vx_swapctx(to_ctx, from_ctx)` -> arg0 = to (cargar), arg1 = from
// (guardar).  Como es una CALL nativa, basta preservar los callee-saved (los
// caller-saved ya los salva el llamante por ABI): guardamos rbp, rbx, r12-r15
// (SysV) o + rdi, rsi (Win64).  PC guardado = retaddr de la CALL; SP guardado =
// RSP del llamante tras el ret.  Al reanudar, la ejecucion continua justo tras
// la llamada, con los callee-saved restaurados.
//
// PRIMER ARRANQUE (ctx = {PC=body, SP=top, BP=top, callee-saved=0}): carga
// rsp=top, rbp=top, callee-saved=0 y `jmp body`; el prologo NATIVO del cuerpo
// (push rbp; mov rbp,rsp; sub rsp,N) monta su marco sobre la pila de la fibra.
//
// `noinfer`: mismo motivo que fiber_switch -- el bloque es asm verbatim; no
// inferir clobbers ni envolver (nosotros salvamos/restauramos todo a mano de
// forma balanceada), para que el switch sea simetrico y correcto.

/**
 * @brief Context-switch nativo del primitivo abstracto de fibras (SysV).
 * @param to_ctx   (rdi) contexto a CARGAR (salta a el).
 * @param from_ctx (rsi) contexto donde GUARDAR el estado actual.
 */
@Target("!os:windows")
@Naked public void __vx_swapctx(u64 to_ctx, u64 from_ctx) {
    asm volatile noinfer {
        mov rax, [rsp]
        mov [rsi], rax
        lea rax, [rsp + 8]
        mov [rsi + 8], rax
        mov [rsi + 16], rbp
        mov [rsi + 24], rbx
        mov [rsi + 32], r12
        mov [rsi + 40], r13
        mov [rsi + 48], r14
        mov [rsi + 56], r15
        mov rax, [rdi]
        mov rbp, [rdi + 16]
        mov rbx, [rdi + 24]
        mov r12, [rdi + 32]
        mov r13, [rdi + 40]
        mov r14, [rdi + 48]
        mov r15, [rdi + 56]
        mov rsp, [rdi + 8]
        jmp rax
    }
}

/**
 * @brief Context-switch nativo del primitivo abstracto de fibras (Win64).
 * @copydetails __vx_swapctx
 * @note Win64: args en rcx(to)/rdx(from); callee-saved incluye rdi/rsi.
 */
@Target("os:windows")
@Naked public void __vx_swapctx(u64 to_ctx, u64 from_ctx) {
    asm volatile noinfer {
        mov rax, [rsp]
        mov [rdx], rax
        lea rax, [rsp + 8]
        mov [rdx + 8], rax
        mov [rdx + 16], rbp
        mov [rdx + 24], rbx
        mov [rdx + 32], r12
        mov [rdx + 40], r13
        mov [rdx + 48], r14
        mov [rdx + 56], r15
        mov [rdx + 64], rdi
        mov [rdx + 72], rsi
        mov rax, [rcx]
        mov rbp, [rcx + 16]
        mov rbx, [rcx + 24]
        mov r12, [rcx + 32]
        mov r13, [rcx + 40]
        mov r14, [rcx + 48]
        mov r15, [rcx + 56]
        mov rdi, [rcx + 64]
        mov rsi, [rcx + 72]
        mov rsp, [rcx + 8]
        jmp rax
    }
}

// ===========================================================================
//  Trampolines: primer punto de ejecucion de una fibra recien creada.
// ===========================================================================
// fiber_init prepara la pila para que el PRIMER fiber_switch hacia la fibra
// termine con un `ret` que aterrice aqui.  El trampolin coloca el `arg`
// (guardado en rbx) como primer argumento del ABI y salta a `entry`
// (guardado en r12).  Se usa `jmp` (no `call`): entry NO retorna al trampolin;
// si retornara, cae en __fiber_exit (trampa).

/**
 * @brief Trampolin de arranque de fibra (SysV): entry(arg).
 * @note rbx = arg, r12 = entry (los coloco fiber_init en la pila).  rdi es el
 *       1er argumento del ABI SysV.
 */
@Target("!os:windows")
@Naked void __fiber_trampoline() {
    asm volatile noinfer {
        mov rdi, rbx
        jmp r12
    }
}

/**
 * @brief Trampolin de arranque de fibra (Win64): entry(arg).
 * @note rbx = arg, r12 = entry.  rcx es el 1er argumento del ABI Win64.  Se
 *       reserva el shadow space (32 bytes) que exige Win64 antes de entrar a
 *       @c entry, y se mantiene la pila 16-alineada.
 */
@Target("os:windows")
@Naked void __fiber_trampoline() {
    asm volatile noinfer {
        mov rcx, rbx
        sub rsp, 32
        jmp r12
    }
}

/**
 * @brief Trampa de retorno de fibra: una fibra cuyo @c entry retorna cae aqui.
 *
 * En el modelo F1 (test aislado) las fibras NUNCA retornan (ceden con
 * fiber_switch y terminan cediendo al main, que las libera).  Si aun asi una
 * @c entry retornara, este bloqueo detiene el proceso de forma controlada en
 * vez de ejecutar basura de la pila.
 */
@Target("!os:windows")
@Naked void __fiber_exit() {
    asm volatile noinfer {
    __fiber_exit_loop:
        hlt
        jmp __fiber_exit_loop
    }
}
@Target("os:windows")
@Naked void __fiber_exit() {
    asm volatile noinfer {
    __fiber_exit_loop:
        hlt
        jmp __fiber_exit_loop
    }
}

// ===========================================================================
//  fiber_init: prepara la pila de una fibra nueva.
// ===========================================================================

/// Numero de qwords de callee-saved que fiber_switch salva/restaura.
/// SysV = 6 (rbp,rbx,r12,r13,r14,r15); Win64 = 8 (+rdi,rsi).
@Target("!os:windows")
comptime u64 FIBER_SAVED_QWORDS = 6;
@Target("os:windows")
comptime u64 FIBER_SAVED_QWORDS = 8;

/**
 * @brief Prepara @p ctx para que el 1er @ref fiber_switch hacia el arranque
 *        ejecute @c entry(@p arg).
 *
 * Escribe en la CIMA de la pila (de arriba hacia abajo) el marco que
 * @ref fiber_switch espera al restaurar: la retaddr = @ref __fiber_trampoline,
 * los callee-saved (uno guarda @p arg en rbx, otro @p entry en r12), y una
 * retaddr de reserva = @ref __fiber_exit por si @p entry retornara.
 *
 * @par Layout de la pila tras fiber_init (SysV, direcciones crecientes)
 * @verbatim
 *   ctx = stack_top - 8*(SAVED+2)              (RSP inicial de la fibra)
 *   +---------------------------------------+
 *   | [ctx+ 0] r15  = 0                      |  <- pop r15  (primero)
 *   | [ctx+ 8] r14  = 0                      |  <- pop r14
 *   | [ctx+16] r13  = 0                      |  <- pop r13
 *   | [ctx+24] r12  = entry                  |  <- pop r12   (== entry_fn)
 *   | [ctx+32] rbx  = arg                     |  <- pop rbx   (== arg)
 *   | [ctx+40] rbp  = 0                       |  <- pop rbp
 *   | [ctx+48] retaddr = __fiber_trampoline   |  <- ret salta aqui
 *   | [ctx+56] retaddr = __fiber_exit         |  (por si entry retorna)
 *   +---------------------------------------+  = stack_top
 * @endverbatim
 * El orden de pop coincide con @ref fiber_switch (SysV): r15,r14,r13,r12,rbx,
 * rbp.  Tras `ret`, RSP = ctx+48 y el trampolin hace `jmp entry` con rbx/r12
 * ya cargados.  RSP en ese punto es 16-alineado-menos-8 (como espera un
 * `call`), garantizado por alinear @p stack_top a 16.
 *
 * @param ctx        Puntero (u64) al @c FiberCtx (1 qword) a inicializar.
 * @param stack_top  Cima de la pila de la fibra (direccion mas alta; la pila
 *                   crece hacia abajo).  DEBE estar 16-alineada.
 * @param entry      Direccion nativa de la funcion de entrada (recibe 1 arg).
 * @param arg        Argumento que se pasa a @p entry.
 */
@Target("!os:windows")
public void fiber_init(u64 ctx, u64 stack_top, u64 entry, u64 arg) {
    // Alinear la cima a 16 (por si el llamante no lo hizo).
    u64 top = stack_top & ~((u64)15);
    // Marco: SAVED callee-saved + retaddr(trampolin) + retaddr(exit) = SAVED+2.
    u64 nslots = FIBER_SAVED_QWORDS + 2;
    u64 base = top - nslots * 8;   // RSP inicial de la fibra (ctx guardara esto)
    u64* s = (u64*)base;
    // Callee-saved en orden de POP (r15 primero ... rbp ultimo, ver el asm).
    s[0] = 0;       // r15
    s[1] = 0;       // r14
    s[2] = 0;       // r13
    s[3] = entry;   // r12 = entry  (el trampolin hace jmp r12)
    s[4] = arg;     // rbx = arg    (el trampolin mueve rbx -> rdi)
    s[5] = 0;       // rbp
    // retaddr que consume el `ret` de fiber_switch: el trampolin de arranque.
    s[6] = (u64)(cfn() -> void) __fiber_trampoline;
    // retaddr de reserva por si entry retorna (no deberia).
    s[7] = (u64)(cfn() -> void) __fiber_exit;
    // Guardar el RSP inicial en el ctx.
    u64* c = (u64*)ctx;
    c[0] = base;
}

/**
 * @brief Prepara @p ctx (variante Win64: 8 callee-saved).
 * @copydetails fiber_init
 * @note Orden de pop en Win64 (ver el asm): r15,r14,r13,r12,rsi,rdi,rbx,rbp.
 *       entry -> r12, arg -> rbx (el trampolin mueve rbx -> rcx).
 */
@Target("os:windows")
public void fiber_init(u64 ctx, u64 stack_top, u64 entry, u64 arg) {
    u64 top = stack_top & ~((u64)15);
    u64 nslots = FIBER_SAVED_QWORDS + 2; // 8 + 2 = 10
    u64 base = top - nslots * 8;
    u64* s = (u64*)base;
    // Orden de POP en Win64: r15,r14,r13,r12,rsi,rdi,rbx,rbp.
    s[0] = 0;       // r15
    s[1] = 0;       // r14
    s[2] = 0;       // r13
    s[3] = entry;   // r12 = entry
    s[4] = 0;       // rsi
    s[5] = 0;       // rdi
    s[6] = arg;     // rbx = arg  (trampolin: rbx -> rcx)
    s[7] = 0;       // rbp
    s[8] = (u64)(cfn() -> void) __fiber_trampoline; // retaddr del `ret`
    s[9] = (u64)(cfn() -> void) __fiber_exit;        // retaddr de reserva
    u64* c = (u64*)ctx;
    c[0] = base;
}

// ===========================================================================
//  Pilas de fibra (memoria host via malloc: RawAllocator en interp/JIT, slab de
//  vx_mem en AOT).
// ===========================================================================

/// Tamano por defecto de la pila de una fibra en v1 (fija, sin guard page).
comptime u64 FIBER_STACK_DEFAULT = 65536; // 64 KiB

/**
 * @brief Reserva una pila de fibra en memoria HOST y devuelve su CIMA.
 *
 * Usa el allocator HOST del lenguaje (`malloc`), que devuelve memoria host
 * valida en LOS TRES modos (interp/JIT via el RawAllocator del runtime; AOT via
 * el slab de @c vx_mem).  Es la eleccion correcta para fibras: la pila la
 * manipula codigo NATIVO (fiber_switch), que necesita direcciones host reales
 * -- una arena VM no serviria en interp.  La pila crece hacia abajo, asi que se
 * devuelve la direccion mas alta (base + size).
 *
 * @param size Bytes de pila.  0 -> 64 KiB.
 * @return Cima de la pila (usar como @c stack_top de @ref fiber_init), o 0 si
 *         la reserva fallo.
 * @note @ref fiber_init alinea la cima a 16 hacia abajo antes de usarla; el
 *       tamano recomendado es multiplo de pagina y >= 16 KiB.
 */
public u64 fiber_stack_alloc(u64 size) {
    u64 sz = size;
    if (sz == 0) sz = FIBER_STACK_DEFAULT;
    u64 base = (u64)malloc(sz);
    if (base == 0) return 0;
    // La cima es base+sz.  fiber_stack_free recupera la base exacta con top-sz.
    u64 top = base + sz;
    return top;
}

/**
 * @brief Libera una pila reservada con @ref fiber_stack_alloc.
 * @param top  Cima devuelta por @ref fiber_stack_alloc (== base + size).
 * @param size Tamano usado en la reserva (mismo que se paso a alloc; 0 -> 64K).
 * @note La base se recupera exacta como @c top - @c size (malloc/free
 *       simetricos): @ref fiber_stack_alloc devuelve @c base+size.
 */
public void fiber_stack_free(u64 top, u64 size) {
    u64 sz = size;
    if (sz == 0) sz = FIBER_STACK_DEFAULT;
    u64 base = top - sz;
    free((i64*)base);
}
