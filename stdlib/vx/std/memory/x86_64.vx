        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm v0,
    ) {
        movq v0, p
        punpcklqdq v0, v0
        inject(gen_relleno_grande("movdqu", "movdqu", 16, 8, ""))
    }
}

/**
 * @brief Relleno grande con registros de 256 bits (AVX2): 256 bytes por vuelta.
