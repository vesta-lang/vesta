 * @brief Relleno grande con registros de 128 bits (SSE2): 128 bytes por vuelta.
 *
 * Espejo de @ref memcpy_medium_sse2 sin sus lecturas.
 *
 * PRECONDICION: @p n al menos 128.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 128 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_medium_sse2(u8* dst, u8 val, usize n) {
