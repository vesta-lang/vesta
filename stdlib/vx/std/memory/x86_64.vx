namespace std.memory.x86_64;

/**
 * @file x86_64.vx
 * @brief Copias anchas para x86-64.
 *
 * La mitad de x86-64 de `std.memory`: el fichero de arriba tiene lo portable y
 * este aporta lo que solo existe aqui.  `std.memory` re-exporta el de la
 * arquitectura que toque, asi que quien escribe `import std.memory` recibe lo
 * suyo sin mencionarlo -- mismo reparto que en `std.syscall`.
 *
 * Cada version es LINEAL: sin preguntar por el procesador y sin ramas.  Quien
 * elige entre ellas es `memcpy`, que ya reparte por tamano y aprovecha para
 * repartir tambien por juego de instrucciones.  Asi cada una se puede medir
 * por separado, el compilador puede inlinearlas, y el cuerpo queda diminuto.
 *
 * Las tres hacen EXACTAMENTE lo mismo y solo cambia el ancho del registro y el
 * nombre de la instruccion:
 *
 *     SSE2     16 B   movdqu
 *     AVX2     32 B   vmovdqu
 *     AVX-512  64 B   vmovdqu64
 *
 * Que se parezcan tanto es buena senal: el algoritmo es uno solo.
 *
 * Estas funciones usan `asm`, que el INTERPRETE ignora en silencio.  No hace
 * falta condicionarlas por motor: solo se llaman desde la variante de `memcpy`
 * que ya eligio motor, y bajo el interprete esa variante ni las menciona.
 */

import std.types only usize;
import std.comptime only inject;

/// Bits del bitmask que devuelve `cpu_features()`.  Los consulta `memcpy` una
/// vez por copia; la rama la predice el procesador sin fallar, porque en una
/// misma maquina siempre sale la misma.
public const u64 BIT_AVX2 = 1 << 4;
/// @copydoc BIT_AVX2
public const u64 BIT_AVX512F = 1 << 7;
/// @copydoc BIT_AVX2
///
/// ERMS: el procesador declara que su `rep movsb` va por lineas de cache.  Sin
/// este bit, `rep movsb` sigue estando -- es de siempre -- pero es lento en los
/// tamanos que no son enormes, asi que la diferencia importa.
public const u64 BIT_ERMS = 1 << 8;

/* --- Presupuesto de registros anchos, por ABI ---------------------------
 *
 * Cuantos registros del banco ancho puede gastar una copia SIN pagar por
 * ellos.  No es una preferencia: lo marca el ABI.
 *
 *   System V (Linux, BSD, macOS)  todos son de usar y tirar -> se gastan.
 *   Windows                       xmm6..xmm15 hay que devolverlos como
 *                                 estaban, asi que cada uno por encima de
 *                                 seis cuesta un guardado y una restauracion
 *                                 en el prologo.  Eso solo se amortiza en
 *                                 copias grandes, de ahi que el presupuesto
 *                                 suba poco y solo en el tramo mayor.
 *
 * Poner un numero intermedio para los dos seria lo peor de ambos: gastaria en
 * Windows lo que desaprovecha en Linux.  Por eso el presupuesto es del
 * OBJETIVO y no del gusto de quien escribe. */
@Target("!os:windows")
public enum Budget : i64 {
    small = 8,
    medium = 10,
    big = 14,
}

/// @copydoc Budget
@Target("os:windows")
public enum Budget : i64 {
    small = 6,
    medium = 6,
    big = 8,
}

/// Lo que el procesador ha dicho que sabe hacer, o 0 si aun no se le ha
/// preguntado.  Ese 0 no significa "no sabe nada": significa "sin averiguar".
u64 __rasgos = 0;
/// Si ya se le pregunto.  Va aparte del valor porque un procesador podria
/// contestar 0 legitimamente, y entonces el valor no distinguiria los dos
/// casos.
bool __rasgos_sabidos = false;

/**
 * @brief Averigua que sabe hacer el procesador, una sola vez.
 *
 * Nada de dar por sentado el juego de instrucciones: se le pregunta y se
 * guarda la respuesta.  Preguntar es caro -- CPUID serializa la ejecucion --
 * asi que las copias no lo hacen cada vez, llaman aqui.
 *
 * Es idempotente y no hace falta llamarla antes de nada: la primera copia que
 * necesite saberlo la llama por su cuenta.
 *
 * @return El bitmask con los BIT_* de arriba.
 */
public u64 init_cpuid() {
    if (!__rasgos_sabidos) {
        __rasgos = cpu_features();
        __rasgos_sabidos = true;
    }
    return __rasgos;
}

/**
 * @brief Genera el cuerpo de una copia SOLAPADA de @p bytes + @p bytes.
 *
 * El algoritmo es: @p bytes desde el principio y otros tantos que terminan en
 * el final, solapandose por el medio.  Que con 64 sirva para el tramo 65..128
 * es una consecuencia del tamano elegido, no la definicion -- por eso el
 * tamano es un parametro y no un numero incrustado.
 *
 * Asi el mismo generador vale para los tramos que vengan:
 *
 *     gen_solapada("movdqu",  16,  64)   4 + 4 accesos   (small, SSE2)
 *     gen_solapada("vmovdqu", 32, 128)   4 + 4 accesos   (un tramo mayor)
 *     gen_solapada("vmovdqu64", 64, 256) 4 + 4 accesos
 *
 * Las seis versiones de este fichero son ese mismo algoritmo, cargando y
 * guardando de uno en uno.  Lo unico que cambia entre ellas es el ancho del
 * registro y el nombre de la instruccion.
 *
 * Escribir eso seis veces a mano es pedir una errata.  El generador emite
 * EXACTAMENTE las mismas instrucciones que se escribirian; no genera mas ni
 * menos, solo evita repetirlas.
 *
 * @param mn Mnemonico (movdqu / vmovdqu / vmovdqu64 y sus formas alineadas).
 * @param ancho Bytes por acceso: 16, 32 o 64.
 * @param bytes Bytes que cubre cada mitad.  Multiplo de @p ancho.
 * @return El cuerpo del bloque asm, listo para empalmar.
 */
comptime string gen_solapada(string mn, i64 ancho, i64 bytes, i64 regs) {
    // Un tramo desde el principio y otro que termina en el final; se solapan
    // por el medio, que es lo que ahorra la cola.  Cada tramo reparte sus
    // accesos como cualquier otro bloque: cargas primero, y en tandas si no
    // caben en el presupuesto.
    return gen_bloque(mn, mn, ancho, bytes, "d", "s", regs) +
           gen_bloque(mn, mn, ancho, bytes, "fd", "fs", regs);
}

/**
 * @brief Copia entre 65 y 128 bytes con registros de 128 bits (SSE2).
 *
 * El rango se cubre con dos mitades que se SOLAPAN por el medio, sin bucle y
 * sin cola.  Los bytes del solape se escriben dos veces con el mismo valor, lo
 * que no cuesta nada y ahorra la cola -- que en una copia corta es lo caro:
 * una prediccion de salto fallada vale mas que la copia entera.
 *
 * El cuerpo lo genera @ref gen_solapada con este patron, cuatro bloques de
 * 16 bytes por mitad:
 *
 *     movdqu v, [s + 0x00]      ; primera mitad, desde el principio
 *     movdqu [d + 0x00], v
 *     ...                       ; +0x10, +0x20, +0x30
 *     movdqu v, [fs + 0x00]     ; segunda mitad, termina en el final
 *     movdqu [fd + 0x00], v
 *     ...                       ; +0x10, +0x20, +0x30
 *
 * Se carga y se guarda de uno en uno en vez de tener varios registros vivos a
 * la vez: menos presion para el asignador y menos dependencias.
 *
 * Los registros los elige el COMPILADOR (`reg` y `xmm`, sin numero): escribir
 * el fisico le quitaria al asignador la posibilidad de usar los libres.
 *
 * SSE2 es BASE en x86-64, asi que esta version vale siempre.
 *
 * Los rangos NO pueden solaparse.  PRECONDICION: @p n entre 65 y 128; no se
 * comprueba -- quien enruta por tamano es `memcpy`, y repetirlo aqui anadiria
 * ramas que el llamante ya resolvio.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_small_sse2(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 64;
    u8* fin_s = src + n - 64;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        xmm v0,
        xmm v1,
        xmm v2,
        xmm v3,
    ) {
        inject(gen_solapada("movdqu", 16, 64, 4))
    }
}

/**
 * @brief Lo mismo con registros de 256 bits (AVX2).
 *
 * Mismo patron generado que @ref memcpy_small_sse2, con la mitad de accesos
 * porque cada uno mueve el doble: DOS bloques de 32 bytes por mitad.
 *
 *     vmovdqu v, [s + 0x00]     ; y +0x20
 *     vmovdqu [d + 0x00], v
 *     vmovdqu v, [fs + 0x00]    ; y +0x20
 *     vmovdqu [fd + 0x00], v
 *
 * PRECONDICION: @p n entre 65 y 128, y el procesador con AVX2.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_small_avx2(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 64;
    u8* fin_s = src + n - 64;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        ymm v0,
        ymm v1,
    ) {
        inject(gen_solapada("vmovdqu", 32, 64, 2))
    }
}

/**
 * @brief Lo mismo con registros de 512 bits (AVX-512).
 *
 * Mismo patron generado, reducido al minimo: UN bloque de 64 bytes por mitad,
 * porque con ese ancho cada acceso cubre media copia.
 *
 *     vmovdqu64 v, [s + 0x00]
 *     vmovdqu64 [d + 0x00], v
 *     vmovdqu64 v, [fs + 0x00]
 *     vmovdqu64 [fd + 0x00], v
 *
 * PRECONDICION: @p n entre 65 y 128, y el procesador con AVX-512F.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_small_avx512(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 64;
    u8* fin_s = src + n - 64;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        zmm v0,
    ) {
        inject(gen_solapada("vmovdqu64", 64, 64, 1))
    }
}

/**
 * @brief Igual que @ref memcpy_small_sse2 pero con accesos ALINEADOS.
 *
 * Se genera el MISMO patron y las mismas instrucciones; solo cambia la forma
 * del acceso (`movdqa` en vez de `movdqu`).
 *
 * Funciona sin cola y sin bucle porque la precondicion incluye el TAMANO.  Lo
 * que de verdad hace falta es que la segunda mitad empiece alineada, o sea:
 *
 *     (n - 64) % ancho == 0
 *
 * y eso equivale a pedir `n % ancho == 0` UNICAMENTE porque 64 es multiplo de
 * los tres anchos que se usan aqui (16, 32 y 64).  Con un ancho que no
 * dividiera a 64 las dos condiciones dejarian de ser la misma, asi que la
 * regla buena es la de arriba.
 *
 * Esa es la razon de exigir el bloque entero alineado y no solo los punteros:
 * con solo los punteros, la segunda mitad caeria sin alinear y la mitad de los
 * accesos perderian justo lo que se venia a ganar.
 *
 * PRECONDICION: @p dst, @p src y @p n, los tres multiplos de 16.  No se
 * comprueba en ejecucion: costaria las ramas que esta version viene a ahorrar,
 * y un valor mal alineado da EXCEPCION del procesador -- se ve en el acto, no
 * es un fallo silencioso.
 *
 * @param dst Destino, multiplo de 16.
 * @param src Origen, multiplo de 16.
 * @param n Numero de bytes, multiplo de 16, entre 80 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_small_sse2_aligned(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 64;
    u8* fin_s = src + n - 64;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        xmm v0,
        xmm v1,
        xmm v2,
        xmm v3,
    ) {
        inject(gen_solapada("movdqa", 16, 64, 4))
    }
}

/**
 * @brief Igual que @ref memcpy_small_avx2 con accesos alineados a 32.
 *
 * Mismo patron generado que su version no alineada, con `vmovdqa`.
 * @copydetails memcpy_small_sse2_aligned
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_small_avx2_aligned(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 64;
    u8* fin_s = src + n - 64;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        ymm v0,
        ymm v1,
    ) {
        inject(gen_solapada("vmovdqa", 32, 64, 2))
    }
}

/**
 * @brief Igual que @ref memcpy_small_avx512 con accesos alineados a 64.
 *
 * Mismo patron generado que su version no alineada, con `vmovdqa64`.
 * @copydetails memcpy_small_sse2_aligned
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_small_avx512_aligned(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 64;
    u8* fin_s = src + n - 64;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        zmm v0,
    ) {
        inject(gen_solapada("vmovdqa64", 64, 64, 1))
    }
}

/**
 * @brief Genera el cuerpo de una copia RECTA de @p bytes de @p s a @p d.
 *
 * Es el bloque que repite el bucle de las copias grandes.  Emite, para
 * `bytes / ancho` accesos:
 *
 *     <mn> v0, [s + 0]           ; TODAS las cargas primero
 *     <mn> v1, [s + ancho]
 *     ...
 *     <mn> vN, [s + N*ancho]
 *     <mn> [d + 0], v0           ; y DESPUES todas las escrituras
 *     <mn> [d + ancho], v1
 *     ...
 *     <mn> [d + N*ancho], vN
 *
 * Mismo criterio que @ref gen_solapada -- emite exactamente las instrucciones
 * que se escribirian, solo evita repetirlas -- pero sin la segunda mitad,
 * porque aqui el que avanza es el puntero y no el desplazamiento.
 *
 * @param mn Mnemonico.
 * @param ancho Bytes por acceso: 16, 32 o 64.
 * @param bytes Bytes del bloque.  Multiplo de @p ancho.
 * @param d Nombre del operando con la direccion de destino.
 * @param s Nombre del operando con la direccion de origen.
 * @return El cuerpo del bloque asm, listo para empalmar.
 */
comptime string gen_bloque(string mnl, string mne, i64 ancho, i64 bytes,
                           string d, string s, i64 regs) {
    static_assert(ancho == 16 || ancho == 32 || ancho == 64,
                  "el ancho tiene que ser el de un registro real: 16, 32 o 64");
    static_assert(bytes % ancho == 0,
                  "el bloque tiene que ser multiplo del ancho del registro");
    static_assert(regs >= 1 && regs <= 16,
                  "el presupuesto de registros del banco ancho va de 1 a 16");
    i64 accesos = bytes / ancho;
    string out = "";
    // TODAS las cargas primero y TODAS las escrituras despues, cada acceso en
    // su propio registro.  Alternar carga y escritura sobre un mismo registro
    // encadenaria cada acceso con el anterior por una dependencia que el
    // algoritmo no tiene: la copia no necesita haber escrito el bloque 0 para
    // leer el 1.  Separadas, el procesador puede tener varias lecturas en
    // vuelo a la vez y las escrituras llegan cuando llegan.
    //
    // Si el bloque pide mas accesos que registros hay de presupuesto, se parte
    // en tandas que quepan.  Dentro de cada tanda se mantiene el reparto
    // cargas-primero; entre tandas se vuelve a empezar por el registro 0,
    // porque los de la anterior ya se escribieron.
    i64 k = 0;
    while (k < accesos) {
        i64 n = accesos - k;
        if (n > regs) {
            n = regs;
        }
        for (i64 i = 0; i < n; i++) {
            i64 o = (k + i) * ancho;
            out += "${mnl} v${i}, [${s} + ${o}]\n";
        }
        for (i64 i = 0; i < n; i++) {
            i64 o = (k + i) * ancho;
            out += "${mne} [${d} + ${o}], v${i}\n";
        }
        k += n;
    }
    return out;
}

/**
 * @brief Genera el cuerpo COMPLETO de una copia grande: bucle + cola solapada.
 *
 * El patron es siempre el mismo y solo cambian el ancho y el mnemonico, asi
 * que se escribe una vez:
 *
 *     bucle:  <BLOQUE de `bloque` bytes desde s a d>
 *             add s, bloque ; add d, bloque
 *             cmp s, fs ; jb bucle
 *             <BLOQUE de `bloque` bytes desde fs a fd>   ; cola, solapando
 *
 * y cada BLOQUE, a su vez (@ref gen_bloque), es
 *
 *     <mn> v0, [s + 0]        ; TODAS las cargas
 *     <mn> v1, [s + ancho]
 *     ...
 *     <mn> [d + 0], v0        ; y DESPUES todas las escrituras
 *     <mn> [d + ancho], v1
 *     ...
 *
 * No hay contador: la condicion del bucle es el propio puntero de origen
 * contra donde empieza la cola.  Llevar la cuenta aparte obligaria a restarla
 * y compararla cada vuelta, y esa cuenta no dice nada que el puntero no diga
 * ya.
 *
 * La cola NO es un caso aparte ni un bucle byte a byte: es otro bloque igual
 * que termina justo en el final del rango.  Reescribe unos bytes que ya
 * estaban bien, que no cuesta nada, y a cambio no hay resto que tratar.
 *
 * @param mn Mnemonico.
 * @param ancho Bytes por acceso: 16, 32 o 64.
 * @param bloque Bytes por vuelta.  Multiplo de @p ancho.
 * @return El cuerpo del bloque asm, listo para empalmar.
 */
comptime string gen_grande(string mnl, string mne, string mne_cola, i64 ancho,
                           i64 regs, i64 adelanto, string cierre) {
    // El bloque de cada vuelta es justo lo que cabe en el presupuesto: un
    // acceso por registro.  Asi el tamano de la vuelta no es un numero suelto
    // que haya que mantener a mano, sale de cuantos registros se pueden gastar.
    i64 bloque = regs * ancho;
    i64 accesos = regs;
    i64 mitad = accesos / 2;
    string out = "bucle:\n";
    // Pedir con antelacion lo de vueltas siguientes, si se pide.  Con memoria
    // FRiA -- una copia de varios MB no cabe en cache -- el procesador va a
    // buscar cada linea cuando la necesita y espera; pedirla antes solapa esa
    // espera con el trabajo de esta vuelta.  Con datos ya calientes no aporta
    // nada, de ahi que sea un parametro y no algo fijo.
    if (adelanto > 0) {
        out += "prefetcht0 [s + ${adelanto}]\n";
    }
    for (i64 k = 0; k < mitad; k++) {
        i64 o = k * ancho;
        out += "${mnl} v${k}, [s + ${o}]\n";
    }
    for (i64 k = 0; k < mitad; k++) {
        i64 o = k * ancho;
        out += "${mne} [d + ${o}], v${k}\n";
    }
    // Los punteros avanzan AQUi, a mitad del bloque, y no al final: asi el
    // calculo de las direcciones de la vuelta siguiente arranca antes y se
    // solapa con lo que queda de esta.  Lo que avanza es un bloque COMPLETO
    // -- no medio, aunque se haga a mitad de la vuelta --, y por eso la
    // segunda mitad accede con desplazamientos NEGATIVOS: la devuelven al
    // tramo del bloque original que le faltaba, tocando exactamente los mismos
    // bytes que si no se hubiera movido nada.
    out += "add s, ${bloque}\n";
    out += "add d, ${bloque}\n";
    for (i64 k = mitad; k < accesos; k++) {
        i64 o = k * ancho - bloque;
        out += "${mnl} v${k}, [s + ${o}]\n";
    }
    for (i64 k = mitad; k < accesos; k++) {
        i64 o = k * ancho - bloque;
        out += "${mne} [d + ${o}], v${k}\n";
    }
    out += "cmp s, fs\n";
    out += "jb bucle\n";
    // Cola: un bloque igual que termina en el final del rango.
    /* La cola arranca en `n - bloque`, o sea donde caiga: su alineacion
     * depende de `n` y no la controla nadie.  Por eso lleva su propio
     * mnemonico de escritura -- una instruccion que EXIJA alineacion no puede
     * usarse aqui salvo que el llamante garantice tambien el tamano. */
    out += gen_bloque(mnl, mne_cola, ancho, bloque, "fd", "fs", regs);
    // Cierre: `vzeroupper` cuando se han usado registros anchos, `sfence`
    // cuando las escrituras han sido no temporales.  Va aqui y no en cada
    // funcion porque es parte del patron, no del cuerpo.
    if (cierre != "") {
        out += "${cierre}\n";
    }
    return out;
}

/**
 * @brief Genera un bloque de RELLENO de @p bytes desde @p d.
 *
 * La gemela de @ref gen_bloque para el relleno, con una diferencia que cambia
 * la forma: rellenar no tiene lecturas.  Todas las escrituras sacan el valor
 * del MISMO registro, asi que no hay presupuesto que repartir ni tandas que
 * hacer -- un solo registro ancho basta por muchos accesos que haya, y no hay
 * dependencia entre ellos porque ninguno espera a un dato.
 *
 * @param mne Mnemonico de escritura (movdqu / vmovdqu / vmovdqu64 y alineadas).
 * @param ancho Bytes por acceso: 16, 32 o 64.
 * @param bytes Bytes que cubre el bloque.  Multiplo de @p ancho.
 * @param d Registro con la direccion destino.
 * @return El cuerpo del bloque asm, listo para empalmar.
 */
comptime string gen_relleno(string mne, i64 ancho, i64 bytes, string d) {
    static_assert(ancho == 16 || ancho == 32 || ancho == 64,
                  "el ancho tiene que ser el de un registro real: 16, 32 o 64");
    static_assert(bytes % ancho == 0,
                  "el bloque tiene que ser multiplo del ancho del registro");
    i64 accesos = bytes / ancho;
    string out = "";
    for (i64 i = 0; i < accesos; i++) {
        i64 o = i * ancho;
        out += "${mne} [${d} + ${o}], v0\n";
    }
    return out;
}

/**
 * @brief Genera un relleno SOLAPADO de @p bytes + @p bytes.
 *
 * Mismo algoritmo que @ref gen_solapada: un tramo desde el principio y otro
 * que termina en el final, solapandose por el medio.  Los bytes del solape se
 * escriben dos veces con el mismo valor -- que en un relleno es literalmente
 * gratis -- y a cambio no hay cola ni salto que predecir.
 *
 * @param mne Mnemonico de escritura.
 * @param ancho Bytes por acceso.
 * @param bytes Bytes que cubre cada mitad.
 * @return El cuerpo del bloque asm.
 */
comptime string gen_relleno_solapado(string mne, i64 ancho, i64 bytes) {
    return gen_relleno(mne, ancho, bytes, "d") +
           gen_relleno(mne, ancho, bytes, "fd");
}

/**
 * @brief Genera un relleno GRANDE: bucle de @p regs accesos por vuelta + cola.
 *
 * Espejo de @ref gen_grande sin su mitad de lecturas.  Se conserva lo que
 * SIGUE aplicando: el puntero avanza a mitad del bloque para adelantar el
 * calculo de la vuelta siguiente, y la condicion se prueba contra el puntero
 * de cola en vez de llevar un contador aparte.
 *
 * @param mne Mnemonico de escritura del bucle.
 * @param mne_cola El de la cola, que arranca donde caiga y por eso no puede
 *        exigir alineacion aunque el bucle si la exija.
 * @param ancho Bytes por acceso.
 * @param regs Accesos por vuelta.
 * @param cierre Instruccion final (`vzeroupper`, `sfence`) o cadena vacia.
 * @return El cuerpo del bloque asm.
 */
comptime string gen_relleno_grande(string mne, string mne_cola, i64 ancho,
                                   i64 regs, string cierre) {
    i64 bloque = regs * ancho;
    i64 mitad = regs / 2;
    string out = "bucle:\n";
    for (i64 k = 0; k < mitad; k++) {
        i64 o = k * ancho;
        out += "${mne} [d + ${o}], v0\n";
    }
    out += "add d, ${bloque}\n";
    for (i64 k = mitad; k < regs; k++) {
        i64 o = k * ancho - bloque;
        out += "${mne} [d + ${o}], v0\n";
    }
    out += "cmp d, fd\n";
    out += "jb bucle\n";
    out += gen_relleno(mne_cola, ancho, bloque, "fd");
    if (cierre != "") {
        out += "${cierre}\n";
    }
    return out;
}

/**
 * @brief Copia grande con registros de 128 bits (SSE2): 128 bytes por vuelta.
 *
 * Ocho accesos por vuelta, que es donde los registros vectoriales empiezan a
 * rendir: el bucle deja de estar dominado por su propia cuenta y salto.
 *
 * El cuerpo lo genera @ref gen_grande con este patron:
 *
 *     bucle:
 *       movdqu v0, [s + 0]        ; las OCHO cargas primero
 *       movdqu v1, [s + 16]
 *       ...                       ; hasta v7, de 16 en 16
 *       movdqu v7, [s + 112]
 *       movdqu [d + 0], v0        ; y DESPUES las ocho escrituras
 *       ...
 *       movdqu [d + 112], v7
 *       add s, 128
 *       add d, 128
 *       cmp s, fs                 ; el puntero ES la condicion
 *       jb bucle
 *       movdqu v0, [fs + 0]       ; cola: otro bloque igual que
 *       ...                       ; termina en el final del rango
 *       movdqu [fd + 112], v7
 *
 * Las cargas van TODAS antes que las escrituras, cada una a su registro:
 * alternarlas sobre uno solo encadenaria cada acceso con el anterior por una
 * dependencia que la copia no tiene.
 *
 * PRECONDICION: @p n al menos 128 (el tamano de la vuelta).  Con menos, la
 * cola solapada arrancaria por debajo del principio.  Quien reparte por tamano
 * es `memcpy`; comprobarlo aqui anadiria la rama que el llamante ya resolvio.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, 128 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_medium_sse2(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 128;
    u8* fin_s = src + n - 128;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        xmm v0,
        xmm v1,
        xmm v2,
        xmm v3,
        xmm v4,
        xmm v5,
        xmm v6,
        xmm v7,
    ) {
        inject(gen_grande("movdqu", "movdqu", "movdqu", 16, 8, 0, ""))
    }
}

/**
 * @brief Copia grande con registros de 256 bits (AVX2): 256 bytes por vuelta.
 *
 * Mismo patron que @ref memcpy_medium_sse2 con el doble de ancho por acceso,
 * asi que la misma vuelta mueve el doble.  Aqui es donde AVX2 se nota.
 *
 *     bucle:
 *       vmovdqu v0, [s + 0]       ; las OCHO cargas primero
 *       vmovdqu v1, [s + 32]
 *       ...                       ; hasta v7, de 32 en 32
 *       vmovdqu v7, [s + 224]
 *       vmovdqu [d + 0], v0       ; y DESPUES las ocho escrituras
 *       ...
 *       vmovdqu [d + 224], v7
 *       add s, 256
 *       add d, 256
 *       cmp s, fs                 ; el puntero ES la condicion
 *       jb bucle
 *       vmovdqu v0, [fs + 0]      ; cola: otro bloque igual que
 *       ...                       ; termina en el final del rango
 *       vmovdqu [fd + 224], v7
 *
 * PRECONDICION: @p n al menos 256, y el procesador con AVX2.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, 256 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_medium_avx2(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 256;
    u8* fin_s = src + n - 256;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        ymm v0,
        ymm v1,
        ymm v2,
        ymm v3,
        ymm v4,
        ymm v5,
        ymm v6,
        ymm v7,
    ) {
        inject(gen_grande("vmovdqu", "vmovdqu", "vmovdqu", 32, 8, 0, "vzeroupper"))
    }
}

/**
 * @brief Copia grande con registros de 512 bits (AVX-512): 512 por vuelta.
 *
 * Mismo patron que @ref memcpy_medium_sse2 con el ancho maximo:
 *
 *     bucle:
 *       vmovdqu64 v0, [s + 0]     ; las OCHO cargas primero
 *       vmovdqu64 v1, [s + 64]
 *       ...                       ; hasta v7, de 64 en 64
 *       vmovdqu64 v7, [s + 448]
 *       vmovdqu64 [d + 0], v0     ; y DESPUES las ocho escrituras
 *       ...
 *       vmovdqu64 [d + 448], v7
 *       add s, 512
 *       add d, 512
 *       cmp s, fs                 ; el puntero ES la condicion
 *       jb bucle
 *       vmovdqu64 v0, [fs + 0]    ; cola: otro bloque igual que
 *       ...                       ; termina en el final del rango
 *       vmovdqu64 [fd + 448], v7
 *
 * PRECONDICION: @p n al menos 512, y el procesador con AVX-512F.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, 512 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_medium_avx512(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 512;
    u8* fin_s = src + n - 512;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        zmm v0,
        zmm v1,
        zmm v2,
        zmm v3,
        zmm v4,
        zmm v5,
        zmm v6,
        zmm v7,
    ) {
        inject(gen_grande("vmovdqu64", "vmovdqu64", "vmovdqu64", 64, 8, 0, "vzeroupper"))
    }
}

/**
 * @brief Copia @p n bytes con `rep movsb`.
 *
 * Una sola instruccion mueve el rango entero.  No es la reliquia que parece:
 * en los procesadores que anuncian ERMS va por lineas de cache completas y en
 * los tamanos grandes le gana a un bucle vectorial escrito a mano, ademas de
 * ocupar tres instrucciones en lugar de decenas.  En los que NO lo anuncian es
 * lento para tamanos pequenos, por eso quien reparte solo la elige cuando el
 * procesador lo dice -- de ahi que haga falta preguntarselo y no suponerlo.
 *
 * Los tres registros son los que la instruccion EXIGE, asi que aqui se nombran
 * a proposito en lugar de dejar elegir: no hay eleccion que tomar.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_erms(u8* dst, u8* src, usize n) {
    asm ( rdi d = dst, rsi s = src, rcx c = n, ) {
        rep movsb
    }
}

/**
 * @brief Rellena @p n bytes con @p val usando `rep stosb`.
 *
 * La gemela de @ref memcpy_erms para el relleno, con las mismas razones.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes.
 */
/**
 * @brief Rellena de 65 a 128 bytes con registros de 128 bits (SSE2).
 *
 * Espejo de @ref memcpy_small_sse2: dos mitades que se solapan por el medio,
 * sin bucle y sin cola.
 *
 * El valor se difunde a todo el registro en dos pasos: primero se replica a
 * los ocho bytes de un registro general (@c val * 0x0101010101010101, una
 * multiplicacion en vez de siete desplazamientos), y de ahi al vectorial.  En
 * SSE2 no hay difusion directa desde un registro general, asi que se mete la
 * palabra en la mitad baja y se duplica sobre si misma con @c punpcklqdq.
 *
 * PRECONDICION: @p n entre 65 y 128.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_small_sse2(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 64;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm v0,
    ) {
        movq v0, p
        punpcklqdq v0, v0
        inject(gen_relleno_solapado("movdqu", 16, 64))
    }
}

/**
 * @brief Lo mismo con registros de 256 bits (AVX2).
 *
 * Misma forma que @ref memset_small_sse2 con la mitad de accesos, porque cada
 * uno escribe el doble.  Aqui la difusion si es directa: @c vpbroadcastq.
 *
 * PRECONDICION: @p n entre 65 y 128, y el procesador con AVX2.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_small_avx2(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 64;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm sem,
        ymm v0,
    ) {
        // La semilla va en un registro de 128 bits porque `vmovq` escribe la
        // mitad baja de un `xmm`: no admite un `ymm` como destino.  De ahi
        // `vpbroadcastq` la difunde a los cuatro cuartos del de 256.
        vmovq sem, p
        vpbroadcastq v0, sem
        inject(gen_relleno_solapado("vmovdqu", 32, 64))
        vzeroupper
    }
}

/**
 * @brief Lo mismo con registros de 512 bits (AVX-512F).
 *
 * PRECONDICION: @p n entre 65 y 128, y el procesador con AVX-512F.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_small_avx512(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 64;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        zmm v0,
    ) {
        vpbroadcastq v0, p
        inject(gen_relleno_solapado("vmovdqu64", 64, 64))
        vzeroupper
    }
}

