/**
 * @brief Relleno grande con doble vuelta: 256 bytes, 16 registros (SSE2).
 *
 * Espejo de @ref memcpy_big_sse2.  La vuelta es del doble porque se gasta el
 * banco entero: menos vueltas para los mismos bytes, y la cuenta y el salto
 * del bucle se reparten entre el doble de trabajo.
 *
 * En el relleno el banco ancho no hace falta para GUARDAR datos -- todas las
 * escrituras leen el mismo registro -- pero declararlos igual permite reusar
 * el generador y deja al asignador la eleccion; el codigo emitido escribe
 * siempre desde @c v0.
 *
 * PRECONDICION: @p n al menos 256.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 256 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_big_sse2(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 256;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm v0,
    ) {
        movq v0, p
        punpcklqdq v0, v0
        inject(gen_relleno_grande("movdqu", "movdqu", 16, 16, ""))
    }
}

/**
 * @brief Relleno grande con AVX2 y doble vuelta: 512 bytes.
 * @copydetails memset_big_sse2
 *
 * PRECONDICION: @p n al menos 512, y el procesador con AVX2.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 512 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_big_avx2(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 512;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm sem,
        ymm v0,
    ) {
        vmovq sem, p
        vpbroadcastq v0, sem
        inject(gen_relleno_grande("vmovdqu", "vmovdqu", 32, 16, "vzeroupper"))
    }
}

/**
 * @brief Relleno grande con AVX-512 y doble vuelta: 1024 bytes.
 * @copydetails memset_big_sse2
 *
 * PRECONDICION: @p n al menos 1024, y el procesador con AVX-512F.
 *
 * @param dst Destino.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 1024 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_big_avx512(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 1024;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        zmm v0,
    ) {
        vpbroadcastq v0, p
        inject(gen_relleno_grande("vmovdqu64", "vmovdqu64", 64, 16, "vzeroupper"))
    }
}

/**
 * @brief Relleno ENORME con escrituras NO TEMPORALES (AVX2).
 *
 * Espejo de @ref memcpy_streaming_avx2, y aqui la ventaja es aun mas clara
 * que en la copia: un relleno grande no tiene lecturas que aprovechen la
 * cache, asi que meter el destino entero en ella es trabajo tirado dos veces
 * -- se expulsa lo que habia y ademas se paga la lectura-para-escribir de
 * cada linea, que en un relleno no aporta nada porque la linea se sobrescribe
 * completa.  `vmovntdq` escribe directo a memoria y se salta las dos cosas.
 *
 * No lleva `prefetch`: no hay origen que precargar.  Si lleva `sfence`, y no
 * es opcional: las escrituras no temporales no respetan el orden que el resto
 * del programa da por hecho, y sin la barrera quien lea el destino despues
 * podria no ver lo escrito.
 *
 * PRECONDICION: @p dst multiplo de 32 -- `vmovntdq` lo EXIGE, un destino mal
 * alineado da excepcion del procesador --, @p n al menos 512, y AVX2.
 *
 * @param dst Destino, multiplo de 32.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 512 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_streaming_avx2(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 512;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm sem,
        ymm v0,
    ) {
        vmovq sem, p
        vpbroadcastq v0, sem
        inject(gen_relleno_grande("vmovntdq", "vmovdqu", 32, 16,
                                  "sfence\nvzeroupper"))
    }
}

/**
 * @brief Relleno ENORME con escrituras NO TEMPORALES (AVX-512F).
 * @copydetails memset_streaming_avx2
 *
 * PRECONDICION: @p dst multiplo de 64, @p n al menos 1024, y AVX-512F.
 *
 * @param dst Destino, multiplo de 64.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 1024 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_streaming_avx512(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 1024;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        zmm v0,
    ) {
        vpbroadcastq v0, p
        inject(gen_relleno_grande("vmovntdq", "vmovdqu64", 64, 16,
                                  "sfence\nvzeroupper"))
    }
}

/* --- Variantes ALINEADAS del relleno --------------------------------------
 *
 * El mismo patron y las mismas instrucciones; solo cambia la FORMA del acceso
 * (`movdqa` / `vmovdqa` / `vmovdqa64` en vez de las que no exigen nada).  En
 * los procesadores recientes la diferencia se ha estrechado mucho, pero sigue
 * habiendo microarquitecturas donde un acceso alineado no cruza linea de cache
 * nunca y el no alineado si.
 *
 * PRECONDICION en todas: @p dst multiplo del ancho del acceso.  Una
 * instruccion alineada con una direccion que no lo esta da excepcion del
 * procesador -- no es una perdida de rendimiento, es que el programa cae.  Por
 * eso el reparto solo llega aqui despues de COMPROBARLO, y por eso existen
 * ambas versiones en vez de una que adivine.
 */

/**
 * @brief @ref memset_small_sse2 con accesos alineados.
 * @param dst Destino, multiplo de 16.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_small_sse2_aligned(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 64;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm v0,
    ) {
        movq v0, p
        punpcklqdq v0, v0
        inject(gen_relleno_solapado("movdqa", 16, 64))
    }
}

/**
 * @brief @ref memset_small_avx2 con accesos alineados.
 * @param dst Destino, multiplo de 32.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_small_avx2_aligned(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 64;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm sem,
        ymm v0,
    ) {
        vmovq sem, p
        vpbroadcastq v0, sem
        inject(gen_relleno_solapado("vmovdqa", 32, 64))
        vzeroupper
    }
}

/**
 * @brief @ref memset_small_avx512 con accesos alineados.
 * @param dst Destino, multiplo de 64.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, entre 65 y 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_small_avx512_aligned(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 64;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        zmm v0,
    ) {
        vpbroadcastq v0, p
        inject(gen_relleno_solapado("vmovdqa64", 64, 64))
        vzeroupper
    }
}

/**
 * @brief @ref memset_medium_sse2 con accesos alineados en el CUERPO.
 *
 * La cola conserva su mnemonico sin exigencias: arranca en `n - bloque`, o sea
 * donde caiga, y su alineacion depende de @p n -- que el llamante no controla.
 * Exigirsela seria pedir que el tamano tambien fuera multiplo del ancho.
 *
 * @param dst Destino, multiplo de 16.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 128 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_medium_sse2_aligned(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 128;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm v0,
    ) {
        movq v0, p
        punpcklqdq v0, v0
        inject(gen_relleno_grande("movdqa", "movdqu", 16, 8, ""))
    }
}

/**
 * @brief @ref memset_medium_avx2 con accesos alineados en el cuerpo.
 * @copydetails memset_medium_sse2_aligned
 * @param dst Destino, multiplo de 32.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 256 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_medium_avx2_aligned(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 256;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        xmm sem,
        ymm v0,
    ) {
        vmovq sem, p
        vpbroadcastq v0, sem
        inject(gen_relleno_grande("vmovdqa", "vmovdqu", 32, 8, "vzeroupper"))
    }
}

/**
 * @brief @ref memset_medium_avx512 con accesos alineados en el cuerpo.
 * @copydetails memset_medium_sse2_aligned
 * @param dst Destino, multiplo de 64.
 * @param val Byte con el que rellenar.
 * @param n Numero de bytes, 512 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memset_medium_avx512_aligned(u8* dst, u8 val, usize n) {
    u8* fin_d = dst + n - 512;
    u64 pat = ((u64) val) * 72340172838076673;
    asm (
        reg d = dst,
        reg fd = fin_d,
        reg p = pat,
        zmm v0,
    ) {
        vpbroadcastq v0, p
        inject(gen_relleno_grande("vmovdqa64", "vmovdqu64", 64, 8, "vzeroupper"))
    }
}

@Target("arch:x86_64")
@NoIdiom
public void memset_erms(u8* dst, u8 val, usize n) {
    u64 v = (u64) val;
    asm ( rdi d = dst, rax a = v, rcx c = n, ) {
        rep stosb
    }
}

/**
 * @brief Igual que @ref memcpy_medium_sse2 pero con accesos ALINEADOS.
 *
 * Se emite el MISMO patron y las mismas instrucciones; solo cambia la forma
 * del acceso (`movdqa` en vez de `movdqu`):
 *
 *     bucle:
 *       movdqa v0, [s + 0]        ; las OCHO cargas primero
 *       ...                       ; hasta v7, de 16 en 16
 *       movdqa [d + 0], v0        ; y DESPUES las ocho escrituras
 *       ...
 *       add s, 128
 *       add d, 128
 *       cmp s, fs
 *       jb bucle
 *       movdqa v0, [fs + 0]       ; cola, solapando
 *       ...
 *
 * La alineacion se conserva SOLA dentro del bucle: el puntero avanza de 128 en
 * 128 y 128 es multiplo de 16, asi que si entra alineado sigue alineado.  Lo
 * que no se conserva solo es la COLA: arranca en `n - 128`, de modo que hace
 * falta
 *
 *     (n - 128) % 16 == 0
 *
 * y eso equivale a pedir `n % 16 == 0` UNICAMENTE porque 128 es multiplo de
 * 16.  Con una vuelta que no fuera multiplo del ancho las dos condiciones
 * dejarian de ser la misma, asi que la regla buena es la de arriba.
 *
 * PRECONDICION: @p dst, @p src y @p n, los tres multiplos de 16, y @p n al
 * menos 128.  No se comprueba en ejecucion: costaria las ramas que esta
 * version viene a ahorrar, y un valor mal alineado da EXCEPCION del procesador
 * -- se ve en el acto, no es un fallo silencioso.
 *
 * @param dst Destino, multiplo de 16.
 * @param src Origen, multiplo de 16.
 * @param n Numero de bytes, multiplo de 16 y al menos 128.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_medium_sse2_aligned(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 128;
    u8* fin_s = src + n - 128;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        xmm v0,
        xmm v1,
        xmm v2,
        xmm v3,
        xmm v4,
        xmm v5,
        xmm v6,
        xmm v7,
    ) {
        inject(gen_grande("movdqa", "movdqa", "movdqa", 16, 8, 0, ""))
    }
}

/**
 * @brief Igual que @ref memcpy_medium_avx2 con accesos alineados a 32.
 *
 * Mismo patron con `vmovdqa`:
 *
 *     bucle:
 *       vmovdqa v0, [s + 0]       ; y hasta v7, de 32 en 32
 *       ...
 *       vmovdqa [d + 0], v0       ; despues las ocho escrituras
 *       ...
 *       add s, 256 ; add d, 256 ; cmp s, fs ; jb bucle
 *       vmovdqa v0, [fs + 0]      ; cola, solapando
 *       ...
 *
 * @copydetails memcpy_medium_sse2_aligned
 *
 * @param dst Destino, multiplo de 32.
 * @param src Origen, multiplo de 32.
 * @param n Numero de bytes, multiplo de 32 y al menos 256.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_medium_avx2_aligned(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 256;
    u8* fin_s = src + n - 256;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        ymm v0,
        ymm v1,
        ymm v2,
        ymm v3,
        ymm v4,
        ymm v5,
        ymm v6,
        ymm v7,
    ) {
        inject(gen_grande("vmovdqa", "vmovdqa", "vmovdqa", 32, 8, 0, "vzeroupper"))
    }
}

/**
 * @brief Igual que @ref memcpy_medium_avx512 con accesos alineados a 64.
 *
 * Mismo patron con `vmovdqa64`:
 *
 *     bucle:
 *       vmovdqa64 v0, [s + 0]     ; y hasta v7, de 64 en 64
 *       ...
 *       vmovdqa64 [d + 0], v0     ; despues las ocho escrituras
 *       ...
 *       add s, 512 ; add d, 512 ; cmp s, fs ; jb bucle
 *       vmovdqa64 v0, [fs + 0]    ; cola, solapando
 *       ...
 *
 * @copydetails memcpy_medium_sse2_aligned
 *
 * @param dst Destino, multiplo de 64.
 * @param src Origen, multiplo de 64.
 * @param n Numero de bytes, multiplo de 64 y al menos 512.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_medium_avx512_aligned(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 512;
    u8* fin_s = src + n - 512;
    asm (
        reg d = dst,
        reg s = src,
        reg fd = fin_d,
        reg fs = fin_s,
        zmm v0,
        zmm v1,
        zmm v2,
        zmm v3,
        zmm v4,
        zmm v5,
        zmm v6,
        zmm v7,
    ) {
        inject(gen_grande("vmovdqa64", "vmovdqa64", "vmovdqa64", 64, 8, 0, "vzeroupper"))
    }
}

/**
 * @brief Copia grande con SSE2 y DOBLE vuelta: 256 bytes, 16 registros.
 *
 * Misma forma que @ref memcpy_medium_sse2 con el doble de accesos por vuelta.
 * Lo que se gana no son los accesos --son los mismos por byte-- sino el coste
 * del bucle: `cmp` y `jb` se pagan una vez cada 256 bytes en lugar de cada
 * 128.  Lo que se paga es el minimo: por debajo de 256 bytes esta version no
 * aplica, y de ahi que la de 8 registros siga estando para el tramo de en
 * medio.
 *
 * Usa los 16 registros del banco, que es todo lo que hay; no cabe una vuelta
 * mayor sin volver a leer un registro antes de haberlo escrito, que es
 * justamente la dependencia que se venia a evitar.
 *
 * PRECONDICION: @p n al menos 256.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, 256 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_big_sse2(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 256;
    u8* fin_s = src + n - 256;
    asm (
        reg d = dst, reg s = src, reg fd = fin_d, reg fs = fin_s,
        xmm v0, xmm v1, xmm v2,  xmm v3,  xmm v4,  xmm v5,  xmm v6,  xmm v7,
        xmm v8, xmm v9, xmm v10, xmm v11, xmm v12, xmm v13, xmm v14, xmm v15,
    ) {
        inject(gen_grande("movdqu", "movdqu", "movdqu", 16, 16, 0, ""))
    }
}

/**
 * @brief Copia grande con AVX2 y doble vuelta: 512 bytes, 16 registros.
 * @copydetails memcpy_big_sse2
 *
 * PRECONDICION: @p n al menos 512, y el procesador con AVX2.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, 512 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_big_avx2(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 512;
    u8* fin_s = src + n - 512;
    asm (
        reg d = dst, reg s = src, reg fd = fin_d, reg fs = fin_s,
        ymm v0, ymm v1, ymm v2,  ymm v3,  ymm v4,  ymm v5,  ymm v6,  ymm v7,
        ymm v8, ymm v9, ymm v10, ymm v11, ymm v12, ymm v13, ymm v14, ymm v15,
    ) {
        inject(gen_grande("vmovdqu", "vmovdqu", "vmovdqu", 32, 16, 0,
                          "vzeroupper"))
    }
}

/**
 * @brief Copia grande con AVX-512 y doble vuelta: 1024 bytes, 16 registros.
 * @copydetails memcpy_big_sse2
 *
 * PRECONDICION: @p n al menos 1024, y el procesador con AVX-512F.
 *
 * @param dst Destino.
 * @param src Origen.
 * @param n Numero de bytes, 1024 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_big_avx512(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 1024;
    u8* fin_s = src + n - 1024;
    asm (
        reg d = dst, reg s = src, reg fd = fin_d, reg fs = fin_s,
        zmm v0, zmm v1, zmm v2,  zmm v3,  zmm v4,  zmm v5,  zmm v6,  zmm v7,
        zmm v8, zmm v9, zmm v10, zmm v11, zmm v12, zmm v13, zmm v14, zmm v15,
    ) {
        inject(gen_grande("vmovdqu64", "vmovdqu64", "vmovdqu64", 64, 16, 0, "vzeroupper"))
    }
}

/**
 * @brief Copia ENORME sin pasar por la cache: escrituras no temporales.
 *
 * Para copias de decenas de MB el cuello no es el procesador sino la cache:
 * una copia normal mete el destino entero en ella y expulsa todo lo demas, que
 * es trabajo tirado -- ese destino no se va a volver a leer inmediatamente.
 * `vmovntdq` escribe DIRECTO a memoria sin ocupar cache, con lo que el ancho
 * de banda sube y, sobre todo, no se destroza lo que habia dentro.
 *
 * Va con dos acompanantes que no son opcionales:
 *
 *   - `prefetcht0` sobre el origen, porque las lecturas SI pasan por cache y
 *     con memoria fria el procesador se pasaria la vuelta esperandolas.
 *   - `sfence` al final, porque las escrituras no temporales NO respetan el
 *     orden que el resto del programa da por hecho: sin la barrera, quien lea
 *     el destino despues podria no ver lo escrito.
 *
 * PRECONDICION: @p dst multiplo de 32 -- `vmovntdq` lo EXIGE, un destino mal
 * alineado da excepcion del procesador -- , @p n al menos 512, y AVX2.  El
 * origen puede estar como sea: las lecturas son de las que no exigen nada.
 *
 * @param dst Destino, multiplo de 32.
 * @param src Origen.
 * @param n Numero de bytes, 512 o mas.
 */
@Target("arch:x86_64")
@NoIdiom
public void memcpy_streaming_avx2(u8* dst, u8* src, usize n) {
    u8* fin_d = dst + n - 512;
    u8* fin_s = src + n - 512;
    asm (
        reg d = dst, reg s = src, reg fd = fin_d, reg fs = fin_s,
        ymm v0, ymm v1, ymm v2,  ymm v3,  ymm v4,  ymm v5,  ymm v6,  ymm v7,
        ymm v8, ymm v9, ymm v10, ymm v11, ymm v12, ymm v13, ymm v14, ymm v15,
    ) {
        inject(gen_grande("vmovdqu", "vmovntdq", "vmovdqu", 32, 16, 1024,
                          "sfence\nvzeroupper"))
    }
}
