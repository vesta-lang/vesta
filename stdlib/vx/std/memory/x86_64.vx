        ymm v8, ymm v9, ymm v10, ymm v11, ymm v12, ymm v13, ymm v14, ymm v15,
    ) {
        inject(gen_grande("vmovdqu", "vmovdqu", "vmovdqu", 32, 512, 0,
                          "vzeroupper"))
