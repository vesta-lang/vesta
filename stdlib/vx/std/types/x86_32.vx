/**
 * std.types para x86 (32 bits): punteros y tamanos de 32 bits.
 * Todos son typedef-new (tipos NOMINALES distintos): un uintptr NO es
 * intercambiable con un u32 plano SIN un cast explicito -> seguridad de tipos
 * para direcciones/tamanos, cerrados bajo aritmetica y bitwise.  El `new`
 * "pelado" (sin bloque {from/to}) permite el cast explicito a/desde CUALQUIER
 * numerico ((uintptr)x, (i64)p, ...); declarar from/to lo restringiria.
 */
namespace std.types;

@Target("arch:x86")
public typedef u32 uintptr new;   // entero SIN signo del ancho de un puntero
@Target("arch:x86")
public typedef i32 intptr  new;   // entero CON signo del ancho de un puntero
@Target("arch:x86")
public typedef u32 usize   new;   // tamano/cuenta de objetos (C size_t)
@Target("arch:x86")
public typedef i32 isize   new;   // tamano/diferencia CON signo (Rust isize / ptrdiff)
@Target("arch:x86")
public typedef i32 ssize   new;   // POSIX ssize_t: tamano con signo (o -1 = error)
