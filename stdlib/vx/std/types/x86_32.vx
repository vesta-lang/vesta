/**
 * std.types para x86 (32 bits): punteros y tamanos de 32 bits.
 */
namespace std.types;

@Target("arch:x86")
public typedef u32 uintptr new;
@Target("arch:x86")
public typedef i32 intptr  new;
@Target("arch:x86")
public typedef u32 usize   new;
@Target("arch:x86")
public typedef i32 isize   new;
