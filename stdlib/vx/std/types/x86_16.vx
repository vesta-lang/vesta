/**
 * std.types para x86 modo real (16 bits): punteros y tamanos de 16 bits.
 * Todos son typedef-new (tipos NOMINALES distintos): un uintptr NO es
 * intercambiable con un u16 plano SIN un cast explicito -> seguridad de tipos
 * para direcciones/tamanos, cerrados bajo aritmetica y bitwise.  El `new`
 * "pelado" (sin bloque {from/to}) permite el cast explicito a/desde CUALQUIER
 * numerico ((uintptr)x, (i64)p, ...); declarar from/to lo restringiria.
 */
namespace std.types;

@Target("arch:x86_16")
public typedef u16 uintptr new;   // entero SIN signo del ancho de un puntero
@Target("arch:x86_16")
public typedef i16 intptr  new;   // entero CON signo del ancho de un puntero
@Target("arch:x86_16")
public typedef u16 usize   new;   // tamano/cuenta de objetos (C size_t)
@Target("arch:x86_16")
public typedef i16 isize   new;   // tamano/diferencia CON signo (Rust isize / ptrdiff)
@Target("arch:x86_16")
public typedef i16 ssize   new;   // POSIX ssize_t: tamano con signo (o -1 = error)

// Tipos de COMPATIBILIDAD con C: DEBILES a proposito (ver x86_64.vx).
@Target("arch:x86_16")
public typedef u16 size_t;
@Target("arch:x86_16")
public typedef i16 ssize_t;
