namespace std.syscall.linux.arm;

import std.syscall.abi only syscall_id;
import std.types only size_t;

/**
 * Ejecuta una syscall Linux ARM (32-bit EABI): el numero de servicio va en R7 y los argumentos
 * en R0..R5; `svc #0` hace la llamada; el resultado queda en R0..
 * Un envoltorio castea `invoke` a un `cfn` con SOLO los argumentos
 * que esa syscall usa (aridad/tipos/orden); el compilador toma los
 * primeros N registros de esta firma e INLINA la llamada.
 */
public size_t invoke(register("r7") syscall_id id,
	register("r0") size_t a1,
	register("r1") size_t a2,
	register("r2") size_t a3,
	register("r3") size_t a4,
	register("r4") size_t a5,
	register("r5") size_t a6) {
	asm { svc 0 }
	return (size_t) a1; // R0 tras el trap = resultado
}

