namespace std.syscall.linux.x86_64;

import std.syscall.abi only syscall_id;
import std.types only size_t;

/**
 * Ejecuta una syscall Linux x86-64.  La CONVENCION vive aqui: el ID en RAX y los
 * argumentos en RDI/RSI/RDX/R10/R8/R9 (ABI de `syscall`); el resultado queda en
 * RAX.  Un envoltorio castea `invoke` a un `cfn` con SOLO los argumentos que esa
 * syscall usa (aridad/tipos/orden); el compilador toma los primeros N registros
 * de esta firma e INLINA la llamada -- emite solo los movimientos justos (los
 * argumentos no pasados se eliminan).  Sin `ret` en el asm (usa `return`) para
 * permitir el inline.
 */
public size_t invoke(register("rax") syscall_id id,
                     register("rdi") size_t a1, register("rsi") size_t a2,
                     register("rdx") size_t a3, register("r10") size_t a4,
                     register("r8")  size_t a5, register("r9")  size_t a6) {
    asm { syscall }
    return (size_t) id;   // RAX tras el syscall = resultado
}

