namespace std.syscall.linux.x86_64;

import std.syscall only syscall_id;
import std.types only size_t;

/**
 * Ejecuta una syscall y devuelve el valor en RAX como manda la convencion.
 */
@Naked
public size_t invoke(syscall_id id_call) {
    asm(
        reg p = id_call,   // in: syscall ID
    ) {
        mov rax, p
        syscall
        ret
    }
}

