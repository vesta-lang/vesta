namespace std.syscall.linux.x86_32;

import std.syscall only syscall_id;
import std.types only size_t;

/**
 * Ejecuta una syscall y devuelve el valor en EAX como manda la convencion.
 */
@Naked
public size_t invoke(syscall_id id) {
    asm(
        reg p = id_call,   // in: syscall ID
    ) {
        mov eax, p
        int 0x80
        ret
    }
}

