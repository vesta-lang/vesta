namespace std.syscall.linux.arm64;

import std.syscall.abi only syscall_id;
import std.types only size_t;

/**
 * Ejecuta una syscall Linux ARM64 (AArch64): el numero de servicio va en X8 y los argumentos
 * en X0..X5; `svc #0` hace la llamada; el resultado queda en X0..
 * Un envoltorio castea `invoke` a un `cfn` con SOLO los argumentos
 * que esa syscall usa (aridad/tipos/orden); el compilador toma los
 * primeros N registros de esta firma e INLINA la llamada.
 */
public size_t invoke(register("x8") syscall_id id,
	register("x0") size_t a1,
	register("x1") size_t a2,
	register("x2") size_t a3,
	register("x3") size_t a4,
	register("x4") size_t a5,
	register("x5") size_t a6) {
	asm { svc 0 }
	return (size_t) a1; // X0 tras el trap = resultado
}

