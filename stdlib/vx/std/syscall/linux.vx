    static syscall_ctx_invoke ctx = syscall_ctx_invoke();
    return (i32)((cfn(syscall_id, usize, usize, usize, usize, usize, usize) -> u64)(ctx.invoke_method))(_NR__sysctl, a0, a1, a2, a3, a4, a5);
}

