namespace std.syscall.linux;

import std.syscall.abi only invoke_syscall, syscall_id;

import std.types only nullptr, size_t, ssize_t, usize;

// trae al scope TODA la implementacion del arch (invoke + los
// 400+ _NR_*) y la re-exporta.
@Target("arch:x86_64 && !os:windows")
public import std.syscall.linux.x86_64 only *;

@Target("arch:x86 && !os:windows")
public import std.syscall.linux.x86_32 only *;

// `syscall_ctx_invoke` permite PERSONALIZAR el metodo de
// invocacion por-syscall (reasignar `invoke_method`).  Los
// wrappers de abajo usan el `invoke` DIRECTO (se INLINA ->
// codigo minimo, cross-arch).
public struct syscall_ctx_invoke {
    invoke_syscall invoke_method = invoke;
};

// ===================================================================
// Wrappers tipados de las syscalls Linux.  GENERADOS por
// tools/import/gen_syscall_wrappers.py desde las firmas de
// api.syscall.sh -- NO EDITAR A MANO.
//
// Cada wrapper mantiene su PROPIO `static syscall_ctx_invoke ctx` y
// castea `ctx.invoke_method` al `cfn` con la aridad/tipos reales,
// pasando el `_NR_*` como 1er argumento.  Reasignar `ctx.invoke_method`
// permite PERSONALIZAR como se invoca cada syscall.  Retorno: i32
// (fd/pid/-errno) salvo I/O -> ssize_t, mmap/brk -> void *, lseek -> i64.
// ===================================================================

// --- Presentes en x86-64 Y x86-32 (cross-arch) ---

