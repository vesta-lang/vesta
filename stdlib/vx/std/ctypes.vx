/**
 * std.ctypes -- tipos primitivos del lenguaje C expresados como typedefs puros
 * sobre los tipos Vesta (i8..i64 / u8..u64 / f32 / f64).  Pensado para portar
 * headers C (Win32, POSIX, ...) casi verbatim: `typedef long_int LONG;` en vez
 * de tener que recordar a mano si `long` es i32 o i64 en cada plataforma.
 *
 * Nombres: se mimetiza la forma canonica multi-palabra de C uniendo con `_`
 * (`long int` -> long_int, `long long` -> long_long).  Los tipos cuyo ancho
 * depende de la plataforma (`long`) se resuelven con @Target: en Windows el
 * modelo es LLP64 (`long` = 32 bits); en Linux/macOS es LP64 (`long` = 64 bits).
 *
 * `char`, `float`, `double`, `void` NO se redefinen aqui: ya son tipos Vesta.
 */
namespace std.ctypes;

/* --- enteros con signo (ancho fijo) --- */
public typedef i32 int;            // C `int` (32 bits)
public typedef i8  signed_char;
public typedef i16 short_int;      // C `short` / `short int`
public typedef i64 long_long;      // C `long long` / `long long int`

/* --- enteros sin signo (ancho fijo) --- */
public typedef u8  unsigned_char;
public typedef u16 unsigned_short_int;  // C `unsigned short`
public typedef u32 unsigned_int;        // C `unsigned` / `unsigned int`
public typedef u64 unsigned_long_long;  // C `unsigned long long`

/* --- `long` / `unsigned long`: ancho dependiente de plataforma --- */
/*     Windows (LLP64): 32 bits.  Linux/macOS (LP64): 64 bits.            */
@Target("os:windows")
public typedef i32 long_int;
@Target("!os:windows")
public typedef i64 long_int;

@Target("os:windows")
public typedef u32 unsigned_long_int;
@Target("!os:windows")
public typedef u64 unsigned_long_int;

/* --- punto flotante (alias por completitud; f32/f64 ya son Vesta) --- */

public typedef f64 long_double;    // Vesta no tiene f80; se mapea a f64
