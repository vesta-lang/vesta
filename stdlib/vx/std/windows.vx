	DeviceGeneralFailure,
	DeviceCausedOvercurrent,
	DeviceNotEnoughPower,
	DeviceNotEnoughBandwidth,
	DeviceHubNestedTooDeeply,
	DeviceInLegacyHub
} USB_CONNECTION_STATUS, *PUSB_CONNECTION_STATUS;
typedef enum USB_HUB_NODE {
	UsbHub,
	UsbMIParent
} USB_HUB_NODE;


// CTL_CODE: en C es un macro que compone un codigo de DeviceIoControl.  Aqui
// se modela como funcion comptime (se pliega a constante en cada uso).
comptime u64 CTL_CODE(u64 DeviceType, u64 Function, u64 Method, u64 Access) {
    return ((DeviceType) << 16) | ((Access) << 14) | ((Function) << 2) | (Method);
}

// FSCTL_*: en C son macros CONSTANTES (sin parametros); cada uno fija su codigo.
const u64 FSCTL_READ_FILE_USN_DATA =
    CTL_CODE(FILE_DEVICE_FILE_SYSTEM, 58,  METHOD_NEITHER,  FILE_ANY_ACCESS);
const u64 FSCTL_QUERY_USN_JOURNAL =
    CTL_CODE(FILE_DEVICE_FILE_SYSTEM, 61,  METHOD_BUFFERED, FILE_ANY_ACCESS);
const u64 FSCTL_READ_UNPRIVILEGED_USN_JOURNAL =
    CTL_CODE(FILE_DEVICE_FILE_SYSTEM, 234, METHOD_NEITHER,  FILE_ANY_ACCESS);

const u64 IOCTL_USB_GET_HUB_CAPABILITIES_EX                = CTL_CODE(
    FILE_DEVICE_USB,
    USB_GET_HUB_CAPABILITIES_EX,
    METHOD_BUFFERED,
    FILE_ANY_ACCESS
);
const u64 IOCTL_USB_GET_HUB_CAPABILITIES                   = CTL_CODE(
    FILE_DEVICE_USB,
    USB_GET_HUB_CAPABILITIES,
    METHOD_BUFFERED,
    FILE_ANY_ACCESS
);
const u64 IOCTL_USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION    = CTL_CODE(
    FILE_DEVICE_USB,
    USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION,
    METHOD_BUFFERED,
    FILE_ANY_ACCESS
);
const u64 IOCTL_USB_GET_ROOT_HUB_NAME                      = CTL_CODE(
