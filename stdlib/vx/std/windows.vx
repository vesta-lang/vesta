const u32 FILE_FLAG_POSIX_SEMANTICS                      = 0x01000000;
const u32 FILE_FLAG_SESSION_AWARE                        = 0x00800000;
const u32 FILE_FLAG_OPEN_REPARSE_POINT                   = 0x00200000;
const u32 FILE_FLAG_OPEN_NO_RECALL                       = 0x00100000;
const u32 FILE_FLAG_FIRST_PIPE_INSTANCE                  = 0x00080000;

bool HasOverlappedIoCompleted(LPOVERLAPPED lpOverlapped) {
    return ((*lpOverlapped).Internal != (ULONG_PTR)STATUS_PENDING);
}


typedef struct FILE_NOTIFY_INFORMATION {
  DWORD NextEntryOffset;
  DWORD Action;
  DWORD FileNameLength;
  WCHAR FileName[1];
} FILE_NOTIFY_INFORMATION;