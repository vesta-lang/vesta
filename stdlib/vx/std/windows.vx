        CACHE_DESCRIPTOR Cache;
        ULONGLONG        Reserved[2];
    };

} SYSTEM_LOGICAL_PROCESSOR_INFORMATION, *PSYSTEM_LOGICAL_PROCESSOR_INFORMATION;


