/* Registry Access Rights */
const u32 KEY_QUERY_VALUE                     = 0x0001;
const u32 KEY_SET_VALUE                       = 0x0002;
const u32 KEY_CREATE_SUB_KEY                  = 0x0004;
const u32 KEY_ENUMERATE_SUB_KEYS              = 0x0008;
const u32 KEY_NOTIFY                          = 0x0010;
const u32 KEY_CREATE_LINK                     = 0x0020;
const u32 KEY_WOW64_32KEY                     = 0x0200;
const u32 KEY_WOW64_64KEY                     = 0x0100;
const u32 KEY_WOW64_RES                       = 0x0300;

const u32 KEY_READ                            = (
    (
        STANDARD_RIGHTS_READ    | 
        KEY_QUERY_VALUE         | 
        KEY_ENUMERATE_SUB_KEYS  | 
        KEY_NOTIFY
    ) & (~SYNCHRONIZE)
);

const u32 KEY_WRITE                           = (
    (
        STANDARD_RIGHTS_WRITE   |
        KEY_SET_VALUE           |
        KEY_CREATE_SUB_KEY
    ) & (~SYNCHRONIZE)
);

const u32 KEY_EXECUTE                         = ((KEY_READ) & (~SYNCHRONIZE));

const u32 KEY_ALL_ACCESS                      = (
    (
        STANDARD_RIGHTS_ALL     |
        KEY_QUERY_VALUE         |
        KEY_SET_VALUE           |
        KEY_CREATE_SUB_KEY      |
        KEY_ENUMERATE_SUB_KEYS  |
        KEY_NOTIFY              |
        KEY_CREATE_LINK
    ) & (~SYNCHRONIZE)
);


