    METHOD_BUFFERED,
    FILE_ANY_ACCESS
);

// HID report IOCTLs: en C son macros parametrizados `HID_*_CTL_CODE(id)`; aqui
// funciones comptime que se pliegan en cada uso.
comptime u64 HID_CTL_CODE(u64 id) {
    return CTL_CODE(FILE_DEVICE_KEYBOARD, id, METHOD_NEITHER, FILE_ANY_ACCESS);
}
comptime u64 HID_BUFFER_CTL_CODE(u64 id) {
    return CTL_CODE(FILE_DEVICE_KEYBOARD, id, METHOD_BUFFERED, FILE_ANY_ACCESS);
}
comptime u64 HID_IN_CTL_CODE(u64 id) {
    return CTL_CODE(FILE_DEVICE_KEYBOARD, id, METHOD_IN_DIRECT, FILE_ANY_ACCESS);
}
comptime u64 HID_OUT_CTL_CODE(u64 id) {
    return CTL_CODE(FILE_DEVICE_KEYBOARD, id, METHOD_OUT_DIRECT, FILE_ANY_ACCESS);
}

const u64 IOCTL_HID_GET_FEATURE                   = HID_OUT_CTL_CODE(100);
const u64 IOCTL_HID_GET_INPUT_REPORT              = HID_OUT_CTL_CODE(104);
const u64 IOCTL_HID_SET_FEATURE                   = HID_IN_CTL_CODE(100);
