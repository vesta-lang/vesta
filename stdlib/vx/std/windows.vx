/* Language ID: */
comptime WORD MAKELANGID(u16 p, u16 s) {
    return ((s << 10) | p);
}
comptime WORD PRIMARYLANGID(u16 lgid) {
    return (lgid & 0x3ff);
}
comptime WORD SUBLANGID(u16 lgid) {
    return (lgid >> 10);
}

