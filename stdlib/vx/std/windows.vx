    LONG       DaylightBias;
} TIME_ZONE_INFORMATION, *PTIME_ZONE_INFORMATION;
typedef PTIME_ZONE_INFORMATION LPTIME_ZONE_INFORMATION;

comptime u32 _byteswap_ulong(u32 x) {
    return (((u32)(x) << 24) |
            (((u32)(x) << 8) & 0xff0000) |
            (((u32)(x) >> 8) & 0xff00) |
            ((u32)(x) >> 24));
}

comptime u64 _byteswap_uint64(u64 x) {
    return (((u64)(x) << 56) |
            (((u64)(x) << 40) & 0xff000000000000ULL) |
            (((u64)(x) << 24) & 0xff0000000000ULL) |
            (((u64)(x) << 8)  & 0xff00000000ULL) |
            (((u64)(x) >> 8)  & 0xff000000ULL) |
            (((u64)(x) >> 24) & 0xff0000ULL) |
            (((u64)(x) >> 40) & 0xff00ULL) |
            ((u64)(x)  >> 56));
}



