/* Value for magic header */
const u32 FOURCC_DDS        = (0x20534444);

/* Values for DDS_PIXELFORMAT.dwFlags */
const u32 DDPF_FOURCC       = (0x00000004);




/* CreateFile.dwShareMode Enums: */
const u32 FILE_SHARE_DELETE           = 0x00000004;
const u32 FILE_SHARE_READ             = 0x00000001;
const u32 FILE_SHARE_WRITE            = 0x00000002;

/* Generic Access Rights: */
const u32 GENERIC_READ                = 0x80000000L;
const u32 GENERIC_WRITE               = 0x40000000L;
const u32 GENERIC_EXECUTE             = 0x20000000L;
const u32 GENERIC_ALL                 = 0x10000000L;

/* Standard Access Rights: */
const u32 DELETE                      = 0x00010000L;
const u32 READ_CONTROL                = 0x00020000L;
const u32 WRITE_DAC                   = 0x00040000L;
const u32 WRITE_OWNER                 = 0x00080000L;
const u32 SYNCHRONIZE                 = 0x00100000L;

const u32 STANDARD_RIGHTS_REQUIRED    = 0x000F0000L;

const u32 STANDARD_RIGHTS_READ        = READ_CONTROL;
const u32 STANDARD_RIGHTS_WRITE       = READ_CONTROL;
const u32 STANDARD_RIGHTS_EXECUTE     = READ_CONTROL;

const u32 STANDARD_RIGHTS_ALL         = 0x001F0000L;
const u32 SPECIFIC_RIGHTS_ALL         = 0x0000FFFFL;

/* Commulated Access Rights: */
const u32 FILE_READ_DATA              = 0x0001;
const u32 FILE_LIST_DIRECTORY         = 0x0001;
const u32 FILE_WRITE_DATA             = 0x0002;
const u32 FILE_ADD_FILE               = 0x0002;
const u32 FILE_APPEND_DATA            = 0x0004;
const u32 FILE_ADD_SUBDIRECTORY       = 0x0004;
const u32 FILE_CREATE_PIPE_INSTANCE   = 0x0004;
const u32 FILE_READ_EA                = 0x0008;
const u32 FILE_WRITE_EA               = 0x0010;
const u32 FILE_EXECUTE                = 0x0020;
const u32 FILE_TRAVERSE               = 0x0020;
const u32 FILE_DELETE_CHILD           = 0x0040;
const u32 FILE_READ_ATTRIBUTES        = 0x0080;
const u32 FILE_WRITE_ATTRIBUTES       = 0x0100;
const u32 FILE_ALL_ACCESS             = (
    STANDARD_RIGHTS_REQUIRED | SYNCHRONIZE | 0x1FF
);

const u32 FILE_GENERIC_READ           = (
    STANDARD_RIGHTS_READ |
    FILE_READ_DATA |
    FILE_READ_ATTRIBUTES |
    FILE_READ_EA |
    SYNCHRONIZE
);

const u32 FILE_GENERIC_WRITE          = (
    STANDARD_RIGHTS_WRITE |
    FILE_WRITE_DATA |
    FILE_WRITE_ATTRIBUTES |
    FILE_WRITE_EA |
    FILE_APPEND_DATA |
    SYNCHRONIZE
);

const u32 FILE_GENERIC_EXECUTE        = (
    STANDARD_RIGHTS_EXECUTE |
    FILE_READ_ATTRIBUTES |
    FILE_EXECUTE |
    SYNCHRONIZE
);

/* Creation Disposition: */
const u32 CREATE_ALWAYS               = 2;
const u32 CREATE_NEW                  = 1;
const u32 OPEN_ALWAYS                 = 4;
const u32 OPEN_EXISTING               = 3;
const u32 TRUNCATE_EXISTING           = 5;

/* File Attributes: */
const u32 INVALID_FILE_ATTRIBUTES      = 0xffffffff;
const u32 FILE_ATTRIBUTE_HIDDEN        = 0x2;
const u32 FILE_ATTRIBUTE_NORMAL        = 0x80;
const u32 FILE_ATTRIBUTE_DIRECTORY     = 0x10;
const u32 FILE_ATTRIBUTE_TEMPORARY     = 0x100;
const u32 FILE_ATTRIBUTE_REPARSE_POINT = 0x400;

/* File Offsets: */
const u32 FILE_BEGIN                  = 0;
const u32 FILE_CURRENT                = 1;
const u32 FILE_END                    = 2;

/* File Mapping: */
const u32 SECTION_QUERY                   = 0x0001;
const u32 SECTION_MAP_WRITE               = 0x0002;
const u32 SECTION_MAP_READ                = 0x0004;
const u32 SECTION_MAP_EXECUTE             = 0x0008;
const u32 SECTION_EXTEND_SIZE             = 0x0010;
const u32 SECTION_MAP_EXECUTE_EXPLICIT    = 0x0020;
const u32 SECTION_ALL_ACCESS              = (
    STANDARD_RIGHTS_REQUIRED |
    SECTION_QUERY |
    SECTION_MAP_WRITE |
    SECTION_MAP_READ |
    SECTION_MAP_EXECUTE |
    SECTION_EXTEND_SIZE
);

const u32 FILE_MAP_COPY                   = SECTION_QUERY;
const u32 FILE_MAP_WRITE                  = SECTION_MAP_WRITE;
const u32 FILE_MAP_READ                   = SECTION_MAP_READ;
