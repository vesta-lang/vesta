const u32 CONTEXT_FULL                        = (
    CONTEXT_CONTROL | CONTEXT_INTEGER | CONTEXT_FLOATING_POINT
);

const u32 CONTEXT_ALL                         = (
    CONTEXT_CONTROL |
    CONTEXT_INTEGER |
    CONTEXT_SEGMENTS |
    CONTEXT_FLOATING_POINT |
    CONTEXT_DEBUG_REGISTERS 
);

