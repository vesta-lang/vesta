/* Window: */
// WNDPROC: en C es `LRESULT (CALLBACK *)(HWND, UINT, WPARAM, LPARAM)`.  En x64
// la convencion CALLBACK (__stdcall) coincide con la unica ABI; se modela con
// el puntero a funcion crudo de Vesta `cfn(...) -> R`.
typedef cfn(HWND, UINT, WPARAM, LPARAM) -> LRESULT WNDPROC;
typedef struct tagWNDCLASS {
    UINT        style;
    WNDPROC     lpfnWndProc;
    int         cbClsExtra;
    int         cbWndExtra;
    HINSTANCE   hInstance;
    HICON       hIcon;
    HCURSOR     hCursor;
    HBRUSH      hbrBackground;
    LPCTSTR     lpszMenuName;
    LPCTSTR     lpszClassName;
} WNDCLASS, *PWNDCLASS;

/* Messages: */
typedef struct tagPOINT {
  LONG x;
  LONG y;
} POINT, *PPOINT;

typedef struct tagMSG {
    HWND        hwnd;
    UINT        message;
    WPARAM      wParam;
    LPARAM      lParam;
    DWORD       time;
    POINT       pt;
} MSG, *PMSG, *LPMSG;

// GetCurrentFiber: el puntero al fibra actual vive en el TEB.  En x64 esta en
// gs:[0x20]; en x86 en fs:[0x10].  Se seleccionan con @Target a nivel de
// declaracion (la conmutacion condicional por arch es por-declaracion, no por
// statement): se compila solo la definicion cuyo @Target casa con el objetivo.
@Target("arch:x86_64")
PVOID GetCurrentFiber() {
    asm volatile {
        mov rax, gs:[0x20]
        ret
    }
}

@Target("arch:x86")
PVOID GetCurrentFiber() {
    asm volatile {
        mov rax, fs:[0x10]
        ret
    }
}

PVOID GetFiberData() {
    return *(PVOID *)GetCurrentFiber();
}

