namespace std.comptime.literal;

/**
 * @file literal.vx
 * @brief Parser de literales enteros de ANCHO ARBITRARIO en tiempo de
 *        compilacion (base de u128/u256/u512/BigInt).
 *
 * El constructor `comptime T(expr)` de un tipo de usuario captura el TEXTO crudo
 * del literal y lo pasa a @ref parse_int_lit, que ejecuta aritmetica multi-word
 * real en la ComptimeVM (acumula digito a digito con acarreo) y devuelve un
 * @ref IntLit.  El helper es NEUTRO respecto al tipo destino: acumula en un
 * buffer de words de ancho arbitrario (malloc envuelto en `unique`, RAII) y
 * expone accessors semanticos.  El ctor del tipo (que conoce su representacion)
 * mapea `word(i)` a sus campos; los words fuera de su ancho zero-extienden.
 */

/**
 * @brief Resultado del parser: un entero de ancho arbitrario en words de 64 bits.
 *
 * Los words se guardan en little-endian (word 0 = los 64 bits menos
 * significativos) en un buffer gestionado por RAII.  El signo se guarda como
 * MAGNITUD + flag; el ctor del tipo decide la representacion (complemento a 2
 * si es signed y negativo).
 */
public struct IntLit {
	/// Buffer de words (little-endian).  `unique` -> se libera al salir del
	/// scope comptime; sin fugas.
	unique<u64> words;
	/// Numero de words significativos (>= 1).
	i64 n_words;
	/// True si el literal llevaba un signo '-' (magnitud en @ref words).
	bool negative;

	/**
	 * @brief Word i-esimo, zero-extendiendo mas alla del ancho representado.
	 * @param i Indice del word.
	 * @return El word i-esimo (0 si @p i esta fuera de @ref n_words).
	 */
	u64 word(i64 i) {
		if (i >= 0 && i < this.n_words) {
			return this.words[i];
		}
		return 0;
	}

	/** @brief Numero de words significativos. */
	i64 word_count() {
		return this.n_words;
	}

	/** @brief True si el literal era negativo. */
	bool is_negative() {
		return this.negative;
	}

	/**
	 * @brief Bits significativos (posicion del bit 1 mas alto + 1).
	 * @return El ancho en bits de la magnitud (0 para el valor 0).
	 */
	u64 bit_width() {
		if (this.n_words == 0) {
			return 0;
		}
		i64 hi   = this.n_words - 1;
		u64 w    = this.words[hi];
		u64 bits = (u64) hi * 64;
		while (w != 0) {
			bits = bits + 1;
			w    = w >> 1;
		}
		return bits;
	}
}

/**
 * @brief Parsea un literal entero (decimal, `0x`-hex, con `-` opcional) a un
 *        @ref IntLit de ancho arbitrario.
 *
 * Ejecucion comptime real: recorre el texto acumulando `buf = buf * base + d`
 * con acarreo multi-word (split de 32 bits para evitar el overflow de
 * `word * base`).  Neutro respecto al tipo destino.
 *
 * @param src Texto del literal.
 * @return El valor parseado.
 */
/// Mensaje del digito que no pertenece a la base declarada.
/// Mensaje del literal sin digitos (`0x` a secas, o cadena vacia).
const string VX_LITERAL_VACIO =
	"literal entero sin digitos: falta el numero tras el prefijo de base";
/// Mensaje del digito que no pertenece a la base declarada.
const string VX_LITERAL_DIGITO =
	"digito que no pertenece a la base del literal (0b binario, 0o octal, "
	"0x hexadecimal, sin prefijo decimal)";

public comptime IntLit parse_int_lit(string src) {
	i64  n    = src.length();
	i64  base = 10_i64;
	i64  i    = 0_i64;
	bool neg  = false;
	// Signo opcional.
	if (n >= 1) {
		i64 c0 = ord(substr(src, 0, 1));
		if (c0 == 45) { // '-'
			neg = true;
			i   = 1;
		}
	}
	// Prefijo de base opcional, en minuscula o mayuscula: 0b/0o/0x.  Sin
	// prefijo la base es 10.  El `0` suelto (sin letra detras) es el numero
	// cero en decimal, no un prefijo trunco.
	if (n - i >= 2) {
		i64 p0 = ord(substr(src, i, 1));
		i64 p1 = ord(substr(src, i + 1, 1));
		if (p0 == 48) {                 // '0'
			if (p1 == 98 || p1 == 66) { // 'b' / 'B'
				base = 2;
				i    = i + 2;
			} else if (p1 == 111 || p1 == 79) { // 'o' / 'O'
				base = 8;
				i    = i + 2;
			} else if (p1 == 120 || p1 == 88) { // 'x' / 'X'
				base = 16;
				i    = i + 2;
			}
		}
	}
	// Un prefijo sin digitos detras (`0x` a secas) no es un numero.
	static_assert(i < n, VX_LITERAL_VACIO);
	// Buffer de words: `n` words siempre sobra para `n` digitos.
	i64 cap = n;
	if (cap < 1) {
		cap = 1;
	}
	unique<u64> buf = unique_with(malloc(cap * 8), free);
	i64         z   = 0_i64;
	while (z < cap) {
		buf[z] = 0;
		z      = z + 1;
	}
	i64 nw = 1_i64;
	// Acumular digito a digito: buf = buf * base + d, con acarreo multi-word.
	while (i < n) {
		i64 c =  ord(substr(src, i, 1));
		i64 d = -1_i64;
		if (c >= 48 && c <= 57) {
			d = c - 48; // '0'..'9'
		} else if (c >= 97 && c <= 102) {
			d = c - 87; // 'a'..'f'
		} else if (c >= 65 && c <= 70) {
			d = c - 55; // 'A'..'F'
		}
		// El `_` separa grupos de digitos y no aporta valor.  Cualquier OTRO
		// caracter, o un digito que no pertenece a la base (un 9 en octal, una
		// 'f' en decimal), es un error: aceptarlo callando daria un numero
		// distinto del escrito sin que nadie se entere.
		if (c != 95) {
			static_assert(d >= 0 && d < base, VX_LITERAL_DIGITO);
		}
		if (c != 95) {
			static_assert(d >= 0 && d < base, VX_LITERAL_DIGITO);
		}
		if (d >= 0 && c != 95) {
			u64 carry = (u64) d;
			i64 k     = 0_i64;
			while (k < nw) {
				// w * base + carry sin overflow: split en mitades de 32 bits.
				u64 w  = buf[k];
				u64 lo = (w & 0xFFFFFFFF) * (u64) base + (carry & 0xFFFFFFFF);
				u64 hi = (w >> 32) * (u64) base + (lo >> 32) + (carry >> 32);
				buf[k] = (lo & 0xFFFFFFFF) | (hi << 32);
				carry  = hi >> 32;
				k      = k + 1;
			}
			// El acarreo abre un word nuevo mientras quepa.
			if (carry != 0 && nw < cap) {
				buf[nw] = carry;
				nw      = nw + 1;
			}
		}
		i = i + 1;
	}
	IntLit r;
	r.words    = move(buf);
	r.n_words  = nw;
	r.negative = neg;
	return r;
}
