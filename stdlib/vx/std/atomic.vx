/**
 * @file atomic.vx
 * @brief Operaciones ATOMICAS multi-arquitectura para Vesta, en Vesta puro,
 *        SIN libc.  Libreria de bajo nivel reutilizable por CUALQUIER otra
 *        (vx_mem, vx_sync, pool, colecciones concurrentes, ...).
 *
 * @par Independiente del OS, dependiente de la ARQUITECTURA
 * Los atomicos son primitivas de la CPU (no del SO): las mismas instrucciones
 * valen en Windows, Linux, macOS, bare-metal.  Por eso las variantes se targetean
 * por `@Target("arch:...")`, NO por OS.  Hoy: x86-64 (completo).  arm64 incluido
 * (gated; se activa cuando aterrice el backend AArch64).  x86-32/x86-16: los
 * atomicos de 64 bits necesitan `cmpxchg8b`; follow-up (los de 32 bits nativos).
 *
 * @par Modelo de memoria
 * En x86-64 (TSO) las RMW con prefijo `lock` (cmpxchg/xadd/xchg) son barreras
 * COMPLETAS.  Un load/store alineado de 8 bytes ya es atomico; se exponen como
 * LLAMADAS opacas -> ademas actuan de barrera del COMPILADOR (no se reordenan
 * accesos a memoria a traves de ellas).  Para el StoreLoad explicito esta
 * @ref atomic_fence (mfence).  En arm64 se usan ldaxr/stlxr (acquire/release)
 * + `dmb ish`.
 *
 * @par API (todas sobre i64* host_ptr ALINEADO a 8)
 *   atomic_load64  / atomic_store64   -- load/store atomico + barrera compilador
 *   atomic_cas64                         -- compare-and-swap, devuelve el OLD
 *   atomic_add64   / atomic_sub64     -- fetch-and-add/sub, devuelve el OLD
 *   atomic_swap64                        -- exchange, devuelve el OLD
 *   atomic_or64    / atomic_and64     -- fetch-and-or/and (via CAS), OLD
 *   atomic_fence                         -- barrera de memoria completa (StoreLoad)
 *   vx_cpu_relax                            -- hint de spin (pause / yield)
 *
 * @par Contratos declarados (los verifica el compilador; `vm --analyze`)
 * Todas declaran `@nothrow @nopanic @alloc(partial: 0, total: 0)`: no lanzan, no hacen panic y no
 * alocan.  Son las propiedades que las hacen usables desde donde no hay heap ni
 * runtime (freestanding, un ISR, el interior de un allocator, un spinlock).
 *
 * El `@stack` tiene DOS dimensiones: PARCIAL (marco propio de la funcion) y
 * TOTAL (parcial + la cadena de llamadas mas honda).  Las TRES primitivas de
 * asm (cas/add/swap) tienen DOS cuerpos por `@Target`: el de x86-64 son
 * builtins puros (`@stack(partial: 0, total: 0)`), el de arm64 gasta pila por
 * los `register()` + el asm ldaxr/stlxr (`@stack(partial: 24, total: 24)` /
 * `@stack(partial: 32, total: 32)`) -- frame INCONDICIONAL (solo se compila el
 * de su arch).  Las compuestas (sub/or/and/xor) y los metodos wrapper del
 * struct tienen PARCIAL 0 (su cuerpo solo llama) pero TOTAL per-arch: en x86-64
 * la primitiva no gasta pila (`total 0`), en arm64 heredan el marco de la
 * primitiva de asm que alcanzan (`total 24` si llegan a add/swap64, `total 32`
 * si a cas64).  Todo MEDIDO por --analyze: el parcial es el cuerpo propio (sin
 * contar el inline) y el total lo compone el call-graph -- para una primitiva
 * de asm (marco opaco al IR) usa su @stack declarado.
 *
 * NINGUNA declara `@pure`, y es a proposito: un atomico LEE o MUTA memoria
 * compartida, que es justo su razon de ser.  El verificador lo confirma
 * (`pure=false` en las catorce), asi que declararlo seria mentir y ademas
 * autorizaria al optimizador a hacer CSE de dos `load` sobre el mismo `addr`
 * -- exactamente lo que un atomico no puede permitir.
 *
 * `@complexity(O(1))` va donde el coste es de verdad constante: las que bajan a
 * UNA instruccion (`load/store/cas/add/sub/fence/relax/trylock/unlock`).  Las
 * compuestas sobre un bucle CAS (`swap/or/and/xor` y `spin_lock`) declaran
 * `@complexity(O(n))`, donde la n son los REINTENTOS: sin contencion el CAS
 * triunfa a la primera (O(1) amortizado), con ella el bucle no esta acotado.
 * Declararlas O(1) seria una discrepancia, y el verificador la caza.
 */

namespace std.atomic;

// ===========================================================================
//  x86 (64 y 32 bits): lock cmpxchg / lock xadd / xchg / mfence / pause.
// ===========================================================================

// Los primitivos de 64 bits (cas/add/load/store) usan los BUILTINS del lenguaje
// (atomic_cas_i64/atomic_add_i64/atomic_load_i64/atomic_store_i64): el backend
// (interp/JIT/AOT) los baja a la instruccion x86 atomica nativa (lock cmpxchg /
// lock xadd / mov) con el regalloc gestionando los registros -> SIN inline-asm
// (que en Win64 corrompia un valor vivo del caller: rsi/rdi/r8... como scratch
// del asm no se modelaban como clobber).  Interfaz amigable + composable encima.
//
// Valen IGUAL en 32 bits: el backend ya sabe operar 64 bits ahi (verificado con
// valores cuya mitad ALTA no se conoce al compilar, que es lo unico que
// distingue un i64 de verdad de uno que cabe en 32).  `mfence` y `pause` existen
// en modo protegido, asi que la seccion entera sirve para las dos.  Antes solo
// estaba declarada para x86_64, y eso dejaba el slab allocator sin compilar en
// 32 bits -- con el, cualquier programa que usara malloc.

/// CAS de 64 bits: si `*addr == expected` escribe `desired`.  Devuelve el valor
/// ANTIGUO (== expected si triunfo).  Barrera completa (lock cmpxchg).
@Target("arch:x86_64 || arch:x86")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_cas64(i64* addr, i64 expected, i64 desired) {
	return atomic_cas_i64(addr, expected, desired);
}

/// fetch-and-add de 64 bits.  Devuelve el valor ANTIGUO (lock xadd).
@Target("arch:x86_64 || arch:x86")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_add64(i64* addr, i64 delta) {
	return atomic_add_i64(addr, delta);
}

/// exchange atomico.  Devuelve el valor ANTIGUO.  COMPUESTO sobre CAS (no hay
/// builtin de swap): bucle CAS hasta triunfar.  La n son los REINTENTOS: sin
/// contencion el CAS triunfa a la primera (O(1) amortizado).
@Target("arch:x86_64 || arch:x86")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(n),
	partial_post: O(n),
	total_pre:    O(n),
	total_post:   O(n)
)
	public i64 atomic_swap64(i64* addr, i64 v) {
	i64 old = atomic_load_i64(addr);
	while (atomic_cas_i64(addr, old, v) != old) {
		old = atomic_load_i64(addr);
	}
	return old;
}

/// Load atomico de 64 bits (mov alineado ya es atomico; acquire gratis en TSO).
@Target("arch:x86_64 || arch:x86")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_load64(i64* addr) {
	return atomic_load_i64(addr);
}

/// Store atomico de 64 bits (mov alineado; release en x86-TSO).
@Target("arch:x86_64 || arch:x86")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public void atomic_store64(i64* addr, i64 v) {
	atomic_store_i64(addr, v);
}

/// Barrera de memoria COMPLETA (StoreLoad; x86 solo reordena Store->Load).
@Target("arch:x86_64 || arch:x86")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public void atomic_fence() {
	asm { mfence };
}

/// Hint de spin para un bucle de espera activa (`pause`).
@Target("arch:x86_64 || arch:x86")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public void vx_cpu_relax() {
	asm { pause };
}

// ===========================================================================
//  arm64 (AArch64): ldaxr/stlxr (acquire/release) + dmb ish + yield.
//  GATED por @Target: no se compila en builds x86.  Listo para el backend
//  AArch64 (aun no aterrizado); el asm es opaco hasta que Keystone lo ensamble
//  en modo ARM64, cosa que solo ocurre al compilar para esa arquitectura.
// ===========================================================================

/// CAS de 64 bits.  El `cbnz` reintenta solo si el store-exclusive fallo por
/// interferencia -- es el LL/SC nativo, la operacion sigue siendo una: O(1).
@Target("arch:arm64")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
// Frame propio: los register("x0".."x3") + el asm ldaxr/stlxr gastan pila que
// la variante x86-64 (builtins puros) no.  Medido por --analyze en arm64.
@stack(partial: 32, total: 32)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_cas64(i64* addr, i64 expected, i64 desired) {
	register("x0") i64* a   = addr;
	register("x1") i64  ex  = expected;
	register("x2") i64  de  = desired;
	register("x3") i64  out = 0_i64;
	asm volatile {
		__vxat_cas_retry:
		    ldaxr x3, [x0]
		    cmp x3, x1
		    b.ne __vxat_cas_done
		    stlxr w4, x2, [x0]
		    cbnz w4, __vxat_cas_retry
		__vxat_cas_done:
	};
	return out; // x3 = old
}

/// fetch-and-add.  LL/SC nativo (ver cas64): O(1).
@Target("arch:arm64")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 24, total: 24) // los register + asm gastan frame que la variante x86-64 no
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_add64(i64* addr, i64 delta) {
	register("x0") i64* a   = addr;
	register("x1") i64  d   = delta;
	register("x3") i64  out = 0_i64;
	asm volatile {
		__vxat_add_retry:
		    ldaxr x3, [x0]
		    add x5, x3, x1
		    stlxr w4, x5, [x0]
		    cbnz w4, __vxat_add_retry
	};
	return out; // x3 = old
}

/// exchange.  A diferencia de la de x86 (bucle CAS escrito en Vesta), aqui es
/// el LL/SC nativo (ver cas64): O(1).
@Target("arch:arm64")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 24, total: 24) // los register + asm gastan frame que la variante x86-64 no
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_swap64(i64* addr, i64 v) {
	register("x0") i64* a   = addr;
	register("x1") i64  nv  = v;
	register("x3") i64  out = 0_i64;
	asm volatile {
		__vxat_swap_retry:
		    ldaxr x3, [x0]
		    stlxr w4, x1, [x0]
		    cbnz w4, __vxat_swap_retry
	};
	return out; // x3 = old
}

@Target("arch:arm64")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_load64(i64* addr) {
	return *addr;
}
@Target("arch:arm64")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public void atomic_store64(i64* addr, i64 v) {
	*addr = v;
}
@Target("arch:arm64")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public void atomic_fence() {
	asm volatile { dmb ish };
}
@Target("arch:arm64")
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public void vx_cpu_relax() {
	asm volatile { yield };
}

// ===========================================================================
//  Compuestas ARCH-INDEPENDIENTES (sobre cas/add/load) -> una sola definicion.
// ===========================================================================

/// fetch-and-sub: `*addr -= delta`; devuelve el OLD.  Sobre add64 con -delta.
/// Un solo cuerpo, pero la primitiva que llama difiere por arch (x86: builtins;
/// arm64: register+asm), asi que su frame propio tambien -> `when:`.
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 atomic_sub64(i64* addr, i64 delta) {
	return atomic_add64(addr, -delta);
}

/// fetch-and-or: `*addr |= mask`; devuelve el OLD.  Bucle CAS -> O(n) sobre los
/// REINTENTOS: sin contencion el CAS triunfa a la primera (O(1) amortizado).
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(n),
	partial_post: O(n),
	total_pre:    O(n),
	total_post:   O(n)
)
	public i64 atomic_or64(i64* addr, i64 mask) {
	while (true) {
		i64 old = atomic_load64(addr);
		if (atomic_cas64(addr, old, old | mask) == old) {
			return old;
		}
		vx_cpu_relax();
	}
}

/// fetch-and-and: `*addr &= mask`; devuelve el OLD.  Bucle CAS -> O(n) sobre los
/// REINTENTOS: sin contencion el CAS triunfa a la primera (O(1) amortizado).
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(n),
	partial_post: O(n),
	total_pre:    O(n),
	total_post:   O(n)
)
	public i64 atomic_and64(i64* addr, i64 mask) {
	while (true) {
		i64 old = atomic_load64(addr);
		if (atomic_cas64(addr, old, old & mask) == old) {
			return old;
		}
		vx_cpu_relax();
	}
}

/// fetch-and-xor: `*addr ^= mask`; devuelve el OLD.  Bucle CAS.  Cierra el set
/// completo (add/sub/or/and/xor/swap/cas): con or y and pero sin xor, un toggle
/// de bits habia que escribirlo a mano.  O(n) sobre los REINTENTOS: sin
/// contencion el CAS triunfa a la primera (O(1) amortizado).
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(n),
	partial_post: O(n),
	total_pre:    O(n),
	total_post:   O(n)
)
	public i64 atomic_xor64(i64* addr, i64 mask) {
	while (true) {
		i64 old = atomic_load64(addr);
		if (atomic_cas64(addr, old, old ^ mask) == old) {
			return old;
		}
		vx_cpu_relax();
	}
}

// ===========================================================================
//  Spinlock minimo construido sobre los atomicos (util para las libs).
//  0 = libre, 1 = tomado.  No reentrante.
// ===========================================================================

/// Toma el spinlock en `*lock` (0->1) con backoff `pause`.  O(n) sobre las
/// VUELTAS de espera: depende de cuanto lo retenga el que lo tiene, no de una
/// entrada.  Sin competencia entra a la primera (O(1) amortizado).
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(n),
	partial_post: O(n),
	total_pre:    O(n),
	total_post:   O(n)
)
	public void vx_spin_lock(i64* lock) {
	while (atomic_cas64(lock, 0, 1) != 0) {
		vx_cpu_relax();
	}
}

/// Libera el spinlock (`*lock = 0`, release).
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public void vx_spin_unlock(i64* lock) {
	atomic_store64(lock, 0);
}

/// Intenta tomar el spinlock sin bloquear.  1 = tomado, 0 = estaba ocupado.
@nothrow
@nopanic
@alloc(partial: 0, total: 0)
@stack(partial: 0, total: 0)
@complexity(
	partial_pre:  O(1),
	partial_post: O(1),
	total_pre:    O(1),
	total_post:   O(1)
)
	public i64 vx_spin_trylock(i64* lock) {
	if (atomic_cas64(lock, 0, 1) == 0) {
		return 1;
	}
	return 0;
}

// ===========================================================================
//  atomic<T>: la interfaz de arriba, con la sintaxis de una variable normal.
// ===========================================================================
//
// Envuelve una celda de 64 bits y sobrecarga los operadores para que CADA uno
// sea una operacion atomica.  Se escribe como un entero cualquiera:
//
//     atomic<i64> g;
//     g = 0;              // store atomico
//     g += 1;             // lock xadd -- indivisible
//     g = g + 1;          // lo MISMO: el compilador funde el read-modify-write
//     g++;                // lo mismo
//     i64 v = *g;         // load atomico
//
// Las tres formas del incremento bajan al mismo `lock xadd`.  En C++ la larga
// (`g = g + 1`) compila y es una carrera silenciosa -- tres pasos con sitio
// para otro hilo en medio; aqui el compilador ve que las dos `g` son la misma
// posicion y las funde (ver [[Operadores]], fusion read-modify-write).
//
// Cero coste frente a llamar a `atomic_add64` a mano: los metodos de un
// struct se despachan estaticamente y se inlinean, asi que `g += 1` emite la
// instruccion atomica y nada mas -- sin llamada, sin objeto intermedio.
//
// Lo que NO declara es tan importante como lo que declara: sin `__add__` ni
// comparaciones, un `g < n` o un `g + h` no compilan.  Son operaciones que NO
// pueden ser atomicas (dos lecturas separadas), y el compilador prefiere
// decirlo a dejar pasar codigo que parece atomico y no lo es.  Para eso esta el
// load explicito: `*g < n`, `*g + *h`.
//
// La celda es del tipo T EXACTO: un `atomic<i64>` ocupa 8 bytes y ni uno mas.
// El tipo no miente sobre su ancho ni sobre su alineacion.
//
// @par Que anchos se admiten: lo decide la INTROSPECCION, en comptime
// Una operacion atomica existe para los anchos que la CPU sabe hacer
// indivisibles, no para cualquier tipo.  En vez de fijar un ancho y castear
// (que gastaria memoria y mentiria), cada metodo pregunta por `sizeof<T>()` y
// elige.  Si no hay operacion para ese ancho, `static_assert` para la
// compilacion con un mensaje que dice por que -- nunca se emite un atomico que
// no lo sea.
//
// Hoy el unico ancho con primitiva es 8 bytes (`lock cmpxchg`/`lock xadd` de 64
// bits).  La CPU tambien los tiene de 1/2/4, y de 16 con `cmpxchg16b`; cuando
// esas primitivas aterricen, este mismo `static_assert` se abre y el resto del
// tipo no cambia.  Ese es el sitio unico donde se toca.
//
// @par Coste
// Cero frente a llamar a `atomic_add64` a mano: los metodos de un struct se
// despachan estaticamente y se inlinean, asi que `g += 1` emite la instruccion
// atomica y nada mas -- sin llamada, sin objeto intermedio.  El chequeo de
// ancho es comptime: no queda ni rastro en el binario.
//
// @par Lo que NO declara
// Es tan importante como lo que declara: sin `__add__` ni comparaciones, un
// `g < n` o un `g + h` no compilan.  Son operaciones que NO pueden ser atomicas
// (dos lecturas separadas), y el compilador prefiere decirlo a dejar pasar
// codigo que parece atomico y no lo es.  Para eso esta el load explicito:
// `*g < n`, `*g + *h`.
//
// Los metodos usan los wrappers `atomic_*` de arriba, no los builtins: asi
// `atomic<T>` hereda gratis el gating por `@Target("arch:...")` -- en arm64 los
// wrappers son ldaxr/stlxr y el struct no se entera.
// El bound del tipo es el concepto built-in `Scalar` (entero|float|bool|
// puntero): lo que la CPU sabe leer, escribir e intercambiar de una pieza.  Un
// struct o una clase no entran -- caben en la celda, pero `lock cmpxchg` sobre
// ellos no significa nada.  `Scalar` es un concepto UNIVERSAL del lenguaje: vive
// en el compilador, no aqui (ver doc/VMdoc/Vex/Conceptos.md).
//
// Que METODOS existen para cada T lo decide la clausula `where` de cada uno
// (disponibilidad condicional, estilo Rust `impl where` / Swift `extension
// where`).  `fetch_add`/`fetch_sub` piden `where T: Numeric` (entero o float);
// los bit-ops (`fetch_or/and/xor`) piden `where T: Integer`; `fetch_max/min`
// piden `where T: Comparable`.  Los crudos (`load/store/cas/swap/exchange/
// compare_*/update`) no piden nada: valen para todo Scalar.  Asi un
// `atomic<f32>` tiene load/store/cas/swap/fetch_add pero NO fetch_or -- llamarlo
// da un error claro, no un muro de instanciacion -- y un `atomic<bool>` solo
// load/store/cas/swap.  El `where` es compile-time: cero codigo emitido.
//
// El limite de HOY -- que solo hay primitivas de 1/2/4/8 bytes -- vive en el
// `static_assert` de ancho de cada metodo; cuando aterrice el de 16 (cmpxchg16b)
// se abre ese assert y este tipo no cambia.

/// Mensaje del guard de ancho.  En un sitio: lo comparten todos los metodos.
/// Es lo UNICO que hay que tocar cuando aterrice el ancho de 16 (cmpxchg16b).
comptime string VX_ATOMIC_ANCHO =
	"atomic<T>: no hay operacion atomica para el ancho de T. " +
	"La hay para tipos de 1, 2, 4 u 8 bytes. "                 +
	"Para 16 bytes usa dos celdas o protege el valor con 'synchronized'.";

struct atomic < T : Scalar > {
	T cell;

	// Los valores cruzan a la primitiva con `bitcast`, no con el cast `(i64) v`:
	// el cast convierte el VALOR (un f64 1.5 se volveria el entero 1) y aqui hay
	// que mover los BITS tal cual.  Como `sizeof<T>() == 8` esta garantizado por
	// el guard, el bitcast es siempre legal -- y entre tipos del mismo ancho es
	// un `mov`: coste cero.  Asi un `atomic<f64>` funciona igual que un
	// `atomic<i64>` sin una sola linea de caso especial.

	/// `*g` -- load atomico (acquire en x86-TSO).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(partial: 0, total: 0)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1)
	)
		public T __deref__() {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		return atomic_load(&this.cell);
	}

	/// `g = v` -- store atomico (release en x86-TSO).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(partial: 0, total: 0)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1)
	)
		public T __assign__(T v) {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		atomic_store(&this.cell, v);
		return v;
	}
	// -----------------------------------------------------------------------
	//  fetch_*: devuelven el valor ANTERIOR.
	//
	//  Es la forma que necesitan las estructuras lock-free, y por eso son la
	//  base y no un extra.  El patron canonico de un ring buffer:
	//
	//      i64 idx = tail.fetch_add(1);   // reservo ESTA casilla, no otra
	//      buffer[idx] = x;
	//
	//  con el valor nuevo no se puede escribir: dos hilos que suman 1 obtienen
	//  el mismo "nuevo" si van a la vez, mientras que el "anterior" es distinto
	//  para cada uno -- eso es lo que reparte las casillas sin bloquear.
	//
	//  `+=` se construye sobre estos (`fetch_add(d) + d`), no al reves.
	// -----------------------------------------------------------------------

	/// Suma @p d y devuelve el valor ANTERIOR.  Entero: `lock xadd`, una
	/// instruccion.  Float: bucle CAS -- sumar dos patrones IEEE 754 como si
	/// fueran enteros no da la suma de los numeros.  El `if` lo resuelve la
	/// introspeccion en comptime: en el binario queda solo la rama que toca.
	/// De ahi que el coste dependa de T: O(1) entero, O(n) float.  El frame
	/// tambien: en arm64 el entero (una op nativa) gasta 24B y el float (bucle
	/// CAS) 32B -- se declara cada uno, no el maximo, para no perder el dato.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 24, when: arch:arm64 && is_integer<T>())
	@stack(partial: 0, total: 32, when: arch:arm64 && is_float<T>())
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1),
		when:         is_integer<T>()
	)
	@complexity(
		partial_pre:  O(n),
		partial_post: O(n),
		total_pre:    O(n),
		total_post:   O(n),
		when:         is_float<T>()
	)
		public T fetch_add(T d) where T: Numeric {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		if (is_float<T>()) {
			while (true) {
				T viejo = this.load();
				if (this.compare_exchange(viejo, viejo + d)) { return viejo; }
				vx_cpu_relax();
			}
		}
		return atomic_add(&this.cell, d); // lock xadd del ancho de T
	}

	/// Resta @p d y devuelve el valor ANTERIOR.  Ver @ref fetch_add.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 24, when: arch:arm64 && is_integer<T>())
	@stack(partial: 0, total: 32, when: arch:arm64 && is_float<T>())
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1),
		when:         is_integer<T>()
	)
	@complexity(
		partial_pre:  O(n),
		partial_post: O(n),
		total_pre:    O(n),
		total_post:   O(n),
		when:         is_float<T>()
	)
		public T fetch_sub(T d) where T: Numeric {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		if (is_float<T>()) {
			while (true) {
				T viejo = this.load();
				if (this.compare_exchange(viejo, viejo - d)) { return viejo; }
				vx_cpu_relax();
			}
		}
		return atomic_add(&this.cell, 0 - d); // lock xadd con -delta
	}

	// Los bit-ops son solo para enteros (`where T: Integer`): en un float el
	// operador `|`/`&`/`^` no esta definido.  Para operar los BITS de un float
	// (p.ej. invertir el signo de un f64 atomicamente) usa un `atomic<u64>`
	// sobre la representacion, o `fetch_update` con el calculo a mano.

	/// `|= mask`; devuelve el valor ANTERIOR.  Bucle CAS -> O(n) sobre los
	/// reintentos.  Solo enteros (`where T: Integer`).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T fetch_or(T mask) where T: Integer {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		while (true) {
			T viejo = this.load();
			if (this.compare_exchange(viejo, viejo | mask)) { return viejo; }
			vx_cpu_relax();
		}
	}

	/// `&= mask`; devuelve el valor ANTERIOR.  Bucle CAS -> O(n).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T fetch_and(T mask) where T: Integer {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		while (true) {
			T viejo = this.load();
			if (this.compare_exchange(viejo, viejo & mask)) { return viejo; }
			vx_cpu_relax();
		}
	}

	/// `^= mask`; devuelve el valor ANTERIOR.  Bucle CAS -> O(n).  Util para
	/// toggles.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T fetch_xor(T mask) where T: Integer {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		while (true) {
			T viejo = this.load();
			if (this.compare_exchange(viejo, viejo ^ mask)) { return viejo; }
			vx_cpu_relax();
		}
	}

	// -----------------------------------------------------------------------
	//  Operadores: azucar sobre los fetch_*.  Devuelven el valor NUEVO, que es
	//  lo que vale la expresion `g + d`.  Heredan el mismo `where` que su
	//  fetch_ (los aritmeticos `T: Numeric`, los de bits `T: Integer`), asi que
	//  `g |= m` solo compila para enteros -- igual que `fetch_or`.
	// -----------------------------------------------------------------------

	/// `g += d` / `g = g + d` / `g++`.  Devuelve el valor NUEVO.  Hereda el
	/// coste de fetch_add: O(1) entero, O(n) float.  Frame propio 0 (solo
	/// llama).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 24, when: arch:arm64 && is_integer<T>())
	@stack(partial: 0, total: 32, when: arch:arm64 && is_float<T>())
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1),
		when:         is_integer<T>()
	)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n),
		when:         is_float<T>()
	)
		public T __iadd__(T d) where T: Numeric { return this.fetch_add(d) + d; }

	/// `g -= d` / `g = g - d` / `g--`.  Devuelve el valor NUEVO.  Ver __iadd__.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 24, when: arch:arm64 && is_integer<T>())
	@stack(partial: 0, total: 32, when: arch:arm64 && is_float<T>())
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1),
		when:         is_integer<T>()
	)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n),
		when:         is_float<T>()
	)
		public T __isub__(T d) where T: Numeric { return this.fetch_sub(d) - d; }

	/// `g |= m` / `g = g | m`.  Devuelve el valor NUEVO.  Bucle CAS en la
	/// primitiva: cuerpo O(1) (una llamada), total O(n) (reintentos).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T __ior__(T m) where T: Integer { return this.fetch_or(m) | m; }

	/// `g &= m` / `g = g & m`.  Devuelve el valor NUEVO.  Ver __ior__.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T __iand__(T m) where T: Integer { return this.fetch_and(m) & m; }

	/// `g ^= m` / `g = g ^ m`.  Devuelve el valor NUEVO.  Ver __ior__.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T __ixor__(T m) where T: Integer { return this.fetch_xor(m) ^ m; }

	// -----------------------------------------------------------------------
	//  CAS y exchange.
	// -----------------------------------------------------------------------

	/// Compare-and-swap: si el valor es @p expected lo cambia por @p desired.
	/// Devuelve el valor ANTIGUO (== @p expected si triunfo).  Con esto se
	/// construye cualquier read-modify-write que no tenga instruccion propia
	/// (multiplicar, saturar, maximo, ...): bucle hasta triunfar.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1)
	)
		public T compare_swap(T expected, T desired) {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		return atomic_cas(&this.cell, expected, desired);
	}

	/// Exchange: escribe @p v y devuelve el valor ANTERIOR, sin condiciones.
	/// El coste depende de la ARQUITECTURA, y por eso el contrato va por arch:
	/// x86-64 no tiene builtin de swap y `atomic_swap64` es un bucle CAS
	/// escrito en Vesta (la n son los reintentos), mientras que arm64 lo hace
	/// con el LL/SC nativo, que es una operacion y ya.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 24, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n),
		when:         arch:x86_64
	)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1),
		when:         arch:arm64
	)
		public T swap(T v) {
		static_assert(sizeof<T>() == 1 || sizeof<T>() == 2 ||
			sizeof<T>() == 4 || sizeof<T>() == 8,
			VX_ATOMIC_ANCHO);
		// Sin builtin de swap generico: bucle CAS width-aware.
		while (true) {
			T viejo = this.load();
			if (this.compare_exchange(viejo, v)) { return viejo; }
			vx_cpu_relax();
		}
	}

	/// Como @ref compare_swap pero devuelve SI triunfo.  Es lo que se quiere
	/// saber casi siempre, y evita repetir `if (a.compare_swap(v, n) == v)` en
	/// cada sitio.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1)
	)
		public bool compare_exchange(T expected, T desired) {
		return this.compare_swap(expected, desired) == expected;
	}

	// -----------------------------------------------------------------------
	//  Nombres explicitos.
	//
	//  Los operadores (`*g`, `g = v`, `g += d`) son comodos, pero en codigo
	//  concurrente se suele preferir que la operacion atomica SE VEA:
	//  `head.store(next)` dice mas que `head = next`.  Ademas es el vocabulario
	//  de C++, Rust, Java, Zig y C#: quien viene de ahi ya lo conoce.
	//
	//  Son los mismos metodos, no otros: `load` ES `*g`.
	// -----------------------------------------------------------------------

	/// Load atomico.  Igual que `*g`.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(partial: 0, total: 0)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1)
	)
		public T load() { return this.__deref__(); }

	/// Store atomico.  Igual que `g = v`.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(partial: 0, total: 0)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1)
	)
		public T store(T v) { return this.__assign__(v); }

	/// Exchange.  Alias de @ref swap, con el nombre de C++/Rust.  Su cuerpo es
	/// solo una llamada -> parcial O(1) (el analizador NO cuenta el inline en el
	/// parcial); el total hereda el coste de swap (x86 bucle CAS O(n), arm64
	/// LL/SC O(1)).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 24, when: arch:arm64)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(n),
		total_post:   O(n),
		when:         arch:x86_64
	)
	@complexity(
		partial_pre:  O(1),
		partial_post: O(1),
		total_pre:    O(1),
		total_post:   O(1),
		when:         arch:arm64
	)
		public T exchange(T v) { return this.swap(v); }

	// -----------------------------------------------------------------------
	//  RMW compuestos sobre CAS.
	// -----------------------------------------------------------------------

	/// Deja el maximo entre el valor actual y @p v; devuelve el ANTERIOR.
	/// Sin esto hay que escribir el bucle CAS a mano en cada sitio.  El bucle
	/// esta en el propio cuerpo -> O(n) tambien en la parte parcial.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(n),
		partial_post: O(n),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T fetch_max(T v) where T: Comparable {
		while (true) {
			T viejo = this.load();
			if (viejo >= v) { return viejo; }
			if (this.compare_exchange(viejo, v)) { return viejo; }
			vx_cpu_relax();
		}
	}

	/// Deja el minimo entre el valor actual y @p v; devuelve el ANTERIOR.
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(n),
		partial_post: O(n),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T fetch_min(T v) where T: Comparable {
		while (true) {
			T viejo = this.load();
			if (viejo <= v) { return viejo; }
			if (this.compare_exchange(viejo, v)) { return viejo; }
			vx_cpu_relax();
		}
	}

	/// Aplica @p f al valor de forma atomica y devuelve el ANTERIOR.
	///
	/// Es el bucle CAS generico -- leer, calcular, intentar escribir, reintentar
	/// si otro se adelanto -- que aparece una y otra vez.  Con esto CUALQUIER
	/// operacion atomica se escribe sin tocar la libreria:
	///
	///     contador.fetch_update((x) => x * 2 + 1);
	///     tope.fetch_update((x) => max(x, limite));
	///
	/// @p f debe ser PURA y BARATA.  Pura porque se ejecuta una vez por
	/// reintento: si tiene efectos, ocurriran varias veces.  Y barata porque
	/// cuanto mas tarda, mas facil es que otro hilo se adelante y haya que
	/// repetirla -- con un calculo caro y contencion, el bucle puede no
	/// avanzar.
	///
	/// Si el calculo es caro, el bucle se escribe a mano y se decide que hacer
	/// en cada reintento (reaprovechar parte del trabajo, abandonar, ...):
	///
	///     while (true) {
	///         T viejo = a.load();
	///         T nuevo = calculo_caro(viejo);       // <- aqui decides tu
	///         if (a.compare_exchange(viejo, nuevo)) { break; }
	///     }
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(n),
		partial_post: O(n),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T fetch_update(fn(T) -> T f) {
		while (true) {
			T viejo = this.load();
			if (this.compare_exchange(viejo, f(viejo))) {
				return viejo;
			}
			vx_cpu_relax();
		}
	}

	/// Como @ref fetch_update pero devuelve el valor NUEVO.
	///
	/// La misma relacion que hay entre `fetch_add` y `+=`: el patron habitual es
	/// `nuevo = contador.update((x) => x + 1);`, y con el fetch_ hay que
	/// recalcularlo fuera.  Mismas condiciones sobre @p f (pura y barata).
	@nothrow
	@nopanic
	@alloc(partial: 0, total: 0)
	@stack(0, when: arch:x86_64)
	@stack(partial: 0, total: 32, when: arch:arm64)
	@complexity(
		partial_pre:  O(n),
		partial_post: O(n),
		total_pre:    O(n),
		total_post:   O(n)
	)
		public T update(fn(T) -> T f) {
		while (true) {
			T viejo = this.load();
			T nuevo = f(viejo);
			if (this.compare_exchange(viejo, nuevo)) {
				return nuevo;
			}
			vx_cpu_relax();
		}
	}
}
