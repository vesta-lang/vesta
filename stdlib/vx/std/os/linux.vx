namespace std.os.linux;

/**
 * @file linux.vx
 * @brief Llamadas de Linux para las operaciones del proceso.
 *
 * La mitad de Linux de `std.os`.  Las llamadas no se escriben aqui a mano:
 * vienen de `std.syscall`, que es donde vive la tabla y donde ya esta resuelto
 * el reparto por arquitectura.
 *
 * Cuando el nombre que se ofrece coincide con el de la llamada, no hay
 * envoltorio: se re-exporta y ya esta.  Es el caso de `write`.
 */

public import std.syscall.linux only write, exit_group;
import std.unix only STDIN_FILENO, STDOUT_FILENO, STDERR_FILENO;

/**
 * @brief Los tres flujos estandar, con el valor que les da Linux.
 *
 * Es el descriptor que se le pasa a `write`.  Cada sistema declara aqui los
 * suyos para que la capa portable no tenga que preguntar cual es cual.
 */
public enum Stream : u32 {
    stdin  = STDIN_FILENO,
    stdout = STDOUT_FILENO,
    stderr = STDERR_FILENO
}

/**
 * @brief Termina el proceso.  No vuelve.
 *
 * Es `exit_group` y no `exit`: la segunda termina solo el hilo que la llama, y
 * lo que se promete aqui es que se acaba el proceso entero.  Ese es el unico
 * motivo de que esta si lleve envoltorio: el nombre no coincide.
 *
 * @param code Codigo de salida.
 */
public void exit(i32 code) {
    exit_group(code);
}
