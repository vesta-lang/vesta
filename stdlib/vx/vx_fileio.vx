// stdlib/vx/vx_fileio.vx
//
// @file vx_fileio.vx
// @brief Lectura de ficheros binarios a un buffer, LIBRE de libc de formato.
//
// La stdlib de I/O (stdlib/vx/vx_io.vx, stdlib/native/io/vesta_io.c) solo
// cubre SALIDA a consola.  Este modulo anade la ENTRADA: obtener el tamano de
// un fichero y volcarlo a un buffer provisto por el caller.  Portado del
// ejercicio ReaderBMP (examples_codes_vx/reader_bmp/bmp_io.vx).
//
//   Windows: kernel32 (CreateFileA / GetFileSizeEx / ReadFile / CloseHandle),
//            CERO msvcrt -> vale en AOT/freestanding.
//   POSIX:   libc.so.6 (open / lseek / read / close) via FFI declarativo ->
//            funciona en interp / JIT / AOT sin inline-asm.
//
// DISENO (workaround de la limitacion host-ptr con return-null): NO se expone
// una funcion que DEVUELVA el buffer (`u8* f()`).  Una funcion `u8* f()` con
// una rama `return null` pierde el flag is_host_ptr de su valor de retorno, y
// el llamante deref-ea leyendo memoria VM en vez de host (SIGSEGV al indexar).
// En su lugar el patron es de DOS PASOS:
//     i64 sz = file_size(path);           // -1 si error
//     u8*  buf = malloc(sz);              // el caller reserva
//     i64  n = file_read_into(path, buf, sz);   // el buffer va como ARG
// Los host-ptr pasados como ARGUMENTO SI conservan su naturaleza host.
//
// @Target no aplica a bloques `extern`; se declaran ambos sin condicion y el
// dead-strip elimina el que no use la plataforma activa.

extern "kernel32.dll" {
    fn CreateFileA(u8* name, u32 access, u32 share, u64 sec,
                   u32 disposition, u32 flags, u64 templ) -> u64;
    fn GetFileSizeEx(u64 h, i64* size) -> i32;
    fn ReadFile(u64 h, u8* buf, u32 n, u32* nread, u64 overlapped) -> i32;
    fn WriteFile(u64 h, u8* buf, u32 n, u32* nwritten, u64 overlapped) -> i32;
    fn CloseHandle(u64 h) -> i32;
}

extern "libc.so.6" {
    fn open(u8* path, i32 flags, i32 mode) -> i32;
    fn read(i32 fd, u8* buf, u64 count) -> i64;
    fn write(i32 fd, u8* buf, u64 count) -> i64;
    fn lseek(i32 fd, i64 off, i32 whence) -> i64;
    fn close(i32 fd) -> i32;
}

// ---------------------------------------------------------------------------
// Windows (kernel32).
// ---------------------------------------------------------------------------

// Devuelve el tamano en bytes de `path`, o -1 si no existe / no se pudo abrir.
@Target("os:windows")
public i64 file_size(string path) {
    u8* pc = str_cstr(path);
    if (pc == null) {
        return -1;
    }
    // GENERIC_READ=0x80000000, FILE_SHARE_READ=1, OPEN_EXISTING=3,
    // FILE_ATTRIBUTE_NORMAL=0x80.  INVALID_HANDLE_VALUE = -1 = 0xFFFF...FF.
    u64 h = CreateFileA(pc, (u32) 0x80000000, (u32) 1, (u64) 0,
                        (u32) 3, (u32) 0x80, (u64) 0);
    if (h == 0xFFFFFFFFFFFFFFFF) {
        return -1;
    }
    i64 size = 0;
    i32 gs = GetFileSizeEx(h, &size);
    CloseHandle(h);
    if (gs == 0) {
        return -1;
    }
    return size;
}

// Lee hasta `size` bytes de `path` al buffer `buf` (host, provisto por el
// caller).  Devuelve el numero de bytes leidos, o -1 si error.
@Target("os:windows")
public i64 file_read_into(string path, u8* buf, i64 size) {
    u8* pc = str_cstr(path);
    if (pc == null) {
        return -1;
    }
    u64 h = CreateFileA(pc, (u32) 0x80000000, (u32) 1, (u64) 0,
                        (u32) 3, (u32) 0x80, (u64) 0);
    if (h == 0xFFFFFFFFFFFFFFFF) {
        return -1;
    }
    u32 nread = 0;
    i32 ok = ReadFile(h, buf, (u32) size, &nread, (u64) 0);
    CloseHandle(h);
    if (ok == 0) {
        return -1;
    }
    return (i64) nread;
}

// Escribe `size` bytes desde el buffer host `buf` a `path`, creando o
// truncando el fichero.  Devuelve el numero de bytes escritos, o -1 si error.
//
// Abre con GENERIC_WRITE (0x40000000) sin comparticion y disposicion
// CREATE_ALWAYS (2), que trunca un fichero existente o lo crea si no existe.
// WriteFile vuelca el buffer completo en una sola llamada y reporta cuantos
// bytes reales aterrizaron en disco via el out-param `nwritten`.
@Target("os:windows")
public i64 file_write_from(string path, u8* buf, i64 size) {
    u8* pc = str_cstr(path);
    if (pc == null) {
        return -1;
    }
    // GENERIC_WRITE=0x40000000, share=0, CREATE_ALWAYS=2,
    // FILE_ATTRIBUTE_NORMAL=0x80.
    u64 h = CreateFileA(pc, (u32) 0x40000000, (u32) 0, (u64) 0,
                        (u32) 2, (u32) 0x80, (u64) 0);
    if (h == 0xFFFFFFFFFFFFFFFF) {
        return -1;
    }
    u32 nwritten = 0;
    i32 ok = WriteFile(h, buf, (u32) size, &nwritten, (u64) 0);
    CloseHandle(h);
    if (ok == 0) {
        return -1;
    }
    return (i64) nwritten;
}

// ---------------------------------------------------------------------------
// POSIX (libc.so.6).
// ---------------------------------------------------------------------------

// O_RDONLY=0, SEEK_END=2.  lseek al final devuelve el tamano.
@Target("!os:windows")
public i64 file_size(string path) {
    u8* pc = str_cstr(path);
    if (pc == null) {
        return -1;
    }
    i32 fd = open(pc, (i32) 0, (i32) 0);
    if (fd < 0) {
        return -1;
    }
    i64 end = lseek(fd, (i64) 0, (i32) 2);
    close(fd);
    if (end < 0) {
        return -1;
    }
    return end;
}

@Target("!os:windows")
public i64 file_read_into(string path, u8* buf, i64 size) {
    u8* pc = str_cstr(path);
    if (pc == null) {
        return -1;
    }
    i32 fd = open(pc, (i32) 0, (i32) 0);
    if (fd < 0) {
        return -1;
    }
    i64 got = read(fd, buf, (u64) size);
    close(fd);
    return got;
}

// Escribe `size` bytes desde el buffer host `buf` a `path`, creando o
// truncando el fichero.  Devuelve el numero de bytes escritos, o -1 si error.
//
// O_WRONLY=1, O_CREAT=0x40, O_TRUNC=0x200 (valores de Linux x86-64); la
// combinacion crea el fichero si falta y lo trunca a cero antes de escribir.
// El modo 0644 (0x1A4) fija los permisos del fichero recien creado.
@Target("!os:windows")
public i64 file_write_from(string path, u8* buf, i64 size) {
    u8* pc = str_cstr(path);
    if (pc == null) {
        return -1;
    }
    i32 fd = open(pc, (i32) 0x241, (i32) 0x1A4);
    if (fd < 0) {
        return -1;
    }
    i64 put = write(fd, buf, (u64) size);
    close(fd);
    return put;
}
