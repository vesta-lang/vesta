/**
 * @file vx_mem.vx
 * @brief Arenas del SO + allocator slab + utilidades de memoria, en Vex puro.
 *
 * Reemplaza el RawAllocator y las rutinas de memoria de C (`native`).  Tres
 * capas, todas sin libc de formato:
 *
 *   1. Utilidades de memoria (@ref vx_memset / @ref vx_memcpy / ...): copia
 *      y relleno por qwords (8 bytes) en vez de byte-a-byte -> exprimen el
 *      hardware (el vectorizador del AOT puede subirlas a SIMD).  Centralizadas
 *      aqui para reusarlas desde todo el runtime.
 *
 *   2. Arenas del SO (@ref vmem_reserve / @ref vmem_release): envuelven
 *      VirtualAlloc/VirtualFree (Windows) y mmap/munmap (Linux) y RECIBEN LOS
 *      PERMISOS (@ref MemProt: RW para heap, RX/RWX para codigo JIT).
 *
 *   3. Allocator slab (@ref __vx_malloc / @ref __vx_free, expuestos via
 *      @c @AllocatorOverride): piden arenas grandes RW y sub-alocan con
 *      size-classes + free-lists intrusivas LIFO -> hipereficiente (amortiza
 *      syscalls, sin lock, sin el heap-manager del SO; ~66x vs malloc/free).
 *
 * Auto-bundle: el driver `-m aot` lo fusiona como allocator por DEFECTO cuando
 * el modulo usa el heap y no hay un @c @AllocatorOverride del usuario.  El
 * usuario lo sustituye aplicando su propio @c @AllocatorOverride, o lo desactiva
 * con `--no-mem`.
 */

extern "kernel32.dll" {
    fn VirtualAlloc(u64 addr, u64 size, u32 allocType, u32 protect) -> u64;
    fn VirtualFree(u64 addr, u64 size, u32 freeType) -> i32;
}

// Linux: mmap/munmap RAW (sin libc) via asm volatile syscall.  SysV: arg4 a r10
// (no rcx).  nr y resultado comparten rax.  mmap=9 (6 args), munmap=11 (2 args).
@Target("!os:windows")
i64 __vmem_sys_mmap(i64 addr, i64 len, i64 prot, i64 flags, i64 fd, i64 off) {
    register("rdi") i64 a1 = addr;
    register("rsi") i64 a2 = len;
    register("rdx") i64 a3 = prot;
    register("r10") i64 a4 = flags;
    register("r8")  i64 a5 = fd;
    register("r9")  i64 a6 = off;
    register("rax") i64 rax_io = 9; // SYS_mmap
    asm volatile { syscall };
    return rax_io;
}
@Target("!os:windows")
i64 __vmem_sys_munmap(i64 addr, i64 len) {
    register("rdi") i64 a1 = addr;
    register("rsi") i64 a2 = len;
    register("rax") i64 rax_io = 11; // SYS_munmap
    asm volatile { syscall };
    return rax_io;
}

// =========================================================================
//  Capa 1: utilidades de memoria (hardware-friendly: qwords, no byte-a-byte)
// =========================================================================

/**
 * @brief Rellena @p n bytes desde @p dst con el byte @p val.
 *
 * Construye un patron de 8 bytes y escribe por qwords (8x menos stores que
 * byte-a-byte); el resto (< 8 bytes) se completa con stores de byte.  El
 * vectorizador del AOT puede promover el bucle de qwords a SIMD.
 *
 * @param dst Direccion destino (host_ptr como u64).
 * @param val Byte de relleno (solo se usan los 8 bits bajos).
 * @param n   Numero de bytes a escribir.
 */
void vx_memset(u64 dst, u8 val, u64 n) {
    // Patron de 8 bytes = val replicado (shifts CONSTANTES, validos en AOT).
    u64 b = (u64)val;
    u64 pat = b | (b << 8) | (b << 16) | (b << 24) |
              (b << 32) | (b << 40) | (b << 48) | (b << 56);
    u64* qp = (u64*)dst;
    u64 i = 0;
    u64 nq = n / 8;
    while (i < nq) {
        qp[i] = pat;
        i = i + 1;
    }
    u64 off = nq * 8;
    while (off < n) {
        u8* bp = (u8*)(dst + off);
        bp[0] = val;
        off = off + 1;
    }
}

/**
 * @brief Copia @p n bytes de @p src a @p dst (regiones NO solapadas).
 *
 * Copia por qwords + cola de bytes.  Para solapamiento usar @ref vx_memmove.
 *
 * @param dst Destino (host_ptr como u64).
 * @param src Origen  (host_ptr como u64).
 * @param n   Numero de bytes.
 */
void vx_memcpy(u64 dst, u64 src, u64 n) {
    u64* dq = (u64*)dst;
    u64* sq = (u64*)src;
    u64 i = 0;
    u64 nq = n / 8;
    while (i < nq) {
        dq[i] = sq[i];
        i = i + 1;
    }
    u64 off = nq * 8;
    while (off < n) {
        u8* dp = (u8*)(dst + off);
        u8* sp = (u8*)(src + off);
        dp[0] = sp[0];
        off = off + 1;
    }
}

/**
 * @brief Copia @p n bytes de @p src a @p dst tolerando solapamiento.
 *
 * Si los rangos se solapan y @p dst > @p src, copia hacia atras para no pisar
 * datos aun no leidos.  En caso contrario delega en @ref vx_memcpy.
 *
 * @param dst Destino (host_ptr como u64).
 * @param src Origen  (host_ptr como u64).
 * @param n   Numero de bytes.
 */
void vx_memmove(u64 dst, u64 src, u64 n) {
    if (dst == src || n == 0) return;
    if (dst < src) {
        vx_memcpy(dst, src, n);
        return;
    }
    // dst > src y posible solape: copiar de atras hacia adelante (byte-a-byte;
    // el solape impide el bulk-qword sin doble buffer).
    u64 i = n;
    while (i > 0) {
        i = i - 1;
        u8* dp = (u8*)(dst + i);
        u8* sp = (u8*)(src + i);
        dp[0] = sp[0];
    }
}

// =========================================================================
//  Capa 2: arenas del SO con permisos
// =========================================================================

/**
 * @brief Permisos de una arena.  Mapea a PAGE_* (Windows) / PROT_* (Linux).
 */
enum MemProt {
    None,          ///< sin acceso (guard pages)
    Read,          ///< solo lectura
    ReadWrite,     ///< lectura + escritura (heap normal)
    ReadExec,      ///< lectura + ejecucion (codigo cargado)
    ReadWriteExec, ///< RWX (JIT: emitir + ejecutar)
}

/// Tamano de chunk que el slab pide al SO (comptime: constante de compilacion).
comptime u64 VMEM_CHUNK_BYTES = 1048576; // 1 MiB

/**
 * @brief Traduce @ref MemProt a flags PAGE_* de Windows.
 * @param p Permisos.
 * @return Constante PAGE_* (READWRITE por defecto).
 */
@Target("os:windows")
u32 __vmem_prot_flags(MemProt p) {
    match (p) {
        case None => return 1;          // PAGE_NOACCESS
        case Read => return 2;          // PAGE_READONLY
        case ReadExec => return 32;     // PAGE_EXECUTE_READ
        case ReadWriteExec => return 64; // PAGE_EXECUTE_READWRITE
        case ReadWrite => return 4;     // PAGE_READWRITE
    }
    return 4;
}
/**
 * @brief Traduce @ref MemProt a flags PROT_* de POSIX.
 * @param p Permisos.
 * @return PROT_* combinado (READ|WRITE por defecto).
 */
@Target("!os:windows")
i32 __vmem_prot_flags(MemProt p) {
    match (p) {
        case None => return 0;          // PROT_NONE
        case Read => return 1;          // PROT_READ
        case ReadExec => return 5;      // READ|EXEC
        case ReadWriteExec => return 7; // READ|WRITE|EXEC
        case ReadWrite => return 3;     // READ|WRITE
    }
    return 3;
}

/**
 * @brief Reserva + commit @p size bytes con permisos @p prot.
 *
 * Memoria zero-init por el SO (VirtualAlloc MEM_COMMIT / mmap MAP_ANONYMOUS).
 *
 * @param size Bytes a reservar (el SO redondea a pagina).
 * @param prot Permisos (@ref MemProt).
 * @return Direccion base, o 0 en fallo.
 */
@Target("os:windows")
u64 vmem_reserve(u64 size, MemProt prot) {
    // MEM_COMMIT|MEM_RESERVE = 0x3000 = 12288.
    return VirtualAlloc(0, size, 12288, __vmem_prot_flags(prot));
}
@Target("!os:windows")
u64 vmem_reserve(u64 size, MemProt prot) {
    // MAP_PRIVATE|MAP_ANONYMOUS = 0x22 = 34, fd = -1, off = 0.
    i64 r = __vmem_sys_mmap(0, (i64)size, (i64)__vmem_prot_flags(prot), 34, -1, 0);
    if (r == -1) return 0; // MAP_FAILED
    return (u64)r;
}

/**
 * @brief Libera una arena reservada con @ref vmem_reserve.
 * @param addr Direccion base devuelta por @ref vmem_reserve.
 * @param size Tamano original (necesario en POSIX; ignorado en Windows).
 */
@Target("os:windows")
void vmem_release(u64 addr, u64 size) {
    VirtualFree(addr, 0, 32768); // MEM_RELEASE=0x8000 (size DEBE ser 0)
}
@Target("!os:windows")
void vmem_release(u64 addr, u64 size) {
    __vmem_sys_munmap((i64)addr, (i64)size);
}

// =========================================================================
//  Capa 3: allocator slab (sobre arenas RW)
// =========================================================================
//
// Layout de bloque: [8 bytes header][payload].  El header guarda el indice de
// size-class (0..8) o 255 (large: arena directa).  La free-list es intrusiva:
// un bloque libre guarda el next en su payload.  malloc devuelve el payload
// (header + 8).  Payload 8-aligned (los loads SIMD usan MOVUPD).

/// 9 size-classes: 16,32,64,128,256,512,1024,2048,4096.  Head de free-list/clase.
u64[9] __vmem_free;  ///< head de la free-list por clase (0 = vacia)
u64 __vmem_bump = 0; ///< bump pointer del chunk actual
u64 __vmem_end = 0;  ///< fin del chunk actual

/**
 * @brief Indice de size-class para @p size (>0).
 * @param size Bytes solicitados.
 * @return 0..8 para clases 16..4096, o -1 si es large (>4096).
 */
i32 __vmem_class_of(u64 size) {
    if (size <= 16) return 0;
    if (size <= 32) return 1;
    if (size <= 64) return 2;
    if (size <= 128) return 3;
    if (size <= 256) return 4;
    if (size <= 512) return 5;
    if (size <= 1024) return 6;
    if (size <= 2048) return 7;
    if (size <= 4096) return 8;
    return -1;
}

/**
 * @brief Bytes de la size-class @p cls.  if-else (no shift variable, AOT-safe).
 * @param cls Indice 0..8.
 * @return Tamano en bytes de la clase.
 */
u64 __vmem_size_of(i32 cls) {
    if (cls == 0) return 16;
    if (cls == 1) return 32;
    if (cls == 2) return 64;
    if (cls == 3) return 128;
    if (cls == 4) return 256;
    if (cls == 5) return 512;
    if (cls == 6) return 1024;
    if (cls == 7) return 2048;
    return 4096;
}

/**
 * @brief Pide un chunk RW nuevo al SO y lo arma como region de bump.
 * @param min_need Tamano minimo necesario (si excede VMEM_CHUNK_BYTES).
 */
void __vmem_new_chunk(u64 min_need) {
    u64 sz = VMEM_CHUNK_BYTES;
    if (min_need > sz) sz = min_need;
    u64 p = vmem_reserve(sz, MemProt.ReadWrite);
    __vmem_bump = p;
    __vmem_end = p + sz;
}

/**
 * @brief Slab interno: reserva @p size bytes ZERIFICADOS (kzalloc).
 *
 * Los bloques frescos de la arena ya vienen a cero del SO; los reciclados de la
 * free-list se zerifican con @ref vx_memset.  Asi el cero-init de campos no
 * escritos por un constructor queda garantizado (convencion de @AllocatorOverride).
 *
 * @param size Bytes solicitados.
 * @return Direccion del payload (header + 8), o de base+16 si es large.
 */
u64 __vmem_alloc(u64 size) {
    if (size == 0) size = 1;
    i32 cls = __vmem_class_of(size);
    if (cls < 0) {
        // Large: arena directa.  Layout: [size en base+0][255 marker en base+8]
        // [payload en base+16].  El marker va en base+8 = payload-8, la MISMA
        // posicion que el header de un bloque slab, para que __vmem_free_impl lo
        // detecte leyendo payload-8 (uniforme con el caso slab).
        u64 total = size + 16;
        u64 base = vmem_reserve(total, MemProt.ReadWrite);
        u64* h = (u64*)base;
        h[0] = total; // size en base+0 (= payload-16)
        h[1] = 255;   // marker large en base+8 (= payload-8)
        return base + 16;
    }
    u64 csz = __vmem_size_of(cls);
    u64 head = __vmem_free[cls];
    if (head != 0) {
        // Pop: head es el block (header); next guardado en su payload (head+8).
        u64* hp = (u64*)head;
        __vmem_free[cls] = hp[1];
        hp[0] = (u64)cls; // re-set header
        vx_memset(head + 8, 0, csz); // reciclado -> sucio: kzalloc
        return head + 8;
    }
    // Bump del chunk actual (memoria fresca del SO = ya a cero).
    u64 need = csz + 8;
    if (__vmem_bump == 0) __vmem_new_chunk(need);
    if (__vmem_bump + need > __vmem_end) __vmem_new_chunk(need);
    u64 block = __vmem_bump;
    __vmem_bump = __vmem_bump + need;
    u64* bp = (u64*)block;
    bp[0] = (u64)cls;
    return block + 8;
}

/**
 * @brief Slab interno: devuelve @p payload al pool (o al SO si es large).
 * @param payload Direccion devuelta por @ref __vmem_alloc.
 */
void __vmem_free_impl(u64 payload) {
    if (payload == 0) return;
    u64 block = payload - 8;
    u64* bp = (u64*)block;
    u64 h = bp[0];
    if (h == 255) {
        // Large: marker en payload-8 (base+8); size en base+0 (payload-16).
        u64 base = payload - 16;
        u64* basep = (u64*)base;
        u64 total = basep[0];
        vmem_release(base, total);
        return;
    }
    // Push a la free-list: next = old head (guardado en el payload).
    u64* pp = (u64*)payload;
    pp[0] = __vmem_free[h];
    __vmem_free[h] = block;
}

/**
 * @brief Allocator por defecto del `new` y RAW_ALLOC (via @c @AllocatorOverride).
 *
 * El driver `-m aot` detecta este simbolo igual que un override del usuario
 * (retorno puntero -> alloc).  Devuelve memoria zerificada (kzalloc).
 *
 * @param size Bytes solicitados.
 * @return Puntero al bloque.
 */
@AllocatorOverride
i64* __vx_malloc(u64 size) {
    return (i64*)__vmem_alloc(size);
}

/**
 * @brief Liberador por defecto (via @c @AllocatorOverride; retorno void -> free).
 * @param p Puntero devuelto por @ref __vx_malloc.
 */
@AllocatorOverride
void __vx_free(i64* p) {
    __vmem_free_impl((u64)p);
}
