/**
 * @file vx_sync.vx
 * @brief Runtime de monitores reentrantes nativo para  AOT (tiers
 *        bare/embed), SIN libc.
 *
 * Auto-bundle: el driver `-m aot` fusiona este modulo cuando el programa usa
 * `synchronized`/`monitor` (ops MONENTER/MONEXIT) y no define las primitivas el
 * mismo (mismo patron que vx_io.vx / vx_exc.vx / vx_async.vx).
 *
 * @par Modelo
 * Monitor reentrante por-objeto, sin GC ni tabla de handles.  La palabra de
 * monitor vive INLINE en el objeto, en el offset 16 del ObjectHeader
 * (`sizeof(ObjectHeader)`=24; offset 0 = vtable_ptr en native_poo, offset 16
 * libre y zero-inicializado por `calloc`).  Layout de la palabra (64 bits):
 *
 *   - bits 63..16 : owner_tid (id de hilo duenño; 0 = libre)
 *   - bits 15..0  : lock_depth (recursion; 0 = libre)
 *
 * Adquisicion lock-free via `lock cmpxchg` (inline asm).  Reentrante: si el
 * hilo actual ya es duenño, incrementa la profundidad.  En el modelo
 * cooperativo (single-thread, sin paralelismo real) el lock SIEMPRE esta
 * uncontended -> la CAS optimista triunfa a la primera; el bucle de spin con
 * PAUSE queda como camino frio (correcto) hasta que lleguen hilos reales.
 *
 * @par Multiplataforma
 * x86-64.  El TID se obtiene por plataforma: Windows via `GetCurrentThreadId`
 * (kernel32, unica dependencia en Windows), Linux via syscall `gettid` (186)
 * RAW sin libc.  La aritmetica de la palabra y el `lock cmpxchg` son comunes.
 *
 * @note  4 (hilos reales del SO): el spin con PAUSE se sustituye por un
 *       bloqueo via `WaitOnAddress` (Windows) / `futex` (Linux) sobre la misma
 *       palabra, y el cache de TID pasa a ser thread-local.
 */

// FN.4 (LIM-5): el runtime de asincronia expone el fiber-id de la tarea en
// ejecucion (0 = main / sin fibra) y el yield cooperativo.  El monitor usa el
// fiber-id como duenño (las fibras comparten TID -> el TID no distingue) y CEDE
// en contencion en vez de spin (que deadlockearia en el modelo cooperativo
// single-thread: el duenño nunca correria).  Cross-modulo via el auto-bundle
// multi-modulo (compile_vx_project).
import "vx_async" only vasync_yield, vasync_cur_fiber;

// ---------------------------------------------------------------------------
// FFI minima: identificador del hilo actual.
// ---------------------------------------------------------------------------
// @Target no aplica a bloques `extern`; se declara sin condicion y solo el
// helper @Target'd de Windows lo llama -> el dead-strip elimina el extern en
// los binarios que no son Windows.
extern "kernel32.dll" {
    fn GetCurrentThreadId() -> u32;
}

/**
 * @brief TID del hilo actual en Windows.
 * @return Id de hilo (kernel32 `GetCurrentThreadId`), nunca 0.
 */
@Target("os:windows")
i64 __vsync_tid_raw() {
    return (i64)GetCurrentThreadId();
}

/**
 * @brief TID del hilo actual en Linux/ELF (syscall `gettid` 186, RAW sin libc).
 * @return Id de hilo del kernel, nunca 0.
 */
@Target("!os:windows")
i64 __vsync_tid_raw() {
    register("rax") i64 rax_t = 186; // SYS_gettid (x86-64)
    asm volatile { syscall };
    return rax_t;
}

/**
 * @brief TID del hilo actual.
 * @return Id de hilo (>0).
 * @note NO se cachea: con MULTIHILO real un cache en un global compartido daria
 *       el mismo TID a todos los hilos (el 2o hilo leeria el del 1o) -> se
 *       creerian mutuamente reentrantes y el monitor NO daria exclusion.  En
 *       Windows @c GetCurrentThreadId lee el TEB (barato); en Linux @c gettid es
 *       un syscall (correcto).  Una optimizacion futura seria un cache
 *       thread-local (thread_local emite TLS nativo en AOT).
 */
i64 __vsync_tid() {
    return __vsync_tid_raw();
}

// ---------------------------------------------------------------------------
// Primitivas atomicas de bajo nivel.
// ---------------------------------------------------------------------------

/**
 * @brief Compare-and-swap de 64 bits: `*addr = desired` si `*addr == expected`.
 * @param addr     Puntero destino (host_ptr).
 * @param expected Valor esperado en `*addr`.
 * @param desired  Valor a escribir si coincide.
 * @return El valor ANTIGUO de `*addr` (== @p expected si la CAS triunfo).
 * @note `lock cmpxchg [mem], reg`: rax=expected (in/out -> old), reg=desired.
 *       rax queda con el valor leido (old) tanto en exito como en fallo.
 */
i64 __vsync_cas64(i64* addr, i64 expected, i64 desired) {
    register("rsi") i64* a = addr;     // puntero destino
    register("rax") i64 ex = expected; // in: expected / out: old value
    register("rdx") i64 de = desired;  // valor a escribir si coincide
    asm volatile { lock cmpxchg [rsi], rdx };
    return ex; // rax = valor antiguo
}

/**
 * @brief Lectura atomica de 64 bits (load relaxed).
 * @param addr Puntero origen (host_ptr).
 * @return `*addr`.
 * @note En x86-64 un `mov` alineado de 8 bytes ya es atomico.
 */
i64 __vsync_load64(i64* addr) {
    return *addr;
}

/**
 * @brief Hint de spin para el camino contended (`pause`).
 * @note Funcionalmente un no-op; reduce el consumo del bus en un spin-loop.
 *       En el modelo cooperativo este camino no se alcanza.
 */
void __vsync_pause() {
    asm volatile { pause };
}

// ---------------------------------------------------------------------------
// Empaquetado de la palabra de monitor (owner_tid<<16 | depth).
// ---------------------------------------------------------------------------

/**
 * @brief Construye la palabra de monitor a partir de (owner, depth).
 * @param owner TID duenño.
 * @param depth Profundidad de recursion (1..0xFFFF).
 * @return `(owner << 16) | (depth & 0xFFFF)`.
 */
i64 __vsync_make(i64 owner, i64 depth) {
    return (owner << 16) | (depth & 0xFFFF);
}

/**
 * @brief Extrae el TID duenño de una palabra de monitor.
 * @param word Palabra de monitor.
 * @return owner_tid (0 = libre).
 */
i64 __vsync_owner(i64 word) {
    return ((u64)word) >> 16; // shift logico (u64 zero-extiende)
}

/**
 * @brief Extrae la profundidad de recursion de una palabra de monitor.
 * @param word Palabra de monitor.
 * @return lock_depth (0 = libre).
 */
i64 __vsync_depth(i64 word) {
    return word & 0xFFFF;
}

/**
 * @brief Identidad del "duenño" del monitor: COMPUESTO (tid, fiber-id).
 * @return `(tid << 16) | fiber_id` -> distingue tanto HILOS REALES del SO (tids
 *         distintos) como FIBRAS cooperativas del mismo hilo (fiber_id distinto).
 * @note El owner ocupa los bits 63..16 de la palabra de monitor (48 bits): tid
 *       (32b, GetCurrentThreadId/gettid) en 47..16 y fiber_id (16b) en 15..0 del
 *       owner.  Nunca 0 (tid nunca es 0) -> compatible con el centinela "libre".
 *       Cubre a la vez el modelo COOPERATIVO (single-thread, fibras) y el
 *       MULTIHILO real (spawn = hilo del SO): un hilo real tiene fiber_id 0 y su
 *       tid lo identifica; dos fibras del mismo hilo comparten tid pero difieren
 *       en fiber_id.  La contienda cede (fibra) o spinea (hilo real) segun el
 *       caso en __vx_monenter.
 */
i64 __vsync_self() {
    return (__vsync_tid() << 16) | vasync_cur_fiber();
}

// ---------------------------------------------------------------------------
// API publica: monenter / monexit.
// ---------------------------------------------------------------------------

/**
 * @brief Adquiere el monitor reentrante de @p obj (op MONENTER de ).
 * @param obj host_ptr al ObjectHeader (lo que devuelve `new` en native_poo).
 *
 * La palabra de monitor vive en `obj + 16` (= `obj + 2` en aritmetica `i64*`).
 *
 * Camino rapido (comun): el monitor esta libre -> una sola CAS `0 ->
 * make(tid, 1)` lo toma sin tocar el bucle.  Camino lento: reentrada (el hilo
 * ya es duenño, incrementa la profundidad) o contienda real (spin con PAUSE
 * hasta que se libere).  En el modelo cooperativo el camino lento de contienda
 * no se alcanza.
 */
void __vx_monenter(i64* obj) {
    i64* word_addr = obj + 2; // obj + 16 bytes
    i64 self = __vsync_self(); // fiber-id+1 (owner en el modelo cooperativo)
    i64 want1 = __vsync_make(self, 1);
    // Fast path optimista: monitor libre -> tomarlo con una unica CAS.
    if (__vsync_cas64(word_addr, 0, want1) == 0) {
        return; // adquirido sin contienda
    }
    // Slow path: reentrada o contienda.
    while (true) {
        i64 cur = __vsync_load64(word_addr);
        i64 depth = __vsync_depth(cur);
        if (depth == 0) {
            // Quedo libre entre el fast path y ahora: reintentar tomarlo.
            if (__vsync_cas64(word_addr, 0, want1) == 0) {
                return;
            }
        } else if (__vsync_owner(cur) == self) {
            // Reentrante (misma fibra): incrementar la profundidad.
            i64 want = __vsync_make(self, depth + 1);
            if (__vsync_cas64(word_addr, cur, want) == cur) {
                return;
            }
        } else {
            // Contienda REAL: otra fibra posee el monitor.  En el scheduler
            // cooperativo hay que CEDER (no spin): la fibra duenña solo puede
            // liberar si el scheduler la corre.  Si estamos en una fibra
            // (__vasync_current_fiber != 0) cedemos al scheduler; si no (main
            // sin scheduler) no hay contienda posible -> pause defensivo.
            if (vasync_cur_fiber() != 0) {
                vasync_yield();
            } else {
                __vsync_pause();
            }
        }
    }
}

/**
 * @brief Libera el monitor reentrante de @p obj (op MONEXIT de ).
 * @param obj host_ptr al ObjectHeader.
 *
 * Si la profundidad es 1 (ultima salida) libera la palabra a 0 (release); si es
 * mayor, decrementa la profundidad manteniendo el duenño.
 */
void __vx_monexit(i64* obj) {
    i64* word_addr = obj + 2; // obj + 16 bytes
    i64 cur = __vsync_load64(word_addr);
    i64 depth = __vsync_depth(cur);
    if (depth <= 1) {
        *word_addr = 0; // ultima salida: liberar (release)
    } else {
        // Todavia reentrante: decrementar manteniendo el duenño.
        *word_addr = __vsync_make(__vsync_owner(cur), depth - 1);
    }
}

// ---------------------------------------------------------------------------
// API publica exportable (monitor sobre un host_ptr crudo al objeto).
// `synchronized` baja a __vx_monenter/__vx_monexit via el bundle; estos wrappers
// (sin prefijo `__`, exportables al .vxi) permiten a OTROS modulos (p.ej.
// vx_thread + codigo multihilo) tomar/soltar el monitor de un objeto por puntero.
// ---------------------------------------------------------------------------

/**
 * @brief Adquiere el monitor reentrante del objeto en @p obj (host_ptr).
 * @param obj host_ptr al ObjectHeader (palabra de monitor en obj+16).
 */
public void vx_lock(i64* obj) {
    __vx_monenter(obj);
}

/**
 * @brief Libera el monitor reentrante del objeto en @p obj (host_ptr).
 * @param obj host_ptr al ObjectHeader.
 */
public void vx_unlock(i64* obj) {
    __vx_monexit(obj);
}
