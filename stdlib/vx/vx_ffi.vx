// stdlib/vx/vx_ffi.vx
//
// Carga dinamica de LIBRERIAS NATIVAS en AOT (sin la VM): el AOT baja los
// opcodes `dlopen`/`dlsym` (builtins ffi_open/ffi_sym) a CALL a estas funciones
// .  Asi NO se depende del runtime de la VM y, sobre todo, el USUARIO puede
// REDEFINIR `__vx_dlopen`/`__vx_dlsym` en su propio modulo para cambiar como
// se cargan las librerias (igual que con __vx_malloc / __vx_write).
//
//   Windows: LoadLibraryA + GetProcAddress (kernel32).
//   POSIX:   dlopen(path, RTLD_NOW) + dlsym (libdl/libc).
//
// El path/nombre llegan como punteros a cstring NUL-terminada (el frontend los
// NUL-termina al emitir DLOPEN/DLSYM), tal y como esperan estas APIs.
//
// @Target no aplica a bloques `extern`; declaramos los de AMBAS plataformas sin
// condicion: el extern no usado (p.ej. dlopen en un build PE) lo elimina el
// dead-strip y NO se importa.

extern "kernel32.dll" {
	fn LoadLibraryA(u8 *path) -> u64;
	fn GetProcAddress(u64 hModule, u8 *name) -> u64;
}

extern "dl" {
	fn dlopen(u8 *path, i32 flags) -> u64;
	fn dlsym(u64 handle, u8 *name) -> u64;
}

// --- dlopen: cargar una libreria por nombre/ruta -> handle (0 si falla) ------
@Target("os:windows")
i64 __vx_dlopen(u8 *path) {
	return (i64) LoadLibraryA(path);
}
@Target("!os:windows")
i64 __vx_dlopen(u8 *path) {
	// RTLD_NOW = 2 (resolver todos los simbolos al cargar).
	return (i64) dlopen(path, 2);
}

// --- dlsym: resolver un simbolo en una libreria cargada -> direccion ---------
@Target("os:windows")
i64 __vx_dlsym(i64 handle, u8 *name) {
	return (i64) GetProcAddress((u64) handle, name);
}
@Target("!os:windows")
i64 __vx_dlsym(i64 handle, u8 *name) {
	return (i64) dlsym((u64) handle, name);
}
