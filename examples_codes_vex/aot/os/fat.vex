// ===========================================================================
// fat -- driver FAT12 minimo de solo-lectura.
//
// El boot carga la imagen de disco completa a RAM como ramdisk contiguo a
// partir de 0x7C00 (sector S -> 0x7C00 + S*512).  La imagen es una FAT12
// estandar: el BPB vive en el boot sector (offsets 0x0B..), seguido de la(s)
// FAT(s), el root directory y la zona de datos (clusters).  Este modulo monta
// la FAT leyendo el BPB y carga ficheros (los programas) por nombre 8.3
// siguiendo su cadena de clusters.  Sin int 0x13: en modo largo (64-bit) no
// hay BIOS; toda la "lectura de disco" es acceso al ramdisk en RAM.
// ===========================================================================

u64 RAMDISK = 0x7C00;          // base del ramdisk (sector 0 = boot sector)

// --- Lectura de campos del BPB (en el boot sector, RAMDISK + offset) ---
u64 bpb_u8(u64 off) {
    u8* p = (u8*) (RAMDISK + off);
    return (u64) p[0];
}
u64 bpb_u16(u64 off) {
    u16* p = (u16*) (RAMDISK + off);
    return (u64) p[0];
}

// Siguiente cluster en la cadena (FAT12: entradas de 12 bits empaquetadas).
u64 fat_next(u64 cluster) {
    u64 reserved = bpb_u16(0x0E);
    u64 fat_base = RAMDISK + reserved * 512;
    u64 off = cluster + (cluster / 2);            // cluster * 1.5
    u16* p = (u16*) (fat_base + off);
    u64 val = (u64) p[0];
    if ((cluster & 1) != 0) {
        return val >> 4;                          // cluster impar: 12 bits altos
    }
    return val & 0xFFF;                           // cluster par: 12 bits bajos
}

// Construye el nombre 8.3 (11 bytes, mayusculas, padded con espacios) en `dst`
// a partir del comando `name` (p.ej. "calc" -> "CALC       ").
void fat_mk83(char* name, u8* dst) {
    u64 i = 0;
    while (i < 11) { dst[i] = 32; i = i + 1; }    // rellenar de espacios
    i = 0;
    while (name[i] != 0 && i < 8) {
        u64 c = (u64) name[i];
        if (c >= 97 && c <= 122) { c = c - 32; }  // a-z -> A-Z
        dst[i] = (u8) c;
        i = i + 1;
    }
}

// Busca un fichero en el root directory.  Devuelve la direccion (en RAM) de su
// entrada de 32 bytes, o 0 si no existe.
u64 fat_find(char* name) {
    u64 reserved = bpb_u16(0x0E);
    u64 nfats = bpb_u8(0x10);
    u64 spf = bpb_u16(0x16);
    u64 root_ents = bpb_u16(0x11);
    u64 root_start = reserved + nfats * spf;
    u64 root_addr = RAMDISK + root_start * 512;
    u8 want[11];
    fat_mk83(name, want);
    u64 e = 0;
    while (e < root_ents) {
        u8* ent = (u8*) (root_addr + e * 32);
        if (ent[0] == 0) { return 0; }            // fin del directorio
        if (ent[0] != 0xE5) {                      // no es una entrada borrada
            u64 j = 0;
            bool eq = true;
            while (j < 11) {
                if (ent[j] != want[j]) { eq = false; }
                j = j + 1;
            }
            if (eq) { return root_addr + e * 32; }
        }
        e = e + 1;
    }
    return 0;
}

// Carga el fichero de la entrada `ent` a `dst` siguiendo su cadena de clusters.
// Devuelve el numero de bytes escritos (el tamano del fichero).
u64 fat_load(u64 ent, u8* dst) {
    u16* first_p = (u16*) (ent + 0x1A);            // primer cluster (low word)
    u32* size_p = (u32*) (ent + 0x1C);             // tamano del fichero
    u64 size = (u64) size_p[0];
    u64 spc = bpb_u8(0x0D);
    u64 reserved = bpb_u16(0x0E);
    u64 nfats = bpb_u8(0x10);
    u64 spf = bpb_u16(0x16);
    u64 root_ents = bpb_u16(0x11);
    u64 root_sects = (root_ents * 32 + 511) / 512;
    u64 data_start = reserved + nfats * spf + root_sects;
    u64 cluster = (u64) first_p[0];
    u64 csize = spc * 512;
    u64 written = 0;
    // Cluster valido: 2..0xFF7; >= 0xFF8 es fin-de-cadena (EOC).
    while (cluster >= 2 && cluster < 0xFF8 && written < size) {
        u64 sect = data_start + (cluster - 2) * spc;
        u8* src = (u8*) (RAMDISK + sect * 512);
        u64 k = 0;
        while (k < csize && written < size) {
            dst[written] = src[k];
            written = written + 1;
            k = k + 1;
        }
        cluster = fat_next(cluster);
    }
    return written;
}
