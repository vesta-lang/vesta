// AOT float SSE2: FABS (valor absoluto via ANDPS, mascara ~signbit).
// El valor negativo se deriva por recursion (runtime) para que el
// optimizador NO constant-foldee el fabs y el codegen ANDPS se ejerza
// de verdad.  FNEG (XORPS) tambien se valida de paso.

// Suma recursiva: produce un valor float runtime (no foldable).
f64 fsum(i64 n, f64 acc, f64 step) {
    if (n == 0) { return acc; }
    return fsum(n - 1, acc + step, step);
}

f64 myabs(f64 x) { return fabs(x); }   // -> IrOp::FABS -> ANDPS

i32 main() {
    f64 neg = fsum(4, 0.0, -2.5);   // -10.0 (runtime)
    f64 a = myabs(neg);              // |-10.0| = 10.0  (ANDPS)
    f64 pos = fsum(3, 0.0, 2.0);    // 6.0 (runtime)
    f64 b = myabs(pos);              // |6.0| = 6.0
    return (i32) (a + b);           // 16
}
