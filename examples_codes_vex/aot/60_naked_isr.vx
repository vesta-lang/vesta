// ===========================================================================
// Phase NR -- @Naked: funciones sin prologo/epilogo NI ret implicito.
//
// Es el primitivo fundacional de "Vesta sin runtime" para dev OS: con @Naked
// + inline asm el programador escribe ISRs, stubs de entry y rutinas de
// cambio de modo SIN que el compilador inserte ningun byte alrededor.  El
// cuerpo (tipicamente `asm { ... }`) se emite VERBATIM y el programador
// provee la salida real (ret / iretq / iret).  Misma semantica que
// `__attribute__((naked))` de GCC.
//
// Garantias del codegen AOT:
//   - sin push rbp / mov rbp,rsp / sub rsp (prologo).
//   - sin lea rsp / pop rbp (epilogo).
//   - sin el `ret` implicito del cierre de funcion.
//   - NO se elimina aunque ningun CALL la referencie (un ISR se referencia
//     desde la IDT, invisible al compilador) -> se siembra siempre.
//   - simbolo GLOBAL en el .o -> la rutina de setup de la IDT la referencia
//     por nombre (`dq isr_timer` en un bloque `bytes`, o desde asm).
//
// Compilar:  vm --vex 60_naked_isr.vex -m aot --emit obj --format elf -o isr.o
//   objdump -d isr.o  ->  <isr_timer> es EXACTAMENTE el asm de abajo.
// ===========================================================================

// ISR de timer (PIC maestro): envia EOI (0x20) al puerto de comando 0x20 y
// retorna con iretq.  Sin params, void.  El desensamblado es solo estas
// cinco instrucciones; el compilador no anade nada.
@Naked void isr_timer() {
    asm volatile {
        push rax
        mov al, 0x20
        out 0x20, al
        pop rax
        iretq
    }
}

// @Naked tambien sirve para helpers de bajo nivel con ABI manual.  Aqui se
// llama desde Vex normal: en SysV (ELF) los args llegan en rdi/rsi y el
// resultado se devuelve en rax, igual que cualquier funcion -- pero el cuerpo
// es asm puro sin frame.  add_naked(40, 2) == 42.
@Naked i64 add_naked(i64 a, i64 b) {
    asm volatile {
        mov rax, rdi
        add rax, rsi
        ret
    }
}

i64 main() {
    // isr_timer existe en el binario (GLOBAL) aunque no la llamemos: la
    // referenciaria la IDT.  Aqui solo ejercitamos add_naked.
    return add_naked(40, 2);  // -> exit code 42
}
