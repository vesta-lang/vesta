// AOT Inc 2: binario plano (.bin) sin cabecera.
// El layout = .text (main en offset 0) ++ .rodata (bytes block) verbatim.
// Util para ROMs, payloads cargados en una direccion fija, firmware.

// Datos crudos al final de la imagen (p.ej. una firma o tabla).
bytes firma {
    db "VEX", 0x00            // 56 45 58 00
    dw 0xCAFE                  // FE CA
    dd 0x12345678             // 78 56 34 12
}

i32 main() {
    return 0x42;              // 66
}
