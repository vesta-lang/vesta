// Interop C (Fase 4): este modulo Vex se usa DESDE C sin friccion.
//
// Compilado con `vex --port c --emit-header` produce:
//   - 205_c_interop.c : las DEFINICIONES (codigo C portado del IR).
//   - 205_c_interop.h : las DECLARACIONES publicas (typedefs de structs
//                       C-compatibles + prototipos de funciones con firma
//                       C-representable + punteros a funcion cfn).
//
// Un programa C incluye el .h y enlaza el .c (ver 205_c_interop_consumer.c).
// Es un MODULO LIBRERIA: sin `main` (no es ejecutable, es importable).  Solo
// expone tipos del carril C-representable (POD, cfn, structs C-compat); los
// tipos gestionados (string/clase/fn capturador) NO cruzan la frontera C.
// Ver doc/VMdoc/Vex/InteropC.md.

// Struct C-compat (layout C: orden de declaracion + alineacion de plataforma).
// El header lo emite como `typedef struct { double x, y; } Vec2;`.
struct Vec2 {
    f64 x;
    f64 y;
}

// Struct cruza POR PUNTERO (ABI de agregados); el header declara
// `double vec2_dot(Vec2* a, Vec2* b);` -- ABI-compatible con el .c (void*).
f64 vec2_dot(Vec2 a, Vec2 b) {
    return a.x * b.x + a.y * b.y;
}

// Callback C: el parametro `cfn(i64) -> i64` es un puntero a funcion CRUDO
// estilo C.  El header lo declara como `int64_t (*f)(int64_t)`.  Un programa
// C pasa una funcion suya directamente.
i64 apply(cfn(i64) -> i64 f, i64 x) {
    return f(x);
}

// Funcion escalar pura: prototipo C directo `int64_t add3(int64_t, ...)`.
i64 add3(i64 a, i64 b, i64 c) {
    return a + b + c;
}
