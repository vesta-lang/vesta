// examples_codes_vex/235_unique_wraps_gc.vex
//
// Combinacion de modelos de memoria: unique<gc<T>>.  Un smart pointer
// unique envuelve un objeto gestionado por GC.  El objeto GC lo recolecta
// el recolector; el unique solo sostiene el handle.  Se puede leer el
// valor a traves del handle GC original (aun accesible en el scope).
//
// Verifica que las dos gestiones (RAII del unique + GC del objeto)
// coexisten sin colision.  Igual en interp/JIT y AOT nativo.
//
// Esperado: R00 == 42.

class Nodo {
    public i64 v;
    public Nodo(i64 x) { this.v = x; }
}

i32 main() {
    gc<Nodo> g = new Nodo(42);
    unique<gc<Nodo>> u = unique_box(g);
    return (i32) g.v;              // 42; el GC recoge el Nodo, u no lo libera
}
