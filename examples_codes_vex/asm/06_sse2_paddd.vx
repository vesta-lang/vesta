// SSE2 (vectorizacion real): suma 4 enteros i32 EN PARALELO con una sola
// instruccion `paddd` (packed add dword).  Patron tipico de SIMD: los datos
// viven en memoria (host, via malloc) y los register() ligan PUNTEROS (GP);
// el registro vectorial xmm0 es scratch interno del asm (clobber), no un
// binding -> no requiere soporte de banco XMM en el regalloc.
//
//     vm --vex 06_sse2_paddd.vex -o sse && vm --run sse.velb
//
// @expect 110
i32 main() {
    i32* a = malloc(16);                 // 4 x i32 (host)
    i32* b = malloc(16);

    a[0] = 1;  a[1] = 2;  a[2] = 3;  a[3] = 4;
    b[0] = 10; b[1] = 20; b[2] = 30; b[3] = 40;

    register("rdi") i32* pa = a;
    register("rsi") i32* pb = b;
    
    asm volatile {
        movdqu xmm0, [rdi]               // xmm0 = a[0..3]
        paddd  xmm0, [rsi]               // xmm0 += b[0..3] (4 sumas en 1 instr)
        movdqu [rdi], xmm0               // a[0..3] = resultado
    };
    return a[0] + a[1] + a[2] + a[3];     // 11+22+33+44 = 110
}
