// examples_codes_vex/analyze/cost_interproc.vex
//
// Ejemplos para el coste INTERPROCEDURAL (PARCIAL vs TOTAL) y la diferencia
// PRE-opt vs POST-opt del modo --analyze.
//
// Cubre:
//   - PARCIAL != TOTAL: una funcion con un loop que llama a otra O(n) ->
//     parcial O(n) (call=O(1)), TOTAL O(n^2) (callee compuesto).
//   - cadena f -> g -> h para ver la transitividad del call-graph.
//   - PRE vs POST: el analizador reporta el coste sobre el IR del FUENTE
//     (PRE-opt) y sobre el IR FINAL tras O2 (POST-opt).  NOTA: el optimizer
//     O2 actual hace inline/DCE/copy-prop/LICM pero NO elimina loops ni
//     hace unrolling que rebaje la clase asintotica; por eso en estos
//     ejemplos PRE y POST coinciden en la clase de complejidad.  La
//     infraestructura reporta ambos para que, si el optimizer gana
//     dead-loop-elimination en el futuro, la diferencia aflore sola
//     (p.ej. loop_muerto pasaria de PRE O(n) a POST O(1)).
//
// Uso:
//   vm --analyze examples_codes_vex/analyze/cost_interproc.vex
//   vm --analyze examples_codes_vex/analyze/cost_interproc.vex --analyze-json

// Hoja del call-graph: O(n) puro (un loop).
i64 trabajo_lineal(i64 n) {
    i64 acc = 0;
    i64 i = 0;
    while (i < n) {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

// PARCIAL O(n) (su unico loop), llama a trabajo_lineal (O(n)) DENTRO del loop
// -> TOTAL O(n^2).  El call site esta a profundidad de loop 1, por lo que el
// O(n) del callee se multiplica por n.
i64 agregador(i64 n) {
    i64 total = 0;
    i64 i = 0;
    while (i < n) {
        total = total + trabajo_lineal(n);
        i = i + 1;
    }
    return total;
}

// Cadena de transitividad: nivel_h es la hoja (O(n)).
i64 nivel_h(i64 n) {
    i64 acc = 0;
    i64 i = 0;
    while (i < n) {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

// nivel_g: sin loops propios (parcial O(1)), pero llama a nivel_h (O(n))
// fuera de cualquier loop -> TOTAL O(n).
i64 nivel_g(i64 n) {
    return nivel_h(n) + 1;
}

// nivel_f: un loop propio (parcial O(n)) y dentro llama a nivel_g (TOTAL O(n))
// -> TOTAL O(n^2) por transitividad (f -> g -> h compuesto).
i64 nivel_f(i64 n) {
    i64 s = 0;
    i64 i = 0;
    while (i < n) {
        s = s + nivel_g(n);
        i = i + 1;
    }
    return s;
}

// Candidato a PRE != POST: el loop calcula 'basura' que NO se usa (resultado
// muerto).  Un optimizer con dead-loop-elimination lo dejaria en O(1).  El O2
// actual NO elimina el loop (no tiene esa pasada), asi que PRE == POST == O(n);
// el ejemplo documenta el comportamiento real y deja el caso listo para
// cuando el optimizer gane esa capacidad.
i64 loop_muerto(i64 n) {
    i64 basura = 0;
    i64 i = 0;
    while (i < n) {
        basura = basura + i * 3;
        i = i + 1;
    }
    // 'basura' nunca se usa: el loop es codigo muerto.
    return 42;
}

i32 main() {
    i64 r = agregador(4) + nivel_f(4) + loop_muerto(10);
    return 0;
}
