// ============================================
// SSA IR pre-optimizacion (frontend output)
// ============================================
// SSA IR - VestaVM
@module bench_struct_field

@format velb

@function main() -> i32 {
entry_0:
    %v = alloca.i8 12
    %1 = const.i64 0
    store %1, %v
    %2 = const.i64 8
    %3 = add.i64 %v, %2
    %4 = const.i32 0
    store %4, %3
    %5 = const.i64 1
    %6 = trunc.i32 %5
    store %6, %v
    %7 = const.i64 2
    %8 = trunc.i32 %7
    %9 = const.i64 4
    %10 = add.i64 %v, %9
    store %8, %10
    %11 = const.i64 3
    %12 = trunc.i32 %11
    %13 = const.i64 8
    %14 = add.i64 %v, %13
    store %12, %14
    %15 = const.i64 0
    %sum = trunc.i32 %15
    %17 = const.i64 0
    %i = trunc.i32 %17
    br while_header_1
while_header_1:
    %19 = phi.i32 [%i, entry_0] [%52, while_body_2]
    %20 = phi.i32 [%sum, entry_0] [%50, while_body_2]
    %21 = const.i64 30000000
    %22 = sext.i64 %19
    %23 = cmp.lt.bool %22, %21
    br.cond %23, while_body_2, while_exit_3
while_body_2:
    %24 = load.i32 %v
    %25 = const.i32 1
    %26 = add.i32 %24, %25
    store %26, %v
    %27 = const.i64 4
    %28 = add.ptr %v, %27
    %29 = const.i64 4
    %30 = add.ptr %v, %29
    %31 = load.i32 %30
    %32 = const.i32 2
    %33 = add.i32 %31, %32
    store %33, %28
    %34 = const.i64 8
    %35 = add.ptr %v, %34
    %36 = const.i64 8
    %37 = add.ptr %v, %36
    %38 = load.i32 %37
    %39 = const.i32 3
    %40 = add.i32 %38, %39
    store %40, %35
    %41 = load.i32 %v
    %42 = add.i32 %20, %41
    %43 = const.i64 4
    %44 = add.ptr %v, %43
    %45 = load.i32 %44
    %46 = add.i32 %42, %45
    %47 = const.i64 8
    %48 = add.ptr %v, %47
    %49 = load.i32 %48
    %50 = add.i32 %46, %49
    %51 = const.i32 1
    %52 = add.i32 %19, %51
    br while_header_1
while_exit_3:
    ret.i32 %20
}


// ============================================
// SSA IR post-optimizacion (opt_level=2)
// ============================================
// SSA IR - VestaVM
@module bench_struct_field

@format velb

@function main() -> i32 {
entry_0:
    %6 = const.i32 1
    %9 = const.i64 4
    %v = alloca.i8 12
    store %6, %v
    %8 = const.i32 2
    %10 = add.i64 %v, %9
    %13 = const.i64 8
    store %8, %10
    %12 = const.i32 3
    %14 = add.i64 %v, %13
    store %12, %14
    %sum = const.i32 0
    %28 = add.ptr %v, %9
    %35 = add.ptr %v, %13
    %21 = const.i64 30000000
    br while_header_1
while_header_1:
    %19 = phi.i32 [%sum, entry_0] [%52, while_body_2]
    %20 = phi.i32 [%sum, entry_0] [%50, while_body_2]
    %22 = sext.i64 %19
    %23 = cmp.lt.bool %22, %21
    br.cond %23, while_body_2, while_exit_3
while_body_2:
    %24 = load.i32 %v
    %26 = add.i32 %24, %6
    store %26, %v
    %31 = load.i32 %28
    %33 = add.i32 %31, %8
    store %33, %28
    %38 = load.i32 %35
    %40 = add.i32 %38, %12
    store %40, %35
    %41 = load.i32 %v
    %42 = add.i32 %20, %41
    %45 = load.i32 %28
    %46 = add.i32 %42, %45
    %50 = add.i32 %46, %40
    %52 = add.i32 %19, %6
    br while_header_1
while_exit_3:
    ret.i32 %20
}

