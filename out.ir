// ============================================
// SSA IR pre-optimizacion (frontend output)
// ============================================
// SSA IR - VestaVM
@module t16d2

@format velb

@function main() -> i64 {
entry_0:
    %n = const.i64 8
    %1 = const.i64 2
    %2 = mul.i64 %n, %1
    %3 = raw_alloc.ptr %2
    %a = bitcast.ptr %3
    %5 = const.i64 2
    %6 = mul.i64 %n, %5
    %7 = raw_alloc.ptr %6
    %b = bitcast.ptr %7
    %9 = const.i64 2
    %10 = mul.i64 %n, %9
    %11 = raw_alloc.ptr %10
    %c = bitcast.ptr %11
    %i = const.i64 0
    br while_header_1
while_header_1:
    %14 = phi.i64 [%i, entry_0] [%28, while_body_2]
    %15 = cmp.lt.bool %14, %n
    br.cond %15, while_body_2, while_exit_3
while_body_2:
    %16 = const.i64 2
    %17 = mul.i64 %14, %16
    %18 = add.ptr %a, %17
    %19 = const.i64 5
    %20 = trunc.i16 %19
    store %20, %18
    %21 = const.i64 2
    %22 = mul.i64 %14, %21
    %23 = add.ptr %b, %22
    %24 = const.i64 1
    %25 = add.i64 %14, %24
    %26 = trunc.i16 %25
    store %26, %23
    %27 = const.i64 1
    %28 = add.i64 %14, %27
    br while_header_1
while_exit_3:
    %29 = const.i64 0
    %30 = const.i64 16
    %31 = const.i64 2
    br vec_main_hdr_4
vec_main_hdr_4:
    %32 = phi.i64 [%29, while_exit_3] [%39, vec_main_body_5]
    %33 = add.i64 %32, %30
    %34 = cmp.le.bool %33, %n
    br.cond %34, vec_main_body_5, vec_tail_hdr_6
vec_main_body_5:
    %35 = mul.i64 %32, %31
    %36 = add.ptr %c, %35
    %37 = add.ptr %a, %35
    %38 = add.ptr %b, %35
    vec_binop %36, %37, %38, imm=544
    %39 = add.i64 %32, %30
    br vec_main_hdr_4
vec_tail_hdr_6:
    %40 = phi.i64 [%32, vec_main_hdr_4] [%51, vec_tail_body_7]
    %41 = cmp.lt.bool %40, %n
    br.cond %41, vec_tail_body_7, vec_exit_8
vec_tail_body_7:
    %42 = const.i64 2
    %43 = mul.i64 %40, %42
    %44 = add.ptr %a, %43
    %45 = load.i16 %44
    %46 = add.ptr %b, %43
    %47 = load.i16 %46
    %48 = sub.i16 %45, %47
    %49 = add.ptr %c, %43
    store %48, %49
    %50 = const.i64 1
    %51 = add.i64 %40, %50
    br vec_tail_hdr_6
vec_exit_8:
    %52 = const.i64 0
    br while_header_9
while_header_9:
    %53 = phi.i64 [%52, vec_exit_8] [%67, while_body_10]
    %54 = cmp.lt.bool %53, %n
    br.cond %54, while_body_10, while_exit_11
while_body_10:
    %55 = str_lit_addr.ptr
    %56 = const.i64 2
    %57 = getproc.ptr
    calln @stdlib/native/io/vesta_io:vio_print(%57, %55, %56)
    calln @stdlib/native/io/vesta_io:vio_print_int(%53)
    %58 = str_lit_addr.ptr
    %59 = const.i64 2
    %60 = getproc.ptr
    calln @stdlib/native/io/vesta_io:vio_print(%60, %58, %59)
    %61 = const.i64 2
    %62 = mul.i64 %53, %61
    %63 = add.ptr %c, %62
    %64 = load.i16 %63
    %65 = sext.i64 %64
    calln @stdlib/native/io/vesta_io:vio_print_int(%65)
    calln @stdlib/native/io/vesta_io:vio_print_newline()
    %66 = const.i64 1
    %67 = add.i64 %53, %66
    br while_header_9
while_exit_11:
    raw_free %a
    raw_free %b
    raw_free %c
    %68 = const.i64 0
    ret.i64 %68
}


// ============================================
// SSA IR post-optimizacion (opt_level=2)
