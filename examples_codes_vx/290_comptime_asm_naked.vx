// -----------------------------------------------------------------------------
// Una `comptime fn` puede LLAMAR a un helper @Naked (cuerpo asm puro) y el
// resultado se computa en COMPILE-TIME en el ComptimeVM (JIT + interp fallback).
// El @Naked se compila al vuelo dentro del ComptimeVM via vrt:naked_dispatch.
// interp = JIT = AOT.
// -----------------------------------------------------------------------------

// Helper @Naked: cuerpo asm nativo puro (sin prologo/epilogo), devuelve 42.
@Naked
i64 fortytwo() {
	asm volatile {
		mov rax, 42
		ret
	}
}

// comptime fn que llama al helper @Naked -> ejecutado en el ComptimeVM.
comptime i64 c_get() { return fortytwo(); }

// El valor se usa en una constante compile-time + static_assert.
const i64 V = c_get();
static_assert(V == 42, "fortytwo() debe ser 42");

i32 main() {
	return (i32) V; // 42
}
