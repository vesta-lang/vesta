namespace ejemplos.asignar_subclase;

// Una subclase cabe donde se espera la base, se escriba como se escriba.
//
// La misma conversion aparece en seis sitios -- al declarar, al reasignar, al
// devolver, al pasar un argumento, al guardar en un campo y al entrar por un
// `set` --, y tiene que dar la misma respuesta en los seis.  Se separaron: la
// reasignacion la rechazaba, asi que `Base b = new Derivada();` compilaba y
// `b = new Derivada();` no.
//
// Pasaba desapercibido porque la reasignacion si consultaba la mitad del
// criterio, la de las interfaces: con el destino declarado como interfaz
// funcionaba y solo fallaba con la superclase, que es el caso que un programa
// escribe sin pensarlo.
//
// Este ejemplo recorre los seis sitios con el destino declarado de las DOS
// formas -- superclase e interfaz -- y comprueba ademas que la llamada acaba en
// el metodo de la subclase, que es de lo que sirve el ascenso.

interface Habla {
	i64 decir();
}

class Animal {
	public i64 patas() { return 1; }
}

class Perro : Animal {
	@Override
		public i64 patas() { return 4; }
}

// El que cumple la interfaz va APARTE, sin superclase, a proposito: una clase
// que hereda Y cumple una interfaz destapa un fallo distinto del camino nativo
// -- las ranuras de la interfaz pisan las de la clase --, y este ejemplo esta
// para fijar el ascenso, no para arrastrar aquello.  El fallo tiene su propio
// reproductor.
class Loro : Habla {
	public i64 decir() { return 10; }
}

class Jaula {
	public Animal dentro;
	public Habla quien;

	public Jaula(Animal a, Habla h) {
		this.dentro = a; // argumento del constructor + guardar en campo
		this.quien  = h;
	}

	// El parametro de un `set` es otro de los seis sitios.
	public set ocupante(Animal a) { this.dentro = a; }
}

// El retorno: se declara la base y se devuelve la subclase.
Animal fabricar() {
	return new Perro();
}

Habla fabricar_habla() {
	return new Loro();
}

// El argumento: se declara la base y se pasa la subclase.
i64 patas_de(Animal a) { return a.patas(); }
i64 dice(Habla h) { return h.decir(); }

i32 main() {
	// 1. Declarar con inicializador.
	Animal a = new Perro();
	Habla  h = new Loro();

	// 2. REASIGNAR: el caso que fallaba.  Con la superclase declarada como
	//    destino daba "tipo del valor (Perro) incompatible con tipo del
	//    destino (Animal)"; con la interfaz, no.
	a = new Perro();
	h = new Loro();

	// 3. Retorno.
	      Animal r  = fabricar();
	      Habla  rh = fabricar_habla();

	// 4. Argumento.
	const i64    p1 = patas_de(new Perro());
	const i64    d1 = dice(new Loro());

	// 5. Campo, por el constructor.
	      Jaula  j  = new Jaula(new Perro(), new Loro());

	// 6. Parametro de un `set`.
	j.ocupante = new Perro();

	// El ascenso sirve para que la llamada acabe en el metodo de la subclase:
	// si el despacho se quedara en la base, cada `patas()` daria 1 y no 4.
	const i64 patas = a.patas() + r.patas() + p1 + j.dentro.patas(); // 16
	const i64 voces = h.decir() + rh.decir() + d1; // 30

	println("patas=${patas} voces=${voces}");

	// 16 + 30 = 46
	return (i32)(patas + voces - 4); // 42
}
