// Mutex cooperativo de fibras: N fibras incrementan un contador compartido M
// veces cada una dentro de la seccion critica.  El incremento es un
// read-modify-write NO atomico sobre un global; sin el mutex, las fibras (sobre
// varios hilos del SO) se pisan y el total sale menor.  Con el mutex, el total
// es EXACTO (N*M) -> prueba la exclusion mutua cross-hilo.
import std.pool only pool_start, pool_submit, pool_join;
import std.mutex only Mutex, mutex_new, mutex_lock, mutex_unlock,
mutex_free;

Mutex g_mtx; // handle tipado (overlay) como global
      i64 g_counter = 0;
const i64 NF        = 4; // fibras
const i64 M         = 20_000; // incrementos por fibra

void worker(i64 a) {
	for (i64 i = 0; i < M; i++) {
		mutex_lock(g_mtx);
		g_counter += 1; // seccion critica (RMW no atomico)
		mutex_unlock(g_mtx);
	}
}
i32 main() {
	g_mtx = mutex_new();
	pool_start(4);
	for (i64 i = 0; i < NF; i++) {
		pool_submit((i64)(cfn(i64) -> void) worker, 0);
	}
	pool_join();
	mutex_free(g_mtx);
	// total esperado = NF * M = 80000.
	if (g_counter == NF * M) {
		return 42;
	}
	return 1;
}
