// =============================================================================
// 185_vectorize_int.vx
//
// Auto-vectorizacion con ENTEROS (no solo floats).  El mismo idiom
// `c[i] = a[i] OP b[i]` y la reduccion `acc = acc + a[i]` se vectorizan para
// punteros HOST de tipo i64/u64 (W=2 lanes por registro SSE2 de 128b) e
// i32/u32 (W=4 lanes).  Solo suma/resta: SSE2 no tiene multiplicacion ni
// division PACKED de enteros, asi que mul/div caen al camino escalar.
//
//   - i64:  PADDQ/PSUBQ  (2 lanes de 64b)
//   - i32:  PADDD/PSUBD  (4 lanes de 32b)
//
// En el JIT/AOT el bucle interior es SIMD; en el interprete (oraculo), escalar
// por lane.  Resultado IDENTICO (solo cambia la velocidad).  Sirve de
// documentacion del patron + validacion (interp == jit).
// =============================================================================

// Suma vectorizada de un array i64 (reduccion).
i64 sum_i64(i64* p, i32 n) {
    i64 acc = 0;
    for (i32 i = 0; i < n; i++) { acc = acc + p[i]; }   // REDUCCION i64 (PADDQ)
    return acc;
}

i64 main() {
    i64 total = 0;

    // --- element-wise i64: c[i] = a[i] + b[i]  (PADDQ, W=2) ---
    i64* a = malloc(80);   // 10 x i64
    i64* b = malloc(80);
    i64* c = malloc(80);
    for (i32 i = 0; i < 10; i++) { a[i] = (i64)(i + 1); b[i] = (i64)(i * 2); }
    for (i32 i = 0; i < 10; i++) { c[i] = a[i] + b[i]; }   // c[i] = 3i+1
    total = total + sum_i64(c, 10);                        // sum(3i+1) = 145

    // --- element-wise i32: e[i] = x[i] - y[i]  (PSUBD, W=4, con cola 7%4=3) ---
    i32* x = malloc(28);   // 7 x i32
    i32* y = malloc(28);
    i32* e = malloc(28);
    for (i32 i = 0; i < 7; i++) { x[i] = (i + 10) * 3; y[i] = i; }
    for (i32 i = 0; i < 7; i++) { e[i] = x[i] - y[i]; }    // e[i] = 2i+30
    i32 se = 0;
    for (i32 i = 0; i < 7; i++) { se = se + e[i]; }         // sum(2i+30) = 42+210 = 252
    total = total + (i64) se;

    // --- reduccion i64 con N impar (ejercita la cola escalar) ---
    i64* d = malloc(56);   // 7 x i64
    for (i32 i = 0; i < 7; i++) { d[i] = (i64)(2 * i + 1); }
    total = total + sum_i64(d, 7);                          // 1+3+5+7+9+11+13 = 49

    free(a); free(b); free(c);
    free(x); free(y); free(e);
    free(d);

    // total = 145 + 252 + 49 = 446
    return total;
}
