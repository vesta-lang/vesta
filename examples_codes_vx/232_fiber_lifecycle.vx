namespace ejemplos.fiber_lifecycle;

// 232_fiber_lifecycle.vx
//
// F2 de las fibras nativas: valida el CICLO DE VIDA COMPLETO de una fibra
// usando el MODULO CANONICO IMPORTADO (`import "vx_fiber"`, NO inlineado).
// A diferencia de 230 (que inlinea los primitivos), aqui los primitivos
// fiber_switch / fiber_init / fiber_stack_alloc / fiber_stack_free vienen del
// modulo stdlib/vx/vx_fiber.vx a traves de un `import ... only`.  Esto
// ejercita la ruta cross-modulo de @Naked en interp/JIT (LIM-A/B, cerrada en
// 90779cc + 8cd25d8) y la propagacion de native_imports del runner de asm.
//
// CICLO DE VIDA VALIDADO:
//   1. crear una fibra (pila host + ctx host + fiber_init).
//   2. arrancarla (fiber_switch main -> fibra).
//   3. la fibra incrementa un contador (=1) y CEDE (fiber_switch fibra -> main).
//   4. main la REANUDA (fiber_switch main -> fibra).
//   5. la fibra incrementa otra vez (=2) y TERMINA cediendo definitivo a main.
//   6. main libera la pila.
//   R0 = contador final = 2, IDENTICO en -m vm / -m jit / -m aot.
//
// FRONTERA NATIVO/VM:  el cuerpo de la fibra (@Naked) y fiber_switch corren
// SIEMPRE como codigo NATIVO.  Toda la memoria que tocan (ctx + estado
// compartido) vive en memoria HOST (malloc), NO en el stack VM (en interp
// `&local` seria un vaddr VM que el codigo nativo malinterpretaria).
//
// POR QUE EL CUERPO DE LA FIBRA ES @Naked (no una fn Vex normal):  la fibra
// corre sobre SU PROPIA pila nativa (la que reserva fiber_stack_alloc).  Una fn
// Vex normal, en interp, asume un frame VM y direcciones VM; ejecutandola sobre
// una pila host cruda romperia esa suposicion.  El cuerpo @Naked es asm puro:
// no asume runtime, solo lee/escribe el estado host que le pasamos por r13.
// Es el mismo enfoque que 230, y vale en los 3 modos via naked_native.
//
// Compilar/ejecutar:
//   vm --vx 232_fiber_lifecycle.vx -o p && vm -m vm  --run p.velb   (R00=2)
//   vm --vx 232_fiber_lifecycle.vx -o p && vm -m jit --run p.velb   (R00=2)
//   vm -m aot --vx 232_fiber_lifecycle.vx --format pe -o p.exe && ./p.exe  (exit 2)

import "vx_fiber" only fiber_switch, fiber_init, fiber_stack_alloc, fiber_stack_free;

// ===========================================================================
//  Cuerpo de fibra (@Naked): incrementa, cede, se reanuda, incrementa, termina.
//  El arg (base del estado host) llega en rcx (Win64) / rdi (SysV) via el
//  trampolin de vx_fiber; se guarda en r13 (callee-saved: fiber_switch lo
//  preserva por-fibra, asi sobrevive a la cesion y reanudacion).
//  Layout del estado host (3 qwords): [base+0]=counter [+8]=self_ctx [+16]=main_ctx
// ===========================================================================
@Target("!os:windows")
@Naked void fiber_body() {
    asm volatile noinfer {
        mov r13, rdi
        // --- fase 1: incrementar (counter -> 1) ---
        mov rax, [r13 + 0]
        add rax, 1
        mov [r13 + 0], rax
        // ceder a main (fiber_switch(self, main))
        mov rdi, [r13 + 8]
        mov rsi, [r13 + 16]
        call fiber_switch
        // --- fase 2 (tras reanudar): incrementar (counter -> 2) ---
        mov rax, [r13 + 0]
        add rax, 1
        mov [r13 + 0], rax
        // terminar: ceder definitivo a main (no retorna)
        mov rdi, [r13 + 8]
        mov rsi, [r13 + 16]
        call fiber_switch
        ret
    }
}
@Target("os:windows")
@Naked void fiber_body() {
    asm volatile noinfer {
        mov r13, rcx
        // --- fase 1: incrementar (counter -> 1) ---
        mov rax, [r13 + 0]
        add rax, 1
        mov [r13 + 0], rax
        // ceder a main (fiber_switch(self, main))
        mov rcx, [r13 + 8]
        mov rdx, [r13 + 16]
        call fiber_switch
        // --- fase 2 (tras reanudar): incrementar (counter -> 2) ---
        mov rax, [r13 + 0]
        add rax, 1
        mov [r13 + 0], rax
        // terminar: ceder definitivo a main (no retorna)
        mov rcx, [r13 + 8]
        mov rdx, [r13 + 16]
        call fiber_switch
        ret
    }
}

// ===========================================================================
//  Orquestacion del ciclo de vida.
// ===========================================================================
u64 run() {
    // Bloque HOST: 2 celdas de contexto + estado de 3 qwords.
    //   [0]=main_ctx  [1]=fib_ctx  [2]=counter  [3]=self_ctx  [4]=main_ctx(copia)
    u64 blk = (u64)malloc(5 * 8);
    u64 main_ctx = blk + 0 * 8;
    u64 fib_ctx  = blk + 1 * 8;

    // Estado de la fibra (3 qwords desde el offset 2).
    u64 st = blk + 2 * 8;
    u64* ps = (u64*)st;
    ps[0] = 0;         // counter
    ps[1] = fib_ctx;   // self_ctx  (la fibra cede con fiber_switch(self, main))
    ps[2] = main_ctx;  // main_ctx

    // Pila de la fibra (64 KiB) en memoria host, via el modulo importado.
    u64 stk = fiber_stack_alloc(65536);

    // Crear la fibra: 1er switch arrancara fiber_body(st) sobre stk.
    fiber_init(fib_ctx, stk, (u64)(cfn() -> void) fiber_body, st);

    // Paso 1: arrancar (main -> fibra).  La fibra incrementa (counter=1) y cede.
    fiber_switch(main_ctx, fib_ctx);
    // Aqui counter == 1.

    // Paso 2: reanudar (main -> fibra).  La fibra incrementa (counter=2) y termina.
    fiber_switch(main_ctx, fib_ctx);
    // Aqui counter == 2 y la fibra ya cedio definitivo.

    u64 total = ps[0];   // 2

    // Liberar la pila (via el modulo importado).
    fiber_stack_free(stk, 65536);
    free((i64*)blk);
    return total;
}

i32 main() {
    u64 r = run();
    return (i32)r;   // 2
}
