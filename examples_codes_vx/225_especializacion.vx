namespace ejemplos.especializacion;

// Especializacion de structs genericos: total + parcial (#7).
//
// Tras el template PRIMARIO `struct Caja<T>`, se pueden declarar
// especializaciones para casos concretos:
//   - TOTAL:   `struct Caja<i64>`  / `struct Caja<Punto>`  (tipo EXACTO)
//   - PARCIAL: `struct Caja<T*>`                            (PATRON: cualquier
//                                                            puntero; T es un
//                                                            param fresco)
// Al instanciar `Caja<X>`, el compilador elige la especializacion MAS
// ESPECIFICA que matchee (exacta > patron > primario) y clona ESA definicion.
// Cada especializacion puede tener campos y metodos DISTINTOS.  Es 100%
// compile-time: el backend (interp / JIT / AOT) ve structs concretos normales,
// sin ningun artefacto generico en runtime.
//
// Regla de params frescos: un identificador DESNUDO en el patron es un tipo
// CONCRETO (total: `Caja<Punto>`); un identificador DENTRO de un patron
// compuesto (`T*`, `T[]`) es un param FRESCO (parcial: `Caja<T*>`).

struct Punto {
	i64 x;
	i64 y;
}

// ---- PRIMARIO ------------------------------------------------------------
struct Caja<T> {
	T v;
	i64 clase() { return 1; } // marca: "primario"
}

// ---- TOTAL sobre un primitivo: i64 exacto --------------------------------
struct Caja<i64> {
	i64 v;
	i64 extra;                // campo EXTRA que el primario no tiene
	i64 clase() { return 2; } // marca: "total i64"
}

// ---- TOTAL sobre un tipo de usuario: Punto exacto ------------------------
struct Caja<Punto> {
	Punto v;
	i64 clase() { return 3; } // marca: "total Punto"
}

// ---- PARCIAL: cualquier puntero host (T es param fresco) -----------------
struct Caja<T*> {
	T*   v;
	bool propio;              // campo EXTRA propio del patron puntero
	i64 clase() { return 4; } // marca: "parcial T*"
}

i32 main() {
	Caja<i32>   a   = {.v = 7};             // -> primario  (clase=1)
	Caja<i64>   b   = {.v = 10,.extra = 5}; // -> total i64 (clase=2, extra=5)
	Punto       pt  = {.x = 1,.y = 2};
	Caja<Punto> c   = {.v = pt}; // -> total Punto (clase=3)
	i64*        raw = (i64*) malloc(8);
	Caja<i64*>  d   = {.v = raw,.propio = true}; // -> parcial T* (clase=4)

	// Suma de marcas: 1 + 2 + 3 + 4 = 10.  Mas el campo extra (5) de la total.
	i64 marcas = a.clase() + b.clase() + c.clase() + d.clase();
	free(raw);
	println("a=${a.clase()} b=${b.clase()} c=${c.clase()} d=${d.clase()} extra=${b.extra}");
	return (i32)(marcas + b.extra + 27); // 10 + 5 + 27 = 42
}
