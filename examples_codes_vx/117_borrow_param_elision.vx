namespace ejemplos.borrow_param_elision;

// Test F2 + F4: param borrow + lifetime elision rule 1.
//
// F2: el parametro `p` se registra como Param -> su borrow puede
// retornarse via on_borrow_escape sin error.
//
// F4: la funcion `identity_borrow` devuelve un borrow<i32> y tiene
// exactamente 1 borrow param.  El borrow checker aplica la regla de
// elision: el lifetime del retorno = lifetime de p.  En el callsite
// el borrow resultante tiene como owner el argumento original.

// Identidad: devuelve el mismo borrow recibido.
borrow<i32> identity_borrow(borrow<i32> p) => p;

// Read-through via borrow: cualquier funcion que recibe un borrow y
// devuelve un valor (no un borrow) NO necesita elision.
i32 deref_borrow(borrow<i32> p) => read_borrow(p);

// Un prestamo SIN NOMBRE tambien sale por `return`, y se juzga igual: por la
// memoria que presta.  `p` apunta dentro de lo que el LLAMANTE paso, asi que el
// prestamo vive lo que viva eso y puede salir.  El mismo `return` sobre un
// local de esta funcion es un error (ver 609).
struct Caja {
	i64 v;
}

borrow_mut<i64> campo_de(Caja* c) {
	i64* p = &(*c).v;
	return lend_mut(p);
}

// Presta lo APUNTADO por un puntero, no la ranura del puntero: escribir por el
// prestamo cambia `c.v`.
i32 por_puntero() {
	Caja            c = {.v = 41};
	borrow_mut<i64> b = campo_de(&c);
	write_borrow(b, 42);
	return (i32)c.v;
}

i32 main() {
	unique<i32> myvec = unique_box(77);

	borrow<i32> r1 = lend(myvec);
	borrow<i32> r2 = identity_borrow(r1); // F4: r2 hereda owner=myvec
	i32         v1 = deref_borrow(r2);    // OK: r2 es shared

	if (v1 != 77) return 100;

	// Aun podemos crear mas shared (R2):
	borrow<i32> r3 = lend(myvec);
	i32         v2 = read_borrow(r3);
	if (v2 != 77) return 200;
	if (por_puntero() != 42) return 300;

	return 42;
}
