namespace ejemplos.operator_overload2;

// examples_codes_vx/44_operator_overload2.vx
//
// Operator overloading C-2: resto de operadores binarios, unario neg
// e indexado de lectura sobre STRUCT y CLASS.
//
// Mapeo dunder:
//   Binarios aritmeticos:  -  ->  __sub__   *  ->  __mul__
//                          /  ->  __div__   %  ->  __mod__
//   Comparacion ordenada:  <  ->  __lt__    >  ->  __gt__
//                          <= ->  __le__    >= ->  __ge__
//   Unario:                -x ->  __neg__   (metodo sin args)
//   Indexado (lectura):    o[i] -> __index__(i)
//
// Sin el dunder, el comportamiento clasico queda intacto (aritmetica de
// primitivos, comparacion de int, subscript de ptr/array).  Este
// ejemplo verifica AMBAS cosas (overload + fallback).
//
// Compilar y ejecutar (interp/Full):
//   vm --vx examples_codes_vx/44_operator_overload2.vx -o oo2
//   vm --run oo2.velb --stats          (R00 == 42)
//
// Compilar nativo (AOT, los structs/clases son AOT-compilables):
//   vm --vx examples_codes_vx/44_operator_overload2.vx -m aot --emit exe -o oo2.exe
//   ./oo2.exe ; echo $?                 (exit-code == 42)
//
// Resultado esperado: 42.

struct Vec2 {
    i32 x;
    i32 y;

    // Resta componente a componente: devuelve la suma de las diferencias.
    i32 __sub__(Vec2 o) {
        return (this.x - o.x) + (this.y - o.y);
    }

    // Producto escalar (dot product).
    i32 __mul__(Vec2 o) {
        return this.x * o.x + this.y * o.y;
    }

    // Division entera componente a componente, sumada.
    i32 __div__(Vec2 o) {
        return this.x / o.x + this.y / o.y;
    }

    // Modulo componente a componente, sumado.
    i32 __mod__(Vec2 o) {
        return this.x % o.x + this.y % o.y;
    }

    // Comparacion ordenada por magnitud al cuadrado (x*x + y*y).
    i32 mag2() {
        return this.x * this.x + this.y * this.y;
    }
    bool __lt__(Vec2 o) {
        return this.mag2() < o.mag2();
    }
    bool __gt__(Vec2 o) {
        return this.mag2() > o.mag2();
    }
    bool __le__(Vec2 o) {
        return this.mag2() <= o.mag2();
    }
    bool __ge__(Vec2 o) {
        return this.mag2() >= o.mag2();
    }

    // Negacion: invierte ambas componentes y suma; -Vec2(3,4) -> -7.
    i32 __neg__() {
        return (0 - this.x) + (0 - this.y);
    }

    // Indexado de lectura: 0 -> x, otro -> y.
    i32 __index__(i32 i) {
        if (i == 0) {
            return this.x;
        }
        return this.y;
    }
}

i32 main() {
    Vec2 a;
    a.x = 10;
    a.y = 7;
    Vec2 b;
    b.x = 4;
    b.y = 3;

    // __sub__: (10-4) + (7-3) = 6 + 4 = 10.
    i32 sub = a - b;                  // 10

    // __mul__: 10*4 + 7*3 = 40 + 21 = 61.
    i32 mul = a * b;                  // 61

    // __div__: 10/4 + 7/3 = 2 + 2 = 4.
    i32 dv = a / b;                   // 4

    // __mod__: 10%4 + 7%3 = 2 + 1 = 3.
    i32 md = a % b;                   // 3

    // Comparaciones ordenadas por magnitud:
    //   a.mag2 = 100 + 49 = 149 ; b.mag2 = 16 + 9 = 25.
    i32 lt = (i32)(a < b);           // 149 < 25 -> false -> 0
    i32 gt = (i32)(a > b);           // 149 > 25 -> true  -> 1
    i32 le = (i32)(b <= a);          // 25 <= 149 -> true -> 1
    i32 ge = (i32)(b >= a);          // 25 >= 149 -> false -> 0

    // Unario neg: -(a) -> (0-10) + (0-7) = -17.
    i32 ng = -a;                      // -17

    // Indexado de lectura: a[0] = 10, a[1] = 7.
    i32 ix0 = a[0];                   // 10
    i32 ix1 = a[1];                   // 7

    // FALLBACK INTACTO: aritmetica de int, comparacion de int y subscript
    // de array siguen funcionando exactamente igual.
    i32 i = 9;
    i32 j = 4;
    i32 int_sub = i - j;             // 5
    i32 int_mul = i * j;             // 36
    i32 int_lt = (i32)(j < i);       // 1
    i32 arr[3] = {100, 200, 300};
    i32 arr_v = arr[1];              // 200 (subscript de array clasico)

    // Validacion de las comparaciones overloaded: lt=0, gt=1, le=1, ge=0.
    // gate1 = gt * le = 1*1 = 1 ; verifica que lt y ge son 0.
    i32 cmp_ok = (i32)(lt == 0 && gt == 1 && le == 1 && ge == 0);  // 1

    // Validacion del fallback: int_sub=5, int_mul=36, int_lt=1, arr_v=200.
    i32 fb_ok = (i32)(int_sub == 5 && int_mul == 36 && int_lt == 1 &&
                      arr_v == 200);                                // 1

    // Validacion de aritmetica + neg + index overloaded.
    //   sub=10, mul=61, dv=4, md=3, ng=-17, ix0=10, ix1=7.
    i32 arith_ok = (i32)(sub == 10 && mul == 61 && dv == 4 && md == 3 &&
                         ng == -17 && ix0 == 10 && ix1 == 7);       // 1

    // 42 solo si TODO va bien.
    i32 gate = cmp_ok * fb_ok * arith_ok;  // 1*1*1 = 1
    return 42 * gate;                       // 42 * 1 = 42
}
