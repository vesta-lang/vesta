namespace ejemplos.pool_fibers_yield;

// 242_pool_fibers_yield.vx
//
// Scheduler M:N de FIBRAS (unidad de ejecucion unica).  Mezcla:
//   - fibras COOPERATIVAS que ceden con vx_yield() varias veces (cada iteracion
//     suma 1 al contador y cede) -> el scheduler las suspende y reanuda,
//   - "tareas" run-to-completion (fibras que NUNCA ceden) que suman de golpe.
// Todo sobre 4 workers con work-stealing.  La misma unidad (Fiber*) para ambas.
//
//   40 fibras que ceden * 10 iteraciones = 400
// + 60 tareas sin yield * 10                = 600
//   ------------------------------------------------
//                                    total = 1000  EXACTO
//
//   vm -m aot --vx 242_pool_fibers_yield.vx --format pe -o p.exe && ./p.exe  (exit 42)

import std.pool only pool_start, pool_submit, pool_join, vx_yield;
import "vx_sync" only vx_lock, vx_unlock;

i64 g_lock = 0;
i64 g_counter = 0;

// Fibra cooperativa: 10 iteraciones, cada una suma 1 y CEDE al scheduler.
void coop_fiber(i64 arg) {
    i64 i = 0;
    while (i < 10) {
        vx_lock((i64*)g_lock);
        g_counter = g_counter + 1;
        vx_unlock((i64*)g_lock);
        vx_yield();          // cede: el worker corre otra fibra y luego reanuda
        i = i + 1;
    }
}

// Tarea run-to-completion (fibra que nunca cede): suma 10 de golpe.
void plain_task(i64 arg) {
    i64 i = 0;
    while (i < 10) {
        vx_lock((i64*)g_lock);
        g_counter = g_counter + 1;
        vx_unlock((i64*)g_lock);
        i = i + 1;
    }
}

i32 main() {
    g_lock = (i64)malloc(4 * 8);
    i64* lo = (i64*)g_lock; lo[0] = 0; lo[1] = 0; lo[2] = 0; lo[3] = 0;
    g_counter = 0;

    pool_start(4);

    i64 k = 0;
    while (k < 40) {
        pool_submit((i64)(cfn(i64) -> void) coop_fiber, 0);  // ceden
        k = k + 1;
    }
    k = 0;
    while (k < 60) {
        pool_submit((i64)(cfn(i64) -> void) plain_task, 0);  // no ceden
        k = k + 1;
    }

    pool_join();

    return (g_counter == 1000) ? 42 : (i32)(g_counter % 1000);
}
