namespace ejemplos.argumentos_uniformes;

// La MISMA expresion como argumento, en todas las formas de llamar que hay.
//
// "Encaja este argumento con su parametro" es la pregunta que mas veces se hace
// el comprobador, y estaba escrita una vez por CLASE de llamada: funcion
// suelta, closure, metodo, constructor, metodo estatico, variante de enum.  Y
// ninguna copia tenia todas las reglas -- unas convertian el nombre de una
// funcion en un valor-funcion, otras re-tipaban una constante que cabe en un
// newtype, otras admitian subir un puntero a struct a su base --, asi que la
// misma expresion se aceptaba en un sitio y se rechazaba en otro sin ninguna
// razon de diseno.
//
// Este ejemplo escribe las dos que mas se notan en TODOS los sitios: una
// constante donde se espera un newtype, y el NOMBRE de una funcion donde se
// espera una funcion.  Si alguna vuelve a quedarse corta, aqui deja de
// compilar.

typedef i64 Metros new;

i64 doblar(i64 x) { return x * 2; }

enum Caja {
	ConNewtype(Metros),
	ConFn(cfn(i64) -> i64)
}

// 1. Funcion suelta.
i64 f_newtype(Metros m) { return (i64) m; }
i64 f_fn(cfn(i64) -> i64 cb) { return cb(21); }

class K {
	public i64 v;
	// 2. Constructor.
	public K(Metros m, cfn(i64) -> i64 cb) { this.v = (i64) m + cb(21); }
	// 3. Metodo.
	public i64 m_newtype(Metros m) { return (i64) m; }
	public i64 m_fn(cfn(i64) -> i64 cb) { return cb(21); }
	// 4. Metodo estatico.
	public static i64 s_newtype(Metros m) { return (i64) m; }
	public static i64 s_fn(cfn(i64) -> i64 cb) { return cb(21); }
}

struct S {
	// 5. Metodo de struct, y su estatico.
	i64 m_newtype(Metros m) { return (i64) m; }
	static i64 s_fn(cfn(i64) -> i64 cb) { return cb(21); }
}

i32 main() {
	K k = new K(3, doblar); // constructor: 3 + 42 = 45
	S s;

	// 6. Closure: el parametro es una funcion, el argumento un nombre.
	fn(cfn(i64) -> i64) -> i64 lam = (cfn(i64) -> i64 cb) => { return cb(21); };

	// 7. Variante de enum.
	Caja c1 = Caja.ConNewtype(3);
	Caja c2 = Caja.ConFn(doblar);
	i64  v1 = 0_i64;
	match (c1) { case ConNewtype(m) => { v1 = (i64) m; } case ConFn(f) => { v1 = 0; } }
	i64 v2 = 0_i64;
	match (c2) { case ConNewtype(m) => { v2 = 0; } case ConFn(f) => { v2 = f(21); } }

	const i64 newtypes = f_newtype(3) + k.m_newtype(3) + K.s_newtype(3) +
		s.m_newtype(3) + v1; // 5 * 3  = 15
	const i64 funciones = f_fn(doblar) + k.m_fn(doblar) + K.s_fn(doblar) +
		S.s_fn(doblar) + lam(doblar) + v2; // 6 * 42 = 252

	println("newtypes=${newtypes} funciones=${funciones} ctor=${k.v}");

	// 15 + 252 + 45 = 312
	return (i32)(newtypes + funciones + k.v - 270); // 42
}
