// examples_codes_vx/238_move_from_field_nofree.vx
//
// Combinacion de modelos: mover (move) un campo unique<T> FUERA de su
// contenedor.  Tras el move, el slot del campo queda a cero, asi que el
// destructor del contenedor NO vuelve a liberar el recurso: se libera
// exactamente una vez, por el nuevo dueno.  Un contador de liberaciones
// lo observa.
//
// Esperado: R00 == 1 (una sola liberacion, sin double-free).

class Counter { public static i64 libs; }

void del(i64 r) { Counter.libs = Counter.libs + 1; }

class Cont { unique<i64> h; }

void run() {
    Cont c = new Cont();
    c.h = unique_with(5, del);
    unique<i64> robado = move(c.h);    // saca el recurso del campo
}   // ~robado libera 1 vez; c.h con slot=0 no re-libera

i32 main() {
    Counter.libs = 0;
    run();
    return (i32) Counter.libs;         // 1
}
