// -----------------------------------------------------------------------------
// Resolver que navega un array HERMANO: traduccion de RVA sin helpers ni punteros
// -----------------------------------------------------------------------------
// Un resolver de campo (`@offset { }`) puede recorrer un ARRAY hermano de la
// vista via `this.<array>[i].<campo>` -- toda la logica del formato (aqui:
// traducir un RVA a offset de fichero buscando la seccion que lo contiene) vive
// DENTRO del overlay, declarativamente.  Nada de helpers, nada de `*(T*)(buf+..)`.
//
// `Img.at_rva` resuelve su propia direccion traduciendo `this.target_rva` por la
// tabla `this.secs`, exactamente como haria un cargador PE con un RVA.  El campo
// se lee/escribe como cualquier otro (el overlay dice DONDE; el compilador el COMO).
// interp = JIT = AOT.

@overlay
struct Sec {
	u32 va   @0x00; // RVA de la seccion
	u32 vsz  @0x04; // tamano virtual
	u32 rptr @0x08; // offset de fichero
}
@overlay
struct Img {
	u32 count      @0x00;
	u32 target_rva @0x04;
	Sec secs[count] @offset(0x08) stride(12);

	// El campo cuya direccion se resuelve traduciendo target_rva por las secciones.
	u32 at_rva @offset {
		u32 rva = target_rva;
		i32 i   = 0_i32;
		while ((u32)i < count) {
			u32 va  = this.secs[i].va;
			u32 vsz = this.secs[i].vsz;
			if (rva >= va && rva < va + vsz) {
				// direccion de fichero = base + rptr_de_la_seccion + (rva - va)
				return base + (u64)this.secs[i].rptr + (u64)(rva - va);
			}
			i = i + 1;
		}
		return base + (u64)rva; // fallback: dentro de las cabeceras
	};
}

i32 main() {
	u8* buf = (u8*) malloc(512);
	// count=2, target_rva=0x2010
	*(u32*)(buf + 0) = 2;
	*(u32*)(buf + 4) = 0x2010;
	// secs[0] @ base+8:  va=0x1000 vsz=0x200 rptr=0x60
	*(u32*)(buf + 8)  = 0x1000;
	*(u32*)(buf + 12) = 0x0200;
	*(u32*)(buf + 16) = 0x60;
	// secs[1] @ base+20: va=0x2000 vsz=0x300 rptr=0xC0
	*(u32*)(buf + 20) = 0x2000;
	*(u32*)(buf + 24) = 0x0300;
	*(u32*)(buf + 28) = 0xC0;
	// target_rva 0x2010 cae en secs[1]: offset = 0xC0 + (0x2010-0x2000) = 0xD0
	*(u32*)(buf + 0xD0) = 0x7BCD;

	Img im = Img(buf);
	u32 v  = im.at_rva;         // resuelve traduciendo el RVA -> 0x7BCD
	println("AT_RVA=${v:hex}"); // 7bcd

	free(buf);
	return (i32) v; // 0x7BCD = 31693
}
