namespace ejemplos.vectorize_scalar_int;

// Auto-vectorizacion de difusion escalar ENTERA (scalar broadcast):
//   c[i] = a[i] OP k   con k escalar entero invariante del loop.
// El escalar se REPLICA a 64 bits y se difunde a todos los lanes
// (UNPCKLPD/VBROADCASTSD) -> PADD?/PMULL? por lane.  i16/i32/i64.

i64 main() {
    i64 n = 50;

    // i32: c = a*3, luego c += 7, luego c = 1000 - c (este ultimo bail = cola)
    i32* a = (i32*) malloc(n * 4);
    i32* c = (i32*) malloc(n * 4);
    i64 i = 0;
    while (i < n) { a[i] = (i32) i; i = i + 1; }
    for (i64 j = 0; j < n; j = j + 1) { c[j] = a[j] * 3; }   // 3i
    for (i64 j = 0; j < n; j = j + 1) { c[j] = c[j] + 7; }   // 3i+7
    i64 s32 = 0;
    i = 0;
    while (i < n) { s32 = s32 + (i64) c[i]; i = i + 1; }
    // sum(3i+7, i=0..49) = 3*1225 + 350 = 4025.

    // i16: scalar mul broadcast (PMULLW)
    i16* b = (i16*) malloc(n * 2);
    i16* d = (i16*) malloc(n * 2);
    i = 0;
    while (i < n) { b[i] = (i16)(i + 1); i = i + 1; }
    for (i64 j = 0; j < n; j = j + 1) { d[j] = b[j] * 2; }   // 2(i+1)
    i64 s16 = 0;
    i = 0;
    while (i < n) { s16 = s16 + (i64) d[i]; i = i + 1; }
    // sum(2(i+1), i=0..49) = 2*(1225+50) = 2550.

    // i8: scalar add broadcast (PADDB)
    i8* e = (i8*) malloc(n);
    i8* f = (i8*) malloc(n);
    i = 0;
    while (i < n) { e[i] = (i8) 1; i = i + 1; }
    for (i64 j = 0; j < n; j = j + 1) { f[j] = e[j] + 4; }   // 5
    i64 s8 = 0;
    i = 0;
    while (i < n) { s8 = s8 + (i64) f[i]; i = i + 1; }        // 50*5=250

    free(a); free(c); free(b); free(d); free(e); free(f);
    // 4025 + 2550 + 250 = 6825
    return s32 + s16 + s8;
}
