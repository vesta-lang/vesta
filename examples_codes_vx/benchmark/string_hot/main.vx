// Bench: strings en hot loop (concat + length + compare).
i32 main() {
	string base   = "abc";
	string suffix = "xyz";
	i64    hits   = 0_i64;
	i32    i      = 0_i32;
	while (i < 200_000) {
		string combo = base + suffix;
		u64    ln    = combo.length();
		if (ln == 6) {
			hits = hits + 1;
		}
		if (combo.equals("abcxyz")) {
			hits = hits + 1;
		}
		i = i + 1;
	}
	return (i32) hits;
}
