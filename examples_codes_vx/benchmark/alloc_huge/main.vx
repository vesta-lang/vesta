// alloc_huge: 100 bloques de 16 MB, con una ventana de 4 vivos.
// Mismo algoritmo que main.c; ver alli por que a este tamano lo que se mide es
// el fallo de pagina y no la llamada al asignador.
//
// Las 4096 paginas de cada bloque se tocan una a una: `malloc` solo RESERVA, y
// sin tocar los 1600 MB no llegarian a existir -- se estaria midiendo apuntar
// en una tabla, no conseguir memoria.

i32 main() {
	u8*[4] anillo; // potencia de 2; 4 x 16 MB = 64 MB vivos
	i32 acc = 0;
	i32 i   = 0;
	while (i < 100) {
		u8* p = (u8 *) malloc(16_777_216);
		u8  v = (u8)(i & 255);
		i32 o = 0;
		while (o < 16_777_216) { // un toque por pagina
			p[o] = v;
			o = o + 4096;
		}
		p[16_777_215] = v;
		i32 k     = i & 3;
		u8* viejo = anillo[k]; // el mas viejo sale de la ventana
		if (viejo != null) {
			acc = acc + (i32) viejo[0];
			free(viejo);
		}
		anillo[k] = p;
		i = i + 1;
	}
	i32 k2 = 0;
	while (k2 < 4) { // vaciar la ventana
		u8*               v2  = anillo[k2];
		if (v2 != null) { acc = acc + (i32) v2[0];
			free(v2); }
		k2 = k2 + 1;
	}
	return acc & 255;
}
