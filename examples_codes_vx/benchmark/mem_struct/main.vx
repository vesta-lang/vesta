// mem_struct: 1M iteraciones x 3 caminos (pila, heap por sizeof, heap por
// tamano explicito), con ventana de 64 vivos en los dos de heap.
// Mismo algoritmo que main.c; ver alli que compara y por que la ventana.
//
// El camino de la pila es un struct de valor, que es lo que el lenguaje da sin
// tocar el heap.  Los dos de heap piden bloque crudo con `malloc`, igual que C:
// aqui se compara DONDE vive el struct, no el modelo de objetos (eso es
// `mem_class`).

struct Punto {
    i32 x;
    i32 y;
}

i32 main() {
    i32*[64] anillo_a;              // camino 2
    i32*[64] anillo_b;              // camino 3
    i64 acc = 0;
    i32 i = 0;
    while (i < 1000000) {
        i32 base = (i32) (acc & 255);

        Punto p;                    // 1. en la pila
        p.x = base;
        p.y = base + 1;
        acc = acc + (i64) (p.x + p.y);

        i32 k = i & 63;

        i32* h = (i32*) malloc(8);  // 2. en heap
        h[0] = base;
        h[1] = base + 1;
        i32* va = anillo_a[k];
        if (va != null) {
            acc = acc + (i64) (va[0] + va[1]);
            free(va);
        }
        anillo_a[k] = h;

        i32* m = (i32*) malloc(8);  // 3. en heap
        m[0] = base;
        m[1] = base + 1;
        i32* vb = anillo_b[k];
        if (vb != null) {
            acc = acc + (i64) (vb[0] + vb[1]);
            free(vb);
        }
        anillo_b[k] = m;

        i = i + 1;
    }
    i32 k2 = 0;
    while (k2 < 64) {               // vaciar las dos ventanas
        i32* va2 = anillo_a[k2];
        if (va2 != null) { acc = acc + (i64) (va2[0] + va2[1]); free(va2); }
        i32* vb2 = anillo_b[k2];
        if (vb2 != null) { acc = acc + (i64) (vb2[0] + vb2[1]); free(vb2); }
        k2 = k2 + 1;
    }
    return (i32) (acc % 251);
}
