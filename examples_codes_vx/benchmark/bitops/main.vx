// Bench: bitops (and/or/xor/shl/shr/popcount-like via xor accumulate).
// 30M iter x 8 bit ops = 240M ops.
i32 main() {
	u64 a = 0xDEADBEEFCAFEBABE_u64;
	u64 b = 0x1234567890ABCDEF_u64;
	i32 i = 0_i32;
	while (i < 30_000_000) {
		a = a ^ (u64) i;
		a = a & 0x0000FFFFFFFFFFFF;
		a = a | 0x0001010101010101;
		a = a << 1;
		a = a >> 1;
		b = b + (a & 0xFFFF);
		b = b ^ (a >> 16);
		b = b << 1;
		i = i + 1;
	}
	return (i32)((a + b) & 0xFF);
}
