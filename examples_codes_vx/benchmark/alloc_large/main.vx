// alloc_large: 500K bloques de 256 KB, con una ventana de 16 vivos.
// Mismo algoritmo que main.c; el porque del diseno esta en
// `alloc_small/main.c`.
//
// A este tamano el bloque ocupa 64 paginas y hay que tocarlas todas: `malloc`
// solo RESERVA, y sin tocar no se estaria midiendo memoria que exista.

i32 main() {
	u8*[16] anillo; // potencia de 2: el indice sale con AND
	i32 acc = 0;
	i32 i   = 0;
	while (i < 500_000) {
		u8* p = (u8 *) malloc(262_144);
		u8  v = (u8)(i & 255);
		i32 o = 0;
		while (o < 262_144) { // un toque por pagina
			p[o] = v;
			o = o + 4096;
		}
		p[262_143] = v;
		i32 k     = i & 15;
		u8* viejo = anillo[k]; // el mas viejo sale de la ventana
		if (viejo != null) {
			acc = acc + (i32) viejo[0];
			free(viejo);
		}
		anillo[k] = p;
		i = i + 1;
	}
	i32 k2 = 0;
	while (k2 < 16) { // vaciar la ventana
		u8*               v2  = anillo[k2];
		if (v2 != null) { acc = acc + (i32) v2[0];
			free(v2); }
		k2 = k2 + 1;
	}
	return acc & 255;
}
