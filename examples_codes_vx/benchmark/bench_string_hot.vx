// Bench: strings en hot loop -- concat + length + compare.
// Mide el coste de las ops de string en programas tipicos (parsers,
// loggers, formato).  Hot loop construye un string acumulando partes
// y compara contra un literal, midiendo el throughput de STRMAKE +
// STRCAT + STRLEN + STRCMP.
//
// Workload: 200K iteraciones con 3 string ops por iter = 600K ops.

i32 main() {
	string base   = "abc";
	string suffix = "xyz";
	i64    hits   = 0_i64;
	i32    i      = 0_i32;
	while (i < 200_000) {
		// STRCAT crea un ROPE O(1) -- cheap.
		string combo = base + suffix;
		// STRLEN materializa si es ROPE.
		u64 ln = combo.length();
		if (ln == 6) {
			hits = hits + 1;
		}
		// STRCMP fuerza flatten + memcmp.
		if (combo.equals("abcxyz")) {
			hits = hits + 1;
		}
		i = i + 1;
	}
	return (i32) hits;
}
