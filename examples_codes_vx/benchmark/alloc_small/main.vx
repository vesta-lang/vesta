// alloc_small: 5M bloques de 16 bytes, con una ventana de 64 vivos.
// Mismo algoritmo que main.c; ver alli por que hay cuatro bancos de reserva,
// por que se toca cada pagina y por que la ventana.
//
// Se usa `malloc` y NO `new Clase`: un objeto nuestro paga cabecera de 24 bytes
// y registro en el recolector, y compararlo contra el `malloc` de C no mide
// asignadores sino modelos de objeto.  El camino de objetos tiene su propio
// banco en `mem_class`.
//
// La ventana hace falta tambien para nosotros: con el bloque naciendo y
// muriendo en la misma iteracion, nuestro pase de escape lo descompone y no
// reserva nada -- exactamente igual que gcc borraba el malloc.

i32 main() {
    u8*[64] anillo;                 // potencia de 2: el indice sale con AND
    i32 acc = 0;
    i32 i = 0;
    while (i < 5000000) {
        u8* p = (u8*) malloc(16);
        u8 v = (u8) (i & 255);
        p[0] = v;                   // 16 bytes caben en una pagina: un toque
        p[15] = v;
        i32 k = i & 63;
        u8* viejo = anillo[k];      // el mas viejo sale de la ventana
        if (viejo != null) {
            acc = acc + (i32) viejo[0];
            free(viejo);
        }
        anillo[k] = p;
        i = i + 1;
    }
    i32 k2 = 0;
    while (k2 < 64) {               // vaciar la ventana
        u8* v2 = anillo[k2];
        if (v2 != null) { acc = acc + (i32) v2[0]; free(v2); }
        k2 = k2 + 1;
    }
    return acc & 255;
}
