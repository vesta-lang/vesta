// mem_class: 1M objetos en heap, con una ventana de 64 vivos.
// Mismo algoritmo que main.c; ver alli en que se diferencia este banco de los
// de bloque crudo (`alloc_small` y companeros) y por que la ventana.
//
// Aqui SI se usa `new Foo()`: este es el banco del camino de objetos, con su
// cabecera de 24 bytes, su constructor y su registro en el recolector.  El
// bloque crudo se mide en `alloc_small`.
//
// La ventana hace falta tambien para nosotros: con el objeto naciendo y
// muriendo en la misma iteracion, nuestro pase de escape lo descompone y no
// reserva nada -- exactamente igual que gcc borraba el malloc del main.c.

class Foo {
	public i32 x;
	public Foo(i32 v) { this.x = v; }
}

i32 main() {
	Foo[64] anillo; // potencia de 2: el indice sale con AND
	i32     acc = 0_i32;
	i32     i = 0_i32;
	while (i < 1_000_000) {
		Foo f     = new Foo(i & 255);
		i32 k     = i & 63;
		Foo viejo = anillo[k]; // el mas viejo sale de la ventana
		if (viejo != null) {
			acc = acc + viejo.x;
		}
		anillo[k] = f;
		i         = i + 1;
	}
	i32 k2 = 0_i32;
	while (k2 < 64) { // vaciar la ventana
		Foo v = anillo[k2];
		if (v != null) { acc = acc + v.x; }
		k2 = k2 + 1;
	}
	return acc & 255;
}
