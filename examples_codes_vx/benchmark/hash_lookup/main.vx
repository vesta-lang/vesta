// hash_lookup: 50M mezclas estilo FNV, con el resultado consumido.
// Mismo algoritmo que main.c; ver alli los DOS problemas que tenia: la
// condicion que no se cumplia nunca y el borrado de la mezcla que provocaba.

i32 main() {
	u64 seed = 0xCAFEBABEDEADBEEF;
	u64 acc  = 0;
	i32 i    = 0;
	while (i < 50_000_000) {
		seed = seed ^ (u64) i;
		seed = seed * 1_099_511_628_211;
		seed = seed >> 7;
		seed = seed | 1;
		acc  = acc + (seed & 255); // el hash se consume
		i    = i + 1;
	}
	return (i32)(acc % 251);
}
