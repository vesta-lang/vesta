// alloc_medium: 4M bloques de 1 KB, con una ventana de 64 vivos.
// Mismo algoritmo que main.c; el porque del diseno esta en
// `alloc_small/main.c`.
//
// Se usa `malloc` y NO `new Clase`: aqui se mide el bloque crudo.  El camino de
// objetos, con su cabecera y su registro en el recolector, tiene su propio
// banco en `mem_class`.

i32 main() {
	u8*[64] anillo; // potencia de 2: el indice sale con AND
	i32     acc = 0_i32;
	i32     i = 0_i32;
	while (i < 4_000_000) {
		u8* p = (u8*) malloc(1024);
		u8  v = (u8)(i & 255);
		p[0]    = v; // 1 KB cabe en una pagina: un solo toque
		p[1023] = v;
		i32 k     = i & 63;
		u8* viejo = anillo[k]; // el mas viejo sale de la ventana
		if (viejo != null) {
			acc = acc + (i32) viejo[0];
			free(viejo);
		}
		anillo[k] = p;
		i         = i + 1;
	}
	i32 k2 = 0_i32;
	while (k2 < 64) { // vaciar la ventana
		u8* v2 = anillo[k2];
		if (v2 != null) {
			acc = acc + (i32) v2[0];
			free(v2);
		}
		k2 = k2 + 1;
	}
	return acc & 255;
}
