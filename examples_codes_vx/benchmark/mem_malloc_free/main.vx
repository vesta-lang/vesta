// mem_malloc_free: 5M bloques de 96 bytes, con una ventana de 64 vivos.
// Mismo algoritmo que main.c; el porque de la ventana esta en
// `alloc_small/main.c`.
//
// Se distingue de `alloc_small` (16 B) y `alloc_medium` (1 KB) por el tamano:
// 96 bytes cae en otra clase del asignador.

i32 main() {
    u8*[64] anillo;                 // potencia de 2: el indice sale con AND
    i32 acc = 0;
    i32 i = 0;
    while (i < 5000000) {
        u8* buf = (u8*) malloc(96);
        buf[0] = (u8) (i & 255);
        buf[95] = (u8) ((i + 95) & 255);
        i32 k = i & 63;
        u8* viejo = anillo[k];      // el mas viejo sale de la ventana
        if (viejo != null) {
            acc = acc + (i32) viejo[0] + (i32) viejo[95];
            free(viejo);
        }
        anillo[k] = buf;
        i = i + 1;
    }
    i32 k2 = 0;
    while (k2 < 64) {               // vaciar la ventana
        u8* v = anillo[k2];
        if (v != null) { acc = acc + (i32) v[0] + (i32) v[95]; free(v); }
        k2 = k2 + 1;
    }
    return acc % 251;
}
