// cmp_fusion: 50M comparaciones + salto, con el resultado consumido.
// Mismo algoritmo que main.c.
//
// La version anterior era `while (i < n) { acc = acc + 1; i = i + 1; }`, que es
// una recurrencia afin: cualquier compilador decente la resuelve en forma
// cerrada, y en C el `main` quedaba en `return 50000000` sin ejecutar una sola
// vuelta.  Ahora la condicion depende de un generador congruencial que nadie
// puede resolver de antemano, asi que las 50M comparaciones se hacen.
//
// Que luego cada backend las resuelva sin saltar (nuestra if-conversion emite
// SELECT, gcc emite `adc`) es parte de lo que este banco mide: hasta donde
// optimiza cada uno.  Lo que no vale es que el trabajo desaparezca.

i32 main() {
	u32 s   = 12_345;
	i32 acc = 0_i32;
	i32 i   = 0_i32;
	while (i < 50_000_000) {
		s = s * 1_664_525 + 1_013_904_223;
		if ((s >> 31) == 0) { acc = acc + 1; }
		i = i + 1;
	}
	return acc & 255;
}
