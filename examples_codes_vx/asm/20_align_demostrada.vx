// Lo contrario del caso que casca: aqui la exigencia SI se cumple, y se
// demuestra, asi que el compilador no dice nada.
//
// `movdqa` exige que su direccion sea multiplo de 16.  El destino sale de una
// reserva grande, que el asignador entrega alineada, y de ahi se deduce lo que
// hace falta -- sin que el programador escriba ninguna anotacion.
//
// Es la otra mitad de la comprobacion, y la que de verdad la sostiene: avisar
// siempre seria facil y no valdria nada.  Si algun dia el hecho de alineacion
// deja de llegar hasta aqui, esto empieza a avisar sobre codigo correcto.
//
// @expect 42

// Escribe 16 ceros en `dst` con la variante que EXIGE la direccion alineada.
void limpia_16(u8* dst) {
	asm (reg d = dst, xmm v0,) {
		pxor v0, v0
		movdqa [d], v0
	}
}

i32 main() {
	// Reserva grande: la entrega la arena del sistema tras una cabecera de 64,
	// asi que su alineacion se conoce y es de sobra para lo que se le pide.
	u8* base = (u8*) malloc(8192);
	base[0] = 7;
	limpia_16(base);
	// Los 16 primeros bytes quedaron a cero.
	i32 r = 42_i32;
	if (base[0] != 0) { r = 1; }
	free((i64*) base);
	return r;
}
