// AVX2: suma 8 enteros i32 EN PARALELO con `vpaddd` sobre registros de 256
// bits (ymm).  Igual patron que el SSE2 pero el doble de ancho.  `vzeroupper`
// al final evita la penalizacion de transicion AVX<->SSE.  Requiere un CPU con
// AVX2 (universal en x86-64 moderno).
//
// @expect 396
i32 main() {
	i32* a = malloc(32); // 8 x i32
	i32* b = malloc(32);

	for (i32 i = 0; i < 8; i = i + 1) {
		a[i] = i + 1;
		b[i] = (i + 1) * 10;
	}

	register("rdi") i32 *pa = a;
	register("rsi") i32 *pb = b;

	asm volatile {
		vmovdqu ymm0, [rdi]
		vpaddd  ymm0, ymm0, [rsi]
		vmovdqu [rdi], ymm0
		vzeroupper
	};

	i32 s = 0;

	for (i32 i = 0; i < 8; i = i + 1) s = s + a[i];

	return s; // sum((i+1)+(i+1)*10) i=0..7 = 11*36 = 396
}
