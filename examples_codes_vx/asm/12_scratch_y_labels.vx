// Phase AS inc.7: scratch (temporales que el compilador reserva) + labels
// locales.  Bucle que suma 1..N enteramente en registros elegidos por el
// compilador.
// @expect 55
u64 main() {
    asm volatile (
        reg n = 10,     // in
        reg acc,        // scratch (acumulador) -> read-back
        reg i,          // scratch (contador)
    ) clobber(flags) {
        xor acc, acc
        mov i, n
    .loop:
        add acc, i
        dec i
        jnz .loop
    }
    return acc;         // read-back: 1+2+...+10 = 55
}
