// Metaprogramacion + asm: una `comptime` const se SUSTITUYE textualmente en el
// cuerpo del asm (igual que una macro), evitando hardcodear el literal y
// manteniendo el codigo legible.  El compilador reemplaza `MASK` por su valor
// ANTES de ensamblar.
//
// @expect 0x340078
const u32 MASK = 0x00FF00FF_u32; // mascara de bytes (cabe en imm32)
u64 main() {
	register("rax") u64 v = 0x12345678_u64;
	asm volatile {
		and rax, MASK // MASK -> 0xff00ff (comptime)
	};
	return v; // 0x12345678 & 0x00FF00FF = 0x340078
}
