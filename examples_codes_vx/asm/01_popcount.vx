// Phase AS (inline-asm nativo ejecutado por el JIT de VestaVM).
//
// Cuenta los bits a 1 de un valor usando la instruccion x86 POPCNT,
// escrita como inline-asm NASM Intel + storage-class register("reg").
//
// Sin flags: el inline-asm se compila y ejecuta directamente.  Los clobbers
// (aqui "cc", las flags) los INFIERE el compilador; no hace falta declararlos.
//     vm --vx 01_popcount.vx -o popcount
//     vm --run popcount.velb
//
// @expect 8
u64 main() {
    register("rdi") u64 valor = 0xFF;   // 8 bits a 1
    register("rax") u64 cuenta;          // output-only (sin init)
    asm volatile {
        popcnt rax, rdi                  // cuenta = popcount(valor)
    };                                   // clobbers ("cc") inferidos
    return cuenta;                        // -> 8
}
