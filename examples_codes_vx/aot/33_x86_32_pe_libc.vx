// CALL a libc desde un PE32 (x86-32, .exe Windows): un `extern "msvcrt.dll"`
// se resuelve por la IAT (multi-DLL: kernel32!ExitProcess del _start + el libc).
// IMPORTANTE: las funciones de libc son CDECL (args en la PILA); el codegen
// 32-bit emite cdecl (push args + call + add esp) para las llamadas externas,
// aunque las funciones internas usan regparm.
//
//   vm -m aot --vx examples_codes_vx/aot/33_x86_32_pe_libc.vx \
//      -o tu.exe --aot-arch x86-32 --emit exe --format pe
//   tu.exe & echo %errorlevel%     # -> 65 ('A')
//
// objdump -p: kernel32.dll!ExitProcess + msvcrt.dll!toupper.

extern "msvcrt.dll" { fn toupper(i32 c) -> i32; }

i32 main() {
	return toupper(97); // 'a' -> 'A' = 65, via msvcrt.dll!toupper (cdecl)
}
