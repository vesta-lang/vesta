// Boot sector de VALIDACION en QEMU: escribe 'V' al debugcon (0xE9) y por la
// BIOS (int 0x10), luego sale de QEMU via isa-debug-exit (0xF4, codigo 0x42).
@bits(16)
@section(".text", "rx")
asm boot {
	    cli
	    xor ax, ax
	    mov ds, ax

	    mov al, 0x56          ; 'V' -> debugcon QEMU (port 0xE9)
	    out 0xE9, al

	    mov ah, 0x0E          ; 'V' -> BIOS teletype (path real)
	    mov al, 0x56
	    int 0x10

	    mov al, 0x42          ; salir de QEMU: isa-debug-exit -> exit (0x42<<1)|1 = 133
	    out 0xF4, al

	hang:
	    hlt
	    jmp hang

	    times 510-($-$$) db 0
	    dw 0xAA55
}
