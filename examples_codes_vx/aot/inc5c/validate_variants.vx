// CPU dispatch (Inc 5c): validador INDEPENDIENTE de las dos variantes de
// strcmp de la lib.  Llama strcmp_sse2 Y strcmp_avx2 DIRECTAMENTE (no via el
// override del dispatcher, que solo elige una segun el host) con char* sobre
// buffers controlados byte-a-byte.  Comprueba que AMBAS dan el signo esperado
// para una tabla exhaustiva.  Asi SSE2 (el fallback universal) queda validado
// aunque el host tenga AVX2.
//
//   vm -m aot --vx examples_codes_vx/aot/inc5c/validate_variants.vx \
//      -o vv.exe --format pe --emit exe ; ./vv.exe ; echo $?   # -> 42

import "simd_string";

// Buffers de prueba en secciones rw.  Sin nul: pasamos longitud explicita.
@section(".d_empty", "rw")
bytes d_empty { db 0 }                      // usable como puntero valido, len 0

@section(".d_a", "rw")
bytes d_a { db 0x61 }                       // "a"
@section(".d_b", "rw")
bytes d_b { db 0x62 }                       // "b"

@section(".d_abc", "rw")
bytes d_abc { db 0x61,0x62,0x63 }           // "abc"
@section(".d_abd", "rw")
bytes d_abd { db 0x61,0x62,0x64 }           // "abd"
@section(".d_ab", "rw")
bytes d_ab { db 0x61,0x62 }                 // "ab"

// 16 'x' + ultimo distinto (pos 15).
@section(".d_x15A", "rw")
bytes d_x15A { db 0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x41 }
@section(".d_x15B", "rw")
bytes d_x15B { db 0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x78,0x42 }

// 16 'x' + byte 16 distinto (pos 16, segundo chunk).  len 17.
@section(".d_x16A", "rw")
bytes d_x16A { times 16 db 0x78
              db 0x41 }
@section(".d_x16B", "rw")
bytes d_x16B { times 16 db 0x78
              db 0x42 }

// 32 'q' con ultimo distinto (pos 31).  len 32.
@section(".d_q31A", "rw")
bytes d_q31A { times 31 db 0x71
              db 0x41 }
@section(".d_q31B", "rw")
bytes d_q31B { times 31 db 0x71
              db 0x42 }

// 33 't' iguales.  len 33.
@section(".d_t33a", "rw")
bytes d_t33a { times 33 db 0x74 }
@section(".d_t33b", "rw")
bytes d_t33b { times 33 db 0x74 }

// Compara el signo de un i64 -> -1/0/1.
i64 sgn(i64 v) {
    if (v < 0) { return -1; }
    if (v > 0) { return 1; }
    return 0;
}

// Signo de cada variante (4 args -> caben en los arg_regs del ABI, incluido
// Win64 que solo tiene 4 GP arg_regs).
i64 sse_sgn(u8* a, i64 la, u8* b, i64 lb) {
    return sgn(simd_string.strcmp_sse2(a, la, b, lb));
}
i64 avx_sgn(u8* a, i64 la, u8* b, i64 lb) {
    return sgn(simd_string.strcmp_avx2(a, la, b, lb));
}

i32 main() {
    u8* p_empty = (u8*) section_start(".d_empty");
    u8* p_a   = (u8*) section_start(".d_a");
    u8* p_b   = (u8*) section_start(".d_b");
    u8* p_abc = (u8*) section_start(".d_abc");
    u8* p_abd = (u8*) section_start(".d_abd");
    u8* p_ab  = (u8*) section_start(".d_ab");
    u8* p_x15A = (u8*) section_start(".d_x15A");
    u8* p_x15B = (u8*) section_start(".d_x15B");
    u8* p_x16A = (u8*) section_start(".d_x16A");
    u8* p_x16B = (u8*) section_start(".d_x16B");
    u8* p_q31A = (u8*) section_start(".d_q31A");
    u8* p_q31B = (u8*) section_start(".d_q31B");
    u8* p_t33a = (u8*) section_start(".d_t33a");
    u8* p_t33b = (u8*) section_start(".d_t33b");

    // Cada caso suma 2 al total (sse + avx) y suma 1 por cada variante que
    // acierta el signo esperado.  ok == total <=> ambas variantes correctas
    // en TODOS los casos.
    i64 ok = 0;
    i64 total = 0;

    // "" vs "" -> 0
    total=total+2; if(sse_sgn(p_empty,0,p_empty,0)==0){ok=ok+1;} if(avx_sgn(p_empty,0,p_empty,0)==0){ok=ok+1;}
    // "a" vs "a" -> 0
    total=total+2; if(sse_sgn(p_a,1,p_a,1)==0){ok=ok+1;} if(avx_sgn(p_a,1,p_a,1)==0){ok=ok+1;}
    // "a" vs "b" -> -1
    total=total+2; if(sse_sgn(p_a,1,p_b,1)==-1){ok=ok+1;} if(avx_sgn(p_a,1,p_b,1)==-1){ok=ok+1;}
    // "b" vs "a" -> 1
    total=total+2; if(sse_sgn(p_b,1,p_a,1)==1){ok=ok+1;} if(avx_sgn(p_b,1,p_a,1)==1){ok=ok+1;}
    // "abc" vs "abc" -> 0
    total=total+2; if(sse_sgn(p_abc,3,p_abc,3)==0){ok=ok+1;} if(avx_sgn(p_abc,3,p_abc,3)==0){ok=ok+1;}
    // "abc" vs "abd" -> -1 (difiere en pos 2)
    total=total+2; if(sse_sgn(p_abc,3,p_abd,3)==-1){ok=ok+1;} if(avx_sgn(p_abc,3,p_abd,3)==-1){ok=ok+1;}
    // "abd" vs "abc" -> 1
    total=total+2; if(sse_sgn(p_abd,3,p_abc,3)==1){ok=ok+1;} if(avx_sgn(p_abd,3,p_abc,3)==1){ok=ok+1;}
    // "abc" vs "ab" (prefijo) -> 1
    total=total+2; if(sse_sgn(p_abc,3,p_ab,2)==1){ok=ok+1;} if(avx_sgn(p_abc,3,p_ab,2)==1){ok=ok+1;}
    // "ab" vs "abc" -> -1
    total=total+2; if(sse_sgn(p_ab,2,p_abc,3)==-1){ok=ok+1;} if(avx_sgn(p_ab,2,p_abc,3)==-1){ok=ok+1;}

    // difiere en pos 15 (ultimo del primer chunk de 16), len 16 -> -1 / 1
    total=total+2; if(sse_sgn(p_x15A,16,p_x15B,16)==-1){ok=ok+1;} if(avx_sgn(p_x15A,16,p_x15B,16)==-1){ok=ok+1;}
    total=total+2; if(sse_sgn(p_x15B,16,p_x15A,16)==1){ok=ok+1;} if(avx_sgn(p_x15B,16,p_x15A,16)==1){ok=ok+1;}

    // difiere en pos 16 (primer byte del segundo chunk), len 17 -> -1 / 1
    total=total+2; if(sse_sgn(p_x16A,17,p_x16B,17)==-1){ok=ok+1;} if(avx_sgn(p_x16A,17,p_x16B,17)==-1){ok=ok+1;}
    total=total+2; if(sse_sgn(p_x16B,17,p_x16A,17)==1){ok=ok+1;} if(avx_sgn(p_x16B,17,p_x16A,17)==1){ok=ok+1;}

    // difiere en pos 31 (ultimo del segundo chunk de 16), len 32 -> -1 / 1
    total=total+2; if(sse_sgn(p_q31A,32,p_q31B,32)==-1){ok=ok+1;} if(avx_sgn(p_q31A,32,p_q31B,32)==-1){ok=ok+1;}
    total=total+2; if(sse_sgn(p_q31B,32,p_q31A,32)==1){ok=ok+1;} if(avx_sgn(p_q31B,32,p_q31A,32)==1){ok=ok+1;}

    // len 33 iguales -> 0 (dos chunks + cola)
    total=total+2; if(sse_sgn(p_t33a,33,p_t33b,33)==0){ok=ok+1;} if(avx_sgn(p_t33a,33,p_t33b,33)==0){ok=ok+1;}

    // prefijo: 16 'x' (de p_x16A) prefijo de los mismos 17 -> -1 / 1
    total=total+2; if(sse_sgn(p_x16A,16,p_x16A,17)==-1){ok=ok+1;} if(avx_sgn(p_x16A,16,p_x16A,17)==-1){ok=ok+1;}
    total=total+2; if(sse_sgn(p_x16A,17,p_x16A,16)==1){ok=ok+1;} if(avx_sgn(p_x16A,17,p_x16A,16)==1){ok=ok+1;}

    // chunk completo de 16 iguales, ambos len 16 -> 0
    total=total+2; if(sse_sgn(p_x16A,16,p_x16A,16)==0){ok=ok+1;} if(avx_sgn(p_x16A,16,p_x16A,16)==0){ok=ok+1;}

    if (ok == total) {
        return 42;
    }
    return 1;
}
