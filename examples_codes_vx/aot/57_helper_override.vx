// CPU dispatch (Inc 4): @HelperOverride(memcpy) -- el usuario reemplaza el
// helper memcpy multi-versionado del build entero por su propia funcion.
//
// Sin la anotacion, __vx_memcpy_init elige base (rep movsb) o avx2 segun
// cpuid.  CON @HelperOverride(memcpy), __vx_memcpy_init apunta el fp DIRECTO
// a `my_memcpy` (sin leer cpuid) -> todos los concats de value-string nativos
// llaman a my_memcpy.
//
// El override DEBE copiar byte-exacto (los strings resultantes deben quedar
// correctos) Y ademas incrementa un contador observable en .data para PROBAR
// que el override se invoco.
//
// NOTA: el override es native-only.  En interp/JIT/Full el memcpy del concat
// sigue inline (rep movsb), el override NO aplica -- esto es por diseno (la
// tabla de punteros + el cpuid solo existen en native_poo_).
//
//   vm -m aot --vx examples_codes_vx/aot/57_helper_override.vx \
//      -o ovr.exe --format pe --emit exe ; ./ovr.exe ; echo $?   # -> 42

// Contador global en .data (writable).  El override lo incrementa cada vez
// que se invoca; main lo lee al final para confirmar el uso.
@section(".ovrctr", "rw")
	bytes g_calls {
	dq 0
}

// Override del memcpy del build: copia byte-a-byte (correcta para cualquier n)
// + cuenta la invocacion.  Firma void(u8*, u8*, u64) como exige el helper.
@HelperOverride(memcpy)
	void my_memcpy(u8 *dst, u8 *src, u64 n) {
	u64 i = 0;
	while (i < n) {
		dst[i] = src[i];
		i = i + 1;
	}
	// Registrar la invocacion en el contador global.
	u64* ctr = (u64 *) section_start(".ovrctr");
	*    ctr = *ctr + 1;
}

i32 main() {
	// Varios concats -> cada uno baja a `call [fp]` (CALLIND) -> my_memcpy.
	string s1      = "ab" + "cde"; // "abcde"  -> 5
	string d       = "0123456789";
	string s2      = d + d;                                   // 20
	string s3      = s2 + d;                                  // 30

	// (a) correctitud de los concats (longitudes byte-exactas).
	u64    total   = s1.length() + s2.length() + s3.length(); // 5 + 20 + 30 = 55
	i32    len_ok  = (i32)(total == 55);

	// (b) el override SE invoco: g_calls > 0.
	u64*   ctr     = (u64 *) section_start(".ovrctr");
	i32    used_ok = (i32)(*ctr > 0);

	// 42 solo si AMBAS condiciones se cumplen.
	if (len_ok == 1 && used_ok == 1) {
		return 42;
	}
	return 1;
}
