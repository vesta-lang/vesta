//  Embed (native_poo_ / AOT): retorno de `string` POR VALOR.
//
// En native el `string` es un VALUE-TYPE de 24 bytes {ptr,len,cap} en
// stack (HEAP-ALWAYS, RAII).  Una funcion que RETORNA un string por
// valor usa el ABI SRET de un struct de 24 bytes: el caller aloca un
// retbuf oculto y lo pasa como primer argumento; el callee escribe el
// value-string ahi y transfiere el ownership del buffer al caller (que
// lo libera via su RAII).  Antes esto segfauteaba porque el retorno se
// trataba como un handle i64 (8 bytes) en registro.
//
// Casos cubiertos:
//   mk(a, b)       -> "ab"+"cde" = "abcde"  (length 5)   concat
//   g()            -> "hola"                (length 4)   literal
//   mk(mk(a,b), c) -> "ab"+"cd"+"ef" = ...  (length 6)   encadenado
//
// Resultado esperado: R0 = 5 + 4 + 6 - 10 = 5.
// (5 del concat directo; verificamos g()=4 y la cadena=6 sumando y
//  restando para que el exit-code final sea exactamente 5.)
//
// Validado por ejecucion (PE/ELF) + valgrind (0 leaks, sin double-free:
// cada buffer lo libera UNA sola vez su poseedor).

string mk(string a, string b) {
	return a + b;
}

string g() {
	return "hola";
}

i32 main() {
	string a = "ab";
	string b = "cde";

	// Caso 1: concat retornado por valor desde mk -> "abcde" (length 5).
	string c  = mk(a, b);
	i64    n1 = c.length(); // 5

	// Caso 2: literal retornado por valor desde g -> "hola" (length 4).
	string h  = g();
	i64    n2 = h.length(); // 4

	// Caso 3: llamada encadenada -- el resultado de mk se pasa como arg.
	string x  = "cd";
	string y  = "ef";
	string r  = mk(mk(a, x), y); // "ab"+"cd"+"ef" = "abcdef" (length 6)
	i64    n3 = r.length();      // 6

	// 5 + 4 + 6 - 10 = 5.
	return (i32)(n1 + n2 + n3 - 10);
}
