// AOT thread_local: plantilla con tipos float y constantes `comptime`.
//
// La plantilla de un thread_local debe ser una CONSTANTE de compilacion (es la
// imagen que el cargador copia a cada hilo, no un store en runtime).  Ademas de
// enteros/bool/char, se aceptan literales float (f64/f32) -- se empaquetan sus
// bits IEEE 754 -- y referencias a un `comptime` const.
//
// Resultado esperado: (i64)(x * 4.0) + base = 10 + 32 = exit code 42.

const i64 BASE = 32_i64; // constante de compilacion

thread_local f64 x    = 2.5_f64; // plantilla float (bits IEEE en .tdata/.tls)
thread_local i64 base = BASE;    // plantilla desde un comptime const

i64 main() {
	return (i64)(x * 4.0) + base; // 10 + 32
}
