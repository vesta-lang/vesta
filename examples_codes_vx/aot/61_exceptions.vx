// Excepciones nativas AOT (auto-hospedadas en , setjmp/longjmp).
//
// try/catch/throw sin GC, sin VM, sin runtime de la VM: el frontend baja
// el try a __vx_push_frame + __vx_setjmp + br_cond, el throw a
// __vx_throw, y el catch a __vx_pop_frame + __vx_get_value -- todas
// funciones Vesta de stdlib/vx/vx_exc.vx (enlazado en el .exe).
//
// El throw cruza la frontera de funcion (risky -> caught_path): el longjmp
// desuela el frame de risky y reanuda en el setjmp de caught_path.  El
// objeto lanzado vive en heap (new) -> sobrevive al longjmp; el catch lee
// su campo.  main devuelve 42 si todo el flujo es correcto.

class Boom {
    public i64 code;
    public Boom(i64 c) { this.code = c; }
}

// Lanza si x<0 (cruzando la frontera de funcion hacia el try del caller).
public i64 risky(i64 x) {
    if (x < 0) { throw new Boom(20); }
    return x * 2;
}

// Camino con captura: risky(-1) lanza -> catch lee e.code (20) -> +1 = 21.
public i64 caught_path() {
    i64 r = 0;
    try {
        r = risky(-1);
    } catch (Boom e) {
        r = e.code + 1;
    }
    return r;
}

// Camino normal: risky(10) = 20, sin throw -> pop normal del frame.
public i64 normal_path() {
    i64 r = -1;
    try {
        r = risky(10);
    } catch (Boom e) {
        r = -99;
    }
    return r;
}

public i64 main() {
    // 21 (caught) + 20 (normal) + 1 = 42.
    return caught_path() + normal_path() + 1;
}
