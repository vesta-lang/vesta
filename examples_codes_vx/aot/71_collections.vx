// AOT: colecciones (ArrayList / HashMap) SIN la VM.
//
// El nucleo del plugin de colecciones (stdlib/native/collections) es C puro:
// sus funciones vcol_* toman uint64 (handle + valor), NO necesitan la VM
// (ni proc_ptr ni vm_mem).  El AOT importa esas funciones por IAT desde
// vesta_collections.dll y el keyword `ArrayList`/`HashMap` baja a CALLN directo.
//
// La unica parte atada a la VM (gc_addref/release para mantener vivos los
// elementos GC) se omite en AOT (native_poo): el lifetime lo gestiona el modelo
// nativo (RAII / gc<T>), no el refcount de la VM.
//
// Requiere que vesta_collections.dll acompane al .exe (como cualquier FFI).
//
//   vm --vx 71_collections.vx -m aot --emit exe --format pe -o cols.exe
//   (copia vesta_collections.dll junto a cols.exe)
//
// Esperado: exit 42.

i32 main() {
	// ArrayList<i64>: nucleo VM-free (vcol_alist_*).
	ArrayList xs = arraylist(8);
	xs.push(10);
	xs.push(20);
	xs.push(12);
	i32 suma = 0;
	suma = suma + (i32) xs.get(0); // 10
	suma = suma + (i32) xs.get(1); // 20
	suma = suma + (i32) xs.get(2); // 12

	// HashMap<i64,i64>: nucleo VM-free (vcol_map_*).
	HashMap m = hashmap(16);
	m.put(1, 100);
	m.put(2, 200);
	if (m.get(2) == 200) { suma = suma + 0; } // (no-op, valida lookup)

	return suma;                              // 10 + 20 + 12 = 42
}
