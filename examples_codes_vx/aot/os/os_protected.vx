// ===========================================================================
// Mini-SO de 32 bits en Vesta: bootloader propio -> modo protegido.
//
// Variante mas simple que 61_os_longmode.vx (no entra en modo largo ni usa
// paginacion).  Demuestra el camino real-mode -> protected-mode con el AOT
// de Vesta (sin gcc/ld/nasm), suficiente para un kernel de 32 bits.
//
//   1. Boot sector de 512 bytes (BIOS lo carga en 0x7C00).
//   2. Real mode (16) -> habilita A20, carga GDT, entra en modo protegido.
//   3. Protected mode (32) -> imprime "Protected mode OK!" y sale.
//
// Marcadores por el debugcon de QEMU (puerto 0xE9):
//   'R' (real) -> "Protected mode OK!" -> sale por isa-debug-exit (0xF4,
//   codigo 0x42 -> QEMU exit (0x42<<1)|1 = 133).
//
// La transicion de modo usa un FAR JUMP SIMBOLICO (`jmp 0x08:pm32`) y la base
// del GDT es un simbolo (`dd gdt_ents`): los resuelve el emisor AOT
// cross-bloque.  El layout fijo del binario plano usa @at(offset).
//
// Compilar:
//   vm -m aot --vx os_protected.vx --emit bin --bin-base 0x7C00 -o os32.bin
//   (o, mas simple: python run.py run protected)
// Ejecutar:
//   qemu-system-i386 -drive format=raw,file=os32.bin -display none \
//       -debugcon stdio -device isa-debug-exit,iobase=0xf4,iosize=0x04
//   -> imprime "RProtected mode OK!" y termina con exit 133.
//
// Mapa del binario (base de carga 0x7C00):
//   0x000  boot16   (16-bit)   entry
//   0x080  pm32     (32-bit)
//   0x120  msg      "Protected mode OK!\n\0"
//   0x1C0  gdtr     (limit + base simbolica)
//   0x1C8  gdt_ents (3 descriptores: null, code32, data32)
//   0x1FE  firma    0xAA55
// ===========================================================================

// --------------------------------------------------------------------------
// Etapa 1: real mode (16-bit).  BIOS entra aqui en 0x7C00.
// --------------------------------------------------------------------------
@bits(16)
@section(".boot", "rx")
@at(0x0000)
	asm boot16 {
	cli
	xor ax, ax
	mov ds, ax
	mov es, ax
	mov ss, ax
	mov sp, 0x7C00

	mov al, 0x52
	out 0xE9, al

	in al, 0x92
	or al, 2
	out 0x92, al

	lgdt [0x7DC0]

	mov eax, cr0
	or eax, 1
	mov cr0, eax

	jmp 0x08:pm32 // far jump SIMBOLICO -> recarga CS=0x08 (code32)
}

// --------------------------------------------------------------------------
// Etapa 2: modo protegido (32-bit).  Imprime el mensaje y sale.
// --------------------------------------------------------------------------
@bits(32)
@section(".pm", "rx")
@at(0x0080)
	asm pm32 {
	    mov ax, 0x10
	    mov ds, ax
	    mov es, ax
	    mov ss, ax
	    mov esp, 0x7C00

	    mov esi, 0x7D20
	    mov al, [esi]
	.print:
	    test al, al
	    jz .done
	    out 0xE9, al
	    inc esi
	    mov al, [esi]
	    jmp .print
	.done:
	    mov al, 0x42
	    out 0xF4, al
	.hang:
	    hlt
	    jmp .hang
}

// --------------------------------------------------------------------------
// Datos.
// --------------------------------------------------------------------------
@section(".msg")
@at(0x0120)
	bytes msg { db "Protected mode OK!", 0x0A, 0 }

// GDTR: limite (3 descriptores * 8 - 1 = 0x17) + base SIMBOLICA del GDT.
@section(".gdtr")
@at(0x01C0)
	bytes gdtr {
	dw 0x0017
		dd gdt_ents // base del GDT por SIMBOLO (resuelto cross-bloque)
}

// GDT: null, code32 (0x08), data32 (0x10).
@section(".gdtents")
@at(0x01C8)
	bytes gdt_ents {
	dq 0
		db 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x9A, 0xCF, 0x00 // code32: G=1 D=1
		db 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x92, 0xCF, 0x00 // data32
}

// Firma de boot MBR en el offset 510.
@section(".sig")
@at(0x01FE)
	bytes sig { db 0x55, 0xAA }
