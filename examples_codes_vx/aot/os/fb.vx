// ===========================================================================
// fb -- consola de TEXTO sobre un LINEAR FRAMEBUFFER (VBE, 32bpp).
//
// El boot fija un modo grafico VBE (800x600x32) y deja el VBE ModeInfoBlock en
// 0x5000 (LFB en +0x28, pitch en +0x10, ancho +0x12, alto +0x14) y la fuente
// 8x16 de la VGA BIOS en 0x60000.  Este modulo renderiza texto dibujando los
// glifos pixel a pixel -- una consola "moderna" de 64 bits, no el VGA text
// mode legacy de 0xB8000.
// ===========================================================================

u64 g_lfb   = 0;         // direccion del linear framebuffer
u64 g_pitch = 0;       // bytes por linea de scanline
u64 g_w     = 0;           // ancho en pixeles
u64 g_h     = 0;           // alto en pixeles
u64 g_cols  = 0;        // columnas de texto (g_w / 8)
u64 g_rows  = 0;        // filas de texto (g_h / 16)
u64 g_fcol  = 0;        // cursor: columna
u64 g_frow  = 0;        // cursor: fila
u64 g_fg    = 0x00CFCFCF; // color del texto (gris claro)
u64 g_bg    = 0x00101830; // color de fondo (azul muy oscuro)

void fb_putpix(u64 x, u64 y, u64 color) {
	u32* p = (u32 *)(g_lfb + y * g_pitch + x * 4);
	p[0] = (u32) color;
}

// Pinta toda la pantalla con el color de fondo.
void fb_clear() {
	u64  total = g_w * g_h;
	u32* p     = (u32 *) g_lfb;
	u64  i     = 0;
	// pitch puede ser > ancho*4; recorremos por fila para respetarlo.
	u64  y     = 0;
	while (y < g_h) {
		u64 base = y * g_pitch;
		u64 x    = 0;
		while (x < g_w) {
			u32* q = (u32 *)(g_lfb + base + x * 4);
			q[0] = (u32) g_bg;
			x = x + 1;
		}
		y = y + 1;
	}
	g_fcol = 0;
	g_frow = 0;
}

void fb_init() {
	u16* pitch_p = (u16 *)(0x5000 + 0x10);
	u16* w_p     = (u16 *)(0x5000 + 0x12);
	u16* h_p     = (u16 *)(0x5000 + 0x14);
	u32* lfb_p   = (u32 *)(0x5000 + 0x28);
	g_pitch = (u64) pitch_p[0];
	g_w     = (u64) w_p[0];
	g_h     = (u64) h_p[0];
	g_lfb   = (u64) lfb_p[0];
	g_cols  = g_w / 8;
	g_rows  = g_h / 16;
	fb_clear();
}

// Dibuja el glifo del caracter c en la celda (cx, cy).
void fb_drawc(u64 c, u64 cx, u64 cy) {
	u8* font = (u8 *) 0x00060000;
	u64 gi   = c * 16;
	u64 px0  = cx * 8;
	u64 py0  = cy * 16;
	u64 r    = 0;
	while (r < 16) {
		u64 bits = (u64) font[gi + r];
		u64 mask = 0x80;
		u64 b    = 0;
		while (b < 8) {
			u64 col = g_bg;
			if ((bits & mask) != 0) {
				col = g_fg;
			}
			fb_putpix(px0 + b, py0 + r, col);
			mask = mask >> 1;
			b    = b + 1;
		}
		r = r + 1;
	}
}

// Sube el contenido una fila de texto (16 px) y limpia la ultima.
void fb_scroll() {
	u64 row_bytes = g_pitch * 16;
	u64 total     = g_pitch * g_h;
	u8* lfb       = (u8 *) g_lfb;
	// copiar hacia arriba en bloques de 8 bytes (mas rapido que byte a byte).
	u64 i         = 0;
	u64 lim       = total - row_bytes;
	while (i + 8 <= lim) {
		u64* d = (u64 *)(g_lfb + i);
		u64* s = (u64 *)(g_lfb + i + row_bytes);
		d[0] = s[0];
		i = i + 8;
	}
	// limpiar la ultima fila de texto.
	while (i < total) {
		lfb[i] = 0;
		i = i + 1;
	}
}

void fb_set_fg(u64 color) {
	g_fg = color;
}

void fb_putc(u64 c) {
	if (c == 10) { // '\n'
		g_fcol = 0;
		g_frow = g_frow + 1;
	} else {
		if (c == 8) { // backspace
			if (g_fcol > 0) {
				g_fcol = g_fcol - 1;
				fb_drawc(32, g_fcol, g_frow);
			}
		} else {
			fb_drawc(c, g_fcol, g_frow);
			g_fcol = g_fcol + 1;
			if (g_fcol >= g_cols) {
				g_fcol = 0;
				g_frow = g_frow + 1;
			}
		}
	}
	if (g_frow >= g_rows) {
		fb_scroll();
		g_frow = g_rows - 1;
	}
}
