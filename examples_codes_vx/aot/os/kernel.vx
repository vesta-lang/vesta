// ===========================================================================
// VestaOS -- kernel MODULAR de 64 bits con bootloader propio, escrito en
// Vesta y compilado con el AOT de Vesta (sin gcc / ld / nasm).
//
// El kernel se reparte en MoDULOS Vesta (import): lib (itoa), serial (COM1),
// console (driver VGA con cursor/scroll/color).  Este fichero raiz contiene
// el bootloader (asm) y kmain(), que usa los modulos.
//
// Arranque:
//   1. Sector 1 (bootloader, 16-bit): la BIOS lo carga en 0x7C00; lee el
//      resto de la imagen desde disco (int 0x13), habilita A20, carga la GDT
//      y pasa a modo protegido.
//   2. Modo protegido (32-bit): paginacion (PAE + EFER.LME + CR0.PG) y salto
//      a modo largo.
//   3. Modo largo (64-bit): fija la pila y llama a kmain() (Vesta).
//   4. kmain(): inicializa COM1 y la consola VGA, imprime un banner, calcula
//      los primos < 50 y la serie de Fibonacci, y los muestra en pantalla y
//      por el puerto serie.
//
// Construir y ejecutar:  python run.py run        (ver README.md)
// ===========================================================================
import "serial";
import "fb";
import "shell";
import "prog";
import "term";
import "clock"; // reloj RTC (clock_init para el uptime)

// ---------------------------------------------------------------------------
// SECTOR 1 -- bootloader (asm).  Layout fijo con @at; firma 0xAA55 en 0x1FE.
// ---------------------------------------------------------------------------
@bits(16)
@section(".boot", "rx")
@at(0x0000)
	asm boot16 {

	db 0xEB, 0x3C, 0x90
	times 0x3B db 0
	cli
	xor ax, ax
	mov ds, ax
	mov es, ax
	mov ss, ax
	mov sp, 0x7C00

	mov al, 0x52
	out 0xE9, al

	mov [0x0500], dl

	cld
	mov ax, 0x1130
	mov bh, 0x06
	int 0x10
	push es
	pop ds
	mov si, bp
	mov ax, 0x6000
	mov es, ax
	xor di, di
	mov cx, 0x1000
	rep movsb
	xor ax, ax
	mov ds, ax
	mov es, ax

	mov ax, 0x4F01
	mov cx, 0x0143
	mov di, 0x5000
	int 0x10
	mov ax, 0x4F02
	mov bx, 0x4143
	int 0x10

	mov si, 0x0600
	mov byte [si], 0x10
	mov byte [si + 1], 0
	mov word [si + 2], 127
	mov word [si + 4], 0x7E00
	mov word [si + 6], 0
	mov dword [si + 8], 1
	mov dword [si + 12], 0
	mov dl, [0x0500]
	mov ah, 0x42
	int 0x13

	in al, 0x92
	or al, 2
	out 0x92, al

	lgdt [0x7E00]
	mov eax, cr0
	or eax, 1
	mov cr0, eax
	jmp 0x08:pm32
}

@bits(32)
@section(".pm", "rx")
@at(0x0240)
	asm pm32 {
	    mov ax, 0x10
	    mov ds, ax
	    mov es, ax
	    mov ss, ax
	    mov esp, 0x7C00

	    mov al, 0x50
	    out 0xE9, al

	    mov edi, 0x00200000
	    mov ecx, 0x1800
	    xor eax, eax
	    rep stosd
	    mov dword [0x00200000], 0x00201003
	    mov dword [0x00201000], 0x00202003
	    mov dword [0x00201008], 0x00203003
	    mov dword [0x00201010], 0x00204003
	    mov dword [0x00201018], 0x00205003
	    mov edi, 0x00202000
	    mov eax, 0x83
	    mov ecx, 0x0800
	fill_pd:
	    mov [edi], eax
	    add eax, 0x00200000
	    add edi, 8
	    dec ecx
	    jnz fill_pd

	    mov eax, 0x00200000
	    mov cr3, eax
	    mov eax, cr4
	    or eax, 0x20
	    mov cr4, eax
	    mov ecx, 0xC0000080
	    rdmsr
	    or eax, 0x0100
	    wrmsr
	    mov eax, cr0
	    or eax, 0x80000000
	    mov cr0, eax
	    jmp 0x18:lm64
}

@bits(64)
@section(".lm", "rx")
@at(0x0340)
	asm lm64 {
	    mov ax, 0x20
	    mov ds, ax
	    mov es, ax
	    mov ss, ax
	    mov rsp, 0x00090000
	    call kmain
	.hang:
	    hlt
	    jmp .hang
}

@section(".gdtr")
@at(0x0200)
	bytes gdtr {
	dw 0x0027
		dd gdt_ents
}
@section(".gdtents")
@at(0x0208)
	bytes gdt_ents {
	dq 0
		db 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x9A, 0xCF, 0x00 // code32
		db 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x92, 0xCF, 0x00 // data32
		db 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x9A, 0xAF, 0x00 // code64
		db 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x92, 0xAF, 0x00 // data64
}
@section(".sig")
@at(0x01FE)
	bytes sig { db 0x55, 0xAA }

// ---------------------------------------------------------------------------
// SECTORES 2+ -- logica del kernel en Vesta.
// ---------------------------------------------------------------------------

// Punto de entrada del kernel (llamado por el stub de modo largo).
@section(".kernel")
@at(0x0380)
	void kmain() {
	serial.serial_init();
	fb.fb_init();       // consola grafica (linear framebuffer VBE 800x600x32)
	clock.clock_init(); // registra el instante de arranque (para uptime)

	// Banner (verde sobre el fondo azul oscuro del framebuffer).
	fb.fb_set_fg(0x0040E040);
	term.tputs("VestaOS 1.0  --  kernel de 64 bits en Vesta (framebuffer VBE)\n\n");
	fb.fb_set_fg(0x00CFCFCF);

	// Auto-test al arranque (validacion headless): carga el programa 'calc'
	// desde el DISCO y lo ejecuta con dos expresiones.  Esto ejercita todo el
	// cargador de programas + la tabla de API + la llamada por puntero, sin
	// necesidad de entrada interactiva.  Sale por el debugcon.
	term.tputs("selftest: ");
	u64 ent = prog.prog_find("calc");
	if (ent != 0) {
		prog.prog_exec(ent, "2+3*4");   // -> "= 14"
		prog.prog_exec(ent, "(2+3)*4"); // -> "= 20"
	} else {
		term.tputs("calc no encontrado\n");
	}

	// Terminal interactiva (teclado o serie); incluye calc/edit, los comandos
	// de ficheros (ls/cat/write/cp/mv/touch/rm/mkdir/echo>), reloj (date/
	// uptime), df y beep.
	shell.shell_run();

// shell_run() solo retorna con 'exit'; en HW real caemos al hlt del stub.
}
