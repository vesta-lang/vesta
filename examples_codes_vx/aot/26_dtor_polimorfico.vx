// AOT.2.d (4) -- dtor polimorfico: una referencia de tipo BASE que posee una
// instancia DERIVADA ejecuta el destructor DERIVADO al salir de scope (RAII).
// El cleanup despacha ~T() por la vtable de la instancia (no por el tipo
// estatico) -- como un `virtual ~T()` de C++.
//
// Compilar + enlazar + ejecutar (ELF):
//   vm -m aot --vx examples_codes_vx/aot/26_dtor_polimorfico.vx \
//      -o poly.o --format elf --emit obj
//   gcc -no-pie poly.o harness.c -o poly && ./poly ; echo $?   # -> 2
//
// harness.c:
//   static long g=0;
//   void note(long x){ g=x; }
//   long get_note(void){ return g; }
//
// `Animal a = new Dog()` -> al cerrar run() el cleanup carga la vtable de obj[0]
// (que __new_Dog dejo apuntando a la vtable de Dog), lee el slot del dtor y hace
// CALLIND -> se ejecuta ~Dog (note(2)), no ~Animal (note(1)).  Luego free.  Sin
// leaks (valgrind limpio).

extern "h" { fn note(i64 x) -> void;
	fn get_note() -> i64; }

class Animal { i64 v;
	~Animal() { note(1); } }
class Dog : Animal { ~Dog() { note(2); } }

void run() {
	Animal a = new Dog(); // ref base, instancia derivada
} // ~ aqui: dispatch virtual -> ~Dog

i64 main() {
	run();
	return get_note(); // 2 (se ejecuto ~Dog, no ~Animal)
}
