// AOT.2.b: clases NATIVAS sin runtime VM (sin GC, sin ClassRegistry).
//   vm -m aot --vx 20_class_native.vx --emit obj --format elf -o c.o
//   gcc c.o -o c && ./c        # exit 42
//
// `new Rect(...)` -> calloc(1, size) (heap zero-init) + ctor directo; los
// campos son LOAD/STORE [obj+off]; el metodo es una funcion libre con `this`.
// El objeto se LIBERA al exit del scope (RAII via RAW_FREE -> free): cero
// leaks, cero dangling (valgrind-clean).  Sin runtime: el .o solo referencia
// los simbolos externos calloc/free (los resuelve el linker -- o el allocator
// del usuario en freestanding via @AllocatorOverride).  El programador decide
// la reserva; el GC seria opt-in enlazando el runtime de la VM.

class Rect {
	i32 w;
	i32 h;
	Rect(i32 a, i32 b) { this.w = a;
		this.h = b; }
	i32 area() { return this.w * this.h; }
}

i32 main() {
	Rect r = new Rect(6, 7); // calloc + ctor; free automatico al salir
	return r.area();         // 6 * 7 = 42
}
