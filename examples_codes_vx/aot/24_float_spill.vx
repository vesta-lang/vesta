// AOT float SSE2: presion de registros FP -> spills (MOVSD a/desde slot).
// Mantiene >14 valores f64 vivos simultaneamente (mas que XMM0..XMM13
// asignables) para forzar al regalloc a derramar algunos a la pila, y
// los suma todos al final (cada uno se relee del spill).  La recursion
// del productor evita el constant-folding.

// Genera un f64 runtime: acc + step, n veces (no plegable).
f64 ramp(i64 n, f64 acc, f64 step) {
	if (n == 0) { return acc; }
	return ramp(n - 1, acc + step, step);
}

i64 spill_sum() {
	// 16 valores f64 vivos: cada ramp produce un valor runtime distinto.
	f64 a0 = ramp(1, 0.0, 1.0);  // 1
	f64 a1 = ramp(2, 0.0, 1.0);  // 2
	f64 a2 = ramp(3, 0.0, 1.0);  // 3
	f64 a3 = ramp(4, 0.0, 1.0);  // 4
	f64 a4 = ramp(5, 0.0, 1.0);  // 5
	f64 a5 = ramp(6, 0.0, 1.0);  // 6
	f64 a6 = ramp(7, 0.0, 1.0);  // 7
	f64 a7 = ramp(8, 0.0, 1.0);  // 8
	f64 a8 = ramp(9, 0.0, 1.0);  // 9
	f64 a9 = ramp(10, 0.0, 1.0); // 10
	f64 b0 = ramp(11, 0.0, 1.0); // 11
	f64 b1 = ramp(12, 0.0, 1.0); // 12
	f64 b2 = ramp(13, 0.0, 1.0); // 13
	f64 b3 = ramp(14, 0.0, 1.0); // 14
	f64 b4 = ramp(15, 0.0, 1.0); // 15
	f64 b5 = ramp(16, 0.0, 1.0); // 16
	// suma 1..16 = 136.  Todos vivos hasta aqui -> presion FP.
	f64 sum = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
		+ a8 + a9 + b0 + b1 + b2 + b3 + b4 + b5;
	return (i64) sum; // FTOI -> 136
}

i32 main() {
	i64 s = spill_sum(); // 136
	return (i32) s;      // 136 & 0xFF = 136
}
