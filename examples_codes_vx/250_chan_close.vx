// Canal con close(): el productor envia N valores y CIERRA; el consumidor
// recibe hasta que el canal esta cerrado Y drenado (idioma CSP productor/
// consumidor con senal de fin).  Ejercita vx_chan_close + vx_chan_is_closed
// sobre el scheduler M:N de fibras.
import "vx_pool" only vx_pool_start, vx_pool_submit, vx_pool_join;
import "vx_chan" only Chan, vx_chan_new, vx_chan_send, vx_chan_recv,
                     vx_chan_close, vx_chan_is_closed, vx_chan_free;

Chan g_ch;
i64 g_sum = 0;
i64 g_count = 0;
i64 g_n = 50;

void producer(i64 arg) {
    i64 i = 0;
    while (i < g_n) {
        vx_chan_send(g_ch, i + 1);   // envia 1..50
        i = i + 1;
    }
    vx_chan_close(g_ch);             // senal de fin: no habra mas datos
}

void consumer(i64 arg) {
    i64 s = 0;
    i64 c = 0;
    // Recibir hasta que el canal este CERRADO y DRENADO.  Los valores enviados
    // son 1..50 (nunca 0), asi que recv==0 solo ocurre en canal cerrado+vacio.
    while (true) {
        i64 v = vx_chan_recv(g_ch);
        if (v == 0 && vx_chan_is_closed(g_ch)) {
            break;                   // cerrado + drenado
        }
        s = s + v;
        c = c + 1;
    }
    g_sum = s;
    g_count = c;
}

i32 main() {
    g_ch = vx_chan_new(4);           // buffer pequeno -> fuerza park/wake real
    vx_pool_start(2);
    vx_pool_submit((i64)(cfn(i64) -> void) consumer, 0);
    vx_pool_submit((i64)(cfn(i64) -> void) producer, 0);
    vx_pool_join();
    vx_chan_free(g_ch);
    // sum(1..50) = 1275, count = 50 -> 42 si ambos correctos.
    return (g_sum == 1275 && g_count == 50) ? 42 : (i32) g_sum;
}
