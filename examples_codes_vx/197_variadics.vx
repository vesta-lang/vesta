namespace ejemplos.variadics;

// =============================================================================
// 197_variadics.vx
//
// Funciones VARIADICAS estilo Go: `fn foo(A fixed, T... rest)`.  El parametro
// `rest` (ultimo) acepta 0+ argumentos del tipo del elemento T.  El caller
// empaqueta los args trailing en un array de pila y pasa (ptr, count); el
// callee recibe `rest` como `T*` (se indexa `rest[i]`) y lee el numero de
// elementos con el builtin `vacount()`.  Es la formalizacion del patron
// "argv por puntero" como feature del lenguaje (sin GC, AOT-friendly).
//
// Resultado esperado: 42
// =============================================================================

// Solo variadico: suma todos los argumentos.
i64 sum(i64... nums) {
    i64 total = 0;
    i64 n = vacount();
    i64 i = 0;
    while (i < n) {
        total = total + nums[i];
        i = i + 1;
    }
    return total;
}

// Fijo + variadico: parte de `base` y acumula el resto.
i64 sum_from(i64 base, i64... nums) {
    i64 total = base;
    i64 n = vacount();
    i64 i = 0;
    while (i < n) {
        total = total + nums[i];
        i = i + 1;
    }
    return total;
}

i64 main() {
    i64 a = sum(10, 20, 12);        // 42
    i64 b = sum();                  // 0  (cero args variadicos)
    i64 c = sum_from(100, 1, 2, 3); // 106
    i64 d = sum_from(7);            // 7  (solo el fijo)

    // a(42) + b(0) + c(106) + d(7) = 155 ; 155 - 113 = 42
    return a + b + c + d - 113;
}
