// select sobre canales (fan-in): un consumidor multiplexa la RECEPCION de dos
// canales con chan_select_recv_block.  Dos productores envian por canales
// distintos; el consumidor recibe de "el que este listo" hasta juntar todos los
// mensajes.  El orden de llegada NO es determinista (depende del scheduler) pero
// la SUMA y los conteos por-canal SI -> verificacion estable.
import std.pool only pool_start, pool_submit, pool_join;
import std.chan only Chan, chan_new, chan_send, chan_free,
chan_select_recv_block;

Chan g_ch_a;
Chan g_ch_b;
i64  g_sum = 0_i64;
i64  g_from_a = 0_i64;
i64  g_from_b = 0_i64;

const i64 A_N = 2_i64; // el canal A envia 2 mensajes: 10, 11
const i64 B_N = 3_i64; // el canal B envia 3 mensajes: 20, 21, 22

void producer_a(i64 arg) {
	for (i64 i = 0_i64; i < A_N; i++) {
		chan_send(g_ch_a, 10 + i);
	}
}
void producer_b(i64 arg) {
	for (i64 i = 0_i64; i < B_N; i++) {
		chan_send(g_ch_b, 20 + i);
	}
}
void consumer(i64 arg) {
	Chan[2] chans;
	chans[0] = g_ch_a;
	chans[1] = g_ch_b;
	i64 v     = 0_i64;
	i64 total = A_N + B_N; // 5 mensajes en total
	for (i64 got = 0_i64; got < total; got++) {
		i64      idx = chan_select_recv_block(&chans[0], 2, &v);
		g_sum += v;
		if (idx == 0) {
			g_from_a += 1;
		} else {
			g_from_b += 1;
		}
	}
}
i32 main() {
	g_ch_a = chan_new(1); // cap 1: fuerza send bloqueante -> park/wake
	g_ch_b = chan_new(1);
	pool_start(2);
	pool_submit((i64)(cfn(i64) -> void) consumer, 0);
	pool_submit((i64)(cfn(i64) -> void) producer_a, 0);
	pool_submit((i64)(cfn(i64) -> void) producer_b, 0);
	pool_join();
	chan_free(g_ch_a);
	chan_free(g_ch_b);
	// sum = 10+11 + 20+21+22 = 84; from_a=2, from_b=3.
	if (g_from_a == A_N && g_from_b == B_N && g_sum == 84) {
		return 42;
	}
	return (i32)g_sum;
}
