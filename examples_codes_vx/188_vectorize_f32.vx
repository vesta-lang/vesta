// =============================================================================
// 188_vectorize_f32.vx
//
// Auto-vectorizacion de FLOAT de 32 bits (single precision).  El mismo
// element-wise `c[i] = a[i] OP b[i]` y la reduccion `acc += a[i]` se vectorizan
// para punteros f32 HOST, con el DOBLE de lanes que f64: SSE2 W=4, AVX2 W=8,
// AVX512 W=16.  Usa instrucciones packed-single (ADDPS/SUBPS/MULPS/DIVPS, sin
// el prefijo 66 de las packed-double).
//
// En el JIT/AOT el bucle interior es SIMD (VADDPS ymm/zmm); en el interprete,
// escalar por lane con sufijo .ps.  Resultado IDENTICO (solo cambia velocidad).
// =============================================================================

// Suma vectorizada de un array f32 (reduccion).
f32 sumf(f32* p, i32 n) {
    f32 acc = 0.0;
    for (i32 i = 0; i < n; i++) { acc = acc + p[i]; }   // REDUCCION f32
    return acc;
}

i64 main() {
    f32* a = malloc(40);   // 10 x f32
    f32* b = malloc(40);
    f32* c = malloc(40);
    for (i32 i = 0; i < 10; i++) { a[i] = (f32)(i + 1); b[i] = (f32)(i * 2); }

    // element-wise: c[i] = a[i] + b[i] = 3i+1 ; suma = 145
    for (i32 i = 0; i < 10; i++) { c[i] = a[i] + b[i]; }
    f32 s1 = sumf(c, 10);

    // reduccion con N impar (cola escalar)
    f32* d = malloc(28);   // 7 x f32
    for (i32 i = 0; i < 7; i++) { d[i] = (f32)(2 * i + 1); }
    f32 s2 = sumf(d, 7);   // 49

    free(a); free(b); free(c); free(d);

    // 145 + 49 = 194
    return (i64)(s1 + s2);
}
