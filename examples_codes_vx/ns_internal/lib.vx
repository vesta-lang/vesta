// NS.3: `internal` = visible en TODO el paquete (mismo PackageId) pero NO
// exportado a paquetes distintos.  Aqui NO hay @id ni vx.toml distinto, asi
// que consumidor y dep comparten el paquete (anonimo) y `internal` es visible.
namespace lib;

public   i64 publica(i64 x) { return x + 1; }
internal i64 interna(i64 x) { return x + 100; }   // package-scoped
