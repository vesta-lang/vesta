namespace ejemplos.syncimpl_hook;

// 254_syncimpl_hook.vx
//
// @SyncImpl: `synchronized` HOOKEABLE.  Cuando el programa declara un par de
// funciones @SyncImpl monitor_enter/monitor_exit, el bloque `synchronized(obj)`
// baja a un CALL a esas funciones en LOS 3 MODOS (interp/JIT/AOT) en vez del
// monitor por defecto (opcode MONENTER/MONEXIT en interp/JIT, __vx_monenter/
// monexit en AOT).  Mecanismo, no politica: la impl del usuario decide el lock
// (aqui: un simple contador de invocaciones que verifica que el hook se llama).
//
// VERIFICACION: 21 iteraciones de bump() -> 21 entradas + 21 salidas del monitor
// custom.  El resultado 42 (= enter_count + exit_count) SOLO es posible si el
// override se invoco en CADA synchronized; con el monitor por defecto los
// contadores quedarian a 0.  Identico en -m vm / -m jit / -m aot (42 cabe en un
// byte -> exit-code 42 en el binario nativo).

// Contadores de invocacion del monitor custom (host globals).
i64 __sync_enter_count = 0;
i64 __sync_exit_count  = 0;

// Override de la primitiva de adquisicion.  El nombre convenido (monitor_enter)
// selecciona el rol.  Firma: void(<ptr> obj) -- obj es el host_ptr al objeto.
@SyncImpl
	void monitor_enter(i64 *obj) {
	__sync_enter_count = __sync_enter_count + 1;
}

// Override de la primitiva de liberacion.
@SyncImpl
	void monitor_exit(i64 *obj) {
	__sync_exit_count = __sync_exit_count + 1;
}

class Box {
	i32 value;
	Box() { this.value = 0; }
	i32 bump() {
		synchronized (this) {
			this.value = this.value + 1;
		}
		return this.value;
	}
}

i32 main() {
	Box b = new Box();
	i32 i = 0;
	while (i < 21) {
		b.bump();
		i = i + 1;
	}
	// 21 enters + 21 exits = 42.  Confirma que AMBOS hooks se invocaron una vez
	// por cada synchronized (entrada y salida).
	i64 total = __sync_enter_count + __sync_exit_count;
	return (i32)total; // 42
}
