namespace ejemplos.operadores;

// =============================================================================
// Sobrecarga de operadores.
//
// Un struct o una clase declara metodos con nombre reservado ("dunder") y los
// operadores del lenguaje pasan a llamarlos.  El dispatch es ESTATICO en un
// struct (CALL directo, sin vtable), asi que el optimizador puede inlinearlo:
// un operador sobrecargado no cuesta mas que la operacion que hace dentro.
//
//   +  -  *  /  %      __add__ __sub__ __mul__ __div__ __mod__
//   <  >  <= >=        __lt__  __gt__  __le__  __ge__
//   == !=              __eq__  __ne__   (sin __ne__, se niega __eq__)
//   &  |  ^  << >>     __and__ __or__  __xor__ __lshift__ __rshift__
//   -x  ~x             __neg__ __invert__
//   a[i]  a[i]=v       __index__  __index_set__
//   a[x..y]            __slice__  __slice_mut__   (el rango llega normalizado
//                      a [lo, hi); sin superior, hasta `len()`)
//
// El tipo que devuelve cada operador lo decide quien lo escribe.  Entre
// `__slice__` y `__slice_mut__` elige el DESTINO: si pide lo que da el de
// escritura, ese; si no, el de lectura.
//
// Los compuestos y el incremento salen de los anteriores; no hay que
// declararlos:
//
//   +=  -=  *=  /=  %=  &=  |=  ^=  <<=  >>=
//   ++  --
//
// `a += b` es `a = a + b` (via __add__) y `a++` es `a += 1`.  Un tipo que
// necesite que la operacion sea UNA sola (indivisible, no leer-modificar-
// escribir) declara ademas el dunder IN-PLACE -- `__iadd__`, `__isub__`, ... --
// y entonces `+=` llama a ESE.  Es lo que usan los tipos atomicos.
//
// `!x`, `x && y`, `x || y` e `if (x)` NO tienen dunder propio: usan `__bool__`.
// Asi el CORTOCIRCUITO se conserva (sobrecargar `&&`, como deja C++, lo
// perderia: evaluaria siempre el lado derecho).
//
// Resultado esperado: R00 == 42
// =============================================================================

/// Vector 2D: aritmetica, comparacion e indexado.
struct Vec2 {
	i64 x;
	i64 y;

	public Vec2 __add__(Vec2 o) {
		Vec2 r;
		r.x = this.x + o.x;
		r.y = this.y + o.y;
		return r;
	}
	public Vec2 __sub__(Vec2 o) {
		Vec2 r;
		r.x = this.x - o.x;
		r.y = this.y - o.y;
		return r;
	}
	public Vec2 __mul__(i64 k) {
		Vec2 r;
		r.x = this.x * k;
		r.y = this.y * k;
		return r;
	}
	public Vec2 __neg__() {
		Vec2 r;
		r.x = -this.x;
		r.y = -this.y;
		return r;
	}
	public bool __eq__(Vec2 o) => this.x == o.x && this.y == o.y;
	/// `v[0]` / `v[1]` -> componente.
	public i64 __index__(i64 i) { if (i == 0) { return this.x; } return this.y; }
	/// `v[i] = k`.  Lo que DEVUELVE el operador lo decide quien lo escribe --
	/// aqui, si escribio --, y es lo que vale la asignacion.
	public bool __index_set__(i64 i, i64 k) {
		if (i == 0) {
			this.x = k;
			return true;
		}
		if (i == 1) {
			this.y = k;
			return true;
		}
		return false;
	}
	/// `v` es "verdad" si no es el vector cero.
	public bool __bool__() => this.x != 0 || this.y != 0;
}

/// Lo que da un corte de `Fila`: que tramo se pidio y si se pidio para escribir.
struct Tramo {
	i64  lo;
	i64  hi;
	bool escribe;
}

/// Una fila que se corta con `f[x..y]`.
struct Fila {
	i64 n;

	/// La longitud: hasta donde llega `f[x..]`.
	public u64 len() => (u64)this.n;
	/// Cortar para LEER.
	public Tramo __slice__(
		u64 lo,
		u64 hi
	) => {.lo = (i64)lo, .hi = (i64)hi, .escribe = false};
	/// Cortar para ESCRIBIR: lo elige un destino que lo pida.
	public TramoMut __slice_mut__(u64 lo, u64 hi) => {.lo = (i64)lo };
}

/// El tipo que da el corte para escribir: distinto, para que el destino elija.
struct TramoMut {
	i64 lo;
}

/// Mascara de bits: bitwise, shifts y el `+=` con dunder IN-PLACE.
struct Mask {
	i64 v;

	public Mask __and__(i64 r) {
		Mask m;
		m.v = this.v & r;
		return m;
	}
	public Mask __or__(i64 r) {
		Mask m;
		m.v = this.v | r;
		return m;
	}
	public Mask __xor__(i64 r) {
		Mask m;
		m.v = this.v ^ r;
		return m;
	}
	public Mask __lshift__(i64 r) {
		Mask m;
		m.v = this.v << r;
		return m;
	}
	public Mask __rshift__(i64 r) {
		Mask m;
		m.v = this.v >> r;
		return m;
	}
	public Mask __invert__() {
		Mask m;
		m.v = ~this.v;
		return m;
	}
	public bool __bool__() => this.v != 0;

	/// Dunder IN-PLACE: `m += 1` llama AQUI, en vez de a `__add__` + store.
	/// Para un tipo normal da igual; para uno que promete atomicidad es la
	/// diferencia entre una operacion y tres.
	public void __iadd__(i64 r) { this.v = this.v + r; }
}

i32 main() {
	// 1. Aritmetica: `+`, `-` y `*` con un escalar.
	Vec2 a;
	a.x = 3;
	a.y = 4;
	Vec2 b;
	b.x    = 1;
	b.y    = 2;
	Vec2 c = a + b; // (4, 6)  -- __add__
	Vec2 d = c - b; // (3, 4)  -- __sub__
	Vec2 e = d * 2; // (6, 8)  -- __mul__

	// 2. Compuesto SIN declararlo: `+=` sale de `__add__`.
	Vec2 f;
	f.x = 0;
	f.y = 0;
	f += e; // (6, 8)
	f += b; // (7, 10)
	f -= b; // (6, 8)  -- via __sub__

	// 3. Indexado y unario.
	i64  sum =  f[0] + f[1];     // 14      -- __index__
	Vec2 neg = -a;               // (-3,-4) -- __neg__
	sum      =  sum + (-neg[0]); // 14 + 3 = 17

	// La escritura por indice vale lo que devuelva `__index_set__`.
	Vec2 g;
	g.x         = 0;
	g.y         = 0;
	bool dentro = (g[1] = 9); // escribe y: true
	bool fuera  = (g[5] = 1); // no hay componente 5: false, y no escribe
	if (!dentro || fuera || g[1] != 9 || g[0] != 0) return 1;

	// El corte: el rango llega normalizado a [lo, hi) en todas sus formas.
	Fila  fila = {.n = 10};
	Tramo t1   = fila[2..5];  // [2, 5)
	Tramo t2   = fila[..4];   // [0, 4)
	Tramo t3   = fila[3..];   // [3, 10): hasta len()
	Tramo t4   = fila[1..=3]; // [1, 4)
	if (t1.lo != 2 || t1.hi != 5 || t2.lo != 0 || t3.hi != 10 || t4.hi != 4) {
		return 2;
	}
	TramoMut w = fila[6..8]; // el destino pide el de escritura
	if (t1.escribe || w.lo != 6) return 3;

	// 4. Igualdad: `!=` se deriva negando `__eq__`.
	if (a == d) { sum = sum + 10; } // (3,4) == (3,4) -> 27
	if (a != b) { sum = sum + 5; }  // -> 32

	// 5. Verdad de un objeto: `if`, `!` y `&&` usan `__bool__`, y el
	//    cortocircuito sigue intacto.
	Vec2 zero;
	zero.x = 0;
	zero.y = 0;
	if (a && !zero) { sum = sum + 4; } // -> 36

	// 6. Bitwise, shifts e in-place.
	Mask m;
	m.v = 0b1010;
	m   = m | 0b0101; // 0b1111 = 15
	m   = m & 0b1110; // 0b1110 = 14
	m   = m ^ 0b0001; // 0b1111 = 15
	m <<= 1;          // 30      -- via __lshift__
	m >>= 1;          // 15      -- via __rshift__
	m += 1;           // 16      -- __iadd__ (in-place)
	m++;              // 17      -- ++ es += 1 -> __iadd__

	Mask inv = ~m;              // __invert__
	if (inv) { sum = sum + 1; } // -18 != 0 -> 37

	// 37 + (17 - 12) = 42
	return (i32)(sum + (m.v - 12));
}
