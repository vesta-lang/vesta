namespace ejemplos.expect_falla;

// `expect` cuando la afirmacion es falsa: dice QUE se dio por hecho, y muere.
//
// `unwrap` que falla solo puede contar el mensaje generico del catalogo: "habia
// que desenvolver algo y no habia nada".  Eso dice lo que paso, no lo que se
// esperaba.  `expect` deja escrito el supuesto en el propio sitio, y es lo
// unico que queda cuando falla.
//
// El mensaje se escribe SOLO en la rama de que no hay nada, asi que el camino
// bueno no paga: la rama esta y no se toma.  Y el texto es conocido al
// compilar -- por eso tiene que ser una cadena escrita en el sitio --, asi que
// no se construye nada en ejecucion.
//
// Este programa TIENE que morir: la suite comprueba que aparece el mensaje
// propio, el codigo del catalogo y la cadena de llamadas.

i64 leer_config(Optional<i64> valor) {
	return expect(valor, "el limite de reintentos venia de la configuracion");
}

i32 main() {
	      Optional<i64> sin_configurar = None();
	const i64           v              = leer_config(sin_configurar);
	println("no se debe llegar aqui: ${v}");
	return 0;
}
