// examples_codes_vx/295_c_func_ptr.vx
//
// Punteros a funcion estilo C `R (*name)(args)`, que mapean al tipo `cfn`
// (puntero PURO a codigo, 8 bytes; distinto del lambda fat `fn`, 16 bytes).
// Cubiertos: campo de struct, typedef, parametro, variable local, y la
// promocion de un nombre de funcion desnudo a un parametro cfn.
//
// Resultado esperado: R0 == 42.

// typedef de puntero a funcion C.
typedef i32 (*BinOp)(i32 a, i32 b);

// Struct con campos puntero a funcion (tabla de operaciones, estilo vtable C).
struct Ops {
    i32 (*add)(i32 a, i32 b);
    i32 (*mul)(i32 a, i32 b);
    u8  tag;
}

i32 c_add(i32 a, i32 b) { return a + b; }
i32 c_mul(i32 a, i32 b) { return a * b; }
i32 c_dbl(i32 x)        { return x * 2; }

// Parametro puntero a funcion (callback), llamado indirectamente.
i32 apply1(i32 (*cb)(i32 x), i32 v) { return cb(v); }

i32 main() {
    // Variable local puntero a funcion C + promocion del nombre desnudo.
    i32 (*op)(i32 a, i32 b) = c_add;
    i32 r1 = op(10, 8);          // 18

    // typedef como tipo de variable.
    BinOp m = c_mul;
    i32 r2 = m(3, 5);            // 15

    // Campos puntero a funcion en struct.
    Ops ops;
    ops.add = c_add;
    ops.mul = c_mul;
    ops.tag = 1;
    i32 r3 = ops.add(2, 3);      // 5

    // Promocion de nombre de funcion a parametro cfn (callback).
    i32 r4 = apply1(c_dbl, 2);   // 4

    // 18 + 15 + 5 + 4 = 42
    return r1 + r2 + r3 + r4;
}
