namespace ejemplos.vectorize_fma;

// =============================================================================
// 190_vectorize_fma.vx
//
// Auto-vectorizacion de DOT-PRODUCT con FMA fusionado: el patron
//   for/while (i)  acc = acc + a[i] * b[i];
// (acumulador float + dos arrays HOST del mismo tipo) se vectoriza con un
// acumulador vectorial multiplicado-acumulado: por chunk, acc_lanes += a*b.
//
// El JIT/AOT emite VFMADD231P{D,S} (multiplica-acumula con UN SOLO redondeo);
// el interprete (oraculo) usa el opcode VM `fmadd` (std::fma, tambien 1
// redondeo) por lane -> coincide BIT-A-BIT con el JIT.  Un mul+add separado
// daria DOS redondeos y divergiria.  La cola escalar (N % W) usa mul+add en
// ambos por igual.  Resultado IDENTICO entre interp y jit.
//
// Solo punteros float (f64/f32) HOST; necesita AVX para el VFMADD en el JIT
// (sin AVX el JIT cae a interp, que sigue siendo correcto).
// =============================================================================

// Producto escalar (dot product) de dos vectores f64.
f64 dot(f64* a, f64* b, i32 n) {
    f64 acc = 0.0;
    for (i32 i = 0; i < n; i++) { acc = acc + a[i] * b[i]; }   // -> FMA
    return acc;
}

i64 main() {
    f64* a = malloc(80);   // 10 x f64
    f64* b = malloc(80);
    for (i32 i = 0; i < 10; i++) { a[i] = (f64)(i + 1); b[i] = (f64)(i + 1); }
    f64 r = dot(a, b, 10);   // sum (i+1)^2 = 1+4+9+...+100 = 385

    // N impar: ejercita la cola escalar (7 % W != 0)
    f64* c = malloc(56);   // 7 x f64
    f64* d = malloc(56);
    for (i32 i = 0; i < 7; i++) { c[i] = 2.0; d[i] = (f64)(i + 1); }
    f64 r2 = dot(c, d, 7);   // 2*(1+2+...+7) = 56

    free(a); free(b); free(c); free(d);

    // 385 + 56 = 441
    return (i64)(r + r2);
}
