namespace ejemplos.rango_sin_subindice_err;

// Un rango `[a..b]` sobre algo que no sabe cortar es un error (VX2154).  Antes
// el rango se ignoraba: `arr[1..3]` era `arr[1]`, y un `__index__(i)` recibia
// `1`, otro resultado sin aviso.
struct Tabla {
	i64[4] v;

	i64 __index__(u64 i) => this.v[i];
}

i32 main() {
	i64[4] arr = {1, 2, 3, 4};
	i64    a   = arr[1..3];
	Tabla  t   = {.v = {5, 6, 7, 8}};
	i64    b   = t[1..3];
	return (i32)(a + b);
}
