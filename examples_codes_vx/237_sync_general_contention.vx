namespace ejemplos.sync_general_contention;

// 237_sync_general_contention.vx
//
// F4-(a) PROPER de las fibras nativas: contienda REAL sobre el monitor GENERAL
// de vx_sync (__vx_monenter/__vx_monexit), NO el lock inline-asm co-ubicado del
// 234.  Tres fibras contienden el mismo objeto: cada una adquiere el monitor,
// incrementa un contador, CEDE mientras lo tiene (forzando contienda), incrementa
// otra vez, y libera.  El monitor cooperativo (owner por fiber-id + vasync_yield
// en contienda) evita el deadlock que un spin causaria en el modelo cooperativo
// single-thread (la fibra duenña solo corre si el scheduler la elige).
//
// Total esperado: 3 fibras * 7 iters * 2 incrementos = 42, sin updates perdidos
// (exclusion mutua) ni deadlock (el yield del monitor funciona).
//
// El `synchronized` de main dispara el auto-bundle de vx_sync (CALL __vx_monenter
// en el IR); las fibras (@Naked) llaman __vx_monenter/__vx_monexit por asm sobre
// el mismo runtime bundleado.  AOT: `-m aot`.
//
//   vm -m aot --vx 237_sync_general_contention.vx --format pe -o p.exe && ./p.exe
//     -> exit 42

import "vx_async" only vasync_yield, vasync_task_done, vasync_spawn_fiber, vasync_run;

// Clase trivial: su unico proposito es que `synchronized` en main emita
// CALL __vx_monenter y dispare el auto-bundle multi-modulo (vx_sync+vx_async).
class Trigger {
	i32 x;
}

// ===========================================================================
//  Cuerpo de tarea (@Naked).  arg = state block (host) en r13:
//    [r13+0]  = iters restantes
//    [r13+8]  = lock_obj_ptr (host_ptr; su palabra de monitor en obj+16)
//    [r13+16] = counter_ptr  (host_ptr al contador compartido)
//  Adquiere/libera via el MONITOR GENERAL (__vx_monenter/__vx_monexit), que cede
//  internamente en contienda.  r12 = obj (callee-saved: sobrevive el yield).
// ===========================================================================
@Target("!os:windows")
	@Naked
void race_task() {
	asm volatile noinfer {
		    mov r13, rdi
		race_loop:
		    mov rax, [r13 + 0]
		    test rax, rax
		    jz race_end
		    mov r12, [r13 + 8]

		    mov rdi, r12
		    call __vx_monenter

		    mov rax, [r13 + 16]
		    mov rcx, [rax]
		    add rcx, 1
		    mov [rax], rcx

		    call vasync_yield

		    mov rax, [r13 + 16]
		    mov rcx, [rax]
		    add rcx, 1
		    mov [rax], rcx

		    mov rdi, r12
		    call __vx_monexit

		    mov rax, [r13 + 0]
		    sub rax, 1
		    mov [r13 + 0], rax
		    jmp race_loop
		race_end:
		    call vasync_task_done
		race_hang:
		    jmp race_hang
	}
}
@Target("os:windows")
	@Naked
void race_task() {
	asm volatile noinfer {
		    mov r13, rcx
		    sub rsp, 32
		race_loop:
		    mov rax, [r13 + 0]
		    test rax, rax
		    jz race_end
		    mov r12, [r13 + 8]
		    mov rcx, r12
		    call __vx_monenter
		    mov rax, [r13 + 16]
		    mov rcx, [rax]
		    add rcx, 1
		    mov [rax], rcx
		    call vasync_yield
		    mov rax, [r13 + 16]
		    mov rcx, [rax]
		    add rcx, 1
		    mov [rax], rcx
		    mov rcx, r12
		    call __vx_monexit
		    mov rax, [r13 + 0]
		    sub rax, 1
		    mov [r13 + 0], rax
		    jmp race_loop
		race_end:
		    call vasync_task_done
		race_hang:
		    jmp race_hang
	}
}

i32 main() {
	// Dispara el auto-bundle de vx_sync (synchronized -> CALL __vx_monenter).
	Trigger t = new Trigger();
	synchronized (t) {
		t.x = 1;
	}

	// Objeto compartido cuyo monitor (celda obj+16) se contiende.
	u64  lock_obj = (u64)malloc(4 * 8);
	u64* lo       = (u64 *)lock_obj;
	lo[0] = 0;
	lo[1] = 0;
	lo[2] = 0;
	lo[3] = 0;

	// Contador compartido.
	u64  cnt_cell = (u64)malloc(8);
	u64* cc       = (u64 *)cnt_cell;
	cc[0] = 0;

	// 3 state blocks de 3 qwords: [iters, lock_obj, counter_ptr].
	u64  blk = (u64)malloc(3 * 3 * 8);
	u64  s1  = blk + 0 * 24;
	u64  s2  = blk + 1 * 24;
	u64  s3  = blk + 2 * 24;
	u64* p1  = (u64 *)s1;
	p1[0] = 7;
	p1[1] = lock_obj;
	p1[2] = cnt_cell;
	u64* p2 = (u64 *)s2;
	p2[0] = 7;
	p2[1] = lock_obj;
	p2[2] = cnt_cell;
	u64* p3 = (u64 *)s3;
	p3[0] = 7;
	p3[1] = lock_obj;
	p3[2] = cnt_cell;

	vasync_spawn_fiber((i64)(cfn() -> void) race_task, (i64)s1);
	vasync_spawn_fiber((i64)(cfn() -> void) race_task, (i64)s2);
	vasync_spawn_fiber((i64)(cfn() -> void) race_task, (i64)s3);

	vasync_run();

	u64 total = cc[0]; // 3 * 7 * 2 = 42
	free((i64 *)blk);
	free((i64 *)cnt_cell);
	free((i64 *)lock_obj);
	return (i32)total; // 42
}
