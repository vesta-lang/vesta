namespace ejemplos.float_params_loop;

// =============================================================================
// 186_float_params_loop.vx
//
// Regresion: parametros f64, retorno f64 y valores f64 VIVOS A TRAVES de un
// bucle en el JIT (VM_ABI).  Antes el JIT:
//   - cargaba un parametro f64 en un registro GP (pisaba otro parametro, p.ej.
//     el puntero) -> direccion basura en el bucle -> SEGFAULT;
//   - pasaba los args f64 a un CALL guardando un GP stale -> el callee leia
//     bits basura;
//   - escribia el retorno f64 desde un GP stale -> retorno incorrecto (0).
// Causa raiz: el marshalling de params/args/retorno usaba vr() (clase GP) en
// vez de vrt() (clase FP) para valores float.  Fix: vrt() -> el rewrite enruta
// a MOVSD (params/args) y MOVQ_XMM_GP (retorno, bits del f64 a regs[0]).
//
// Verifica interp == jit en: f64 param derivado vivo cruzando el bucle, varios
// f64 vivos simultaneos, y CALL con multiples args f64.
// =============================================================================

// acc del bucle + un f64 (a, derivado del parametro) vivo A TRAVES del bucle.
f64 sum_plus(f64* p, i32 n, f64 base) {
	f64 a   = base + 1.0; // a vive a traves del bucle de abajo
	f64 acc = 0.0;
	for (i32 i = 0; i < n; i++) { acc = acc + p[i]; }
	return acc + a; // retorno f64 (a debe sobrevivir el bucle)
}

// varios f64 vivos a la vez + CALL con 4 args f64 (marshalling float).
f64 combine(f64* p, i32 n, f64 k0, f64 k1, f64 k2, f64 k3) {
	f64 a   = k0 + 1.0;
	f64 b   = k1 + 2.0;
	f64 c   = k2 + 3.0;
	f64 d   = k3 + 4.0;
	f64 acc = 0.0;
	for (i32 i = 0; i < n; i++) { acc = acc + p[i]; } // todos vivos a traves
	return acc + a + b + c + d;
}

i64 main() {
	f64* p = malloc(80);
	for (i32 i = 0; i < 10; i++) { p[i] = (f64)(i + 1); } // sum = 55

	// sum_plus: 55 + (40 + 1) = 96
	f64 r1 = sum_plus(p, 10, 40.0);

	// combine: a=11 b=22 c=33 d=44 (mix=110) + acc=55 = 165
	f64 r2 = combine(p, 10, 10.0, 20.0, 30.0, 40.0);

	free(p);
	// 96 + 165 = 261
	return (i64)(r1 + r2);
}
