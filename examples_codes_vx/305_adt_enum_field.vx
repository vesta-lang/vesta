// examples_codes_vx/305_adt_enum_field.vx
//
// Un enum ADT payloadless (`enum Color { Red, Green, Blue }`, sin `: tipo` ni
// payloads) se puede usar como CAMPO de struct: su valor es un unico qword (el
// tag), asi que ocupa 8 bytes y se asigna/lee como escalar.  (Un enum con
// backing entero `: u32` sigue dando 4 bytes, mejor para ABI C-exacto; un enum
// CON payload como campo se rechaza con error claro.)
//
// Resultado esperado: R0 == 42.

enum Color {
	Red,
	Green,
	Blue
}

// enum ADT como campo en struct plano.
struct Cell {
	u8 x;
	Color c;
	u8 y;
}

// enum ADT como campo en typedef struct + agregado anonimo.
typedef struct _NODE {
	Color kind;
	i32 val;
} NODE;

i32 main() {
	Cell cell;
	cell.x = 10;
	cell.c = Color.Blue;
	cell.y = 20;

	i32 tag = 0;
	match cell.c {
		case Red   => { tag = 1; }
		case Green => { tag = 2; }
		case Blue  => { tag = 8; }
	}

	NODE n;
	n.kind = Color.Green;
	n.val  = 4;
	i32 nk = 0;
	match n.kind {
		case Red   => { nk = 0; }
		case Green => { nk = 0; } // no suma
		case Blue  => { nk = 99; }
	}

	// 10 + 20 + 8 + 4 + 0 = 42
	return (i32)cell.x + (i32)cell.y + tag + n.val + nk;
}
