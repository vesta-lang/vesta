namespace ejemplos.params_metodo;

// Lo que va entre los parentesis de una declaracion no depende de si lo que se
// declara es una funcion suelta, un metodo o un constructor: es la misma
// gramatica.  Y no lo era -- el bucle que la leia estaba copiado cinco veces
// para los metodos, identico byte a byte, y era una version pobre que solo
// aceptaba `tipo nombre` --.  Un metodo no podia declarar un parametro no-nulo
// ni un puntero a funcion al estilo de C, y no por ninguna razon de diseno:
// porque la copia no lo sabia leer.

i64 doblar(i64 x) { return x * 2; }
i64 restar_uno(i64 x) { return x - 1; }

class Calculadora {
	// Puntero a funcion al estilo de C, como parametro de un metodo.
	public i64 aplicar(i64 (*op)(i64), i64 v) { return op(v); }

	// Parametro no-nulo: el que llama no puede pasar nulo, y el cuerpo no
	// tiene que comprobarlo.
	public i64 sumar_uno(i64 !!x) { return x + 1; }
}

struct CalcS {
	i64 aplicar(i64 (*op)(i64), i64 v) { return op(v); }
}

i32 main() {
	Calculadora c = new Calculadora();
	CalcS s;

	i64 a = c.aplicar(&doblar, 10); // 20
	i64 b = c.sumar_uno(9);         // 10
	i64 d = s.aplicar(&restar_uno, 13); // 12

	println("aplicar=${a} sumar_uno=${b} struct=${d}");

	return (i32)(a + b + d); // 42
}
