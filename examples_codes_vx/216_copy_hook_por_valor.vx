namespace ejemplos.copy_hook_por_valor;

// Copy-hook en paso por valor (ruta B, H1).
//
// Pasar un struct con copy-hook `__clone__` POR VALOR a una funcion (`f(a)`)
// hace una COPIA: la callee recibe su propia instancia.  El compilador aloca la
// copia, hace el memcpy y llama `copia.__clone__()` (p.ej. ++refcount); al
// retornar el CALL ejecuta el `~dtor` de la copia (la callee no la posee, igual
// que cualquier struct por valor en Vesta).  Asi un tipo de conteo de
// referencias se comporta correctamente: cada paso por valor incrementa y
// decrementa el contador, y el recurso se libera una sola vez cuando cae a cero.
// Ver doc/VMdoc//SmartPointers.md.

class Counter { public static i64 vivos; }

struct Rc {
	i64* ctrl;
	void __clone__() {*this.ctrl = *this.ctrl + 1; } // copia -> ++refcount
	~Rc() {
		*this.ctrl = *this.ctrl - 1;
		if (*this.ctrl == 0) { free(this.ctrl);
			Counter.vivos = Counter.vivos - 1; }
	}
}

Rc make() {
	Rc r;
	r.ctrl        = (i64 *) malloc(8);
	*r.ctrl       = 1;
	Counter.vivos = Counter.vivos + 1;
	return r;
}

i64 observar(Rc x) { // recibe COPIA por valor -> refcount=2 aqui dentro
	return *x.ctrl;  // 2 (a y la copia x)
} // ~x: refcount baja a 1

i64 trabajo() {
	Rc  a      = make();            // vivos=1, refcount=1
	i64 visto  = observar(a);  // copia -> __clone__ -> 2 ; ~copia -> 1
	i64 visto2 = observar(a); // de nuevo 2 -> 1
	return visto + visto2;    // 2 + 2 = 4
} // ~a: refcount=0 -> free, vivos=0

i32 main() {
	Counter.vivos = 0;
	i64 r = trabajo(); // r = 4 ; al volver, vivos=0 (todo liberado, un solo free)
	return (i32)(38 + r - Counter.vivos); // 38 + 4 - 0 = 42
}
