// -----------------------------------------------------------------------------
// Overlay structs (F2): offsets DINAMICOS + sizeof + CREAR (no solo parsear)
// -----------------------------------------------------------------------------
// F1 daba offsets constantes (`@0x3C`).  F2 permite que el offset de un campo
// dependa de OTROS campos de la vista: `@offset(hermano + N)`.  El resolvedor
// lee los campos hermanos en tiempo de acceso -- asi encadenas cabeceras
// (DOS -> NT -> ...) sin escribir aritmetica de punteros a mano.
//
//   * `@offset(nt_off)` -> la direccion del campo = base + valor_de(nt_off).
//   * Los nombres desnudos en la expresion son campos HERMANOS del overlay.
//   * El compilador exige que la expresion evalue a un entero.
//
// Ademas:
//   * `sizeof(Overlay)` = HUELLA ESTATICA de la vista (max offset+size de los
//     campos de offset CONSTANTE), una CONSTANTE de compilacion.  Sirve para
//     reservar el buffer de respaldo exacto al CREAR la estructura -- sin
//     adivinar tamanos.  (Los campos de offset dinamico no cuentan: son
//     dependientes de los datos.)
//   * Un overlay CREA estructuras, no solo las parsea: escribir `v.campo = x`
//     es `STORE [base + offset]`.  Rellenas un buffer propio a traves de la
//     vista tipada.
//
// Igual en interprete, JIT y AOT.

// Un "peek" de un PE: la cabecera DOS lleva en 0x3C el offset al NT header
// (e_lfanew); la firma del NT header ('PE\0\0') esta en base + ese offset.
@overlay
struct PePeek {
	u16 magic  @0x00;            // 'MZ' = 0x5A4D
	i32 nt_off @0x3C;           // e_lfanew: offset (relativo a base) al NT hdr
	u32 nt_sig @offset(nt_off); // DINAMICO: firma NT en base + nt_off
}

i32 main() {
	// sizeof de la vista = huella ESTATICA = max(0x00+2, 0x3C+4)=0x40=64.
	// El campo dinamico nt_sig NO cuenta (su posicion depende de los datos).
	// Reservamos la parte fija + hueco para el NT header que vamos a crear.
	u64 fixed = sizeof<PePeek>();           // 64 (constante de compilacion)
	println("sizeof<PePeek>() = ${fixed}"); // 64

	// --- CREAR (no parsear): rellenamos un buffer propio via la vista ---
	u8*    buf = (u8 *) malloc(128);
	PePeek pe  = PePeek(buf);

	// Orden topologico: primero el campo del que depende el offset dinamico.
	pe.magic  = (u16)0x5A4D;      // STORE [base + 0x00]
	pe.nt_off = 0x40;            // STORE [base + 0x3C]  (NT hdr tras lo fijo)
	pe.nt_sig = (u32)0x00004550; // STORE [base + nt_off] = base+0x40 ('PE\0\0')

	// --- Releer a traves de la vista: el offset dinamico se resuelve solo ---
	println("magic=${pe.magic} nt_off=${pe.nt_off} nt_sig=${pe.nt_sig}");

	// Comprobamos que nt_sig aterrizo REALMENTE en base + 0x40 (memoria cruda).
	u32 raw = *(u32 *)(buf + 0x40);
	println("en el buffer @0x40 = ${raw}"); // 17744 (0x4550)

	// Retorno determinista (harness):
	//   (nt_sig - 0x4550) verifica la lectura dinamica (0 si correcta)
	//   + sizeof<PePeek>() (64) + nt_off (64) = 128.
	i32 result = (i32)(pe.nt_sig - 0x4550) + (i32)fixed + pe.nt_off;
	free(buf);
	return result; // 0 + 64 + 64 = 128
}
