namespace ejemplos.naked_call_from_normal;

// 231_naked_call_from_normal.vx
//
// LIM-B: una funcion Vex NORMAL (no @Naked) llama a una funcion @Naked del
// MISMO fichero, en los tres modos (-m vm / -m jit / -m aot).  El primitivo
// @Naked es asm nativo puro; el routing a naked_dispatch (interp/JIT) o la
// llamada nativa directa (AOT) debe dar el MISMO resultado.
//
// add_asm(a, b) = a + b  (asm puro; ABI nativo: SysV rdi/rsi, Win64 rcx/rdx).
// main llama a add_asm(19, 23) desde una fn normal -> R0 = 42.
//
// Compilar/ejecutar:
//   vm --vx 231_naked_call_from_normal.vx -o p && vm -m vm  --run p.velb   (R00=42)
//   vm --vx 231_naked_call_from_normal.vx -o p && vm -m jit --run p.velb   (R00=42)
//   vm -m aot --vx 231_naked_call_from_normal.vx --format pe -o p.exe && ./p.exe  (exit 42)

@Target("!os:windows")
@Naked u64 add_asm(u64 a, u64 b) {
    asm volatile noinfer {
        mov rax, rdi
        add rax, rsi
        ret
    }
}
@Target("os:windows")
@Naked u64 add_asm(u64 a, u64 b) {
    asm volatile noinfer {
        mov rax, rcx
        add rax, rdx
        ret
    }
}

// Funcion Vex NORMAL (con prologo/epilogo del compilador) que llama al @Naked.
u64 compute(u64 x, u64 y) {
    u64 r = add_asm(x, y);
    return r;
}

i32 main() {
    u64 r = compute(19, 23);   // 42
    return (i32)r;
}
