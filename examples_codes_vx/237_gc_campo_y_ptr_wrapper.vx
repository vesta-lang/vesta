// examples_codes_vx/237_gc_campo_y_ptr_wrapper.vx
//
// Combinacion de modelos: un objeto GC (gc<Nodo>) guardado como CAMPO de
// una clase normal (RAII), y un puntero raw a un smart pointer unique.
// El campo gc<Nodo> lo recolecta el GC; el contenedor Wrap se libera por
// RAII sin tocar el objeto GC.
//
// Esperado: R00 == 42.

class Nodo {
    public i64 v;
    public Nodo(i64 x) { this.v = x; }
}

class Wrap {
    gc<Nodo> n;                    // campo GC dentro de clase RAII
}

i32 main() {
    Wrap w = new Wrap();
    w.n = new Nodo(42);
    return (i32) w.n.v;
}
