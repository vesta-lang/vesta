/**
 * @file 325_interfaz_vs_abstract.vx
 * @brief Diferencia entre una INTERFAZ (concept) y un struct @Abstract.
 *
 * Los dos NO son lo mismo:
 *
 *   @Abstract struct   ->  BASE PARCIAL con estado + implementacion.
 *                          Se HEREDA (`: Base`): el derivado recibe los
 *                          campos y los metodos ya escritos.  No se puede
 *                          instanciar por si sola.  Aporta CODIGO.
 *
 *   concept (interfaz) ->  CONTRATO puro, sin estado ni codigo.
 *                          Se SATISFACE (`: IConcepto`): el struct promete
 *                          exponer esos metodos y el compilador lo verifica
 *                          en tiempo de compilacion, coste cero.  Aporta
 *                          OBLIGACION, no codigo.
 *
 * Un struct puede usar AMBOS a la vez: heredar de un @Abstract y satisfacer
 * una interfaz.  El orden es `: Base, IConcepto1, IConcepto2` (la base
 * concreta primero, los contratos despues).
 */
namespace iface_vs_abstract;

// --- INTERFAZ: un contrato.  Solo dice "que forma" hace falta, sin dar codigo.
concept Dibujable {
    i64 area();
}

// --- @Abstract: una base parcial.  Da estado (w, h) e implementacion (area).
//     No se puede instanciar suelta: expresa "esto es solo una base".
@Abstract
struct FormaBase {
    i64 w;
    i64 h;
    // Implementacion REAL, heredable por los derivados.
    public i64 area() { return this.w * this.h; }
}

// --- Rect: hereda de FormaBase (recibe campos + area) Y satisface Dibujable
//     (el compilador comprueba que expone `i64 area()`; ya lo hace, heredado).
struct Rect : FormaBase, Dibujable {
    // Sin campos ni metodos propios: todo viene de la base @Abstract.
}

// --- Cuadrado: solo satisface la interfaz Dibujable, SIN heredar de nadie.
//     Aqui NO hay codigo reutilizado; el contrato obliga a escribir `area`.
struct Cuadrado : Dibujable {
    i64 lado;
    public i64 area() { return this.lado * this.lado; }
}

i32 main() {
    // Rect usa la implementacion HEREDADA del @Abstract.
    Rect r;
    r.w = 6;
    r.h = 7;
    i64 a1 = r.area();          // 42, codigo heredado de FormaBase

    // Cuadrado escribe su propia `area` para cumplir el contrato Dibujable.
    Cuadrado c;
    c.lado = 5;
    i64 a2 = c.area();          // 25, codigo propio exigido por la interfaz

    // FormaBase f;             // <- ERROR si se descomenta: es @Abstract.

    return (i32) (a1 + a2);     // 42 + 25 = 67
}
