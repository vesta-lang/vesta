namespace ejemplos.ufcs_cadena;

// ENCADENAR con UFCS: `2.add(4).mul(10).div(5)`.
//
// Ninguna de esas cuatro es un metodo de nada -- son funciones libres que toman
// un numero de primer parametro --, y aun asi se escriben en el orden en que
// ocurren.  Es exactamente la misma llamada que:
//
//     div(mul(add(2, 4), 10), 5)
//
// que es la MISMA operacion escrita del reves: para leerla hay que empezar por
// dentro y hacia atras.  Esa es toda la diferencia, y es la razon de que UFCS
// exista: no anyade poder, anyade el orden de lectura.
//
// Lo que se prueba aqui:
//
//   1. Cadena sobre LITERALES sin un solo cast.  El receptor de cada eslabon es
//      lo que devolvio el anterior, y el primero es un literal pelado.
//   2. Lo mismo con CADENAS, donde cada eslabon devuelve una nueva.
//   3. Un literal de cadena como receptor.  Un literal es un `ptr` a datos
//      estaticos y solo se PROMUEVE a `string` donde hace falta -- por eso
//      `grita("hola")` compila --, asi que `"hola".grita()` tiene que
//      encontrar lo mismo.
//   4. Cruzar de familia a mitad de cadena: de cadena a numero y seguir.
//   5. Y que el receptor no tiene por que ir PRIMERO: `_` dice donde cae.  Es
//      lo que permite llamar por el punto a una firma cuyo primer parametro no
//      es el sujeto -- `memcpy(dst, src, n)` -- sin retorcer la firma, que era
//      el precio que se daba por inevitable para poder escribir asi.
//   6. Y que eso vale igual sobre un MIEMBRO, no solo sobre una funcion libre:
//      un miembro tiene ranura para el receptor en su forma libre, asi que un
//      hueco ahi significa lo mismo y el `this` se da como argumento.
//
// Resultado esperado: 42.

// --- 1. los eslabones numericos --------------------------------------------
i64 add(i64 a, i64 b) => a + b;
i64 mul(i64 a, i64 b) => a * b;
i64 div(i64 a, i64 b) => a / b;

// --- 2 y 3. los de cadena ---------------------------------------------------
string grita(string s) => s.concat("!");
string rodea(string s, string w) => w.concat(s).concat(w);

// Encadenada tambien por dentro.  Sin bucle a proposito: este ejemplo es de
// encadenar, y una cadena reasignada dentro de un bucle se acorrala en
// `560_nativo_cadena_y_ranuras.vx`, que es su sitio.
string repite3(string s) => s.concat(s).concat(s);

// El puente entre las dos familias: recibe cadena y devuelve numero.
i64 largo(string s) => (i64)s.length();

// --- 5. el receptor no tiene por que ir PRIMERO -----------------------------
//
// `_` dice DONDE cae.  Sin el, cae delante, que es lo de siempre.  Con el, en
// el hueco: `10.restar(40, _)` es `restar(40, 10)`.
//
// Esto es lo que permite llamar por el punto a una firma cuyo primer parametro
// NO es el sujeto -- `memcpy(dst, src, n)`, `rodea(lo_que_rodea, el_texto)` --
// sin retorcer la firma para acomodar la forma de llamar.
//
// Y es una REORDENACION y ahi acaba: a partir de ese punto todo es posicional
// como siempre, asi que la eleccion de sobrecarga es exactamente la misma.
i64 restar(i64 a, i64 b) => a - b;

// El texto va SEGUNDO a proposito: aqui el sujeto es lo de dentro, no el marco.
string enmarca(string marco, string texto) => marco.concat(texto).concat(marco);

// Un tipo con MIEMBROS, para el hueco sobre lo que no es una funcion libre.
struct Caja {
	i64 v;
	i64 mezcla(i64 a, i64 b) => this.v + a * 10 + b * 100;
	i64 con(Caja otra, i64 k) => this.v + otra.v * 10 + k;
}

i32 main() {
	// 1. cuatro eslabones, ningun cast, ningun metodo declarado en ninguna
	// parte.  Y el primer receptor es el literal `2` tal cual.
	i64 n = 2.add(4).mul(10).div(5); // ((2+4)*10)/5 = 12

	// ...que es esto mismo escrito del reves
	i64 igual = div(mul(add(2, 4), 10), 5); // 12

	// 2 y 3. cadena de cadenas, empezando por un LITERAL
	string s = "vesta".grita().rodea("*"); // "*vesta!*"
	i64    l = s.largo();                  // 8

	i64 r = "ab".repite3().largo(); // "ababab" -> 6

	// 4. cruzar de familia a mitad de cadena y seguir por la otra
	i64 x = "hola".largo().mul(4); // 4 * 4 = 16

	// 5. el receptor donde se diga.  Sin `_` cae delante, con `_` en el hueco,
	// y las dos son la misma llamada escrita de otra forma.
	i64 h1 = 10.restar(40, _); // restar(40, 10) = 30
	i64 h2 = 40.restar(10);    // restar(40, 10) = 30

	// Y lo que esto desbloquea: `enmarca` pone el texto de SEGUNDO -- su sujeto
	// es lo de dentro, no el marco --, y aun asi se encadena sin tocar la firma.
	string m = "eh".grita().enmarca("<<", _); // "<<" + "eh!" + "<<"
	i64    q = m.largo();                     // "<<eh!<<" -> 7

	/* 6. Y el hueco vale igual cuando lo que se llama es un MIEMBRO.
	 *
	 * Un miembro es alcanzable en forma libre -- `mezcla(c, 2, 3)` encuentra
	 * el metodo de `c`, que es la otra direccion --, asi que tiene una ranura
	 * para el receptor: la cero.  Por tanto un hueco ahi significa lo de
	 * siempre, y el `this` se da como argumento.
	 *
	 * No iba: el punto consulta el indice de UFCS, que guarda funciones
	 * LIBRES, y un miembro no esta ahi; asi que `2.mezcla(c, _, 3)` buscaba un
	 * metodo de `i64` o una libre que tomara un `i64`, y ninguna de las dos es
	 * la pregunta.  Ahora, sin candidata y con hueco, se reescribe y decide el
	 * camino de siempre. */
	Caja c = {1};
	Caja d = {5};
	if (mezcla(c, 2, 3) != 321) { return 1; }   // la otra direccion, ya iba
	if (c.mezcla(2, 3) != 321) { return 2; }    // y la de siempre
	if (2.mezcla(c, _, 3) != 321) { return 3; } // el hueco: el 2 va a `a`
	if (d.con(c, _, 3) != 54) { return 4; }     // this=c (1), otra=d (5), k=3

	i64 tot = n + l + r + x + (h1 - h2) + q - 7; // 42 + 0 + 7 - 7 = 42
	println("num=${n} igual=${igual} cadena=${s} largo=${l}");
	println("repite=${r} cruce=${x} total=${tot}");
	return (i32)tot; // 42
}
