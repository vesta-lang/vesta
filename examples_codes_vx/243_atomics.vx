namespace ejemplos.atomics;

// 243_atomics.vx
//
// Libreria de atomicos (atomic): 4 hilos reales incrementan un contador
// compartido 50000 veces cada uno con atomic_add64 (fetch-and-add atomico,
// SIN lock).  4*50000 = 200000 EXACTO -> prueba que la RMW es atomica (sin
// atomicos, la carrera perderia incrementos).  Tambien ejercita vx_spin_lock.
//
//   vm -m aot --vx 243_atomics.vx --format pe -o p.exe && ./p.exe   (exit 42)

import std.types only uintptr;
import "vx_thread" only vx_thread_spawn, vx_thread_join;
import std.atomic only atomic_add64, atomic_load64, vx_spin_lock, vx_spin_unlock;

i64 g_counter = 0_i64; // contador atomico
i64 g_locked  = 0_i64; // contador protegido por spinlock
i64 g_lock    = 0_i64; // palabra del spinlock

void worker(u64 id) {
	i64 i = 0_i64;
	while (i < 50_000) {
		atomic_add64(&g_counter, 1); // RMW atomica
		vx_spin_lock(&g_lock);
		g_locked = g_locked + 1; // seccion critica
		vx_spin_unlock(&g_lock);
		i = i + 1;
	}
}

i32 main() {
	uintptr[4] h;
	i64        k = 0_i64;
	while (k < 4) {
		h[k] = vx_thread_spawn((uintptr)(cfn(u64) -> void) worker, (uintptr)k);
		k    = k + 1;
	}
	k = 0;
	while (k < 4) {
		vx_thread_join(h[k]);
		k = k + 1;
	}

	// Ambos deben ser 4*50000 = 200000 exactos.
	i64 a = atomic_load64(&g_counter);
	if (a != 200_000) { return (i32)(a % 1000); }
	if (g_locked != 200_000) { return (i32)(g_locked % 1000 + 500); }
	return 42;
}
