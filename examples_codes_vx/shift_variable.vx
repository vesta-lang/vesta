// Desplazamientos por cantidad VARIABLE (en registro, no inmediata): SHL/SHR
// logico y SAR aritmetico.  El selector los compila nativos (la cuenta va a CL)
// en JIT y AOT -- sin caer al interprete.
//
//     vm --vx shift_variable.vx -o s && vm --run s.velb
// @expect 42
u64 shl(u64 x, u64 n) { return x << n; }
u64 shr(u64 x, u64 n) { return x >> n; }
i64 sar(i64 x, i64 n) { return x >> n; } // aritmetico (con signo)

u64 main() {
	u64                         ok = 1_u64;
	if (shl(1, 10) != 1024)     ok = 0;
	if (shr(1024, 3) != 128)    ok = 0;
	if (sar(-64, 2) != -16)     ok = 0; // preserva el signo
	if (shl(0xFF, 0) != 0xFF)   ok = 0; // cuenta 0
	if (shr(0xFF00, 8) != 0xFF) ok = 0;
	return (ok == 1) ? 42 : 0;
}
