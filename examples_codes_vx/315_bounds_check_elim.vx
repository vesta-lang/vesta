namespace ejemplos.bounds_check_elim;

// examples_codes_vx/315_bounds_check_elim.vx
//
// Demuestra la eliminacion de bounds-checks de longitud VARIABLE por RANGO
// RELACIONAL SIMBOLICO (guardas dominantes / predicate propagation).
//
// Vesta usa arrays RAW (sin bounds-check automatico), pero el usuario puede
// escribir los suyos.  En sum_checked el bucle `while (i < len)` establece la
// relacion `i < len` en el cuerpo; el `if (i >= len) panic(...)` interno es un
// bounds-check REDUNDANTE: el optimizer prueba que `i >= len` contradice la
// guarda dominante y lo pliega a `false`, eliminando la rama del panic por
// completo -- sin coste en runtime, aunque `len` NO sea constante.
//
// El mismo mecanismo pliega el check `if (idx >= len)` de get_checked cuando el
// llamador ya garantizo `idx < len` en una guarda dominante.
//
// Compilar y ejecutar:
//   vm --vx examples_codes_vx/315_bounds_check_elim.vx -o bce
//   vm --run bce.velb --stats
//
// Verificar que el panic se elimino (0 CMP_GE / 0 panic en el cuerpo):
//   vm --vx examples_codes_vx/315_bounds_check_elim.vx --vx-emit-only -o bce
//
// Resultado esperado: R00 == 55  (1+2+3+...+10)

i64 sum_checked(i64[] xs, i64 len) {
	i64 s = 0;
	i64 i = 0;
	while (i < len) {
		// Bounds-check escrito a mano.  La guarda del bucle (`i < len`) domina
		// este punto -> `i >= len` es provablemente false -> la rama del panic
		// se elimina en compile-time, con `len` variable.
		if (i >= len) {
			panic("indice fuera de rango en sum_checked");
		}
		s = s + xs[i];
		i = i + 1;
	}
	return s;
}

i64 main() {
	i64[10] arr;
	i64 i = 0;
	while (i < 10) {
		arr[i] = i + 1;
		i = i + 1;
	}
	return sum_checked(arr, 10);
}
