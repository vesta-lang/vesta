// =============================================================================
// modules/keys.vx - constantes de teclas para la TUI
// =============================================================================

// Codigos ASCII de control y especiales.
public const i32 KEY_NONE          = 0_i32;
public const i32 KEY_CTRL_A        = 1_i32;
public const i32 KEY_CTRL_B        = 2_i32;
public const i32 KEY_CTRL_C        = 3_i32;
public const i32 KEY_CTRL_D        = 4_i32;
public const i32 KEY_CTRL_E        = 5_i32;
public const i32 KEY_CTRL_F        = 6_i32;
public const i32 KEY_CTRL_G        = 7_i32;
public const i32 KEY_BACKSPACE     = 8_i32;
public const i32 KEY_TAB           = 9_i32;
public const i32 KEY_LF            = 10_i32;
public const i32 KEY_CTRL_K        = 11_i32;
public const i32 KEY_CTRL_L        = 12_i32;
public const i32 KEY_ENTER         = 13_i32;
public const i32 KEY_CTRL_N        = 14_i32;
public const i32 KEY_CTRL_O        = 15_i32;
public const i32 KEY_CTRL_P        = 16_i32;
public const i32 KEY_CTRL_Q        = 17_i32;
public const i32 KEY_CTRL_R        = 18_i32;
public const i32 KEY_CTRL_S        = 19_i32;
public const i32 KEY_CTRL_T        = 20_i32;
public const i32 KEY_CTRL_U        = 21_i32;
public const i32 KEY_CTRL_V        = 22_i32;
public const i32 KEY_CTRL_W        = 23_i32;
public const i32 KEY_CTRL_X        = 24_i32;
public const i32 KEY_CTRL_Y        = 25_i32;
public const i32 KEY_CTRL_Z        = 26_i32;
public const i32 KEY_ESC           = 27_i32;
public const i32 KEY_BACKSPACE_WIN = 127_i32;

// Teclas virtuales (rango 1000+; valores arbitrarios fuera del rango ASCII).
public const i32 VK_UP    = 1001_i32;
public const i32 VK_DOWN  = 1002_i32;
public const i32 VK_LEFT  = 1003_i32;
public const i32 VK_RIGHT = 1004_i32;
public const i32 VK_HOME  = 1005_i32;
public const i32 VK_END   = 1006_i32;
public const i32 VK_PGUP  = 1007_i32;
public const i32 VK_PGDN  = 1008_i32;
public const i32 VK_DEL   = 1009_i32;
public const i32 VK_INS   = 1010_i32;
public const i32 VK_F1    = 1101_i32;
public const i32 VK_F2    = 1102_i32;
public const i32 VK_F3    = 1103_i32;
public const i32 VK_F4    = 1104_i32;
public const i32 VK_F5    = 1105_i32;
public const i32 VK_F6    = 1106_i32;
public const i32 VK_F10   = 1110_i32;

// Variantes con modificadores (rango 2000+).
// Shift: 2000  Ctrl: 3000  Ctrl+Shift: 4000
public const i32 VK_SHIFT_UP    = 2001_i32;
public const i32 VK_SHIFT_DOWN  = 2002_i32;
public const i32 VK_SHIFT_LEFT  = 2003_i32;
public const i32 VK_SHIFT_RIGHT = 2004_i32;
public const i32 VK_SHIFT_HOME  = 2005_i32;
public const i32 VK_SHIFT_END   = 2006_i32;

public const i32 VK_CTRL_UP    = 3001_i32;
public const i32 VK_CTRL_DOWN  = 3002_i32;
public const i32 VK_CTRL_LEFT  = 3003_i32;
public const i32 VK_CTRL_RIGHT = 3004_i32;
public const i32 VK_CTRL_HOME  = 3005_i32;
public const i32 VK_CTRL_END   = 3006_i32;
public const i32 VK_CTRL_PGUP  = 3007_i32;
public const i32 VK_CTRL_PGDN  = 3008_i32;
// Borrar palabras: Ctrl+Backspace (izquierda), Ctrl+Delete (derecha).
public const i32 VK_CTRL_BACKSPACE = 3009_i32;
public const i32 VK_CTRL_DEL       = 3010_i32;
// Mover linea entera (Alt+Up / Alt+Down): patrones de IDE.
public const i32 VK_ALT_UP   = 5001_i32;
public const i32 VK_ALT_DOWN = 5002_i32;

// =============================================================================
// Validacion compile-time: las constantes no pueden colisionar entre si.
// =============================================================================
static_assert(KEY_ESC != KEY_CTRL_Q, "KEY_ESC colisiona con CTRL_Q");
static_assert(KEY_BACKSPACE != KEY_TAB, "KEY_BACKSPACE colisiona con TAB");
static_assert(VK_UP > 127, "VK_UP debe estar fuera del rango ASCII");
static_assert(VK_F1 > VK_END, "F-keys deben ir despues de las de movimiento");
static_assert(
	VK_SHIFT_UP != VK_CTRL_UP,
	"Shift y Ctrl arrows no deben colisionar"
);
static_assert(
	VK_CTRL_LEFT != KEY_CTRL_L,
	"VK_CTRL_LEFT (3003) no debe pisar KEY_CTRL_L"
);
