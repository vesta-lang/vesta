namespace ejemplos.ufcs_choque;

// NEGATIVO: el tipo declara el metodo y ademas hay una funcion libre que toma
// ese mismo receptor.  Dos candidatos para la misma llamada, y elegir en
// silencio seria decidir por el programador.
//
// No es una precaucion teorica: cual ganase dependeria de los `import` de QUIEN
// LLAMA, asi que anyadir un import en un fichero cambiaria a que cuerpo va una
// llamada que ya estaba escrita y que nadie toco.  Por eso es un error y se
// citan los dos.
//
// Y el segundo caso, que NO es un choque sino una frontera: un tipo FUERTE
// tiene identidad propia, asi que un literal -- que es `i64` -- no encuentra lo
// declarado para el.  Eso esta bien; lo que no valdria es negarlo a secas
// teniendo la candidata ahi al lado, asi que el error dice cual es y con que
// cast se llega, y ademas con el nombre que se ESCRIBE y no el que el aplanado
// le puso.
//
// Se espera que NO compile: VX2068 lo primero, VX2071 lo segundo.

struct Punto {
	i64 x;
	i64 y;

	i64 area() { return this.x * this.y; }
}

// El mismo nombre, para el mismo receptor: aqui esta el choque.
i64 area(Punto p) { return p.x; }

// Y un tipo FUERTE, con su funcion.  `41.anyos()` no la encuentra -- un literal
// es `i64` --, y el error lo dice con el cast que hace falta.
typedef u32 Edad new;

u64 anyos(Edad e) { return (u64)e + 1_u64; }

i32 main() {
	Punto q;
	q.x = 6;
	q.y = 7;
	println("fuerte=${41.anyos()}");
	return (i32)q.area();
}
