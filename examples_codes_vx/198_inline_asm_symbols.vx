namespace ejemplos.inline_asm_symbols;
// 198_inline_asm_symbols.vx
//
// Inline-asm que referencia SIMBOLOS PROPIOS (funciones y globales del modulo).
// El usuario elige la FORMA de la instruccion (no esta hardcodeada): salto/llamada
// directa (rel32), indirecta via registro, carga de direccion absoluta (imm64),
// o carga indirecta desde un global.  El backend de ensamblado enruta cada forma:
//   - `call sym` / `jmp sym`     -> rel32 (BranchRel32) resuelto por el linker AOT.
//   - `lea rax, [rel sym]`       -> rip-relativo (DataRel32), forma PIC.
//   - `mov rax, sym`             -> imm64 absoluto (ABS64): Keystone no hace fixups
//                                   de 64 bits, asi que el backend lo ensambla via
//                                   un literal placeholder y parchea el simbolo.
//   - `mov rax, [global]`        -> carga el valor de 8 bytes del global (rip-rel).
//
// Compilar nativo:  vm -m aot --vx 198_inline_asm_symbols.vx --format pe -o p.exe
// Resultado: 42.

i64 add(i64 a, i64 b) { return a + b; }

i64 g_fp = 0_i64;

// (1) call DIRECTO a una funcion del modulo (rel32).
@Naked
i64 via_call(i64 a, i64 b) {
	asm volatile {
		call add
		ret
	}
}

// (2) mov rax, add (direccion absoluta, imm64) + call indirecto.
@Naked
i64 via_mov(i64 a, i64 b) {
	asm volatile {
		mov rax, add
		call rax
		ret
	}
}

// (3) lea rax, [rel add] (direccion rip-relativa, forma PIC) + call indirecto.
@Naked
i64 via_lea(i64 a, i64 b) {
	asm volatile {
		lea rax, [rel add]
		call rax
		ret
	}
}

// (4) mov rax, [g_fp] (carga el puntero a funcion guardado en un global) + call.
@Naked
i64 via_gfp(i64 a, i64 b) {
	asm volatile {
		mov rax, [g_fp]
		call rax
		ret
	}
}

i32 main() {
	i64 r1 = via_call(3, 4);                //  7
	i64 r2 = via_mov(5, 6);                 // 11
	i64 r3 = via_lea(1, 7);                 //  8
	g_fp = (i64)(cfn(i64, i64) -> i64) add; // guarda la direccion de add
	// (cfn = puntero a funcion crudo de 8 bytes; un lambda fn(...) son 16 bytes
	//  y NO se puede castear a i64 -- usa cfn o &funcion para la direccion)
	i64 r4 = via_gfp(8, 8);          // 16
	return (i32)(r1 + r2 + r3 + r4); // 7+11+8+16 = 42
}
