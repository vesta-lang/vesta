namespace ejemplos.borrow_err_write_shared;

// Un prestamo compartido solo lee: escribir por indice a traves de el es un
// error (VX2153).  Para escribir se toma con `lend_mut`.
i32 main() {
	i64[4]         arena = {1, 2, 3, 4};
	borrow<i64[4]> b     = lend(arena);
	b[1]                 = 3;
	return (i32)b[0];
}
