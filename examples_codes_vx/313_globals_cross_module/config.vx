namespace config;

// Modulo con las tres clases de global que otro modulo puede usar.  Ver
// main.vx para el consumidor.

/// Const con valor entero de compile time: el consumidor lo INLINEA (no hay
/// storage; sale un inmediato en el codigo).
public const i64    LIMITE   = 30;

/// Const string: tampoco tiene storage.  Cada uso -- aqui o en otro modulo --
/// materializa el StringObject a partir del literal, que viaja en el .vxi.
public const string ETIQUETA = "cfg";

/// Global MUTABLE: este SI tiene storage, y es UNO solo en todo el programa.
/// Lo inicializa el `__module_init` de este modulo antes de que corra `main`,
/// y quien lo escriba (aqui o el consumidor) lo escribe para todos.
public       i64    usos     = 2;

/// Suma un uso y devuelve el total.  Escribe el mismo storage que ve el
/// consumidor cuando lee `config.usos`.
public i64 registrar_uso() {
	usos = usos + 1;
	return usos;
}
