// =============================================================================
// 183_memcpy_idiom.vx
//
// Auto-vectorizacion: idioma de COPIA de elementos `dst[i] = src[i]`.
//
// El compilador reconoce el patron de copia sobre punteros HOST (malloc/FFI),
// tanto en su forma `while` como `for`, y lo reemplaza por un unico MEMCPY:
//   - en el JIT/AOT baja a `rep movsb` (host->host, ERMSB) / SIMD;
//   - en el interprete a un bucle host->host correcto.
// Funciona para cualquier tamano de elemento (u8/u16/u32/u64) y respeta el
// indice inicial, el limite variable y el caso de 0 iteraciones.
//
// El resultado es IDENTICO con o sin la optimizacion (solo cambia la
// velocidad).  Sirve de documentacion del patron soportado y de validacion
// (interp == jit).  Resultado esperado: ver el calculo al final de main.
//
// IMPORTANTE: solo aplica a punteros HOST.  Los arrays VM-virtuales (T[N],
// &local) NO se transforman (rep movsb opera sobre direcciones host); siguen
// como bucle escalar normal, igual de correcto.
// =============================================================================

i64 sum_u8(u8* p, i32 n) {
    i64 acc = 0;
    for (i32 i = 0; i < n; i++) { acc = acc + (i64) p[i]; }
    return acc;
}

i64 sum_u64(u64* p, i32 n) {
    i64 acc = 0;
    for (i32 i = 0; i < n; i++) { acc = acc + (i64) p[i]; }
    return acc;
}

i32 main() {
    i64 total = 0;

    // --- u8: copia con WHILE ---
    u8* s8 = malloc(16);
    u8* d8 = malloc(16);
    i32 i = 0;
    while (i < 16) { s8[i] = (u8)(i + 1); i = i + 1; }   // poblar (no es copia)
    i = 0;
    while (i < 16) { d8[i] = s8[i]; i = i + 1; }          // IDIOMA copia (while)
    total = total + sum_u8(d8, 16);                       // 1+2+...+16 = 136

    // --- u32: copia con FOR, indice inicial != 0 ---
    u32* s32 = malloc(40);   // 10 x u32
    u32* d32 = malloc(40);
    for (i32 k = 0; k < 10; k++) { s32[k] = (u32)(k * 10); }   // poblar
    for (i32 k = 0; k < 10; k++) { d32[k] = 0; }               // limpiar dst
    for (i32 k = 3; k < 10; k++) { d32[k] = s32[k]; }          // IDIOMA copia (for, k=3..9)
    i64 s32sum = 0;
    for (i32 k = 0; k < 10; k++) { s32sum = s32sum + (i64) d32[k]; }
    total = total + s32sum;   // d32[3..9] = 30,40,50,60,70,80,90 -> 420; d32[0..2]=0

    // --- u64: copia con FOR ---
    u64* s64 = malloc(64);   // 8 x u64
    u64* d64 = malloc(64);
    for (i32 j = 0; j < 8; j++) { s64[j] = (u64)(j + 1) * 1000; }
    for (i32 j = 0; j < 8; j++) { d64[j] = s64[j]; }            // IDIOMA copia (for, u64)
    total = total + (sum_u64(d64, 8) / 1000);                  // 1+2+...+8 = 36

    // --- 0 iteraciones: el limite es <= el indice inicial ---
    u8* p0 = malloc(4);
    u8* q0 = malloc(4);
    i32 m = 5;
    while (m < 4) { q0[m] = p0[m]; m = m + 1; }   // 0 copias; m queda 5
    total = total + (i64) m;                       // +5

    free(s8); free(d8); free(s32); free(d32);
    free(s64); free(d64); free(p0); free(q0);

    // total = 136 + 420 + 36 + 5 = 597
    return (i32) total;
}
