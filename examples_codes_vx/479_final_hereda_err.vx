namespace ejemplos.final_hereda_err;

// NEGATIVO: heredar de una clase final tiene que ser un error de compilacion.
//
// No es una formalidad.  El compilador se fia de que una clase final no tenga
// derivadas para despachar sus metodos con llamada directa en vez de por tabla;
// si esto se colara, el metodo de la derivada no se ejecutaria nunca y sin un
// solo aviso.

final class Cerrada {
    public i32 v;
    public Cerrada(i32 x) { this.v = x; }
    public i32 quien() { return 1; }
}

class Hija : Cerrada {
    public Hija(i32 x) { super(x); }
    @Override
    public i32 quien() { return 2; }
}

i32 main() {
    Hija h = new Hija(1);
    return h.quien();
}
