namespace ejemplos.escribe_fichero;

// examples_codes_vx/04_escribe_fichero.vx
//
// Escribe un fichero "salida_vx.txt" con un contenido predefinido
//
// Demuestra:
//   - Builtins de I/O de fichero: fopen, fwrite, fclose.
//   - Cadena nativa via FFI a vesta_io.dll.
//   - Manejo del FILE* devuelto por fopen como i64.
//   - Mensaje de progreso por println antes y despues de la operacion.
//
// Compilar y ejecutar:
//   vm --vx examples_codes_vx/04_escribe_fichero.vx -o escribir
//   vm --run escribir.velb
//
// Salida esperada (stdout):
//   == Escritura de fichero Vex ==
//   bytes escritos:
//   == Hecho ==
//
// Efecto secundario: crea el fichero "salida_vx.txt" con el contenido
//   "Hola desde Vex! Este fichero fue escrito por la VM."

i32 main() {
    println("== Escritura de fichero Vex ==");

    i64 fp = fopen("salida_vx.txt", "w");
    if (fp == 0) {
        println("ERROR: no se pudo abrir el fichero");
        return 1;
    }

    i64 bytes_written = fwrite(fp, "Hola desde Vex! Este fichero fue escrito por la VM.\n");
    println("bytes escritos:");
    print_int(bytes_written);

    fclose(fp);
    println("== Hecho ==");
    return 0;
}
