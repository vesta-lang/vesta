// =============================================================================
// 191_vectorize_compound.vx
//
// Auto-vectorizacion de COMPOUND ASSIGN element-wise: `c[i] OP= a[i]`, que es
// `c[i] = c[i] OP a[i]`.  Reusa el mismo VEC_BINOP que `c[i] = a[i] OP b[i]`
// (con la base de destino actuando tambien como primer operando), sin codegen
// nuevo.  Soporta +=, -=, *=, /= (float) y +=, -= (enteros).
//
// Solo punteros HOST.  Mismo SIMD packed (SSE2/AVX2/AVX512) y register-resident
// que el resto del vectorizador.
// =============================================================================

i64 main() {
    // f64 +=
    f64* a = malloc(80);
    f64* c = malloc(80);
    for (i32 i = 0; i < 10; i++) { a[i] = (f64)(i + 1); c[i] = 100.0; }
    for (i32 i = 0; i < 10; i++) { c[i] += a[i]; }   // c[i] = 100 + (i+1)
    f64 s = 0.0;
    for (i32 i = 0; i < 10; i++) { s = s + c[i]; }   // 10*100 + 55 = 1055

    // i64 -=
    i64* x = malloc(80);
    i64* y = malloc(80);
    for (i32 i = 0; i < 10; i++) { x[i] = (i64)(i + 1); y[i] = 5; }
    for (i32 i = 0; i < 10; i++) { y[i] -= x[i]; }   // y[i] = 5 - (i+1)
    i64 sy = 0;
    for (i32 i = 0; i < 10; i++) { sy = sy + y[i]; } // 50 - 55 = -5

    free(a); free(c); free(x); free(y);

    // 1055 + (-5) = 1050
    return (i64) s + sy;
}
