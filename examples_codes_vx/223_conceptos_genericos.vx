namespace ejemplos.conceptos_genericos;

// Conceptos / constraints de genericos: `<T: Concepto>` y `where` (#6).
//
// Un CONCEPTO es un predicado COMPTIME sobre un tipo (devuelve bool).  Se
// usa como CONSTRAINT (bound) de un type-param generico: al instanciar el
// generico con un tipo concreto, el compilador evalua el concepto; si no se
// satisface, error claro.  Las constraints son 100% compile-time: DESAPARECEN
// tras el type-check (cero codigo emitido, cero coste runtime).  El backend
// (interp / JIT / AOT) ve genericos concretos normales.
//
// Cubre:
//   1. Conceptos BUILT-IN (Numeric, Comparable, Sized, ...).
//   2. Concepto de usuario PREDICADO `concept N<T> = <bool-expr>;`.
//   3. Concepto de usuario BLOQUE `concept N<T> { <stmts comptime>; }`.
//   4. Concepto de usuario ESTRUCTURAL `concept N { metodo-sigs }`.
//   5. COMPOSICION de conceptos (`Comparable<T>() && Sized<T>()`).
//   6. Bound INLINE `<T: C>` y clausula `where T: A + B`.
//   7. Bounds en funcion libre, struct, clase y metodo generico.

// ---- 2: concepto PREDICADO (sobre la introspeccion comptime) -------------
concept MiNumero<T> = type.is_numeric<T>();

// ---- 5: COMPOSICION de conceptos (built-in + usuario) --------------------
concept Ordenable<T> = Comparable<T>() && Sized<T>();

// ---- 3: concepto BLOQUE (logica comptime arbitraria) ---------------------
concept CabeEnReg<T> {
	if (type.is_primitive<T>()) { return type.size<T>() <= 8; }
	return false;
}

// ---- 4: concepto ESTRUCTURAL (exige metodos por nombre) ------------------
concept Dibujable { i64 area(); }

// ---- 1 + 6: bound inline con concepto built-in en funcion libre ----------
T maximo<T: Comparable>(T a, T b) {
	if (a > b) { return a; }
	return b;
}

// ---- 6: clausula `where` con concepto de usuario -------------------------
T sumar<T>(T a, T b) where T: MiNumero => a + b;

// ---- composicion + where ------------------------------------------------
T elegir<T>(T a, T b) where T: Ordenable {
	if (a > b) { return a; }
	return b;
}

// ---- 7: bound inline en STRUCT generico ----------------------------------
struct Caja<T: CabeEnReg> {
	T v;
	T leer() => this.v;
}

// ---- 7: bound estructural en funcion + clase con area() ------------------
class Cuadrado {
	i64 lado;
	Cuadrado(i64 l) { this.lado = l; }
	i64 area() => this.lado * this.lado;
}

i64 pintar<T: Dibujable>(T fig) => fig.area();

// ---- 7: bound en METODO generico -----------------------------------------
struct Acumulador {
	i64 base;
	U combinar<U: Numeric>(U x) => (U) this.base + x;
}

// ---- 1: Pod -- sus bytes SON su valor (sin destructor ni nada gestionado) --
// `Copyable` deja pasar un struct con destructor o con un `string` dentro;
// `Pod` no.  Es la misma regla que la huella `@pod` del tipo.
struct Plano {
	i64 x;
	i32 y;
}
struct ConDtor {
	i64 x;
	~ConDtor() { }
}
struct ConCadena {
	string s;
}
i64 bytes_de<T: Pod>() => type.size<T>();

// Un concepto con ARGUMENTOS: el primer parametro es el tipo que lo cumple y
// los demas se dan en la cota.  `<C: Da<i64>>` es `Da<C, i64>`: "C tiene un
// `dame()` que devuelve un i64".  Vale en la cabeza y en `where`.
concept Da<Self, E> {
	E dame();
}
struct Ficha {
	i64 v;

	i64 dame() => this.v;
}
i64 saca<C: Da<i64>>(C c) => c.dame();
i64 saca_w<C>(C c) where C: Da<i64> => c.dame();

// DECLARAR que se cumple, con argumentos: en la cabecera de un struct o de una
// clase, o con `impl`.  Se comprueba al compilar (coste cero).  En un generico,
// cada instancia se comprueba con los argumentos ya sustituidos:
// `Bolsa<i64> : Da<i64>`.
struct Bolsa<T> : Da<T> {
	T v;

	T dame() => this.v;
}
interface IHabla {
	i64 habla();
}
class Voz : IHabla, Da<i64> { // una interfaz (dinamica) y un concepto
	i64 v;

	Voz(i64 v) { this.v = v; }
	i64 dame() => this.v;
	i64 habla() => this.v + 1;
}
struct Pieza {
	i64 v;
}
impl Da<i64> for Pieza {
	i64 dame() => this.v;
}

// Un concepto con CAMPOS y METODOS POR DEFECTO.  Se escribe como el cuerpo de
// un struct: un metodo sin cuerpo (`;`) es el que se EXIGE; uno con cuerpo es
// el que RECIBE quien declara cumplirlo y no lo escribe; un campo lo recibe
// tambien.  Lo que el tipo escribe gana.
concept Contable<Self> {
	i64 total;

	i64 cuantos();
	bool vacio() => this.cuantos() == 0;
	i64 doble() => this.cuantos() * 2;
	Self mismo() => this; // `Self` es el tipo que lo declara
}
struct Saco : Contable { // recibe `total`, `vacio`, `mismo`...
	i64 cuantos() => this.total;
	i64 doble() => 100; // ...pero `doble` lo escribe: gana el suyo
}
class Cesta : Contable { // una clase tambien los recibe (el campo incluido)
	Cesta(i64 n) { this.total = n; }
	i64 cuantos() => this.total + 1;
}
struct Monton {
	i64 total;
}
impl Contable for Monton { // un `impl` solo recibe METODOS
	i64 cuantos() => this.total * 10;
}
// Con argumentos, en un generico: cada instancia recibe los suyos ya
// sustituidos (`Lote<i64> : Medida<i64>` recibe un `i64 tope()`).
concept Medida<Self, E> {
	E base;

	E tope() => this.base + this.base;
}
struct Lote<T> : Medida<T> {
	i64 n;
}

// Un BLOQUE puede empezar por una variable, que se escribe igual que un campo
// con valor: lo que lo hace bloque son sus sentencias (el `return`).
concept Pequeno<T> {
	i64 tam = type.size<T>();
	return tam <= 8;
}
// Cumplirlo por FORMA, sin declararlo: basta con el campo y el exigido; los
// metodos por defecto no se exigen (ni se reciben).
struct Suelto {
	i64 total;

	i64 cuantos() => this.total;
}
i64 cuenta<C: Contable>(C c) => c.cuantos();

i64 prueba_defaults() {
	if (!Pequeno<i64>() || Pequeno<Plano>()) return 6;
	Suelto su = {.total = 9};
	if (cuenta(su) != 9) return 7;
	Saco s = {.total = 3};
	if (s.cuantos() != 3 || s.vacio() || s.doble() != 100) return 1;
	Saco otro = s.mismo();
	if (otro.total != 3) return 2;
	Cesta c = new Cesta(4);
	if (c.cuantos() != 5 || c.vacio() || c.doble() != 10) return 3;
	Monton m = {.total = 2};
	if (m.cuantos() != 20 || m.doble() != 40 || m.vacio()) return 4;
	Lote<i64> l = {.base = 7, .n = 1};
	if (l.tope() != 14) return 5;
	return 0;
}

i32 main() {
	if (bytes_de<Plano>() != 16) return 1;
	if (!Pod<Plano>() || !Pod<i64>()) return 2;
	if (Pod<ConDtor>() || Pod<ConCadena>() || Pod<string>()) return 3;
	Ficha fi = {.v = 20};
	if (saca(fi) + saca_w(fi) != 40) return 4;
	Bolsa<i64> cj = {.v = 3};
	Voz        vz = new Voz(4);
	IHabla     hb = vz;
	Pieza      pz = {.v = 5};
	if (saca(cj) + saca(vz) + hb.habla() + saca(pz) != 17) return 5;
	const i64 pd = prueba_defaults();
	if (pd != 0) return (i32)(10 + pd);

	i64 mx = maximo<i64>(10, 30); // built-in Comparable      -> 30
	i64 sm = sumar<i64>(3, 4);    // user MiNumero (where)     -> 7
	i64 el = elegir<i64>(2, 9);   // Ordenable (composicion)   -> 9

	Caja<i64> c  = {.v = 5}; // CabeEnReg (bloque)        -> v=5
	i64       lv = c.leer(); // 5

	Cuadrado sq = new Cuadrado(2);
	i64      ar = pintar<Cuadrado>(sq); // Dibujable (estructural)   -> 4

	Acumulador a  = {.base = 1};
	i64        cb = a.combinar<i64>(0); // metodo con bound Numeric  -> 1

	println("mx=${mx} sm=${sm} el=${el} lv=${lv} ar=${ar} cb=${cb}");
	// 30 + 7 + 9 - 5 - 4 - 1 - 9 + ... ajustamos a 42:
	// 30 + 7 + 9 + 5 + 4 + 1 - 14 = 42
	return (i32)(mx + sm + el + lv + ar + cb - 14); // 42
}
