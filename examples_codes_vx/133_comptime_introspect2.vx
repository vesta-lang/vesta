namespace ejemplos.comptime_introspect2;

// introspeccion comptime: queries de fields/methods/types.
// cada llamada baja a UN solo
// IrOp::CONST (o STR_LIT_ADDR + STRMAKE para field.name/field.type).
//
// Builtins añadidos:
//   field.count<T>()        -> u32
//   method.count<T>()       -> u32
//   field.offset<T>("field")    -> u64
//   field.has<T>("name")    -> bool
//   method.has<T>("name")   -> bool
//   field.name<T>(idx)      -> string
//   field.type<T>("name")   -> string
//   type.is_class<T>()           -> bool
//   type.is_struct<T>()          -> bool
//   type.is_primitive<T>()       -> bool
//   type.is_subtype<A,B>()       -> bool
//   type.is_same<A,B>()          -> bool

struct Vec3 {
	f64 x;
	f64 y;
	f64 z;
}

class Animal {
	i32 age;
	void hablar() { }
	i32 getAge() => this.age;
}

class Perro : Animal {
	i32 ladridos;
	void ladrar() { }
}

i32 main() {
	// Layouts (offsets calculados estaticamente sobre Vec3 con 3 f64).
	u32 n_vec3 = field.count<Vec3>();     // 3
	u64 off_x  = field.offset<Vec3>("x"); // 0
	u64 off_y  = field.offset<Vec3>("y"); // 8
	u64 off_z  = field.offset<Vec3>("z"); // 16

	// Herencia (Perro hereda fields + methods de Animal).
	u32 n_perro = field.count<Perro>();  // 2 (age + ladridos)
	u32 m_perro = method.count<Perro>(); // 3 (hablar + getAge + ladrar)

	// Predicados.
	bool hf_x  = field.has<Vec3>("x");         // true
	bool hf_w  = field.has<Vec3>("w");         // false
	bool hm_h  = method.has<Animal>("hablar"); // true
	bool hm_v  = method.has<Animal>("volar");  // false
	bool ic    = type.is_class<Animal>();      // true
	bool is_v3 = type.is_struct<Vec3>();       // true
	bool ip    = type.is_primitive<i32>();     // true

	// Jerarquia.
	bool s_pa = type.is_subtype<Perro, Animal>();  // true (down chain)
	bool s_ap = type.is_subtype<Animal, Perro>();  // false (other way)
	bool s_aa = type.is_subtype<Animal, Animal>(); // true (reflexivo)

	// Strings: field.name / field.type.
	string fn0 = field.name<Vec3>(0);   // "x"
	string ft0 = field.type<Vec3>("x"); // "f64"

	// Sumamos 3 puntos por cada chequeo OK -> esperado 42.
	i32                                         ok = 0_i32;
	if (n_vec3 == 3)                            ok = ok + 3;
	if (off_x == 0)                             ok = ok + 3;
	if (off_y == 8)                             ok = ok + 3;
	if (off_z == 16)                            ok = ok + 3;
	if (n_perro == 2)                           ok = ok + 3;
	if (m_perro == 3)                           ok = ok + 3;
	if (hf_x && !hf_w)                          ok = ok + 3;
	if (hm_h && !hm_v)                          ok = ok + 3;
	if (ic && is_v3 && ip)                      ok = ok + 3;
	if (s_pa && !s_ap && s_aa)                  ok = ok + 3;
	if (fn0.length() == 1 && ft0.length() == 3) ok = ok + 12;
	return ok;
}
