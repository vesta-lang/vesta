namespace ejemplos.interfaz_y_herencia;

// Heredar de una clase Y cumplir una interfaz a la vez.
//
// Son dos formas de despacho conviviendo en el mismo objeto, y cada una numera
// sus metodos por su cuenta: la clase por su cadena de herencia, la interfaz
// por el orden en que declara los suyos.  Lo que este ejemplo fija es que las
// dos numeraciones NO se pisen -- que llamar a un metodo de la clase acabe en
// el metodo de la clase, y no en uno de la interfaz que casualmente cayo en la
// misma posicion.
//
// Se comprueban las dos formas en que las numeraciones se solapan:
//
//   1. La clase NO declara constructor.  Entonces su primer metodo ocupa la
//      posicion inicial, que es la misma que reclama el primer metodo de la
//      interfaz.
//   2. La clase SI declara constructor, pero la interfaz tiene DOS metodos.
//      Entonces es el segundo el que cae sobre un metodo de la clase.
//
// Las llamadas van a proposito sobre un valor que sale de una funcion: si el
// objeto se creara y se usara en el mismo sitio, el compilador resolveria la
// llamada estaticamente y no se ejercitaria ninguna tabla.

// --- 1. Sin constructor declarado -----------------------------------------

interface Habla {
	i64 decir();
}

class Animal {
	public i64 patas() { return 1; }
}

class Perro : Animal, Habla {
	@Override
		public i64 patas() { return 4; }
	public i64 decir() { return 10; }
}

Animal fabricar_animal() { return new Perro(); }
Habla fabricar_habla() { return new Perro(); }

// --- 2. Con constructor, y una interfaz de dos metodos ---------------------

interface Ruido {
	i64 uno();
	i64 dos();
}

class Base {
	public Base() { }
	public i64 valor() { return 5; }
}

class Derivada : Base, Ruido {
	public Derivada() { }
	@Override
		public i64 valor() { return 7; }
	public i64 uno() { return 100; }
	public i64 dos() { return 200; }
}

Base fabricar_base() { return new Derivada(); }
Ruido fabricar_ruido() { return new Derivada(); }

i32 main() {
	// Por la clase: tiene que dar el metodo de la clase.
	const i64   a = fabricar_animal().patas(); // 4, no 10
	const i64   b = fabricar_base().valor();   // 7, no 200

	// Por la interfaz: tiene que seguir dando el de la interfaz.
	const i64   c = fabricar_habla().decir();  // 10
	      Ruido r = fabricar_ruido();
	const i64   d = r.uno() + r.dos(); // 300

	println("clase=${a},${b} interfaz=${c},${d}");

	// 4 + 7 + 10 + 300 = 321
	const i64 total = a + b + c + d;
	return (i32)(total - 279); // 42
}
