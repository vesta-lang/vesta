// NS.2: tipos (clase + struct + enum) declarados en un `namespace` y usados
// cross-modulo por su nombre cualificado (geo.Box, geo.Vec2, geo.Shape).
namespace geo;

public class Box {
	public i64 v;
	public Box() { this.v = 0; }
	public i64 get() { return this.v; }
	public void set(i64 x) { this.v = x; }
}

public struct Vec2 { public i64 x;
	public i64 y; }

public enum Shape {
	Circle(i64),
	Square(i64),
	Point
}

public i64 area_hint(geo.Shape s) {
	match (s) {
		case Circle(r) => { return r * 3; }
		case Square(l) => { return l * l; }
		case Point     => { return 0; }
	}
	return -1;
}
