namespace ejemplos.std_numeric;

// `std.numeric` desde FUERA, por todas sus funciones y por varias anchuras.
//
// Un modulo de la libreria compila SUELTO aunque este roto para quien lo use:
// eso ya paso con `std.memory`, que pasaba la suite entera mientras
// `import std.memory` fallaba a cualquiera que lo intentara.  Por eso este
// ejemplo lo importa como lo haria un programa cualquiera.
//
// Se instancian VARIAS anchuras a proposito.  El numero de carriles sale de
// dividir el ancho del registro entre el del elemento, asi que cada tipo toma
// un camino distinto dentro del compilador: probar solo `i64` deja sin tocar
// casi todos.  Los tipos que aparecen aqui son los que el arnes fija.
//
// El segundo import tambien esta a proposito.  Al escribir el modulo,
// `import std.numeric;` junto a `import std.types only usize;` no compilaba:
// las plantillas viajan como TEXTO y al re-parsearlas aqui el `usize` de sus
// firmas no existia, asi que el parametro se quedaba en `void`; y aunque
// resolviera, el nombre corto `add` no llegaba al registro de plantillas, de
// modo que `add<i64>(...)` no se reconocia como generica -- no se instanciaba
// nada y el fallo salia mucho despues, al enlazar, como un simbolo que nadie
// define.  Las dos lineas de abajo son las que lo cazan.
//
// Lo que este ejemplo NO puede comprobar es lo unico que da sentido al modulo:
// que los bucles se ensanchen.  Bajados de uno en uno darian estos mismos
// numeros.  Eso se mide sobre el IR, con `tools/verify_vectorize.py idioms`.

import std.numeric;
import std.types only usize;

const usize N = 64;

i32 main() {
    i64* a = (i64*) malloc((i64) N * 8);
    i64* b = (i64*) malloc((i64) N * 8);
    i64* c = (i64*) malloc((i64) N * 8);
    i32* wa = (i32*) malloc((i64) N * 4);
    i32* wb = (i32*) malloc((i64) N * 4);
    i32* wc = (i32*) malloc((i64) N * 4);
    i16* ha = (i16*) malloc((i64) N * 2);
    i16* hb = (i16*) malloc((i64) N * 2);
    i16* hc = (i16*) malloc((i64) N * 2);
    f32* ga = (f32*) malloc((i64) N * 4);
    f32* gb = (f32*) malloc((i64) N * 4);
    f32* gout = (f32*) malloc((i64) N * 4);
    f64* da = (f64*) malloc((i64) N * 8);
    f64* db = (f64*) malloc((i64) N * 8);
    f64* dc = (f64*) malloc((i64) N * 8);

    for (usize i = 0; i < N; i++) {
        a[i] = (i64) i;
        b[i] = 2;
        wa[i] = (i32) i;
        wb[i] = 2;
        ha[i] = (i16) i;
        hb[i] = 2;
        ga[i] = 1.5;
        gb[i] = 0.5;
        da[i] = 1.5;
        db[i] = 0.5;
    }

    // Dos entradas y una salida, y deshecho: c[i] = i + 2, luego c[i] = i.
    add<i64>(c, a, b, N);
    sub<i64>(c, c, b, N);
    // Un valor suelto repartido a todos los carriles:  c[i] = i + 10.
    add_scalar<i64>(c, c, 10, N);
    // El destino es tambien operando: sube 2 y vuelve a bajar.
    add_into<i64>(c, b, N);
    sub_into<i64>(c, b, N);

    // La misma suma en otra anchura, y el producto, que en enteros solo existe
    // empaquetado para 16 y 32 bits.
    add<i32>(wc, wa, wb, N);          // wc[i] = i + 2
    mul<i32>(wc, wc, wb, N);          // wc[i] = (i + 2) * 2
    mul_scalar<i32>(wc, wc, 2, N);    // wc[i] = (i + 2) * 4
    mul<i16>(hc, ha, hb, N);          // hc[i] = i * 2

    // Y en coma flotante, donde ademas existe la division.
    add<f32>(gout, ga, gb, N);        // 2.0
    add<f64>(dc, da, db, N);          // 2.0
    mul<f64>(dc, dc, db, N);          // 1.0
    div<f64>(dc, dc, db, N);          // 2.0
    negate<f64>(dc, dc, N);           // -2.0

    // Reducciones: la unica forma con dependencia entre vueltas.
    const i64 s = sum<i64>(a, N);     // 0 + 1 + ... + 63 = 2016
    const f64 sf = sum<f64>(da, N);   // 64 * 1.5 = 96

    println("i64=${c[7]} i32=${wc[7]} i16=${hc[7]} f32=${gout[7]} f64=${dc[7]}");
    println("sumas=${s},${sf}");

    // 17 + 36 + 14 + 2 + (-2) + 2016 + 96 = 2179
    const i64 total = c[7] + (i64) wc[7] + (i64) hc[7] + (i64) gout[7]
                    + (i64) dc[7] + s + (i64) sf;

    free(a); free(b); free(c);
    free(wa); free(wb); free(wc);
    free(ha); free(hb); free(hc);
    free(ga); free(gb); free(gout);
    free(da); free(db); free(dc);

    return (i32) (total - 2137);   // 42
}
