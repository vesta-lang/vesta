// -----------------------------------------------------------------------------
// Un ensamblador/desensamblador x86-64 a base de OVERLAYS
// -----------------------------------------------------------------------------
// Una instruccion maquina ES un struct de campos: prefijo REX, opcode, y el byte
// ModR/M (mod[7:6], reg[5:3], rm[2:0]) son CAMPOS -- bitfields de un overlay sobre
// el buffer de codigo.  Con `@overlay` ESCRIBES los campos para ENSAMBLAR y los
// LEES para DESENSAMBLAR (la misma vista, simetrica).  Nombres de registro/opcode
// como constantes y `match` (opcode -> mnemonico) hacen el codigo legible.
// interp = JIT = AOT.

// Registros x86-64 (encoding de 3 bits) y opcodes r/m64,r64 con nombres legibles.
const u8 RAX = 0; const u8 RCX = 1; const u8 RDX = 2; const u8 RBX = 3;
const u8 RSP = 4; const u8 RBP = 5; const u8 RSI = 6; const u8 RDI = 7;
const u8 OP_ADD = 0x01;
const u8 OP_SUB = 0x29;
const u8 OP_XOR = 0x31;
const u8 OP_MOV = 0x89;

// Instruccion registro-registro de 3 bytes: REX.W + opcode + ModR/M.
// El ModR/M son tres bitfields empaquetados en el byte @0x02 (orden x86: rm en
// los bits bajos, luego reg, luego mod en los altos).
@overlay struct RegReg {
    u8 rex    @0x00;         // 0x48 = REX.W (operandos de 64 bits)
    u8 opcode @0x01;
    u8 rm  : 3 @0x02;        // ModR/M.rm  (bits 2:0)  -> registro DESTINO
    u8 reg : 3 @0x02;        // ModR/M.reg (bits 5:3)  -> registro FUENTE
    u8 mod : 2 @0x02;        // ModR/M.mod (bits 7:6)  -> 3 = registro directo

    // ENSAMBLAR: rellena los campos de una instr `op dst, src` (reg,reg).
    public void encode(u8 op, u8 dst, u8 src) {
        this.rex = 0x48;
        this.opcode = op;
        this.mod = 3;         // modo registro directo
        this.reg = src;
        this.rm  = dst;
    }
}

// Nombre de un registro (para el desensamblado legible).
string rn(u8 r) {
    match (r) {
        case 0 => return "rax";
        case 1 => return "rcx";
        case 2 => return "rdx";
        case 3 => return "rbx";
        case 4 => return "rsp";
        case 5 => return "rbp";
        case 6 => return "rsi";
        case 7 => return "rdi";
        case _ => return "r?";
    }
    return "r?";
}

i32 main() {
    u8* code = (u8*) malloc(64);

    // --- ENSAMBLAR: tres instrucciones, cada una una vista RegReg sobre el buffer.
    //     add rax, rcx  |  sub rbx, rdx  |  xor rsi, rdi
    RegReg i0 = RegReg(code + 0);  i0.encode(OP_ADD, RAX, RCX);
    RegReg i1 = RegReg(code + 3);  i1.encode(OP_SUB, RBX, RDX);
    RegReg i2 = RegReg(code + 6);  i2.encode(OP_XOR, RSI, RDI);

    // --- bytes maquina resultantes (hex): 48 01 c8  48 29 d3  48 31 fe ---
    print("code:");
    i32 b = 0;
    i64 sum = 0;
    while (b < 9) {
        u8 by = *(u8*)(code + b);
        print(" ${by:hex}");
        sum = sum + (i64) by;
        b = b + 1;
    }
    println("");

    // --- DESENSAMBLAR: leer los campos de cada vista + match(opcode) -> mnemonico.
    i32 k = 0;
    while (k < 3) {
        RegReg ins = RegReg(code + k * 3);
        print("  ");
        match (ins.opcode) {
            case 0x01 => print("add");
            case 0x29 => print("sub");
            case 0x31 => print("xor");
            case 0x89 => print("mov");
            case _    => print("???");
        }
        // en ModR/M: rm = destino, reg = fuente.
        println(" ${rn(ins.rm)}, ${rn(ins.reg)}");
        k = k + 1;
    }

    // suma de los 9 bytes (verificable): (48+01+c8)+(48+29+d3)+(48+31+fe) = 972
    println("sum=${sum}");
    free(code);
    return (i32) sum;   // 972
}
