namespace ejemplos.sobrecarga;

// SOBRECARGA: varias declaraciones con el mismo nombre, distinguidas por sus
// parametros.  Funciones libres, metodos de struct y metodos de clase.
//
// Hasta ahora el lenguaje no la tenia en ninguna parte salvo un caso: los
// constructores de STRUCT, y solo por ARIDAD, quedandose con el primero que
// encajara (`225`/`335`).  Escribir dos funciones con el mismo nombre daba
// "redefinicion de simbolo a nivel global", y dos metodos, "metodo duplicado".
//
// Lo que se prueba aqui, que es lo que de verdad se rompe:
//
//   1. Por ARIDAD: el mismo nombre con uno y con dos parametros.
//   2. Por TIPO: `i64` contra `f64` con la misma aridad.
//   3. Que gana la EXACTA y no la primera compatible.  Es el caso que mas
//      facil se cuela: un `f64` es asignable a un `i64`, asi que una
//      resolucion que se quede con la primera candidata que "encaja" mandaria
//      `f(2.0)` a `f(i64)` y nunca llegaria a la que el usuario escribio.
//   4. Que el TIPO DE RETORNO sale de la sobrecarga elegida, no de otra.  Con
//      dos que devuelven lo mismo el fallo no se ve: hay que declararlas con
//      retornos DISTINTOS para que se note, porque el sintoma es que el valor
//      se convierte como si fuera del otro tipo y sale basura.
//   5. Y que el orden de DECLARACION no cambia el resultado.  Por eso cada
//      pareja aparece dos veces, en los dos ordenes: un fallo de "gana la
//      ultima declarada" pasa desapercibido si todas las parejas se escriben
//      igual.
//
// Resultado esperado: 42.

// --- 1. por aridad ---------------------------------------------------------
i64 suma(i64 a) => a;
i64 suma(i64 a, i64 b) => a + b;

// 13. Y una VARIADICA con el mismo nombre, que es la que recoge lo que no
// encaja en ninguna de las dos.  Un variadico acepta cualquier cantidad, pero
// la seleccion pedia que la lista de parametros midiera EXACTAMENTE lo que la
// llamada -- y la suya mide uno --, asi que se quedaba fuera: declarar este
// hermano hacia que `suma(1,2,3)` dejara de compilar aunque la variadica sola
// lo aceptara.  Ahora compite, y compite DESPUES: una que dice exactamente lo
// que toma gana a la que lo recoge todo, asi que `suma(7)` sigue yendo a la de
// un parametro.
i64 suma_de_array(i64* xs, i64 n) {
	i64 t = 0_i64;
	for (i64 i = 0_i64; i < n; i = i + 1) { t = t + xs[i]; }
	return t;
}

i64 suma(i64... xs) => suma_de_array(xs, vacount());

// --- 2 y 3. por tipo, y gana la exacta -------------------------------------
i64 cual(i64 x) => 1;
i64 cual(f64 x) => 2;

// --- 4. retornos DISTINTOS, en los dos ordenes ------------------------------
i64 ent_primero(i64 x) => 10;
f64 ent_primero(f64 x) => 20.0;

f64 flot_primero(f64 x) => 20.0;
i64 flot_primero(i64 x) => 10;

// --- 6. METODOS de un struct ------------------------------------------------
//
// El struct despacha estatico y cada metodo baja a una funcion libre
// `Struct__metodo`.  Sin sobrecarga, dos metodos del mismo nombre daban "metodo
// duplicado" -- y antes de eso, los dos se emitian con LA MISMA etiqueta.
struct Medidor {
	i64 base;

	// 11. CONSTRUCTORES del struct.  Su simbolo lleva la ARIDAD dentro
	// (`Medidor__ctor_1`), asi que dos de aridad distinta ya se separaban; dos
	// de la MISMA aridad se emitian con la misma etiqueta y la llamada se iba a
	// uno cualquiera.  Por eso se prohibieron -- "se distinguen por el numero de
	// argumentos, no por sus tipos" --; ahora se distinguen como todo lo demas.
	Medidor(i64 b) { this.base = b; }
	Medidor(f64 b) { this.base = 7; }

	i64 mide(i64 x) => this.base + x;
	i64 mide(f64 x) => this.base + 100;
	i64 mide(i64 x, i64 y) => this.base + x + y;
}

// --- 7. METODOS de una clase, y que NO se confundan con un override ---------
//
// Este es el caso que mas silencioso era: en una clase, un metodo que repetia
// el nombre de otro se tomaba por un override IMPLICITO y REEMPLAZABA su hueco
// de tabla.  Con `hace(i64)` y `hace(f64)` declarados en la misma clase, la
// primera desaparecia y las dos llamadas acababan en la segunda.
class Obrero {
	private i64 turno;

	// 12. CONSTRUCTORES de la clase.  Su simbolo era `<Clase>__ctor` a secas
	// -- sin nada que separara a uno de otro, ni siquiera la aridad, a
	// diferencia del struct --, asi que declarar dos emitia dos etiquetas
	// iguales y la llamada se iba a una cualquiera.  Y ademas se genera un
	// ayudante `__new_` POR CONSTRUCTOR, que NO baja igual en los tres modos:
	// el interprete y el JIT construyen por el registro de clases y el binario
	// nativo con una llamada directa.  Esta clase ademas la EXTIENDE otra, y
	// ahi estaba el ultimo agujero: el `super(...)` del camino nativo se
	// armaba el nombre `Obrero__ctor` a mano -- el de cuando solo podia haber
	// uno --, asi que con dos pedia una etiqueta que ya no existe, el
	// enlazador la daba por externa y el binario NI CARGABA.
	public Obrero(i64 t) { this.turno = t; }
	public Obrero(f64 t) { this.turno = 99; }

	public i64 hace(i64 x) => this.turno + x;
	public i64 hace(f64 x) => this.turno + 1000;

	// 8. Y los `static`, que se llaman por otro camino: `Tipo.metodo(...)`, sin
	// receptor.  Ese camino tambien resolvia por nombre y se quedaba con el
	// primero.
	public static i64 turnos(i64 n) => n * 10;
	public static i64 turnos(f64 n) => 300;
}

// Y que un override SIGUE siendo un override: misma firma exacta, mismo hueco.
//
// 9. Ademas `super.metodo(...)`, que es un TERCER camino: sube por la jerarquia
// buscando el metodo, y lo hacian por separado el comprobador y el bajado.  Con
// dos `hace` en la base, pararse en el hueco equivocado hace que el programa
// llame a un cuerpo creyendo que llama a otro.
class Ayudante : Obrero {
	public Ayudante(i64 t) { super(t); }

	@Override
	public i64 hace(i64 x) => this.hace_base(x) * 2;

	// Llama explicitamente a la sobrecarga de f64 de la BASE.
	public i64 delega_flotante() => super.hace(1.0_f64);

	private i64 hace_base(i64 x) => x + 1;
}

// --- 10. por INTERFAZ -------------------------------------------------------
//
// El CUARTO camino, y el que no se ve: llamando por una interfaz, la ranura de
// la itable se llenaba buscando el implementador POR NOMBRE.  Con dos `corre`,
// las dos ranuras de la interfaz apuntaban al mismo cuerpo.
interface ITarea {
	i64 corre(i64 x);
	i64 corre(f64 x);
}

class Tarea : ITarea {
	public Tarea() { }

	@Override
	public i64 corre(i64 x) => x + 1;

	@Override
	public i64 corre(f64 x) => 5000;
}

i32 main() {
	i64 n = 5_i64;
	f64 d = 5.0_f64;

	// 1. aridad
	i64 a = suma(7);    // 7   (gana la de UN parametro, no la variadica)
	i64 b = suma(3, 4); // 7   (gana la de DOS)
	// 13. y lo que no encaja en ninguna de las dos lo recoge la variadica
	i64 va = suma(1_i64, 2_i64, 3_i64); // 6

	// 2 y 3. tipo, y la exacta gana a la compatible
	i64 c = cual(n); // 1
	i64 e = cual(d); // 2

	// 4 y 5. el retorno sale de la elegida, en los dos ordenes de declaracion
	i64 f = ent_primero(n);  // 10  (si se colara la de f64, saldria basura)
	i64 g = flot_primero(n); // 10

	// 11. constructores del struct: los dos de aridad 1, por tipo
	Medidor mi = Medidor(1_i64);                  // base = 1
	Medidor mf = Medidor(1.0_f64);                // base = 7
	i64     w  = mi.mide(0_i64) + mf.mide(0_i64); // 1 + 7 = 8

	// 6. metodos de struct: por tipo y por aridad
	Medidor m = {.base = 1};
	i64     h = m.mide(2_i64);        // 1 + 2       = 3
	i64     i = m.mide(2.0_f64);      // 1 + 100     = 101
	i64     j = m.mide(2_i64, 3_i64); // 1 + 2 + 3   = 6

	// 12. constructores de CLASE: un ayudante `__new_` por cada uno
	// 7. metodos de clase: la primera NO la borra la segunda
	Obrero o = new Obrero(7);
	i64    k = o.hace(3_i64);   // 7 + 3    = 10
	i64    l = o.hace(3.0_f64); // 7 + 1000 = 1007

	// Y el SEGUNDO constructor de la clase, elegido por el tipo.
	Obrero of = new Obrero(7.0_f64);
	i64    z  = of.hace(3_i64); // 99 + 3 = 102

	// Y el override sigue funcionando: misma firma, sustituye.
	Ayudante y = new Ayudante(7);
	i64      p = y.hace(3_i64); // (3 + 1) * 2 = 8

	// 8. estaticos sobrecargados: `Tipo.metodo(...)`, sin receptor
	i64 q = Obrero.turnos(2_i64);   // 2 * 10 = 20
	i64 r = Obrero.turnos(2.0_f64); // 300

	// 9. super.metodo(...) a la sobrecarga de f64 de la base
	i64 s = y.delega_flotante(); // 7 + 1000 = 1007

	// 10. por INTERFAZ: cada ranura de la itable a SU cuerpo
	ITarea t = new Tarea();
	i64    u = t.corre(2_i64);   // 2 + 1 = 3
	i64    v = t.corre(2.0_f64); // 5000

	i64 total = a + b + va + c + e + f + g;            // 37 + 6 = 43
	i64 met   = h + i + j + k + l + z + p + q + r + s; // 2462 + 102 = 2564
	i64 ifz   = u + v + w;                             // 3 + 5000 + 8 = 5011
	println("suma=${a},${b},${va} cual=${c},${e} retorno=${f},${g} total=${total}");
	println("struct=${h},${i},${j} clase=${k},${l},${z} override=${p}");
	println("static=${q},${r} super=${s} met=${met}");
	println("interfaz=${u},${v} ctor=${w} ifz=${ifz}");
	// 43 + 2564 + 5011 = 7618; 7618 - 7576 = 42
	return (i32)(total + met + ifz - 7576); // 42
}
