namespace ejemplos.vectorizador_completo;

// Las formas de bucle que `std.numeric` NO cubre.
//
// La libreria es la escritura canonica de todo lo que se ensancha, y es lo que
// ejercita `493_std_numeric.vx`.  Aqui quedan las tres cosas que no puede
// expresar, y que sin embargo hay que fijar igual:
//
//   1. La COPIA.  No se ensancha: se reconoce que el bucle entero es un
//      movimiento de bloque y queda UNA instruccion, que es mejor que
//      ensancharlo.  Su sitio en la libreria es `std.memory`, no `std.numeric`.
//
//   2. Una CADENA de operaciones sobre el mismo elemento.  Esta SI se ensancha
//      -- tambien con enteros --, pero no la cubre la libreria: `std.numeric`
//      da una operacion por llamada, y encadenarlas escribiendo el array
//      intermedio seria peor que escribir el bucle.  Aqui se fija que la forma
//      escrita a mano sigue reconociendose.
//
//   3. El PRODUCTO de 64 bits.  No existe empaquetado salvo con AVX-512DQ, y
//      el generador de codigo aun no emite esa instruccion.  Por eso
//      `std.numeric.mul<i64>` no compila: una funcion de libreria que baja a un
//      bucle de uno en uno es una promesa incumplida.
//
// QUE DEPENDE DEL OBJETIVO Y QUE NO -- porque no es lo mismo y decir "no se
// ensancha" a secas seria falso en cuanto se cambie de maquina:
//
//   * Que una forma se reconozca NO depende hoy del objetivo.  La decision se
//     toma sobre el IR, que es comun, asi que este fichero da los MISMOS
//     numeros compilado para x86-64 y para aarch64 -- comprobado, y el arnes lo
//     comprueba en las dos.
//
//   * Cuantos carriles caben SI depende, y se decide al ejecutar: 2, 4 u 8
//     elementos de 64 bits segun lo que tenga la maquina.  El `.velb` es el
//     mismo; quien lo corre lo reparte al ancho que haya.
//
//   * Y lo de arriba sobre el producto de 64 bits es un limite del GENERADOR DE
//     CODIGO, no de toda maquina: en x86-64 con AVX-512DQ la instruccion
//     existe.  Que aqui salga cero es cierto hoy y en todas las maquinas que
//     este compilador sabe targetear, no una verdad universal.
//
// `tools/verify_vectorize.py` fija esos ceros: si algun dia uno empieza a
// ensancharse sera porque alguien lo hizo a proposito, y esa linea del arnes es
// la que hay que mover.
//
// Nada de esto se ve en la salida: con la vectorizacion desactivada el
// programa devuelve exactamente lo mismo, solo que recorriendo los elementos
// de uno en uno.  Por eso lo que se comprueba es el IR.

const i64 N = 64_i64;

// --- 1. La copia, en las dos formas de escribir el bucle. ------------------

i64 copy_while(i64* dst, i64* src, i64 n) {
	i64 i = 0_i64;
	while (i < n) {
		dst[i] = src[i];
		i      = i + 1;
	}
	return dst[0] + dst[n - 1];
}

i64 copy_for(i64* dst, i64* src, i64 n) {
	for (i64 i = 0_i64; i < n; i = i + 1) {
		dst[i] = src[i];
	}
	return dst[0] + dst[n - 1];
}

// --- 2. Cadena: varias operaciones sobre el mismo elemento. ----------------
//
// Se ensancha, y tambien con enteros: sumar y restar carriles existe para todos
// los anchos.  Lo que NO se ensancha es la division entera, ni el producto de
// 8 y de 64 bits, y por eso la cadena mira operacion por operacion en vez de
// mirar el tipo: basta con que UNA no exista para que el resultado intermedio
// deje de ser el que toca.

i64 chain(i64* c, i64* a, i64* b, i64 n) {
	for (i64 i = 0_i64; i < n; i = i + 1) {
		c[i] = a[i] + b[i] - a[i];
	}
	return c[0] + c[n - 1];
}

// --- 3. Producto de 64 bits: no existe empaquetado. ------------------------

i64 scalar_i64(i64* c, i64* a, i64 k, i64 n) {
	for (i64 i = 0_i64; i < n; i = i + 1) {
		c[i] = a[i] * k;
	}
	return c[0] + c[n - 1];
}

i32 main() {
	i64* a = (i64*) malloc(N * 8);
	i64* b = (i64*) malloc(N * 8);
	i64* c = (i64*) malloc(N * 8);

	for (i64 i = 0_i64; i < N; i = i + 1) {
		a[i] = i;
		b[i] = 2;
	}

	// La copia deja c igual que a:  0 + 63 = 63, las dos veces.
	const i64 r1 = copy_while(c, a, N);
	const i64 r2 = copy_for(c, a, N);
	// a + b - a = b = 2 en todos:  2 + 2 = 4.
	const i64 r3 = chain(c, a, b, N);
	// 0*3 = 0 y 63*3 = 189.
	const i64 r4 = scalar_i64(c, a, 3, N);

	println("copia=${r1},${r2} cadena=${r3} escalar_i64=${r4}");

	free(a);
	free(b);
	free(c);

	// 63 + 63 + 4 + 189 = 319
	const i64 total = r1 + r2 + r3 + r4;
	return (i32)(total - 277); // 42
}
