namespace ejemplos.shared_wraps_gc;

// examples_codes_vx/236_shared_wraps_gc.vx
//
// Combinacion de modelos de memoria: shared<gc<T>>.  Un smart pointer
// shared (refcount) envuelve un objeto gestionado por GC.  El bloque de
// control del shared cuenta duenos; el objeto Nodo lo recolecta el GC.
// Ambas gestiones son ortogonales y coexisten.
//
// Esperado: R00 == 42.

class Nodo {
    public i64 v;
    public Nodo(i64 x) { this.v = x; }
}

i32 main() {
    gc<Nodo> g = new Nodo(42);
    shared<gc<Nodo>> s = shared_box(g);
    return (i32) g.v;
}
