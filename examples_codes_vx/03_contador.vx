namespace ejemplos.contador;

// examples_codes_vx/03_contador.vx
//
// Cuenta del 1 al 5 imprimiendo un mensaje en cada iteracion
//
// Demuestra:
//   - Asignacion a variable local con SSA-construction Braun-style.
//   - Bucle 'for' (desazucarado a 'while' + scope para el init).
//   - Operador postfijo i++.
//   - Builtin println() invocado dentro del cuerpo del loop con literales
//     distintos en cada iteracion (compartidos via static_data).
//
// Compilar y ejecutar:
//   vm --vx examples_codes_vx/03_contador.vx -o contador
//   vm --run contador.velb
//
// Salida esperada:
//   == Contador Vesta-lang ==
//   iteracion
//   iteracion
//   iteracion
//   iteracion
//   iteracion
//   == Fin ==

i32 main() {
	println("== Contador Vesta-lang ==");
	for (i32 i = 0_i32; i < 5; i++) {
		println("iteracion");
	}
	println("== Fin ==");
	return 0;
}
