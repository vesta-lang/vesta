// Una instruccion de ensamblador que escribe en un registro lo destruye, y
// quien reparte los registros tiene que saberlo.
//
// La ficha del micro asm ya lo decia -- cada operando lleva escrito si se lee o
// se escribe -- pero eso no llegaba hasta el que asigna registros: el bloque se
// emitia como bytes sueltos y se trataba como si no tocara ninguno.  Con un
// valor vivo en ese registro, el asm lo pisaba y el valor se perdia sin que
// nadie dijera nada.  El sitio donde apuntarlo existia desde el principio
// (AsmBlob::clobbers) y se quedaba vacio.
//
// El registro es rbx a proposito.  Un bloque de ensamblador ya se trataba como
// una llamada, asi que lo que estuviera vivo en un registro de los que no
// sobreviven a una llamada se ponia a salvo solo.  Los que SI sobreviven son
// justo los que el asignador elige para cruzar el bloque, y son los que se
// perdian: la red conservadora los deja pasar y el clobber explicito no se
// declaraba.
//
// El caso mantiene mas valores vivos a la vez de los que caben comodos, para
// que el asignador tenga que usar rbx, y cruza por en medio un `mov rbx, rsp`.
// Si el clobber no se declara, alguno de los sumandos vuelve cambiado.  El
// valor NO depende de que registro elija el asignador: si el compilador es
// correcto, sale el mismo siempre.

i64 suma_con_asm_en_medio(i64 s) {
	i64 a = s + 1;
	i64 b = s + 2;
	i64 c = s + 3;
	i64 d = s + 4;
	i64 e = s + 5;
	i64 f = s + 6;
	i64 g = s + 7;
	i64 h = s + 8;

	// Destruye rbx.  No lee ni escribe nada del programa: lo unico que puede
	// cambiar el resultado es que el asignador tuviera ahi un sumando.
	asm { mov rbx, rsp }

	return a + b + c + d + e + f + g + h;
}

i32 main() {
	// 8 sumandos, s=0: 1+2+3+4+5+6+7+8 = 36.
	i64 t = suma_con_asm_en_medio(0);
	if (t != 36) return 1;

	// Otra vez con s=10: (11..18) = 116.
	i64 u = suma_con_asm_en_medio(10);
	if (u != 116) return 2;

	return 42;
}
