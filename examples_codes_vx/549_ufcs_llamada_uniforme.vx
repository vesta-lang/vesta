namespace ejemplos.ufcs;

// LLAMADA UNIFORME (UFCS): `x.f(a)` y `f(x, a)` son la MISMA llamada.
//
// Una funcion libre cuyo primer parametro admita el receptor se puede escribir
// tras el punto.  No es azucar del bajado: el comprobador REESCRIBE el nodo a
// la otra grafia y lo comprueba el camino de siempre, asi que al IR, al JIT y
// al nativo no les llega nada nuevo -- y las dos formas no pueden divergir en
// la eleccion de sobrecarga, en los prestamos ni en la comprobacion de
// argumentos, porque es literalmente el mismo codigo.
//
// Lo que se prueba aqui:
//
//   1. Receptor STRUCT: el tipo no declara el metodo, lo pone la libre.
//   2. Con ARGUMENTOS ademas del receptor.
//   3. Receptor PRIMITIVO, que es el caso que antes ni llegaba a mirarse:
//      "invocacion de metodo sobre tipo no-clase" y se acababa ahi.
//   4. SOBRECARGA entre las libres candidatas, resuelta con la MISMA regla que
//      una llamada libre -- exacta antes que compatible, cerrada antes que
//      variadica --, no con una propia.
//   5. Mismo nombre para receptores de tipo DISTINTO: no es un choque, es
//      sobrecarga, y es lo que permite extender un tipo sin tocarlo.
//   6. ENCADENADO: el receptor puede ser lo que devolvio la anterior.
//   7. Receptor PUNTERO y receptor CLASE.
//   8. Que el receptor NO tiene que encajar EXACTO: vale alli donde una
//      llamada libre aceptaria el argumento.  Un `i32` encuentra la declarada
//      contra `u64` -- porque `f(y, 3)` compila --, y un literal SIN sufijo se
//      re-tipa si cabe, sin cast: `6.triple()` es `triple(6)`.  Con la clave
//      exacta ninguno de los dos encontraba nada, y las dos grafias dejaban de
//      ser la misma llamada.
//   9. Pero eso vale para los PRIMITIVOS y solo para ellos: un tipo FUERTE es
//      por dentro un entero y aun asi tiene su propio cubo de candidatas, que
//      es precisamente lo que se declara al hacerlo fuerte.
//   10. Y que todo esto vale con el fichero dentro de un `namespace`, que es el
//      caso normal: el aplanado renombra la DECLARACION (`ejemplos__ufcs__f`)
//      pero lo que va tras un punto se escribe corto, asi que buscar `f` a
//      secas no encontraria nada si el indice no supiera el prefijo.
//   11. Una generica de OTRO MODULO, y la funcion ELEGIDA por una expresion.
//      Lo que sigue al punto tiene que ser un nombre -- un ternario no lo es
//      --, asi que la eleccion no cabe ahi; cabe donde caben todas, en el
//      argumento, porque una funcion ya es un valor.  `std.func.apply` es
//      quien lo recibe.
//
// Resultado esperado: 42.

import std.func only apply, tap;

struct Punto {
	i64 x;
	i64 y;
}

// 1 y 2. lo que serian metodos de Punto, escritos fuera de el
i64 perimetro(Punto p) => (p.x + p.y) * 2;
i64 escala(Punto p, i64 k) => (p.x + p.y) * k;

// 3 y 4. receptor primitivo, con sobrecarga entre las candidatas
u64 doble(u64 v) => v * 2_u64;
u64 mas(u64 a, u64 b) => a + b;
u64 mas(u64 a, u64 b, u64 c) => a + b + c;

// 5. el MISMO nombre para otro receptor: otra cabeza de tipo, otra candidata
i64 mas(i64 a, i64 b) => a + b + 100;

// 8. el receptor no encaja EXACTO: un `i32` y un literal sin sufijo llegan
// aqui igual que llegan a `triple(y)` y `triple(6)`
u64 triple(u64 v) => v * 3_u64;

// 9. y un tipo FUERTE, que por dentro es un u32 y aun asi no comparte
// candidatas con el: lo suyo se busca en SU cubo
typedef u32 Edad new;

u64 anyos(Edad e) => (u64)e + 1_u64;

// 7. puntero y clase
i64 leer(i64* p) => *p;

class Caja {
	public i64 v;
	public Caja(i64 v) { this.v = v; }
}

i64 contenido(Caja c) => c.v;

// 11. las dos que la eleccion escoge, y una que se hace por su EFECTO
u64 largo(string s) => s.length();
u64 largo_x2(string s) => s.length() * 2_u64;
void nota(i64 v) { println("nota=${v}"); }
i64 mas_uno(i64 v) => v + 1;

i32 main() {
	Punto q;
	q.x = 4;
	q.y = 5;

	// 1 y 2. receptor struct, con y sin argumentos
	i64 a = q.perimetro(); // 18
	i64 b = q.escala(3);   // 27

	// 3 y 4. receptor primitivo, y la sobrecarga que toca por aridad
	u64 c = ((u64)6).doble();           // 12
	u64 d = ((u64)6).mas(3_u64);        // 9
	u64 e = ((u64)6).mas(3_u64, 1_u64); // 10

	// 6. encadenado: el receptor de la segunda es lo que devolvio la primera
	u64 f = ((u64)6).doble().mas(1_u64); // 13

	// 5. mismo nombre, receptor i64: va a la OTRA, no a la de u64
	i64 g = 5_i64;
	i64 n = g.mas(1_i64); // 5 + 1 + 100 = 106

	// 7. receptor puntero y receptor clase
	i64* pg = &g;
	i64  h  = pg.leer(); // 5
	Caja k  = new Caja(7);
	i64  m  = k.contenido(); // 7

	// 8. sin cast: el literal se re-tipa si cabe, igual que en `triple(6)`,
	// y un `i32` llega a la declarada contra `u64` igual que en `triple(y)`
	i32 y  = 4_i32;
	u64 sc = 6.triple(); // 18
	u64 ch = y.triple(); // 12

	// 9. tipo FUERTE: por dentro un u32, pero con su propio cubo
	Edad ed = (Edad)41_u32;
	u64  ea = ed.anyos(); // 42

	// 10. y los BUILTIN del lenguaje, que son funciones como cualquier otra:
	// `o.unwrap()` es `unwrap(o)`.  Los que llevan una firma registrada ya
	// entraban por el indice; los POLIMORFICOS no, porque valen sobre
	// cualquier `Optional<T>` o `unique<T>` y no tienen un primer parametro
	// concreto que indexar.  Se resuelven igual: si el nombre ES un builtin,
	// se reescribe a la grafia libre y decide la comprobacion de siempre --
	// sin una lista de excepciones que se quede corta al anyadir el
	// siguiente.
	Optional<i64> op = Some(30);
	i64           bu = op.unwrap(); // unwrap(op)      = 30
	shared<i64>   sh = shared_box(7);
	u64           uc = sh.use_count(); // use_count(sh)   = 1
	f64           ra = 81.0_f64;
	f64           rz = ra.sqrt(); // sqrt(ra)        = 9

	// 11. una generica de OTRO MODULO, con la funcion elegida por un ternario.
	// El receptor de la primera es un LITERAL: su tipo es `string`, igual que
	// el de la variable, porque el tipo de una cadena es su tipo y no su
	// representacion -- a `char*` se baja pidiendolo (`.cstr()`).  Antes aqui
	// se deducia `void*` y la misma llamada ligaba un tipo distinto segun se
	// escribiera con un literal o con una variable.
	bool corto = true;
	u64  el    = "hola".apply(corto ? &largo : &largo_x2); // 4
	// Y `tap` deja pasar el valor para poder intercalar el efecto sin partir
	// la cadena en dos.  `mas_uno` no devuelve nada nuevo que explicar; lo que
	// prueba es que el receptor que sigue es el de ANTES del efecto.
	i64 tp = 5.tap(&nota).apply(&mas_uno); // 6

	i64 prim = (i64)(c + d + e + f);           // 12 + 9 + 10 + 13 = 44
	i64 lax  = (i64)(sc + ch + ea);            // 18 + 12 + 42     = 72
	i64 blt  = bu + (i64)uc + (i64)rz;         // 30 + 1 + 9       = 40
	i64 ext  = (i64)el + tp;                   // 4 + 6            = 10
	i64 tot  = a + b + prim + n + h + m + lax; // 207 + 72 = 279
	println("struct=${a},${b} prim=${c},${d},${e} cadena=${f}");
	println("otra_cabeza=${n} puntero=${h} clase=${m} total=${tot}");
	println("sin_cast=${sc} i32=${ch} fuerte=${ea}");
	println("builtins=${bu},${uc},${rz}");
	println("otro_modulo=${el},${tp}");
	return (i32)(tot + blt + ext - 287); // 279 + 40 + 10 - 287 = 42
}
