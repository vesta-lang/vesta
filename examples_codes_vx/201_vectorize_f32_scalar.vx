namespace ejemplos.vectorize_f32_scalar;

// =============================================================================
// 201_vectorize_f32_scalar.vx
//
// Auto-vectorizacion de un compound f32 CON escalar invariante (axpy):
//   for (i)  c[i] = a[i] * k + b[i];      (a/b/c punteros f32 HOST, k escalar)
//
// Antes bailaba porque el broadcast del escalar era solo f64 (VBROADCASTSD /
// UNPCKLPD).  Ahora el f32 se difunde con VBROADCASTSS (AVX/AVX512) o SHUFPS(0)
// (SSE2 128b), y opera packed-single (ADDPS/MULPS/...), el DOBLE de lanes que
// f64 (SSE2 W=4, AVX2 W=8, AVX512 W=16).
//
// El escalar 'k' se toma como LOCAL (no como parametro) por un bug pre-existente
// e INDEPENDIENTE del vectorizador: pasar dos f32 por parametro a una funcion da
// resultados incorrectos (afecta por igual al scalar y al vectorizado; ver la
// nota en el codigo del compilador).  Con k local, oraculo == interp == jit ==
// aot.
//
//   vm --vx examples_codes_vx/201_vectorize_f32_scalar.vx -o f32s
//   vm --run f32s.velb --stats                 # R00 == 950
// =============================================================================

i64 main() {
	f32* c = malloc(100);
	f32* a = malloc(100);
	f32* b = malloc(100);
	f32  k = 2.0_f32;
	// a[i]=i+1, b[i]=i (exactos en f32).
	for (i32 i = 0_i32; i < 25; i++) {
		a[i] = (f32)(i + 1);
		b[i] = (f32)i;
	}
	for (i32 i = 0_i32; i < 25; i++) { c[i] = a[i] * k + b[i]; } // -> ADDPS/MULPS + bcast
	f32 s = 0.0_f32;
	for (i32 i = 0_i32; i < 25; i++) { s = s + c[i]; }
	free(c);
	free(a);
	free(b);
	return (i64) s; // sum_{i=0..24}(2(i+1)+i) = sum(3i+2) = 3*300 + 50 = 950
}
