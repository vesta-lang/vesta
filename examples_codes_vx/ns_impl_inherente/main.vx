// `impl Tipo { metodos }` anade metodos a un tipo existente (struct o clase)
// sin atarlos a ningun concepto -- la forma "inherente", como en Rust --.
// Despacho ESTATICO: llamada directa, y por tanto inline-able.  Colision de
// metodo y aridad con uno que el tipo ya tenga = error de compilacion.
//
// Hubo una segunda palabra para esto, `extension Tipo { }`, y se retiro: hacia
// lo mismo por otro camino, y ese camino se habia quedado corto.
struct Punto { i64 x; i64 y; }
impl Punto {
    i64 suma() { return this.x + this.y; }
    i64 escala(i64 k) { return (this.x + this.y) * k; }
}

class Contador {
    i64 n;
    Contador(i64 v) { this.n = v; }
    i64 get() { return this.n; }
}
impl Contador {
    i64 doble() { return this.get() * 2; }
}

i64 main() {
    Punto p = { .x = 15, .y = 5 };
    Contador c = new Contador(6);
    i64 r = p.suma() + p.escala(1) + c.doble();  // 20 + 20 + 12 = 52
    println("r=${r}");
    return r - 10;                                // 42
}
