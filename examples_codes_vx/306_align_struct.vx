// examples_codes_vx/306_align_struct.vx
//
// `@align(N)` a nivel de STRUCT (equivalente a C `__declspec(align(N))` /
// `_Alignas(N)`): fuerza la alineacion del layout a max(natural, N) y padea el
// tamano a un multiplo de esa alineacion.  Nunca reduce la alineacion natural.
// Funciona en struct plano y en `typedef struct { ... } Name;`.
//
// Resultado esperado: R0 == 42.

// Sin align: 3 x u8 -> size 3, align 1.
struct Small { u8 a;
	u8 b;
	u8 c; }

// @align(16) sobre struct plano -> size padeado a 16, align 16.
@align(16)
	struct Aligned16 { u8 a;
	u8 b;
	u8 c; }

// @align(8) sobre typedef struct -> size 1 padeado a 8, align 8.
@align(8)
	typedef struct _Cache { u8 x; } Cache;

i32 main() {
	// sizeof:  Small=3, Aligned16=16, Cache=8
	// alignof: Small=1, Aligned16=16, Cache=8
	i32 r = (i32)sizeof<Small>()   // 3
		+ (i32)sizeof<Aligned16>() // 16
		+ (i32)sizeof<Cache>()     // 8
		+ (i32)alignof<Small>()    // 1
		+ (i32)alignof<Cache>();   // 8
	// 3 + 16 + 8 + 1 + 8 = 36; +6 = 42
	return r + 6;
}
