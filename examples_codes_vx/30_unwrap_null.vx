namespace ejemplos.unwrap_null;

// Desenvolver algo que no esta es FATAL, y no se captura.
//
// Desenvolver es AFIRMAR que hay algo.  Si no lo hay, el que se equivoco fue
// quien lo afirmo: es un bug del programa, no una condicion que el programa se
// encuentre.  Capturarlo solo sirve para seguir corriendo con la suposicion ya
// rota.  Es lo que hacen Swift (trampa) y Rust (panico); Kotlin lanza porque
// vive en una maquina donde siempre hay excepciones.
//
// Y ademas hace que los TRES modos coincidan.  En nativo no hay desenrollado
// de excepciones, asi que ahi SIEMPRE fue fatal: antes, este mismo programa
// devolvia 999 en el interprete y se moria al compilarlo, que es peor que
// cualquiera de las dos.
//
// Este ejemplo comprueba la mitad que SIGUE VIVA: como se pregunta sin
// afirmar.  Que la afirmacion falsa mata el proceso lo comprueba el caso
// negativo de la suite, que corre el programa y mira que muera.
//
// Resultado esperado: 999.

class Box {
	public i32 v;
	public Box(i32 x) { this.v = x; }
}

i32 main() {
	Box b   = null;
	i32 res = 0;

	// La forma de preguntar sin afirmar.  `isPresent` no desenvuelve nada:
	// solo dice si hay.  Esta es la sustituta del `try/catch` de antes.
	if (isPresent(b) != 0) {
		Box ok = unwrap(b); // no se llega: no hay nada
		res = 111;
	} else {
		res = 999; // la rama de "no hay", sin morirse
	}

	// Y sobre algo que SI esta, desenvolver es lo de siempre.
	Box c = new Box(7);
	if (isPresent(c) != 0) {
		Box ok = unwrap(c);
		res = res + ok.v - 7; // suma cero; solo comprueba que salio bien
	}

	return res;
}
