namespace ejemplos.type_first_class;

// Type-as-first-class-value -- `Type` es un tipo primer-clase en
// compile-time.  `type.of<T>()` empaca un Type como ComptimeValue;
// se guarda en un `comptime Type X` y se usa luego en cualquier
// posicion de tipo (type.size<X>, type.align<X>, type.name<X>, field.count<X>,
// field.name<X>(i), etc.).  Cero runtime: el Type vive solo en compile-time.
//
// Cubre tambien `comptime fn` que devuelve Type (factory de tipos
// parametrizado por valor entero compile-time).

struct Vec2 {
	f32 x;
	f32 y;
}
struct Vec3 {
	f32 x;
	f32 y;
	f32 z;
}
struct Vec4 {
	f32 x;
	f32 y;
	f32 z;
	f32 w;
}

// (1) Type-as-value: T es alias compile-time para Vec3.
comptime Type T = type.of<Vec3>();
static_assert(type.size<T>() == 12, "type.size(T) == type.size(Vec3)");
static_assert(type.align<T>() == 4, "type.align(T) == 4");
static_assert(
	comptime.str.eq(type.name<T>(), "Vec3"),
	"type.name(T) == \"Vec3\""
);
static_assert(comptime.str.eq(type.name<Vec3>(), type.name<T>()), "Vec3 == T");

// (2) Type-as-value sobre primitivos.
comptime Type IntT  = type.of<i32>();
comptime Type LongT = type.of<i64>();
static_assert(type.size<IntT>() == 4, "IntT = i32");
static_assert(type.size<LongT>() == 8, "LongT = i64");

// (3) Introspeccion de campos via Type-value.
static_assert(field.count<T>() == 3, "Vec3 tiene 3 campos");
static_assert(comptime.str.eq(field.name<T>(0), "x"), "campo 0 = x");
static_assert(comptime.str.eq(field.name<T>(2), "z"), "campo 2 = z");

// (4) comptime fn que devuelve Type.  Factory parametrizada.
comptime Type pick_vec(i64 dim) {
	if (dim == 2) return type.of<Vec2>();
	if (dim == 4) return type.of<Vec4>();
	return type.of<Vec3>();
}

comptime Type V4 = pick_vec(4);
static_assert(type.size<V4>() == 16, "Vec4 size");
static_assert(comptime.str.eq(type.name<V4>(), "Vec4"), "Vec4 name");
static_assert(field.count<V4>() == 4, "Vec4 fields");
static_assert(comptime.str.eq(field.name<V4>(3), "w"), "Vec4.fld3 = w");

comptime Type V2 = pick_vec(2);
static_assert(type.size<V2>() == 8, "Vec2 size");
static_assert(comptime.str.eq(type.name<V2>(), "Vec2"), "Vec2 name");

comptime Type VDef = pick_vec(99);
static_assert(comptime.str.eq(type.name<VDef>(), "Vec3"), "fallback Vec3");

i32 main() => 42;
