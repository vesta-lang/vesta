// STACK SWITCH real desde asm en una funcion @Naked, compilado NATIVO por el
// JIT.
//
// Una funcion @Naked no tiene prologo/epilogo/spills, asi que el usuario es
// dueno de la pila: el asm puede REASIGNAR rsp (guardar la pila real, cambiar a
// otra, restaurar) -- el primitivo de las corrutinas/fibras escritas en asm.
// El compilador ENTIENDE la reasignacion de pila y la emite verbatim.  En una
// funcion NORMAL tambien se compila en el JIT, pero el compilador avisa
// (VXA010): el epilogue de una funcion normal gestiona la pila, asi que un
// cambio de pila PERSISTENTE no sobrevive al retorno -> para eso esta @Naked.
//
//     vm --vx asm_naked_stack_switch.vx -o s && vm --run s.velb
// @expect 42
@Naked u64 scratch_stack() {
    asm volatile {
        mov rax, rsp         // guardar la pila real (rax = caller-saved)
        sub rsp, 64          // reservar area scratch (bajar rsp)
        mov qword [rsp], 42  // usar la pila conmutada
        mov rcx, [rsp]       // rcx = 42
        mov rsp, rax         // RESTAURAR rsp (stack switch de vuelta)
        mov rax, rcx         // valor de retorno
        ret
    }
}

u64 main() {
    return scratch_stack();   // 42
}
