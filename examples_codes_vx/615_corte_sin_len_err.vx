namespace ejemplos.corte_sin_len_err;

// `x[a..]` corta hasta el final, y el final lo dice `len()`.  Un tipo que
// declara `__slice__` pero no `len()` no puede decir donde esta (VX2157).
struct SinLen {
	i64 n;

	i64 __slice__(u64 lo, u64 hi) => (i64)(hi - lo);
}

i32 main() {
	SinLen s = {.n = 3};
	i64    a = s[1..];
	return (i32)a;
}
