namespace ejemplos.vectorize_reduction;

// =============================================================================
// 184_vectorize_reduction.vx
//
// Auto-vectorizacion de REDUCCIONES: `for (i) acc = acc + a[i];` (suma).
//
// La suma de un array tiene una dependencia loop-carried (cada acc depende del
// anterior), pero se vectoriza con W=2 acumuladores parciales (uno por lane):
//   acc_lanes += [a[i], a[i+1]]   (VEC_BINOP packed: ADDPD en JIT/AOT)
// y al final una REDUCCION HORIZONTAL acc = acc_lanes[0] + acc_lanes[1] + cola
// escalar para el resto (N % 2).  El valor inicial de acc se respeta.
//
// En el JIT/AOT el bucle interior es SIMD (MOVUPD + ADDPD); en el interprete,
// escalar por lane.  Resultado IDENTICO (solo cambia la velocidad).  Sirve de
// documentacion del patron + validacion (interp == jit).
//
// Solo punteros f64 HOST (malloc/FFI).  El acumulador `acc` es un f64 escalar.
// =============================================================================

// Suma vectorizada de un array f64 (el bucle interior es el patron objetivo).
f64 sum(f64* p, i32 n) {
	f64 acc = 0.0_f64;
	for (i32 i = 0_i32; i < n; i++) { acc = acc + p[i]; } // REDUCCION
	return acc;
}

i32 main() {
	i64 total = 0_i64;

	// --- N par: sin cola ---
	f64* a = malloc(80); // 10 x f64
	for (i32 i = 0_i32; i < 10; i++) { a[i] = (f64)(i + 1); }
	total = total + (i64) sum(a, 10); // 1+2+...+10 = 55

	// --- N impar: ejercita la cola escalar ---
	f64* b = malloc(56); // 7 x f64
	for (i32 i = 0_i32; i < 7; i++) { b[i] = (f64)(2 * i + 1); }
	total = total + (i64) sum(b, 7); // 1+3+5+7+9+11+13 = 49

	// --- acumulador con valor inicial != 0 + N grande ---
	f64* d = malloc(800); // 100 x f64
	for (i32 i = 0_i32; i < 100; i++) { d[i] = 1.0; }
	f64 acc = 1000.0_f64;
	for (i32 i = 0_i32; i < 100; i++) { acc = acc + d[i]; } // 1000 + 100*1 = 1100
	total = total + (i64) acc;

	free(a);
	free(b);
	free(d);

	// total = 55 + 49 + 1100 = 1204
	return (i32) total;
}
