namespace ejemplos.struct_closure_escape_err;

// Struct con closure capturador que escapa por valor (move-on-return).
//
// Un struct value-type puede contener un closure (lambda con captura) y
// retornarse por valor.  Para el caso local-no-escapa, el env del closure vive
// en el stack (cero coste).  Cuando el struct ESCAPA por return, el compilador
// aloca su env en el heap, mueve el struct al caller (SRET) y transfiere el
// ownership del env: el productor no lo libera (move) y el consumidor
// (`Caja c = crear(...)`) lo libera al salir de su scope.  Un unico free, sin
// GC.  Ver doc/VMdoc//ClosuresEnCampos.md.

struct Caja {
	fn() -> i64 leer;
}

Caja crear(i64 v) {
	Caja c;
	c.leer = () => v + 1; // closure capturador; al escapar, env en heap
	return c;             // move-on-return: el env se transfiere al caller
}

i32 main() {
	Caja c = crear(41);    // c posee el env; lo libera al exit del scope
	return (i32) c.leer(); // 42
}
