// -----------------------------------------------------------------------------
// El resultado de una `comptime fn` con inline asm se puede usar en una CONSTANTE
// compile-time y validar con `static_assert` -- todo evaluado por el ComptimeVM
// (JIT + interp fallback) durante la compilacion.  interp = JIT = AOT.
// -----------------------------------------------------------------------------

comptime i64 asm_add(i64 a, i64 b) {
	register("rdi") i64 x = a;
	register("rsi") i64 y = b;
	register("rax") i64 out;
	asm volatile {
		mov rax, rdi
		add rax, rsi
	}
	return out;
}

// La constante se computa por asm en compile-time.
const i64 SUM = asm_add(40, 2);

// static_assert (top-level) valida el valor comptime.  Si fuese distinto de 42,
// la compilacion se detendria con un error claro.
static_assert(SUM == 42, "asm_add(40, 2) debe ser 42");

i32 main() {
	return (i32) SUM; // 42
}
