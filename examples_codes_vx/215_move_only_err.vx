// Move-only: usar un valor tras moverlo es un error (use-after-move).
//
// Un struct GESTIONADO -- con destructor `~Struct()` o un campo destructible --
// que NO define el copy-hook `__clone__` es move-only: `S b = a` TRANSFIERE la
// propiedad de `a` a `b` (no copia), y `a` queda invalidado para evitar un
// doble-free de su recurso.  Usar `a` despues del move es un error de compilacion
// con un mensaje claro.  Para permitir copias, define `void __clone__()`; para
// reusar `a`, reasignale un valor nuevo.  Ver doc/VMdoc//SmartPointers.md.

struct S {
	i64* p;
	~S() { free(this.p); } // recurso -> move-only sin __clone__
}

S mk() {
	S r;
	r.p  = (i64 *) malloc(8);
	*r.p = 7;
	return r;
}

i32 main() {
	S   a = mk();
	S   b = a;      // move: `a` queda invalidado
	i64 x = *a.p; // ERROR: use-after-move de `a`
	return (i32)x;
}
