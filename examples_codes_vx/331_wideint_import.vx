/**
 * @file 331_wideint_import.vx
 * @brief Import cross-module de un `struct` con metodos, herencia y operadores.
 *
 * Ejercita el stdlib `std.wideint`: importa el tipo `u128` (que hereda de
 * `@Abstract Wide128` y sobrecarga /, %, <, >, ==) desde otro modulo.  Antes,
 * el import cross-module de un struct traia el tipo SIN sus metodos (ni propios,
 * ni heredados aplanados, ni operadores).  Ahora el .vxi serializa los metodos
 * de struct y el consumidor resuelve los operadores contra la firma importada.
 *
 * checksum: 1000/7 = 142 resto 6 -> 142*10 + 6 = 1426.  Se valida con la red
 * diferencial (interp = oraculo; jit y aot deben coincidir).
 */
import std.wideint only u128;

u128 mk(u64 lo) { u128 r; r.lo64 = lo; r.hi64 = 0; return r; }

i32 main() {
    u128 a = mk(1000);
    u128 b = mk(7);
    u128 q = a / b;      // 142
    u128 r = a % b;      // 6
    bool ok = (a > b) && (b < a) && (a != b);
    return (i32) (q.lo64 * 10 + r.lo64 + (ok ? 0 : 1000));
}
