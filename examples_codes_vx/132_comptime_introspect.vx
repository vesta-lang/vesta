namespace ejemplos.comptime_introspect;

// introspeccion comptime: builtins atomicos que se
// resuelven 100% en tiempo de compilacion.  Cada llamada baja a
// UN solo IrOp::CONST (o STRMAKE para type.name) -- cero overhead
// runtime, cero acceso a tablas de metadata.
//
// Builtins disponibles:
//   type.size<T>()    -> u64   tamano en bytes
//   type.align<T>()   -> u64   alineamiento en bytes
//   type.name<T>()  -> string nombre canonico (StringObject)
//   type.id<T>()   -> u32   FNV-1a 32-bit estable
//   type.kind<T>()      -> i32   categoria (Primitive=0, Class=1, Struct=2, ...)

i32 main() {
	// Tamanos de primitivos: el compilador conoce el ABI exactamente.
	u64 sz_i32 = type.size<i32>();  // 4
	u64 sz_i64 = type.size<i64>();  // 8
	u64 sz_ptr = type.size<i32*>(); // 8 (puntero)

	// Alineamientos siguen la regla "size para escalar, 8 para wrapper".
	u64 al_i8  = type.align<i8>();  // 1
	u64 al_f64 = type.align<f64>(); // 8

	// Categorias: los enteros, floats, bool, char son Primitive.
	i32 k_i32 = type.kind<i32>();  // 0 = Primitive
	i32 k_ptr = type.kind<i32*>(); // 7 = Ptr

	// type.id<T>(): FNV-1a 32-bit del nombre canonico ("i32", "i64", ...).
	// Estable cross-build: dos ejecuciones del programa dan el mismo ID.
	// Util para fast-path "es de tipo X?" via 1 cmp + 1 jcc.
	u32 id_a = type.id<i32>();
	u32 id_b = type.id<i32>(); // mismo tipo -> mismo ID
	u32 id_c = type.id<i64>(); // tipo distinto -> ID distinto

	// type.name<T>(): construye un StringObject inline con el nombre
	// canonico.  Util para reflexion + logging + debug.
	string name     = type.name<i32>();
	i32    name_len = name.length(); // 3

	// Sumamos puntos por cada chequeo OK -> esperado 42.
	i32                ok = 0_i32;
	if (sz_i32 == 4)   ok = ok + 4;
	if (sz_i64 == 8)   ok = ok + 4;
	if (sz_ptr == 8)   ok = ok + 4;
	if (al_i8 == 1)    ok = ok + 4;
	if (al_f64 == 8)   ok = ok + 4;
	if (k_i32 == 0)    ok = ok + 4;
	if (k_ptr == 7)    ok = ok + 4;
	if (id_a == id_b)  ok = ok + 4;
	if (id_a != id_c)  ok = ok + 4;
	if (name_len == 3) ok = ok + 6;
	return ok;
}
