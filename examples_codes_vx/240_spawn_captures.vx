namespace ejemplos.spawn_captures;

// 240_spawn_captures.vx
//
// CAPTURAS en el body de `spawn { }` en AOT: el cuerpo del hilo usa variables
// LOCALES del outer (capturadas por valor).  Se aloca un struct heap con las
// capturas, se pasa como arg del hilo, y el helper las lee + libera el struct.
//
// Cada hilo recibe su propia `base` (captura por valor) y suma base*10000 al
// contador compartido.  base=1 -> +10000, base=2 -> +20000  => 30000 EXACTO.
//
//   vm -m aot --vx 240_spawn_captures.vx --format pe -o p.exe && ./p.exe   (exit 42)

import "vx_sync" only vx_lock, vx_unlock;

i64 g_lock    = 0_i64; // objeto de lock (host_ptr)
i64 g_counter = 0_i64; // contador compartido

i32 main() {
	g_lock = (i64)malloc(4 * 8);
	i64* lo = (i64*)g_lock;
	lo[0]     = 0;
	lo[1]     = 0;
	lo[2]     = 0;
	lo[3]     = 0;
	g_counter = 0;

	i64 base1 = 1_i64; // capturada por el 1er spawn
	i64 base2 = 2_i64; // capturada por el 2do spawn

	spawn {
		i64 i = 0_i64;
		while (i < 10_000) {
			vx_lock((i64*)g_lock);
			g_counter = g_counter + base1;
			vx_unlock((i64*)g_lock);
			i = i + 1;
		}
	};
	spawn {
		i64 i = 0_i64;
		while (i < 10_000) {
			vx_lock((i64*)g_lock);
			g_counter = g_counter + base2;
			vx_unlock((i64*)g_lock);
			i = i + 1;
		}
	};

	// join-all implicito antes del RET: 1*10000 + 2*10000 = 30000.
	return (g_counter == 30_000) ? 42 : (i32)(g_counter % 1000);
}
