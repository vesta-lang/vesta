namespace ejemplos.literal_campo_privado_err;

// Dar valor a un campo en un literal `{...}` es USARLO: un campo `private` no
// se rellena desde fuera del tipo, ni por nombre ni por posicion (VX2164).  Se
// construye con lo que el tipo ofrece: una factoria, un constructor, un `set`.
struct Caja {
	private i64 secreto;

	public static Caja nueva(i64 v) => {.secreto = v}; // dentro: si
	public i64 ver() => this.secreto;
}

i32 main() {
	Caja buena = Caja.nueva(7);
	Caja mala  = {.secreto = 7};
	return (i32)(buena.ver() + mala.ver());
}
