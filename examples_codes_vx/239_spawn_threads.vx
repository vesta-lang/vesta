namespace ejemplos.spawn_threads;

// 239_spawn_threads.vx
//
// SUGAR de multihilo en AOT: `spawn { body }` lanza un HILO REAL del SO (no una
// fibra cooperativa) y el join-all se INYECTA al final de main -> el programa
// espera a todos los hilos antes de terminar, sin join explicito del usuario.
//
// Dos hilos incrementan un contador compartido 30000 veces cada uno bajo el
// monitor de vx_sync (vx_lock/vx_unlock) -> 60000 EXACTO (exclusion mutua real).
//
// NOTA de semantica: el join-all corre en el RETURN de main, asi que el VALOR de
// retorno ve el resultado unido.  Leer el estado compartido A MITAD de main
// (antes del return) necesitaria un join explicito (vx_thread_join); el patron
// natural es que main devuelva/use el resultado tras los spawn.
//
//   vm -m aot --vx 239_spawn_threads.vx --format pe -o p.exe && ./p.exe   (exit 42)

import "vx_sync" only vx_lock, vx_unlock;

i64 g_lock    = 0; // objeto de lock (host_ptr; palabra de monitor en obj+16)
i64 g_counter = 0; // contador compartido

i32 main() {
	g_lock = (i64)malloc(4 * 8);
	i64* lo = (i64 *)g_lock;
	lo[0] = 0;
	lo[1] = 0;
	lo[2] = 0;
	lo[3] = 0;
	g_counter = 0;

	// Cada `spawn { }` = un hilo del SO en paralelo.
	spawn {
		i64 i = 0;
		while (i < 30_000) {
			vx_lock((i64 *)g_lock);
			g_counter = g_counter + 1;
			vx_unlock((i64 *)g_lock);
			i = i + 1;
		}
	};
	spawn {
		i64 i = 0;
		while (i < 30_000) {
			vx_lock((i64 *)g_lock);
			g_counter = g_counter + 1;
			vx_unlock((i64 *)g_lock);
			i = i + 1;
		}
	};

	// El join-all implicito (antes del RET) espera a ambos hilos; el valor de
	// retorno ya ve g_counter unido: 60000 si la exclusion mutua fue correcta.
	return (g_counter == 60_000) ? 42 : (i32)(g_counter % 1000);
}
