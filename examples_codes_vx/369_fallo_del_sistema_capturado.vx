// Un fallo del PROCESADOR, capturado con `try/catch`, y el programa sigue.
//
// Que un acceso invalido se convierta en `FatalError` capturable ya estaba
// escrito, pero no lo comprobaba nadie: los dos ejemplos que lo ejercitaban
// (`test_av_catch.vx`, `test_av_mixed.vx`) nunca se conectaron a la suite.
// Mientras tanto se rompio -- quien recuperaba el fallo daba el proceso por
// muerto SIEMPRE, tambien cuando el `catch` se habia hecho cargo --, y el
// resultado era lo peor posible: el programa terminaba sin ejecutar el `catch`,
// sin mensaje y con codigo de salida cero, o sea afirmando que todo fue bien.
//
// Lo que se comprueba aqui no es solo que el `catch` reciba el fallo, sino que
// DESPUES se siga ejecutando: es justo lo que se habia perdido.
//
// Fuera de la suite en modo nativo a proposito: sin desenrollado de excepciones
// nativo (`.pdata`/`.eh_frame`) el AOT no puede convertir un fallo del
// procesador en excepcion, y pedirselo seria exigirle algo que aun no existe.

i32 main() {
	i64 hechas = 0;

	// Puntero nulo.
	try {
		i64* p = (i64 *) 0;
		i64  v = *p;
		println("no deberia llegar: ${v}");
	} catch (FatalError e) {
		if (e.kind == 7) hechas = hechas + 1;
	}

	// Una direccion que no esta mapeada.  Se hace DESPUES del primero: si la
	// recuperacion dejase el proceso tocado, esta segunda no llegaria a correr.
	try {
		i64* malo = (i64 *) 0xDEADBEEF;
		i64  v    = *malo;
		println("no deberia llegar: ${v}");
	} catch (FatalError e) {
		if (e.kind == 7) hechas = hechas + 1;
	}

	// Escritura, no lectura: el sistema lo cuenta como otro tipo de acceso y la
	// recuperacion tiene que valer igual.
	try {
		i64* p = (i64 *) 0;
		*    p = 1;
		println("no deberia llegar");
	} catch (FatalError e) {
		if (e.kind == 7) hechas = hechas + 1;
	}

	// Y el programa sigue vivo despues de tres fallos seguidos: se llama a una
	// funcion, se hace aritmetica y se devuelve.  Si la recuperacion cerrara el
	// proceso, nada de esto correria y el caso terminaria en otro numero.
	i64 suma = 0;
	i64 i    = 0;
	while (i < 10) {
		suma = suma + i;
		i    = i + 1;
	}

	// 3 capturados + 45 de la suma = 48.
	return (i32)(hechas + suma);
}
