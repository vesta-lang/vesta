// examples_codes_vx/311_bf_comptime.vx
//
// Compilador Brainfuck -> Vesta escrito USANDO SOLO COMPTIME.
//
// `bf_gen(src)` compila un fuente Brainfuck a codigo Vesta (un lambda
// `fn() -> i32` que ejecuta el programa sobre una cinta de celdas).  El @Macro
// `bf(src)` lo INYECTA como expresion (para asignarlo a una variable y correrlo)
// y `comptime string CODE = bf_gen(PROG)` lo captura como string (para
// MOSTRARLO).  El programa Brainfuck se define UNA sola vez (`PROG`); el codigo
// generado y el codigo ejecutado se derivan de esa unica fuente.  Cero
// interprete Brainfuck en runtime.
//
// Todo el compilador corre en la ComptimeVM (interprete/JIT): `bf_classify` /
// `bf_emit` / `bf_compile_body` / `bf_gen` son `comptime fn` (corren en
// compile-time para GENERAR el codigo) y usan las FUNCIONES ESTANDAR del
// lenguaje (`strlen`, `+` de strings, `s[i]`, `source`), no helpers especificos
// de comptime.
//
// Los fragmentos de codigo Vesta se escriben con `comptime.source(...)`: el IDE
// resalta el argumento como CODIGO real (no un string opaco) y `source`
// devuelve su texto crudo, que se splicea en el cuerpo generado.  Los
// fragmentos con llaves desbalanceadas (`while (...) {` y `}`) no pueden
// capturarse con `source` (rastrea la profundidad de {}) y se dejan como string.
//
// Los 8 comandos Brainfuck se modelan con un `enum` de tokens y se despachan
// con `match` (dos matches: caracter -> token, token -> fragmento de codigo).
//
// El programa BF de prueba `++++++[>+++++++<-]>` calcula 6*7 = 42 en la
// celda 1 y deja el puntero ahi.  Resultado esperado: R0 == 42.

import std.comptime only source, inject;

// --- El compilador Brainfuck (comptime puro) -------------------------------

// Los tokens del lenguaje Brainfuck.
enum BfTok { Right, Left, Inc, Dec, Out, In, Loop, EndLoop, Nop }

// Clasifica UN caracter Brainfuck a su token (match sobre el char).
comptime BfTok bf_classify(char c) {
    match c {
        case '>' => return BfTok.Right;
        case '<' => return BfTok.Left;
        case '+' => return BfTok.Inc;
        case '-' => return BfTok.Dec;
        case '.' => return BfTok.Out;
        case ',' => return BfTok.In;
        case '[' => return BfTok.Loop;
        case ']' => return BfTok.EndLoop;
        case _   => return BfTok.Nop;   // no-comando: se ignora
    }
    return BfTok.Nop;
}

// Emite el fragmento de codigo Vesta de un token (match sobre el enum).  Los
// fragmentos balanceados se escriben como CODIGO real via `source(...)` (el IDE
// los resalta); `Loop`/`EndLoop` (llaves sueltas) quedan como string.
comptime string bf_emit(BfTok t) {

    // usamos "\${tape[p]:char}" para que no se procese en tiempo de compilacion
    // sino en run-time
    match t {
        case Right   => return source( p++; );
        case Left    => return source( p--; );
        case Inc     => return source( tape[p]++; );
        case Dec     => return source( tape[p]--; );
        case Out     => return source( print("\${tape[p]:char}"); );
        case In      => return source( tape[p] = 0; );
        case Loop    => return " while (tape[p] != 0) {";
        case EndLoop => return " }";
        case Nop     => return "";
    }
    return "";
}

// Compila un programa Brainfuck completo a un cuerpo de statements Vesta.
comptime string bf_compile_body(string src) {
    string body = "";
    for (i64 i = 0; i < strlen(src); i++) {
        body += bf_emit(bf_classify(src[i]));   // char -> token -> codigo
    }
    return body;
}

// Compila un fuente Brainfuck a un lambda Vesta completo (como string de
// codigo).  El cuerpo se interpola con `${bf_compile_body(src)}`.
comptime string bf_gen(string src, u32 size_stack) {
    return source(
        () => {
            i32[${size_stack}] tape;
            i32 p = 0;
            ${bf_compile_body(src)}
            return tape[p];
        }
    );
}

i32 main() {
    comptime string PROG = source(++++++[>+++++++<-]>);
    comptime string CODE = bf_gen(PROG, 4096);

    // Imprime el codigo Vesta que el compilador Brainfuck comptime genero.
    println("=== Codigo Vesta generado por el compilador Brainfuck (comptime) ===");
    println("${CODE}");

    // `inject(PROG)` se expande, en compile-time, al mismo lambda Vesta.
    fn() -> i32 programa = inject(CODE);

    i32 r = programa();
    println("brainfuck -> ${r}");

    return r;
}
