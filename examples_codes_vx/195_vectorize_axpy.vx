namespace ejemplos.vectorize_axpy;

// =============================================================================
// 195_vectorize_axpy.vx
//
// Auto-vectorizacion COMPOUND (cadena multi-op): el patron axpy
// `c[i] = a[i] OP1 r0 OP2 r1 ...` (mas de un operador) sobre arrays f64 HOST.
// Antes solo vectorizaba RHS de UN binop; ahora el matcher compound encadena
// VEC ops con `c` como acumulador.  Gracias a la normalizacion de nodos
// conmutativos (Add/Mul: a OP b == b OP a, bit-exacto), vectorizan tambien las
// formas right-leaning y con el escalar primero, no solo el left-leaning.
//
// Corre IDENTICO con o sin vectorizacion (mismo resultado, solo cambia la
// velocidad).  Sirve de documentacion del patron + banco de regresion.
//
// Resultado esperado: 44850 (ver el calculo al final).
// =============================================================================

i64 main() {
	i64  N = 100_i64;
	f64* a = malloc(N * 8);
	f64* b = malloc(N * 8);
	f64* c = malloc(N * 8);
	f64* d = malloc(N * 8);

	// Init (no vectorizable: depende de i).
	for (i64 i = 0_i64; i < N; i = i + 1) {
		a[i] = (f64) i;      // 0, 1, 2, ...
		b[i] = (f64)(i + 1); // 1, 2, 3, ...
		d[i] = 2.0;          // factor por-elemento (array)
	}

	// --- left-leaning: c[i] = a[i]*2.0 + b[i] = 2i + (i+1) = 3i+1 ---
	for (i64 i = 0_i64; i < N; i = i + 1) { c[i] = a[i] * 2.0 + b[i]; }
	f64 s1 = 0.0_f64;
	for (i64 i = 0_i64; i < N; i = i + 1) { s1 = s1 + c[i]; }

	// --- right-leaning: c[i] = b[i] + a[i]*2.0 (mismo valor que s1) ---
	for (i64 i = 0_i64; i < N; i = i + 1) { c[i] = b[i] + a[i] * 2.0; }
	f64 s2 = 0.0_f64;
	for (i64 i = 0_i64; i < N; i = i + 1) { s2 = s2 + c[i]; }

	// --- 3-array: c[i] = a[i]*d[i] + b[i] = 2i + (i+1) (mismo valor) ---
	for (i64 i = 0_i64; i < N; i = i + 1) { c[i] = a[i] * d[i] + b[i]; }
	f64 s3 = 0.0_f64;
	for (i64 i = 0_i64; i < N; i = i + 1) { s3 = s3 + c[i]; }

	free(a);
	free(b);
	free(c);
	free(d);

	// s1 = s2 = s3 = sum_{i=0}^{99} (3i+1) = 3*4950 + 100 = 14950.
	// total = 3 * 14950 = 44850.
	return (i64)(s1 + s2 + s3);
}
