namespace ejemplos.comptime_anchos;

// Un tipo estrecho sigue siendo estrecho al ejecutar algo AL COMPILAR.
//
// La maquina que ejecuta en compilacion recibe los argumentos por sus
// registros, asi que cada constante se escribe en uno.  Eso NO cambia el tipo
// de nada: el ancho del registro es el del TRANSPORTE, y quien recibe el
// argumento lo lee con el ancho que declaro.  Confundir las dos cosas seria
// decir que el lenguaje trabaja en palabras de sesenta y cuatro bits, y no es
// cierto ni aqui ni, mucho menos, en otros procesadores.
//
// Se comprueba con lo que delataria una confusion: un valor que ocupa casi
// todo el ancho declarado, uno negativo -- que el arbol representa como una
// operacion y hay que resolver al vuelo --, y uno que NO cabe en dieciseis
// bits para que se vea que tampoco se recorta de mas.

comptime i16 c_i16(i16 x) { return x; }
comptime u8 c_u8(u8 x) { return x; }
comptime i32 c_i32(i32 x) { return x; }
comptime i16 c_neg(i16 x) { return x; }
i32 main() {
	const i16 a = c_i16(30_000);
	const u8  b = c_u8(200);
	const i32 c = c_i32(-70_000);
	const i16 d = c_neg(-30_000);
	println("i16=${a} u8=${b} i32=${c} neg=${d}");
	// 30000 + 200 - 70000 + (-30000) = -69800
	return (i32)(a + (i16) b + c + d + 69_842); // 42
}
