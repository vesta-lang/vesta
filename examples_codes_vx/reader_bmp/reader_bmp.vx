// =============================================================================
// reader_bmp.vx - Migracion a Vesta del proyecto Java ReaderBMP + JColorsTerm.
//
// Lee un BMP de 24 bits (BGR, sin compresion), imprime sus atributos de
// cabecera y vuelca los pixeles a la terminal como bloques de color ANSI
// truecolor (secuencia 48;2;r;g;b), replicando dump_buffer_cli de JColorsTerm.
//
// Version SINGLE-FILE (sin import): modela el BMP con VISTAS TIPADAS
// (@overlay struct) sobre el buffer host del fichero + FUNCIONES LIBRES, el
// idioma nativo de Vesta para formatos binarios.  El I/O binario usa FFI
// dinamico a msvcrt (portable a interp / JIT / AOT-PE).
// =============================================================================

// ---------------------------------------------------------------------------
// Vistas tipadas del formato BMP (@overlay struct): un overlay ES un puntero;
// vista.campo lee/escribe en base+offset con el ancho declarado (little-endian).
// ---------------------------------------------------------------------------

// BITMAPFILEHEADER: los primeros 14 bytes del fichero.
@overlay
struct BmpFileHeader {
	i16 magic  @0x00; // firma 'BM' = 0x4D42
	i32 size   @0x02; // tamano total del fichero
	i16 rsv1   @0x06;
	i16 rsv2   @0x08;
	i32 offset @0x0A; // offset a los datos de pixel
}

// BITMAPINFOHEADER: 40 bytes que empiezan en el offset 14 del fichero (la vista
// se construye con BmpInfoHeader(buf + 14); sus offsets son relativos a su base).
@overlay
struct BmpInfoHeader {
	i32 hdr_size    @0x00; // 40 = 0x28
	i32 width       @0x04;
	i32 height      @0x08;
	i16 planes      @0x0C;
	i16 bpp         @0x0E;
	i32 compression @0x10;
	i32 image_size  @0x14;
	i32 res_h       @0x18;
	i32 res_v       @0x1C;
	i32 palette     @0x20;
	i32 important   @0x24;
}

comptime i32 BMP_FILE_HDR_SIZE = 14_i32;

// ---------------------------------------------------------------------------
// FFI dinamico a msvcrt para I/O binario de fichero.
// ---------------------------------------------------------------------------
i64 g_msvcrt = 0_i64;
i64 g_fopen  = 0_i64;
i64 g_fread  = 0_i64;
i64 g_fseek  = 0_i64;
i64 g_ftell  = 0_i64;
i64 g_fclose = 0_i64;

void ensure_loaded() {
	if (g_msvcrt != 0) {
		return;
	}
	g_msvcrt = ffi_open("msvcrt.dll");
	g_fopen  = ffi_sym(g_msvcrt, "fopen");
	g_fread  = ffi_sym(g_msvcrt, "fread");
	g_fseek  = ffi_sym(g_msvcrt, "fseek");
	g_ftell  = ffi_sym(g_msvcrt, "ftell");
	g_fclose = ffi_sym(g_msvcrt, "fclose");
}

// Lee `size` bytes de `path` al buffer host `buf` (provisto por el caller).
// Patron de DOS PASOS (el caller mide con file_size y reserva localmente) para
// que el buffer conserve su naturaleza host (ver LIM-10).  Devuelve los bytes
// leidos o -1.
i64 read_file_into(string path, u8* buf, i64 size) {
	ensure_loaded();
	u8* path_c = path.cstr();
	u8* mode_c = "rb".cstr();
	if (path_c == null || mode_c == null) {
		return -1;
	}
	i64 fp = ffi_call(g_fopen, path_c, mode_c);
	if (fp == 0) {
		return -1;
	}
	i64 nread = ffi_call(g_fread, buf, 1, size, fp);
	ffi_call(g_fclose, fp);
	return nread;
}

// Devuelve el tamano en bytes de `path`, o -1 si no se pudo abrir.
i64 file_size(string path) {
	ensure_loaded();
	u8* path_c = path.cstr();
	u8* mode_c = "rb".cstr();
	if (path_c == null || mode_c == null) {
		return -1;
	}
	i64 fp = ffi_call(g_fopen, path_c, mode_c);
	if (fp == 0) {
		return -1;
	}
	ffi_call(g_fseek, fp, 0, 2); // SEEK_END
	i64 size = ffi_call(g_ftell, fp);
	ffi_call(g_fclose, fp);
	return size;
}

// ---------------------------------------------------------------------------
// Presentacion (funciones libres que reciben el u8* y leen via overlays).
// ---------------------------------------------------------------------------

void print_attributes(u8* buf) {
	BmpFileHeader fh        = BmpFileHeader(buf);
	u8*           info_base = buf + BMP_FILE_HDR_SIZE;
	BmpInfoHeader ih        = BmpInfoHeader(info_base);
	println("File Header: ${fh.magic:hex}");
	println("Image Size: ${fh.size} bytes");
	println("Offset Init Data: ${fh.offset}");
	println("");
	println("Header:");
	println("  Size Header: ${ih.hdr_size} bytes");
	println("  Width: ${ih.width} pixels");
	println("  Height: ${ih.height} pixels");
	println("  Color Planes: ${ih.planes}");
	println("  Bits per Pixel: ${ih.bpp}");
	println("Compression Method: ${ih.compression}");
	println("Raw Image Size: ${ih.image_size} bytes");
	println("Horizontal Resolution: ${ih.res_h} pixels/meter");
	println("Vertical Resolution: ${ih.res_v} pixels/meter");
	println("Color Palette: ${ih.palette}");
	println("Important Colors: ${ih.important}");
}

// Volcado ANSI truecolor: replica dump_buffer_cli (BMP = bottom-up, BGR).  Usa
// el builtin bg_rgb(r,g,b) para el color de fondo y RESET para limpiar.
void dump_terminal(u8* buf) {
	BmpFileHeader fh            = BmpFileHeader(buf);
	u8*           info_base     = buf + BMP_FILE_HDR_SIZE;
	BmpInfoHeader ih            = BmpInfoHeader(info_base);
	i32           width         = ih.width;
	i32           height        = ih.height;
	i32           bytes_per_row = width * 3;
	i32           padding       = (4 - (bytes_per_row % 4)) % 4;
	i32           row_padded    = bytes_per_row + padding;
	i32           base          = (i32) fh.offset;

	// BMP se almacena de abajo hacia arriba: fila height-1 primero.
	for (i32 fila = height - 1; fila >= 0; fila--) {
		for (i32 col = 0_i32; col < width; col++) {
			i32 index = base + fila * row_padded + col * 3;
			i32 b     = (i32) buf[index];
			i32 g     = (i32) buf[index + 1];
			i32 r     = (i32) buf[index + 2];
			print("${bg_rgb(r, g, b)} ${RESET}");
		}
		println("");
	}
}

i32 main() {
	// Path fijo: version portable que compila tambien a AOT (donde
	// args_count/args_get no estan disponibles).  Ejecutar desde el
	// directorio reader_bmp/.  La version con CLI esta en main.vx.
	string path = "Ejemplo60x3.bmp";

	// Patron de DOS PASOS con malloc LOCAL (conserva la naturaleza host).
	i64 len = file_size(path);
	if (len <= 0) {
		println("Error: no se pudo medir ${path}");
		return 1;
	}
	u8* buf = malloc(len + 1);
	if (read_file_into(path, buf, len) != len) {
		println("Error: no se pudo leer ${path}");
		free(buf);
		return 1;
	}
	buf[len] = 0;
	println("Leidos ${len} bytes de ${path}");

	print_attributes(buf);
	println("");
	dump_terminal(buf);

	free(buf);
	return 0;
}
