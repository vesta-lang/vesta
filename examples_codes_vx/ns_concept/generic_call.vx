// NS.2: el SEGUNDO fichero del mismo namespace parcial `mat`.
//
// Aqui viven las genericas que `main.vx` llama CUALIFICADAS (`mat.id(...)`).
// Lo que este fichero NO hace es volver a declarar `Numerico`, `doble` ni
// `main`: dos ficheros del mismo namespace comparten espacio de nombres, asi
// que repetir un nombre publico es una colision, no una variante.
namespace mat;

// Generica sin cota: cualquier tipo vale.
public T id<T>(T x) => x;

// Varios parametros de tipo, explicitos en la llamada.
public K primero<K, V>(K a, V b) => a;

// Generica con la cota al concepto del namespace -- declarado en `main.vx`,
// que es el mismo namespace: no hace falta cualificarlo ni importarlo.
public T triple<T: mat.Numerico>(T x) => x + x + x;
