// adc/sbb: aritmetica multi-palabra (bignum) de 64-bit.  El lift modela el CARRY
// FLAG (CF) como parte del pseudo-registro de flags: add/sub lo DEFINEN, adc/sbb
// lo CONSUMEN y producen el CF nuevo (cadena de dos pasos).  Suma y resta de
// 128 bits (par lo:hi) sin op de IR nueva.  interp/JIT/AOT.
//
//     vm --vx asm_adc_sbb.vx -o c && vm --run c.velb
// @expect 42
u64 main() {
	register("rax") u64 lo = 0xFFFFFFFFFFFFFFFF;
	register("rcx") u64 hi = 0;

	// Suma 128b: (0xFFFF...FF : 0) + (43 : 0).
	//   add lo -> lo = 42, CF = 1 (wraparound).  adc hi -> hi = 0 + 0 + 1 = 1.
	{
		register("rbx") u64 alo = 43;
		register("rdx") u64 ahi = 0;
		asm { add rax, rbx
			adc rcx, rdx };
	}
	// lo = 42, hi = 1.

	// Resta 128b: (lo=42 : hi=1) - (0 : 1).
	//   sub lo -> lo = 42, borrow = 0.  sbb hi -> hi = 1 - 1 - 0 = 0.
	{
		register("rbx") u64 blo = 0;
		register("rdx") u64 bhi = 1;
		asm { sub rax, rbx
			sbb rcx, rdx };
	}
	// lo = 42, hi = 0.

	return lo + hi; // 42 + 0 = 42
}
