/**
 * @file 322_herencia_self.vx
 * @brief Herencia ESTATICA de structs (value-type, sin vtable) + el tipo `Self`.
 *
 * `Self` es el tipo concreto del derivado, resuelto por SUSTITUCION COMPTIME al
 * aplanar la herencia (no es covarianza del sistema de tipos): los metodos del
 * base que usan `Self` se clonan sustituyendo `Self` por el derivado ANTES del
 * analisis semantico.  Asi un metodo comun escrito UNA vez en el base devuelve
 * el tipo correcto en cada derivado.
 *
 * Este ejemplo muestra: campos heredados, metodos heredados, `Self` covariante
 * en la firma (`sumar` devuelve el derivado), y `this : Self` (fluent).
 *
 * Resultado esperado: R0 == 84.
 */
namespace herencia_self;

// Base abstracto: no se instancia por si mismo, solo sirve de base.
@Abstract
struct Punto2D {
    i64 x;
    i64 y;

    // `Self` covariante: en `Nombrado` esto es `Nombrado sumar(Nombrado)`.
    public Self sumar(Self o) {
        Self r;
        r.x = this.x + o.x;
        r.y = this.y + o.y;
        return r;
    }

    // Metodo comun heredado.
    public i64 norma1() { return this.x + this.y; }

    // Fluent: `this` es del tipo del derivado, asi `return this` conserva el tipo.
    public Self self_ref() { return this; }
}

// Derivado: hereda los campos (x, y) y los metodos (sumar/norma1/self_ref) con
// `Self = Nombrado`, y anyade uno propio que usa un metodo heredado.
struct Nombrado : Punto2D {
    public i64 doble() { return this.norma1() * 2; }
}

i32 main() {
    Nombrado a; a.x = 10; a.y = 5;
    Nombrado b; b.x = 20; b.y = 7;
    Nombrado c = a.sumar(b);     // Self = Nombrado -> c = (30, 12)
    Nombrado d = c.self_ref();   // fluent, sigue siendo Nombrado
    return (i32) d.doble();      // (30 + 12) * 2 = 84
}
