namespace ejemplos.variadico_metodo_err;

// NEGATIVO, y completo: la unica casilla de la matriz de parametros que falta.
//
// Un variadico empaquetado (`T... xs`) se declara y se lee igual en cualquier
// contexto -- eso lo cubre el 482 --, pero la comprobacion de la llamada y el
// empaquetado de los argumentos solo existen para las funciones sueltas.  Asi
// que fuera de ahi se rechaza DICIENDOLO, con su motivo y su alternativa, en
// vez de dejar que reviente mas tarde contando argumentos.
//
// Los cuatro contextos van juntos porque cada uno lo anota por una rama
// distinta del comprobador, y basta que una se olvide para que el error salga
// tarde y mal.

class Clase {
    public i64 total(i64... xs) { return vacount(); }
}

class ConCtor {
    public i64 v;
    public ConCtor(i64... xs) { this.v = vacount(); }
}

struct Estructura {
    i64 total(i64... xs) { return vacount(); }
}

interface Contrato {
    i64 total(i64... xs);
}

i32 main() {
    Clase c = new Clase();
    return (i32) c.total(1, 2, 3);
}
