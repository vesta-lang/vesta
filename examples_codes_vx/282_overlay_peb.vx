// -----------------------------------------------------------------------------
// Dump COMPLETO del PEB REAL (Process Environment Block) de Windows x64
// -----------------------------------------------------------------------------
// Lee el PEB del PROPIO proceso con INLINE ASM (`mov rax, gs:[0x60]` -- en x64 el
// PEB vive en gs:[0x60]) y lo disecciona entero con overlays: los ~45 campos
// documentados (offsets x64 de ReactOS / Geoff Chappell), el BitField
// decodificado, los flags cruzados, y ADEMAS recorre la lista de modulos cargados
// (Ldr -> InLoadOrderModuleList) imprimiendo el nombre de cada DLL.  Campos fijos
// = @offset(N); campos que se MUEVEN entre versiones (SessionId) = un resolver que
// ramifica sobre la version del propio PEB (contexto runtime en g_os_build).
//
// El inline asm es codigo NATIVO -> requiere JIT (`-m jit`) o AOT; el interprete
// puro no tiene segmento gs.  Windows x64.

// Contexto: build de Windows, leido del propio PEB en runtime.
u64 g_os_build = 0;

// _PEB (x64).
@overlay struct PEB {
    u8  InheritedAddressSpace          @0x000;
    u8  ReadImageFileExecOptions       @0x001;
    u8  BeingDebugged                  @0x002;   // flag anti-debug clasico
    u8  BitField                       @0x003;
    // BitField decodificado (bits, x86 order = bit0 primero):
    u8  ImageUsesLargePages       : 1 @0x003;
    u8  IsProtectedProcess        : 1 @0x003;
    u8  IsImageDynamicallyReloc   : 1 @0x003;
    u8  SkipPatchingUser32Fwd     : 1 @0x003;
    u8  IsPackagedProcess         : 1 @0x003;
    u8  IsAppContainer            : 1 @0x003;
    u8  IsProtectedProcessLight   : 1 @0x003;
    u8  IsLongPathAwareProcess    : 1 @0x003;
    // punteros clave
    u64 Mutant                         @0x008;
    u64 ImageBaseAddress               @0x010;
    u64 Ldr                            @0x018;   // -> PEB_LDR_DATA
    u64 ProcessParameters              @0x020;
    u64 SubSystemData                  @0x028;
    u64 ProcessHeap                    @0x030;
    u64 FastPebLock                    @0x038;
    u64 AtlThunkSListPtr               @0x040;
    u64 IFEOKey                        @0x048;
    u32 CrossProcessFlags              @0x050;
    u64 KernelCallbackTable            @0x058;
    u32 SystemReserved                 @0x060;
    u64 ApiSetMap                      @0x068;
    u32 TlsExpansionCounter            @0x070;
    u64 TlsBitmap                      @0x078;
    u64 ReadOnlySharedMemoryBase       @0x088;
    u64 ReadOnlyStaticServerData       @0x098;
    u64 AnsiCodePageData               @0x0A0;
    u64 OemCodePageData                @0x0A8;
    u64 UnicodeCaseTableData           @0x0B0;
    u32 NumberOfProcessors             @0x0B8;
    u32 NtGlobalFlag                   @0x0BC;
    u64 CriticalSectionTimeout         @0x0C0;
    u64 HeapSegmentReserve             @0x0C8;
    u64 HeapSegmentCommit              @0x0D0;
    u64 HeapDeCommitTotalFreeThreshold @0x0D8;
    u64 HeapDeCommitFreeBlockThreshold @0x0E0;
    u32 NumberOfHeaps                  @0x0E8;
    u32 MaximumNumberOfHeaps           @0x0EC;
    u64 ProcessHeaps                   @0x0F0;
    u64 GdiSharedHandleTable           @0x0F8;
    u64 LoaderLock                     @0x110;
    u32 OSMajorVersion                 @0x118;
    u32 OSMinorVersion                 @0x11C;
    u16 OSBuildNumber                  @0x120;
    u16 OSCSDVersion                   @0x122;
    u32 OSPlatformId                   @0x124;
    u32 ImageSubsystem                 @0x128;
    u32 ImageSubsystemMajorVersion     @0x12C;
    u32 ImageSubsystemMinorVersion     @0x130;
    u64 ActiveProcessAffinityMask      @0x138;
    u64 PostProcessInitRoutine         @0x230;
    // SessionId: su offset cambia entre versiones -> resolver sobre el contexto.
    u32 SessionId @offset {
        if (g_os_build >= 10240) { return base + 0x2C0; }   // Win10 / Win11
        return base + 0x2A0;                                 // 8.1 y anteriores
    };
    u64 AppCompatFlags                 @0x2C8;
    u64 AppCompatFlagsUser             @0x2D0;
    u64 pShimData                      @0x2D8;
    u64 MinimumStackCommit             @0x318;
    u32 FlsHighIndex                   @0x350;
    u32 TracingFlags                   @0x37C;
}

// _PEB_LDR_DATA (x64): la cabeza de las listas de modulos.
@overlay struct LdrData {
    u32 Length                     @0x000;
    u8  Initialized                @0x004;
    u64 SsHandle                   @0x008;
    u64 InLoadOrderFlink           @0x010;   // LIST_ENTRY.Flink (primer modulo)
}

// _LDR_DATA_TABLE_ENTRY (x64): un modulo cargado.  InLoadOrderLinks esta en +0,
// asi que el puntero del nodo de lista ES el inicio de la entry.
@overlay struct LdrEntry {
    u64 InLoadFlink   @0x000;   // siguiente nodo (LIST_ENTRY.Flink)
    u64 DllBase       @0x030;
    u64 EntryPoint    @0x038;
    u32 SizeOfImage   @0x040;
    // BaseDllName : UNICODE_STRING { u16 Length; u16 MaxLength; u64 Buffer }
    u16 NameLen       @0x058;
    u64 NameBuf       @0x060;   // PWSTR (UTF-16)
}

// El PEB del proceso via INLINE ASM: en x64 vive en gs:[0x60].  El asm nativo
// dentro de una funcion corre en interp (auto-JIT), JIT y AOT.
u64 get_peb() {
    register("rax") u64 r;
    asm { mov rax, gs:[0x60] };
    return r;
}

i32 main() {
    u64 peb_ptr = get_peb();
    if (peb_ptr == 0) { println("sin PEB (no Windows?)"); return 1; }
    PEB p = PEB((u8*) peb_ptr);

    // contexto: la version del propio PEB decide el offset de SessionId.
    g_os_build = (u64) p.OSBuildNumber;

    println("PEB @ ${peb_ptr:hex}");
    println("InheritedAddressSpace=${p.InheritedAddressSpace}");
    println("ReadImageFileExecOptions=${p.ReadImageFileExecOptions}");
    println("BeingDebugged=${p.BeingDebugged}");
    println("BitField=${p.BitField:hex}  [LargePages=${p.ImageUsesLargePages} ProtProc=${p.IsProtectedProcess} DynReloc=${p.IsImageDynamicallyReloc} AppContainer=${p.IsAppContainer} LongPathAware=${p.IsLongPathAwareProcess}]");
    println("Mutant=${p.Mutant:hex}");
    println("ImageBaseAddress=${p.ImageBaseAddress:hex}");
    println("Ldr=${p.Ldr:hex}");
    println("ProcessParameters=${p.ProcessParameters:hex}");
    println("SubSystemData=${p.SubSystemData:hex}");
    println("ProcessHeap=${p.ProcessHeap:hex}");
    println("FastPebLock=${p.FastPebLock:hex}");
    println("AtlThunkSListPtr=${p.AtlThunkSListPtr:hex}");
    println("IFEOKey=${p.IFEOKey:hex}");
    println("CrossProcessFlags=${p.CrossProcessFlags:hex}");
    println("KernelCallbackTable=${p.KernelCallbackTable:hex}");
    println("ApiSetMap=${p.ApiSetMap:hex}");
    println("TlsExpansionCounter=${p.TlsExpansionCounter}");
    println("TlsBitmap=${p.TlsBitmap:hex}");
    println("ReadOnlySharedMemoryBase=${p.ReadOnlySharedMemoryBase:hex}");
    println("AnsiCodePageData=${p.AnsiCodePageData:hex}");
    println("OemCodePageData=${p.OemCodePageData:hex}");
    println("UnicodeCaseTableData=${p.UnicodeCaseTableData:hex}");
    println("NumberOfProcessors=${p.NumberOfProcessors}");
    println("NtGlobalFlag=${p.NtGlobalFlag:hex}");
    println("CriticalSectionTimeout=${p.CriticalSectionTimeout:hex}");
    println("HeapSegmentReserve=${p.HeapSegmentReserve:hex}");
    println("HeapSegmentCommit=${p.HeapSegmentCommit:hex}");
    println("HeapDeCommitTotalFreeThreshold=${p.HeapDeCommitTotalFreeThreshold:hex}");
    println("HeapDeCommitFreeBlockThreshold=${p.HeapDeCommitFreeBlockThreshold:hex}");
    println("NumberOfHeaps=${p.NumberOfHeaps}");
    println("MaximumNumberOfHeaps=${p.MaximumNumberOfHeaps}");
    println("ProcessHeaps=${p.ProcessHeaps:hex}");
    println("GdiSharedHandleTable=${p.GdiSharedHandleTable:hex}");
    println("LoaderLock=${p.LoaderLock:hex}");
    println("OSVersion=${p.OSMajorVersion}.${p.OSMinorVersion} build ${p.OSBuildNumber} (CSD ${p.OSCSDVersion})");
    println("OSPlatformId=${p.OSPlatformId}");
    println("ImageSubsystem=${p.ImageSubsystem}.${p.ImageSubsystemMajorVersion}.${p.ImageSubsystemMinorVersion}");
    println("ActiveProcessAffinityMask=${p.ActiveProcessAffinityMask:hex}");
    println("PostProcessInitRoutine=${p.PostProcessInitRoutine:hex}");
    println("SessionId=${p.SessionId}");
    println("AppCompatFlags=${p.AppCompatFlags:hex}");
    println("pShimData=${p.pShimData:hex}");
    println("MinimumStackCommit=${p.MinimumStackCommit:hex}");
    println("FlsHighIndex=${p.FlsHighIndex}");
    println("TracingFlags=${p.TracingFlags:hex}");

    // --- recorrer la lista de modulos cargados (Ldr -> InLoadOrderModuleList) ---
    println("modulos cargados:");
    LdrData ld = LdrData((u8*) p.Ldr);
    u64 head = p.Ldr + 0x10;          // direccion del LIST_ENTRY cabeza
    u64 cur  = ld.InLoadOrderFlink;   // primer nodo
    i32 count = 0;
    while (cur != head && cur != 0 && count < 64) {
        LdrEntry m = LdrEntry((u8*) cur);
        if (m.DllBase != 0 && m.NameLen > 0) {
            print("  ");
            // BaseDllName es UTF-16; imprimimos el byte bajo de cada wchar (ASCII)
            u8* nb = (u8*) m.NameBuf;
            i32 j = 0;
            i32 wchars = (i32)(m.NameLen / 2);
            while (j < wchars && j < 128) {
                print_char((char) *(u8*)(nb + (u64)j * 2));
                j = j + 1;
            }
            println("  (base=${m.DllBase:hex} size=${m.SizeOfImage:hex})");
        }
        cur = m.InLoadFlink;
        count = count + 1;
    }
    println("total_modulos=${count}");

    // verificacion invariante (R0 deterministico en cualquier Windows x64):
    //   - ImageBase apunta a un header 'MZ'
    //   - OSPlatformId == 2 (VER_PLATFORM_WIN32_NT)
    //   - se encontro al menos 1 modulo
    u8* ib = (u8*) p.ImageBaseAddress;
    i32 ok = 0;
    if (*(u8*)(ib+0) == 0x4D && *(u8*)(ib+1) == 0x5A
        && p.OSPlatformId == 2 && count > 0) { ok = 42; }
    println("ok=${ok}");
    return ok;   // 42 si el PEB real se parseo bien
}
