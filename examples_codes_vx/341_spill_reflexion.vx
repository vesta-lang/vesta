namespace ejemplos.spill_reflexion;

// Cobertura de FINDCLASS / FINDMETHOD / FINDFIELD con el operando DERRAMADO.
//
// Va aparte de 340 porque la reflexion necesita el ClassRegistry del runtime:
// AOT la rechaza a proposito en --target=bare, con un diagnostico explicito.
// Aqui el oraculo es el interprete y el JIT debe coincidir.

class Animal {
	public i32 edad = 0;
	public Animal(i32 e) { this.edad = e; }
	public i32 get() { return this.edad; }
}

i64 presion(i64 s) {
	i64 a0 = s + 1;
	i64 a1 = s + 2;
	i64 a2 = s + 3;
	i64 a3 = s + 4;
	i64 a4 = s + 5;
	i64 a5 = s + 6;
	i64 a6 = s + 7;
	i64 a7 = s + 8;
	i64 a8 = s + 9;
	i64 a9 = s + 10;
	i64 b0 = s + 11;
	i64 b1 = s + 12;
	i64 b2 = s + 13;
	i64 b3 = s + 14;
	i64 b4 = s + 15;
	i64 b5 = s + 16;
	i64 b6 = s + 17;
	i64 b7 = s + 18;
	return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 +
		b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7;
}

i32 main() {
	i32    fallos = 0;
	Animal a      = new Animal(5);

	// `cls` queda vivo a traves de la presion -> se derrama, y getMethod
	// tiene que recargarlo en vez de leer el scratch.
	i64    cls    = forName("Animal");
	i64    p      = presion(150);
	i64    m      = getMethod(cls, "get");
	i64    f      = getField(cls, "edad");

	println("findclass=${cls != 0} findmethod=${m != 0} findfield=${f != 0}");
	println("presion=${p} edad=${a.get()}");
	if (cls == 0) { fallos = fallos + 1; }
	if (m == 0) { fallos = fallos + 1; }
	if (f == 0) { fallos = fallos + 1; }
	println("fallos=${fallos}");
	return fallos;
}
