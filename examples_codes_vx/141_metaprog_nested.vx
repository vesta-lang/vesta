namespace ejemplos.metaprog_nested;

// ComptimeValue recursivo + strings dinamicos.
// Cubre:
//  (1) Arrays de strings comptime
//  (2) Structs anidados con campos no-int (via shared_ptr internamente)
//  (3) Builtins de strings dinamicos: chr/ord/substr/repeat/to_str
//  (4) Construccion textual char-por-char en compile-time

// (1) Array de strings comptime.
comptime string[4] FIELDS = {"x", "y", "z", "w"};
static_assert(comptime.str.eq(FIELDS[0], "x"), "f0");
static_assert(comptime.str.eq(FIELDS[3], "w"), "f3");
static_assert(comptime.str.len(FIELDS[0]) == 1, "len 1");

// (3) Strings dinamicos: chr/ord/substr/repeat/to_str.
const string LETTER_A = comptime.chr(65);                        // "A"
const u64    ORD_A    = comptime.ord("A");                       // 65
const string TAIL     = comptime.str.substr("HelloWorld", 5, 5); // "World"
const string BARS     = comptime.str.repeat("|", 8);             // "||||||||"
const string NUM_S    = comptime.to_str(2024);                   // "2024"

static_assert(comptime.str.eq(LETTER_A, "A"), "chr 65");
static_assert(ORD_A == 65, "ord A");
static_assert(comptime.str.eq(TAIL, "World"), "substr");
static_assert(comptime.str.len(BARS) == 8, "repeat | x8");
static_assert(comptime.str.eq(NUM_S, "2024"), "to_str");

// (4) Generic textual: construir un identificador a partir de un tipo.
comptime<T> string mk_setter_name() => comptime.str.concat(
	"set_",
	type.name<T>()
);

struct Vec3 {
	f64 x;
	f64 y;
	f64 z;
}
const string SETTER_V3 = mk_setter_name<Vec3>();
static_assert(comptime.str.eq(SETTER_V3, "set_Vec3"), "setter Vec3");

// (4) Comptime fn iterativa que construye string de A..N.
comptime string alphabet_up_to(i64 n) {
	string buf = "";
	i64    c   = 65_i64;
	while (c <= n) {
		buf = comptime.str.concat(buf, comptime.chr(c));
		c   = c + 1;
	}
	return buf;
}

const string ABCDEF = alphabet_up_to(70);
static_assert(comptime.str.eq(ABCDEF, "ABCDEF"), "alphabet A..F");
static_assert(comptime.str.len(ABCDEF) == 6, "len 6");

// (4) Build CSV-style separator string en compile-time.
const string CSV_HEADER =
	comptime.str.concat(
	comptime.str.concat(FIELDS[0], comptime.str.concat(",", FIELDS[1])),
	comptime.str.concat(",",
		comptime.str.concat(FIELDS[2], comptime.str.concat(",", FIELDS[3]))));

static_assert(comptime.str.eq(CSV_HEADER, "x,y,z,w"), "csv header");

i32 main() {
	// Use comptime strings at runtime: they materialize.
	string                    lbl = SETTER_V3;
	i32                       ok  = 0_i32;
	if (lbl.length() == 8)    ok  = ok + 21;
	if (ABCDEF.length() == 6) ok  = ok + 21;
	return ok; // 42
}
