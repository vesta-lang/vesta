namespace ejemplos.gc_finalize_escape;

// examples_codes_vx/246_gc_finalize_escape.vx
//
// FINALIZACION GC (caso ESCAPE, DETERMINISTA): varios objetos GC que POSEEN un
// recurso interno (unique<T> con deleter custom) y ESCAPAN su scope (return, sin
// cleanup determinista) liberan ese recurso cuando se finalizan -- corriendo
// EXACTAMENTE el mismo deleter que el usuario paso a unique_with (resuelto
// estatico, CALL directo).  Sin el finalizador GC habria FUGA del recurso.
//
// El caso no-escape (variable local que muere en su scope) ya funcionaba via
// cleanup determinista (ver 245).  Aqui cada box escapa de crea() via return,
// por lo que el finalizador GC (backstop) es el UNICO que libera su recurso.
// Ambos caminos invocan el MISMO deleter -> cero divergencia; EXACTAMENTE una
// liberacion por objeto (nunca 0 = fuga, nunca 2 = doble-free).
//
// gc_finalize_all() finaliza DETERMINISTAMENTE (sin depender de la colecta ni de
// residuos del scan conservador), por lo que la observacion es exacta y funciona
// en los TRES modos (interp/JIT/AOT).  Creamos N boxes escapados y verificamos
// que corrieron N liberaciones -> valida ademas que la side-table del
// finalizador resuelve el deleter una vez por objeto (probing + tombstones + la
// tabla hash open-addressing).  Esperado: R00 == 5.

class C { public static i64 libs; }

// Deleter custom del recurso interno.  El usuario decide COMO liberar.
void del(i64 r) { C.libs = C.libs + 1; }

// El box gc<unique<i64>> escapa via return -> sin cleanup determinista; el
// finalizador GC libera el recurso interno cuando el box se finaliza.
// La FIRMA dice quien libera, tambien envuelto en un `gc<>`: quien recoja el
// box tiene que saber a quien invocar.  Dentro no hace falta repetirlo.
gc<unique<i64, del>> crea() {
    gc<unique<i64>> g = gc_box(unique_with(7, del));
    return g;
}

i32 main() {
    C.libs = 0;
    // Cinco boxes escapados que mueren de inmediato (nadie los referencia tras
    // el return).  gc_finalize_all() corre el deleter de cada uno exactamente
    // una vez.
    crea();
    crea();
    crea();
    crea();
    crea();
    gc_finalize_all();      // finaliza los 5 boxes -> del() corre 5 veces
    return (i32) C.libs;    // 5
}
