// NS.1 fix: dentro de un namespace, las referencias a hermanos se resuelven
// tambien en interpolacion de strings ${...}, lambdas, match, spawn, try, etc.
namespace demo.util;

u64 fact(u64 n) { if (n < 2) { return n; } return n * fact(n - 1); }
i64 doble(i64 x) { return x * 2; }

i64 main() {
	// fact() y doble() son hermanos del namespace; se llaman por nombre
	// desnudo incluso DENTRO de la interpolacion ${...}.
	println("fact(5)=${fact(5)} doble(21)=${doble(21)}");
	return doble(21); // 42
}
