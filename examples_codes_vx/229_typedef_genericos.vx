namespace ejemplos.typedef_genericos;

// Interaccion de typedef/using con genericos (#4/#6/#7).
//
// Los alias de tipo (`typedef i64 Edad;`, `using Cantidad = i64;`) se resuelven
// correctamente cuando se usan como argumentos de tipo de genericos: en metodos
// genericos, en bounds de conceptos y al elegir especializaciones.  Un alias es
// transparente: `Caja<Edad>` se comporta exactamente como `Caja<i64>`.

typedef i64 Edad;
using Cantidad = i64;

// #4: metodo generico.
struct Caja {
    i64 base;
    U id<U>(U x) { return x; }
}

// #6: concepto + bound.
concept Num<T> = is_numeric<T>();
i64 sumar<T: Num>(T a, T b) { return (i64)a + (i64)b; }

// #7: especializacion total i64.
struct Env<T> { T v; i64 cual() { return 1; } }
struct Env<i64> { i64 v; i64 extra; i64 cual() { return 2; } }

i32 main() {
    Caja c = {.base = 0};
    Edad e = c.id<Edad>(10);              // alias como type-arg de metodo -> 10
    Cantidad q = sumar<Cantidad>(6, 6);    // alias satisface el bound Num -> 12
    Env<Edad> env = {.v = 0, .extra = 0};  // Edad == i64 -> elige la spec total
    i64 cual = env.cual();                  // 2

    println("e=${e} q=${q} cual=${cual}");
    return (i32)(e + q + cual + 18);        // 10 + 12 + 2 + 18 = 42
}
