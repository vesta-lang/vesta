namespace ejemplos.first_class_functions;

// =============================================================================
// 196_first_class_functions.vx
//
// Funciones de PRIMERA CLASE: un nombre de funcion top-level se puede usar como
// VALOR y asignar a una variable de tipo `fn(...) -> R` (function value con
// env=0).  Antes solo el cast explicito `(fn(...) -> R) name` funcionaba; ahora
// la promocion es automatica en var-decl y en asignacion (incluido global +
// reasignacion).  La llamada `fp(args)` baja a una llamada indirecta
// (CALLCLOSURE) con la convencion natural.
//
// Resultado esperado: 42
// =============================================================================

fn(i64, i64) -> i64 g_op; // variable GLOBAL de tipo funcion

i64 add(i64 a, i64 b) { return a + b; }
i64 mul(i64 a, i64 b) { return a * b; }

// Higher-order: recibe la operacion como valor y la aplica.
i64 apply(fn(i64, i64) -> i64 op, i64 x, i64 y) {
    return op(x, y);
}

i64 main() {
    // 1. var-decl: nombre de funcion -> function value.
    fn(i64, i64) -> i64 f = add;
    i64 r1 = f(10, 11); // 21

    // 2. asignacion global + reasignacion.
    g_op = add;
    i64 r2 = g_op(3, 4); // 7
    g_op = mul;
    i64 r3 = g_op(2, 3); // 6

    // 3. pasar la funcion por nombre a un HOF.
    i64 r4 = apply(add, 5, 3); // 8

    return r1 + r2 + r3 + r4; // 21 + 7 + 6 + 8 = 42
}
