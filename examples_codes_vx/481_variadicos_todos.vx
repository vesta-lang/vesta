namespace ejemplos.variadico_todos;

// El variadico (`T... xs`) en TODOS los contextos donde se puede declarar un
// parametro.  Era la casilla que faltaba de la matriz del 482.
//
// Solo valia en una funcion suelta, y no por diseno: la maquinaria estaba
// escrita ahi y en ningun otro sitio.  Cinco cosas hay que saber para que
// funcione, y cada una vivia en un solo camino -- que dentro del cuerpo el
// parametro se ve como la DIRECCION del array, que detras va un contador que
// nadie escribio, que la aridad tiene un minimo y no un numero exacto, que los
// argumentos de mas se comprueban contra el tipo del ELEMENTO, y que al llamar
// hay que meterlos en un array --.
//
// Ahora las cinco se dicen una vez y valen en los seis contextos.
//
// Y ademas el variadico CRUZADO con las otras dos formas de pasar argumentos
// -- el hueco `_` de la llamada uniforme y los nombres `.ranura = valor` --.
// Ese cruce no lo guardaba nadie: `552_argumentos_nombrados.vx` nombra y no usa
// variadicos, y este usaba variadicos y no nombraba.  El plan llego a dar las
// dos por indecididas ("por ahora, error") cuando el lenguaje ya las contesta.

i64 suma(i64* xs, i64 n) {
	i64 a = 0_i64;
	for (i64 i = 0_i64; i < n; i = i + 1) { a = a + xs[i]; }
	return a;
}

// El paquete cuenta x100 para que se VEA en que ranura cayo cada valor: sin
// eso, `a` y un elemento del paquete dan la misma suma y la prueba no prueba.
i64 mide(i64 a, i64... xs) => a + suma(xs, vacount()) * 100;

// Dos hermanas, una CERRADA y una ABIERTA, para la regla de seleccion.
i64 elige(i64 a) => 1_i64;
i64 elige(i64 a, i64... xs) => 2_i64;

// 1. Funcion suelta: la que siempre funciono.
i64 fn_var(i64... xs) => suma(xs, vacount());

// 2. Metodo de clase.  3. Su constructor.
class Clase {
	public i64 delCtor;
	public Clase(i64... xs) { this.delCtor = suma(xs, vacount()); }
	public i64 total(i64... xs) => suma(xs, vacount());
	// Con parametros fijos DELANTE del variadico: los de delante son
	// obligatorios, de ahi en adelante cualquier cantidad.
	public i64 desde(i64 base, i64... xs) => base + suma(xs, vacount());
}

// 4. Metodo de struct.
struct Estructura {
	i64 total(i64... xs) => suma(xs, vacount());
}

// 5. Metodo de interfaz.
interface Contrato { i64 total(i64... xs); }
class Implementa : Contrato {
	@Override
	public i64 total(i64... xs) => suma(xs, vacount());
}

i32 main() {
	Clase      c = new Clase(1, 2, 3); // ctor -> 6
	Estructura s;
	Contrato   i = new Implementa();

	// 6. Lambda.  Su TIPO tiene que saber decirlo: `fn(T...) -> R`.
	fn(i64...) -> i64 lam = (i64... xs) => { return suma(xs, vacount()); };

	i64 a = fn_var(1, 2, 3, 4);  // 10
	i64 b = c.total(5, 5);       // 10
	i64 d = c.desde(4, 1, 2, 3); // 4 + 6 = 10
	i64 f = s.total(10);         // 10
	i64 g = i.total(2, 3, 5);    // 10
	i64 h = lam(6, 4);           // 10
	i64 z = fn_var();            // ninguno: 0

	println("funcion=${a} metodo=${b} conFijos=${d} struct=${f} interfaz=${g} lambda=${h} vacio=${z} ctor=${c.delCtor}");

	/* --- El cruce con el HUECO y con los NOMBRES. --- */
	i64 r = 5_i64;

	// El hueco marca una POSICION, y de ahi en adelante se empaqueta como
	// siempre: `r.mide(1, _, 2)` ES `mide(1, r, 2)`.  Las dos grafias tienen
	// que dar lo mismo, que es toda la propuesta de la llamada uniforme.
	if (r.mide(1, _, 2) != 701) { return 1; } // a=1, paquete=[5,2]
	if (mide(1, 5, 2) != 701) { return 2; }

	// El nombre dice A QUE RANURA va, y la del paquete recibe ese valor.
	if (mide(1, .xs = 5) != 501) { return 3; }
	if (mide(.xs = 5, .a = 1) != 501) { return 4; } // y fuera de orden

	// Con el punto: el receptor cae en la ranura que el hueco nombra, y el
	// paquete se da por su nombre en la misma llamada.
	if (r.mide(.a = _, .xs = 9) != 905) { return 5; }

	/* SELECCION: con nombres, una variadica NO compite.  A que ranura va un
	 * nombre cuando la ultima lo recoge todo no esta decidido, asi que la
	 * abierta se descarta y gana la cerrada.  Es una regla sobre elegir ENTRE
	 * candidatas, distinta de lo de arriba -- que es que significa el nombre
	 * cuando ya solo hay una --. */
	if (elige(.a = 1) != 1) { return 6; }
	// Y sin nombres: la cerrada va antes que la abierta, que por definicion
	// lo recoge todo y taparia a la que dice exactamente lo que toma.
	if (elige(1) != 1) { return 7; }
	if (elige(1, 2) != 2) { return 8; } // aqui solo encaja la abierta

	// 10*6 + 0 + 6 = 66
	return (i32)(a + b + d + f + g + h + z + c.delCtor - 24); // 42
}
