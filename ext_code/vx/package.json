{
    "name": "vesta",
    "displayName": "Vesta",
    "description": "%vesta.extension.description%",
    "version": "0.1.0",
    "publisher": "desmonhak",
    "license": "SEE LICENSE IN LICENSE.md",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/vesta-lang/vesta"
    },
    "homepage": "https://github.com/vesta-lang",
    "bugs": {
        "url": "https://github.com/vesta-lang/vesta/issues"
    },
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters",
        "Visualization"
    ],
    "keywords": [
        "vesta",
        "vx",
        "vestavm",
        "lsp",
        "compiler"
    ],
    "main": "./dist/extension.js",
    "l10n": "./l10n",
    "activationEvents": [
        "onView:vesta.actions"
    ],
    "contributes": {
        "languages": [
            {
                "id": "vesta",
                "aliases": [
                    "Vesta",
                    "vesta",
                    "vx"
                ],
                "extensions": [
                    ".vx"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./images/icon.png",
                    "dark": "./images/icon.png"
                }
            },
            {
                "id": "nasm",
                "aliases": [
                    "NASM"
                ],
                "configuration": "./nasm-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "vesta",
                "scopeName": "source.vesta",
                "path": "./syntaxes/vesta.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.nasm": "nasm"
                }
            },
            {
                "language": "nasm",
                "scopeName": "source.nasm",
                "path": "./syntaxes/nasm.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "vesta",
                "path": "./snippets/vesta.json"
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "escapeSequence",
                "superType": "string",
                "description": "%vesta.token.escapeSequence.description%"
            },
            {
                "id": "interpolation",
                "superType": "variable",
                "description": "%vesta.token.interpolation.description%"
            },
            {
                "id": "register",
                "superType": "variable",
                "description": "%vesta.token.register.description%"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "vesta",
                "scopes": {
                    "escapeSequence": [
                        "constant.character.escape.vesta"
                    ],
                    "interpolation": [
                        "meta.embedded.expression.vesta"
                    ],
                    "register": [
                        "variable.language.register.vesta"
                    ]
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "vesta",
                    "title": "Vesta",
                    "icon": "images/vesta-activity.svg"
                }
            ]
        },
        "views": {
            "vesta": [
                {
                    "id": "vesta.actions",
                    "name": "Acciones",
                    "icon": "images/vesta-activity.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "vesta.restartServer",
                "title": "%vesta.restartServer.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.stopServer",
                "title": "%vesta.stopServer.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showServerLog",
                "title": "%vesta.showServerLog.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.openStdlib",
                "title": "%vesta.openStdlib.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.openImport",
                "title": "%vesta.openImport.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showPaths",
                "title": "%vesta.showPaths.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showIr",
                "title": "%vesta.showIr.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showIrDiff",
                "title": "%vesta.showIrDiff.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showBytecode",
                "title": "%vesta.showBytecode.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showJitAsm",
                "title": "%vesta.showJitAsm.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showAotAsm",
                "title": "%vesta.showAotAsm.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showComplexity",
                "title": "%vesta.showComplexity.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showModes",
                "title": "%vesta.showModes.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showAotCompat",
                "title": "%vesta.showAotCompat.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showMacroExpand",
                "title": "%vesta.showMacroExpand.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showComptimeValues",
                "title": "%vesta.showComptimeValues.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showAsa",
                "title": "%vesta.showAsa.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.selectTarget",
                "title": "%vesta.selectTarget.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.runCell",
                "title": "%vesta.runCell.title%",
                "category": "Vesta",
                "icon": "$(run)"
            },
            {
                "command": "vesta.runSelection",
                "title": "%vesta.runSelection.title%",
                "category": "Vesta",
                "icon": "$(run-all)"
            },
            {
                "command": "vesta.selectRunOptions",
                "title": "%vesta.selectRunOptions.title%",
                "category": "Vesta"
            },
            {
                "command": "vesta.showDiagram",
                "title": "%vesta.showDiagram.title%",
                "category": "Vesta",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "vesta.showMachineView",
                "title": "%vesta.showMachineView.title%",
                "category": "Vesta",
                "icon": "$(circuit-board)"
            },
            {
                "command": "vesta.compile",
                "title": "%vesta.compile.title%",
                "category": "Vesta",
                "icon": "$(gear)"
            },
            {
                "command": "vesta.run",
                "title": "%vesta.run.title%",
                "category": "Vesta",
                "icon": "$(play)"
            },
            {
                "command": "vesta.showAsmBlock",
                "title": "%vesta.showAsmBlock.title%",
                "category": "Vesta"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "resourceLangId == vesta",
                    "command": "vesta.run",
                    "group": "navigation@1"
                },
                {
                    "when": "resourceLangId == vesta",
                    "command": "vesta.showMachineView",
                    "group": "navigation@2"
                }
            ],
            "editor/context": [
                {
                    "when": "resourceLangId == vesta && editorHasSelection",
                    "command": "vesta.runSelection",
                    "group": "navigation@9"
                },
                {
                    "when": "resourceLangId == vesta",
                    "command": "vesta.openImport",
                    "group": "navigation@10"
                },
                {
                    "when": "resourceLangId == vesta",
                    "command": "vesta.run",
                    "group": "vesta@1"
                },
                {
                    "when": "resourceLangId == vesta",
                    "command": "vesta.compile",
                    "group": "vesta@2"
                },
                {
                    "when": "resourceLangId == vesta",
                    "command": "vesta.showMachineView",
                    "group": "vesta@3"
                },
                {
                    "when": "resourceLangId == vesta",
                    "command": "vesta.showDiagram",
                    "group": "vesta@4"
                },
                {
                    "command": "vesta.showAsmBlock",
                    "when": "resourceLangId == vesta",
                    "group": "vesta@5"
                }
            ],
            "commandPalette": [
                {
                    "command": "vesta.openImport",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showIr",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showIrDiff",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showBytecode",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showJitAsm",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showAotAsm",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showComplexity",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showModes",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showAotCompat",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showMacroExpand",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showComptimeValues",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showAsa",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showDiagram",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.showMachineView",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.compile",
                    "when": "resourceLangId == vesta"
                },
                {
                    "command": "vesta.run",
                    "when": "resourceLangId == vesta"
                }
            ]
        },
        "configuration": {
            "title": "Vesta",
            "properties": {
                "vesta.server.path": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "%vesta.server.path.description%",
                    "scope": "machine-overridable"
                },
                "vesta.server.arguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "%vesta.server.arguments.description%",
                    "scope": "machine-overridable"
                },
                "vesta.server.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "%vesta.server.enable.description%"
                },
                "vesta.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "%vesta.trace.server.description%"
                },
                "vesta.stdlibPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "%vesta.stdlibPath.description%",
                    "scope": "machine-overridable"
                },
                "vesta.vmPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "%vesta.vmPath.description%",
                    "scope": "machine-overridable"
                },
                "vesta.run.mode": {
                    "type": "string",
                    "enum": [
                        "vm",
                        "jit",
                        "aot"
                    ],
                    "enumDescriptions": [
                        "%vesta.run.mode.vm%",
                        "%vesta.run.mode.jit%",
                        "%vesta.run.mode.aot%"
                    ],
                    "default": "jit",
                    "description": "%vesta.run.mode.description%"
                },
                "vesta.run.opt": {
                    "type": "string",
                    "enum": [
                        "",
                        "0",
                        "1",
                        "2",
                        "3"
                    ],
                    "enumDescriptions": [
                        "%vesta.run.opt.default%",
                        "%vesta.opt.o0%",
                        "%vesta.opt.o1%",
                        "%vesta.opt.o2%",
                        "%vesta.opt.o3%"
                    ],
                    "default": "",
                    "description": "%vesta.run.opt.description%"
                },
                "vesta.run.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "%vesta.run.debug.description%"
                },
                "vesta.run.timeout": {
                    "type": "number",
                    "default": 10000,
                    "description": "%vesta.run.timeout.description%"
                },
                "vesta.reuseTerminal": {
                    "type": "boolean",
                    "default": true,
                    "description": "%vesta.reuseTerminal.description%"
                },
                "vesta.inlayHints.parameterNames": {
                    "type": "boolean",
                    "default": true,
                    "description": "%vesta.inlayHints.parameterNames.description%"
                },
                "vesta.inlayHints.compilerFacts": {
                    "type": "boolean",
                    "default": true,
                    "description": "%vesta.inlayHints.compilerFacts.description%"
                },
                "vesta.inlayHints.compilerFactsUnknown": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "%vesta.inlayHints.compilerFactsUnknown.description%"
                },
                "vesta.inspect.os": {
                    "type": "string",
                    "enum": [
                        "",
                        "windows",
                        "linux"
                    ],
                    "enumDescriptions": [
                        "%vesta.inspect.os.host%",
                        "%vesta.inspect.os.windows%",
                        "%vesta.inspect.os.linux%"
                    ],
                    "default": "",
                    "description": "%vesta.inspect.os.description%"
                },
                "vesta.inspect.arch": {
                    "type": "string",
                    "enum": [
                        "",
                        "x86-64",
                        "x86-32",
                        "aarch64"
                    ],
                    "default": "",
                    "description": "%vesta.inspect.arch.description%"
                },
                "vesta.inspect.opt": {
                    "type": "string",
                    "enum": [
                        "",
                        "0",
                        "1",
                        "2",
                        "3"
                    ],
                    "enumDescriptions": [
                        "%vesta.inspect.opt.default%",
                        "%vesta.opt.o0%",
                        "%vesta.opt.o1%",
                        "%vesta.opt.o2%",
                        "%vesta.opt.o3%"
                    ],
                    "default": "",
                    "description": "%vesta.inspect.opt.description%"
                },
                "vesta.inspect.floatIsa": {
                    "type": "string",
                    "enum": [
                        "",
                        "sse2",
                        "avx",
                        "avx512",
                        "x87",
                        "auto"
                    ],
                    "default": "",
                    "description": "%vesta.inspect.floatIsa.description%"
                },
                "vesta.inspect.cpu": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "%vesta.inspect.cpu.description%"
                },
                "vesta.aot.tier": {
                    "type": "string",
                    "enum": [
                        "bare",
                        "embed",
                        "full"
                    ],
                    "default": "bare",
                    "description": "%vesta.aot.tier.description%"
                },
                "vesta.diagram.format": {
                    "type": "string",
                    "enum": [
                        "html",
                        "mermaid",
                        "graphviz"
                    ],
                    "enumDescriptions": [
                        "%vesta.diagram.format.html%",
                        "%vesta.diagram.format.mermaid%",
                        "%vesta.diagram.format.graphviz%"
                    ],
                    "default": "html",
                    "description": "%vesta.diagram.format.description%"
                },
                "vesta.diagram.cost": {
                    "type": "boolean",
                    "default": false,
                    "description": "%vesta.diagram.cost.description%"
                },
                "vesta.flowArrows": {
                    "type": "boolean",
                    "default": true,
                    "description": "%vesta.flowArrows.description%"
                }
            }
        },
        "configurationDefaults": {
            "[vesta]": {
                "editor.formatOnSave": true,
                "editor.insertSpaces": false,
                "editor.tabSize": 4
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "npm run check-types && node esbuild.js --production",
        "compile": "npm run check-types && node esbuild.js",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "watch": "node esbuild.js --watch",
        "lint": "eslint src",
        "test:grammar": "node test/grammar.test.js",
        "test:bundle": "node test/bundle.test.js",
        "test:lsp": "python test/smoke_lsp.py",
        "test": "npm run build && npm run lint && npm run test:grammar && npm run test:manifest && npm run test:l10n && npm run test:bundle",
        "test:l10n": "node test/l10n.test.js",
        "package": "npx --yes @vscode/vsce package",
        "test:manifest": "node test/manifest.test.js"
    },
    "dependencies": {
        "package": "^1.0.1",
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/node": "22.x",
        "@types/vscode": "^1.91.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
