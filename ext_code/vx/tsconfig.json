{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "outDir": "out",
        "lib": ["ES2022"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true
    },
    "exclude": ["node_modules", ".vscode-test"]
}
