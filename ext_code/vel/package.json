{
    "name": "vel",
    "displayName": "VestaVM Assembly",
    "description": "Syntax highlighting for VestaVM assembler",
    "version": "0.0.1",
    "publisher": "desmonhak",
    "engines": {
        "vscode": "^1.115.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "vestaasm",
                "aliases": [
                    "VestaASM",
                    "vestaasm"
                ],
                "extensions": [
                    ".vesta",
                    ".vel",
                    ".vasm"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "vestaasm",
                "scopeName": "source.vestaasm",
                "path": "./syntaxes/vesta.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "vel.helloWorld",
                "title": "Hello World"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:vestaasm"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.115.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "typescript-eslint": "^8.56.1",
        "eslint": "^9.39.3",
        "typescript": "^5.9.3",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2"
    }
}
